; The synchronous compilation handoff. Only a successful final check
; constructs this sealed value; emission consumes it once. The driver
; keeps AST payloads private and makes no edits after this check. The
; declaration list is snapshotted and compared before emission.
; This retains existing checker facts, including their incompleteness;
; it does not turn the word-based backend into a typed semantic IR.
(import core)
(import parser)
(import typecheck)
(import codegen)
(import diag)
(import Vec)

(pub struct CheckedProgram sealed
  (declarations : Nodes)
  (inputDeclarations : Nodes)
  (functions : (Vec FnEnt))
  (mut available : Bool))

(pub struct CheckedResult
  (diagnostics : Diags)
  (program : (Option CheckedProgram)))

; Called after import resolution, expansion and any generated bindings.
; Neither errors nor their poisoned syntax receive an emission value.
(pub :: checkExpandedProgram (-> Nodes Nodes Units CheckedResult))
(pub fn (checkExpandedProgram entry declarations units)
  {
    (let tc (checkModuleTcTyped entry declarations units))
    (let diagnostics (tcOutVec tc))
    (let program
      (if (> (countErrorDiags diagnostics) 0)
        None
        {
          (wordLowerApply tc)
          (Some
            (CheckedProgram
              :declarations (checkedCopyDeclarations declarations)
              :inputDeclarations declarations
              :functions (tcFnsVec tc)
              :available true))
        }))
    (CheckedResult :diagnostics diagnostics :program program)
  })

; Keep the accepted roots alive independently of the caller's vector.
; This copies handles, not AST payloads or their checked stamps.
(:: checkedCopyDeclarations (-> Nodes Nodes))
(fn (checkedCopyDeclarations declarations)
  {
    (let accepted (vecWithCapacity (vecLen declarations)))
    (for declaration in declarations
      (vecPush accepted declaration))
    accepted
  })

;; Whether the merged declaration list still has its checked members
;; in their checked order. Nested AST edits are outside this predicate.
(pub :: checkedDeclarationsUnchanged (-> CheckedProgram Bool))
(pub fn (checkedDeclarationsUnchanged program)
  (if (!= (vecLen program.declarations) (vecLen program.inputDeclarations))
    false
    {
      (let mut unchanged true)
      (let mut i 0)
      (while (&& unchanged (< i (vecLen program.declarations)))
        {
          (set unchanged (nodeSame (vecGet program.declarations i)
                           (vecGet program.inputDeclarations i)))
          (set i (+ i 1))
        })
      unchanged
    }))

(pub :: checkedProgramOf (-> CheckedResult CheckedProgram))
;@axiom:pre((isSome result.program))
(pub fn (checkedProgramOf result)
  (match result.program
    ((Some program) program)
    ((None) __indexTrap)))

; Pass semantic types without exposing the checker's packed context to
; emission. The complete entries stay owned by the checked handoff.
(:: checkedFunctionTypes (-> (Vec FnEnt) FunctionTypes))
(fn (checkedFunctionTypes functions)
  {
    (let types (vecWithCapacity (vecLen functions)))
    (for entry in functions
      (if (&& (== entry.isBuiltin 0) (== entry.isEffectOp 0))
        (vecPush types (FunctionType :name entry.name :ty entry.ty :arity entry.paramCount))))
    types
  })

; The type, effect and region records stay owned by the handoff while
; the emitter uses the checked AST stamps for representation decisions.
; Unknown effects and absent region facts retain their original status.
(pub :: emitCheckedProgram (-> CheckedProgram Names Names Int Bool String))
;@axiom:effect(io)
;@axiom:pre(program.available)
;@axiom:pre((checkedDeclarationsUnchanged program))
(pub fn (emitCheckedProgram program bares fulls target obscure)
  {
    (set program.available false)
    (emitResolvedMode program.declarations (checkedFunctionTypes program.functions) bares fulls
      target obscure)
  })
