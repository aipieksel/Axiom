;;! Internal.CommandPool - the POSIX isolated command-pool entry.
(import Internal.TaskWords)
(import Internal.Command)
(import Vec)

(pub :: commandPoolRun (-> (Vec (Vec String)) Int (Vec Int)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (commandPoolRun cmds width)
  (wordPoolMap (lambda (i) (commandRunWord (vecGet cmds i))) (vecLen cmds) width))
