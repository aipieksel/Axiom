;;! Internal.WindowsCommands - native command-pool capability fallback.
;
; The POSIX command pool retains its isolated process lowering. Windows
; selects the sibling implementation with native process ownership.
(import Err)

(pub struct WindowsCommands sealed
  (unused : Int))

(pub :: windowsCommandsNew (-> Int (Result WindowsCommands Error)))
(pub fn (windowsCommandsNew width)
  (Err (mkError 78 "native command pools are unavailable on this target")))

(pub :: windowsCommandsStart (-> WindowsCommands Int String Int Int String Int))
(pub fn (windowsCommandsStart pool index name argv envp path)
  -78)

(pub :: windowsCommandsJoin (-> WindowsCommands Int Int))
(pub fn (windowsCommandsJoin pool index)
  -78)

(pub :: windowsCommandsClose (-> WindowsCommands Int))
(pub fn (windowsCommandsClose pool)
  0)

(pub :: windowsCommandsStartInherited (-> WindowsCommands Int String Int Int String Int Int Int))
(pub fn (windowsCommandsStartInherited pool index name argv envp path handles count)
  -78)

(pub :: windowsCommandsPoll (-> WindowsCommands Int Int))
(pub fn (windowsCommandsPoll pool index)
  -78)

(pub :: windowsCommandsKill (-> WindowsCommands Int Int Int))
(pub fn (windowsCommandsKill pool index code)
  -78)
