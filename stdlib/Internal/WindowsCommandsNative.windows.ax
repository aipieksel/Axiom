      (* (& code 255) 256))
  })

;; Wait for one child and retire its process handle, even on a native
;; wait or exit-code error. The pool cancels its remaining job on such
;; an error rather than treating an uncertain child as a free slot.
(pub :: windowsCommandWait (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandWait pid)
  {
    ; Allocate the out-cell while the pool still owns the live handle.
    (let cell (__alloc 8))
    (if (!= (& (cmdWaitForSingleObject pid 4294967295) 4294967295) 0)
      {
        (let error cmdLastError)
        (windowsCommandDispose pid)
        error
      }
      (if (== (& (cmdGetExitCodeProcess pid cell) 4294967295) 0)
        {
          (let error cmdLastError)
          (cmdCloseHandle pid)
          error
        }
        {
          (let code (& (__load64 cell 0) 4294967295))
          (let closed (& (cmdCloseHandle pid) 4294967295))
          (if (== closed 0)
            cmdLastError
            (cmdWaitStatus code))
        }))
  })
