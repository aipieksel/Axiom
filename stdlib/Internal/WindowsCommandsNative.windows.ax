;;! Internal.WindowsCommandsNative - contained native command processes.
;
; A pool allocates its owner and all handle slots before calling these
; operations. Creation assigns each suspended child to a private
; kill-on-close job before its handle is published in the owner's slot.
; No operation after CreateProcessW allocates Axiom memory.
(import Internal.WindowsStartup)

(extern "kernel32"
  (cmdCreateJobObjectW :: (-> Int Int Int) (symbol "CreateJobObjectW"))
  (cmdSetInformationJobObject :: (-> Int Int Int Int Int) (symbol "SetInformationJobObject"))
  (cmdInitializeProcThreadAttributeList :: (-> Int Int Int Int Int)
    (symbol "InitializeProcThreadAttributeList"))
  (cmdUpdateProcThreadAttribute :: (-> Int Int Int Int Int Int Int Int)
    (symbol "UpdateProcThreadAttribute"))
  (cmdDeleteProcThreadAttributeList :: (-> Int Int) (symbol "DeleteProcThreadAttributeList"))
  (cmdCreateProcessW :: (-> Int Int Int Int Int Int Int Int Int Int Int) (symbol "CreateProcessW"))
  (cmdResumeThread :: (-> Int Int) (symbol "ResumeThread"))
  (cmdWaitForSingleObject :: (-> Int Int Int) (symbol "WaitForSingleObject"))
  (cmdGetExitCodeProcess :: (-> Int Int Int) (symbol "GetExitCodeProcess"))
  (cmdTerminateProcess :: (-> Int Int Int) (symbol "TerminateProcess"))
  (cmdCloseHandle :: (-> Int Int) (symbol "CloseHandle"))
  (cmdGetStdHandle :: (-> Int Int) (symbol "GetStdHandle"))
  (cmdSetHandleInformation :: (-> Int Int Int Int) (symbol "SetHandleInformation"))
  (cmdGetLastError :: Int (symbol "GetLastError")))

; The errno convention of Sys.Platform.windows, kept private here so
; a native handle never crosses the standard library's public surface.
(:: cmdErrno (-> Int Int))
(fn (cmdErrno code)
  (if (|| (== code 2) (== code 3))
      -2
    (== code 5)
      -13
    (== code 6)
      -9
    (== code 8)
      -12
    (|| (== code 32) (== code 33))
      -16
    (|| (== code 80) (== code 183))
      -17
    (|| (== code 87) (== code 123))
      -22
    (== code 112)
      -28
    (|| (== code 109) (== code 232))
      -32
    (== code 145)
      -39
    (== code 206)
      -36
    (== code 267)
      -20
    (== code 193)
      -8
    -5))

(:: cmdLastError Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (cmdLastError)
  (cmdErrno (& cmdGetLastError 4294967295)))

;; A private, non-inheritable job that kills its processes when its
;; last handle closes. Its owner exists before this call, and publishes
;; the returned raw handle before making another allocation.
(pub :: windowsCommandJobNew Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandJobNew)
  {
    ; JOBOBJECT_EXTENDED_LIMIT_INFORMATION is 144 bytes on both 64-bit
    ; targets. BasicLimitInformation.LimitFlags is DWORD at byte 16.
    ; Allocate before CreateJobObjectW: no new native handle is left
    ; outside its owner by an allocation trap.
    (let limits (__alloc 144))
    (__retain limits)
    (__store64 limits 2 8192)
    (let job (cmdCreateJobObjectW 0 0))
    (let result
      (if (== job 0)
        cmdLastError
        (if (== (& (cmdSetInformationJobObject job 9 limits 144) 4294967295) 0)
          {
            (let error cmdLastError)
            (cmdCloseHandle job)
            error
          }
          job)))
    (__release limits)
    result
  })

;; Closing the private job terminates all processes still in it.
(pub :: windowsCommandJobClose (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandJobClose job)
  (if (== (& (cmdCloseHandle job) 4294967295) 0)
    cmdLastError
    0))

;; Terminate a child, observe termination, and retire its handle. No
;; memory is allocated, so this also runs from an owner's trap cleanup.
(pub :: windowsCommandDispose (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandDispose pid)
  {
    ; TerminateProcess may refuse an already ended child. Its wait is
    ; what establishes termination in either case.
    (cmdTerminateProcess pid 137)
    (let waited (& (cmdWaitForSingleObject pid 4294967295) 4294967295))
    (let error
      (if (== waited 0)
        0
        cmdLastError))
    (let closed (& (cmdCloseHandle pid) 4294967295))
    (if (!= error 0)
        error
      (== closed 0)
        cmdLastError
      0)
  })

; Roll back a suspended or resumed child. Preserve the launch failure
; across the cleanup calls, which can change GetLastError.
(:: cmdSpawnRollback (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (cmdSpawnRollback pid thread slot error)
  {
    (__store64 slot 0 0)
    (windowsCommandDispose pid)
    (cmdCloseHandle thread)
    error
  })

; Reusable launch storage owns every encoding and native record. The
; raw state is borrowed only across synchronous native calls. Publication
; precedes attribute deletion, resume, or any managed owner cleanup.
(pub :: windowsCommandSpawnPrepared (-> WindowsStartup Int Int Int Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandSpawnPrepared startup job path argv envp slot handles count)
  {
    (let state (windowsStartupPrepare startup path argv envp job handles count))
    (if (< state 0)
      state
      {
        (let app (__load64 state 0))
        (let command (__load64 state 4))
        (let env (__load64 state 35))
        (let si (__load64 state 8))
        (let pi (__load64 state 10))
        (let flags (| (__load64 state 33) 4))
        (let inherits (__load64 state 34))
        (if (== (& (cmdCreateProcessW app command 0 0 inherits flags env 0 si pi) 4294967295) 0)
          {
            (let error cmdLastError)
            (windowsStartupFinish state)
            error
          }
          {
            (let pid (__load64 pi 0))
            (let thread (__load64 pi 1))
            (__store64 slot 0 pid)
            (windowsStartupFinish state)
            (let previous (& (cmdResumeThread thread) 4294967295))
            (if (== previous 4294967295)
                (cmdSpawnRollback pid thread slot cmdLastError)
              (> previous 1)
                (cmdSpawnRollback pid thread slot -5)
              {
                (cmdCloseHandle thread)
                pid
              })
          })
      })
  })

;; Start a contained child. Its live handle is published before resume.
;; Convenience callers own and close one launch-storage resource; pools
;; call the Prepared sibling to reuse all native scratch between starts.
(pub :: windowsCommandSpawn (-> Int Int Int Int Int Int))
;@axiom:effect(io)
(pub fn (windowsCommandSpawn job path argv envp slot)
  (windowsCommandSpawnInherited job path argv envp slot 0 0))

;; Only valid standard streams and the supplied inheritable transport
;; handles cross into the child. Supplied handles stay caller-owned.
(pub :: windowsCommandSpawnInherited (-> Int Int Int Int Int Int Int Int))
;@axiom:effect(io)
(pub fn (windowsCommandSpawnInherited job path argv envp slot handles handleCount)
  {
    (let startup windowsStartupNew)
    (let result (windowsCommandSpawnPrepared startup job path argv envp slot handles handleCount))
    (windowsStartupClose startup)
    result
  })

;; Observe completion without retiring the process handle: 1 when it
;; has ended, 0 while running, or a negative errno on failure.
(pub :: windowsCommandPoll (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandPoll pid)
  {
    (let status (& (cmdWaitForSingleObject pid 0) 4294967295))
    (if (== status 0)
        1
      (== status 258)
        0
      cmdLastError)
  })

;; Request termination without retiring the handle. A child already
;; observed as ended succeeds too; a later wait still owns retirement.
(pub :: windowsCommandKill (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandKill pid exitCode)
  (if (== (& (cmdTerminateProcess pid (& exitCode 4294967295)) 4294967295) 0)
    {
      (let error cmdLastError)
      (if (== (& (cmdWaitForSingleObject pid 0) 4294967295) 0)
        0
        error)
    }
    0))

(:: cmdSignalOf (-> Int Int))
(fn (cmdSignalOf code)
  (if (|| (== code 3221225477) (== code 3221225725))
      11
    (|| (&& (>= code 3221225612) (<= code 3221225621)) (== code 3221225620))
      8
    (|| (== code 3221225501) (== code 3221225622))
      4
    (|| (== code 2147483651) (== code 2147483652))
      5
    (== code 3221225786)
      2
    (== code 3221226505)
      6
    0))

(:: cmdWaitStatus (-> Int Int))
(fn (cmdWaitStatus code)
  {
    (let signal (cmdSignalOf code))
    (if (> signal 0)
      signal
      (* (& code 255) 256))
  })

;; Wait for one child and retire its process handle, even on a native
;; wait or exit-code error. The pool cancels its remaining job on such
;; an error rather than treating an uncertain child as a free slot.
(pub :: windowsCommandWait (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (windowsCommandWait pid)
  {
    ; Allocate the out-cell while the pool still owns the live handle.
    (let cell (__alloc 8))
    (__retain cell)
    (let result
      (if (!= (& (cmdWaitForSingleObject pid 4294967295) 4294967295) 0)
        {
          (let error cmdLastError)
          (windowsCommandDispose pid)
          error
        }
        (if (== (& (cmdGetExitCodeProcess pid cell) 4294967295) 0)
          {
            (let error cmdLastError)
            (cmdCloseHandle pid)
            error
          }
          {
            (let code (& (__load64 cell 0) 4294967295))
            (let closed (& (cmdCloseHandle pid) 4294967295))
            (if (== closed 0)
              cmdLastError
              (cmdWaitStatus code))
          })))
    (__release cell)
    result
  })
