;;! Internal.WindowsLiveness - library-only file-liveness operations.
;
; Kernel-owned poll sets do not use a separate marker. Windows selects
; the sibling module, whose raw-address operations must remain behind
; the standard library's Internal import boundary (AX5002).
;; File-liveness cells are unused with kernel-owned poll sets: 1.
(pub :: windowsMarkerAlive (-> Int Int))
;@axiom:effect(pure)
(pub fn (windowsMarkerAlive cell)
  1)

;; File-liveness cells are unused with kernel-owned poll sets: 0.
(pub :: windowsMarkerRetire (-> Int Int))
;@axiom:effect(pure)
(pub fn (windowsMarkerRetire cell)
  0)

;; Console handle duplication is unused with termios: -78.
(pub :: windowsConsoleDup (-> Int Int))
;@axiom:effect(pure)
(pub fn (windowsConsoleDup fd)
  -78)
