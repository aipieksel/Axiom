;;! Internal.WorkerExec - Darwin's exec-only child replacement.
;
; XNU bsd/kern/syscalls.master and SDK sys/syscall.h define execve as59.
; Add the BSD syscall class (0x02000000), as the other Darwin calls do.
; Sys's ordinary command route uses posix_spawn and leaves sysExecveNum0.
;; The raw execve entry used only after a registered fork.
(pub :: workerExecveNum Int)
(pub fn (workerExecveNum)
  33554491)
