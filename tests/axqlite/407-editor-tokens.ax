(import IO)
(import Str)
(import Vec)
(import Axqlite.AxqlParse)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let source "SELECT name, 12, 'é', ?, :key FROM users @")
    (let tokens (axqlTokens source))
    (for i in 0..(/ (vecLen tokens) 3)
      {
        (let start (vecGet tokens (* i 3)))
        (let end (vecGet tokens (+ (* i 3) 1)))
        (let kind (vecGet tokens (+ (* i 3) 2)))
        (println (concat (format kind) (concat ":" (strSlice source start (- end start)))))
      })
    (let mut keywords true)
    (for word in (strSplit axqlKeywords 32)
      (if (! (axqlIsKeyword (strLower word)))
        (set keywords false)))
    (println (concat "keywords:" (format keywords)))
    (println (concat "contextual:" (format (axqlIsKeyword "integer"))))
    (println (concat "empty:" (format (vecLen (axqlTokens "")))))
  })
