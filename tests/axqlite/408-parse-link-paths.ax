; Identifier components remain separate, and finite paths share the
; parser's nesting budget with the expressions around them.
(import IO)
(import Str)
(import Vec)
(import Err)
(import AxqlPrint)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

(:: pathText (-> Int String))
(fn (pathText n)
  {
    (let mut text "")
    (for i in 0..n
      (set text (concat text "boss.")))
    (concat text "name")
  })

(:: status (-> String String))
(fn (status text)
  (match (axqlParse text)
    ((Ok _) "ok")
    ((Err _) "refused")))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println (axqlPrintParse "SELECT author.team.country.name, author.team.* FROM books"))
    (println (axqlPrintParse "SELECT \"author.part\".\"team.part\".\"name.part\" FROM books"))
    (println (axqlPrintParse "SELECT author.\"*\".name, author.team.\"*\" FROM books"))
    (println (status "SELECT a..b FROM t"))
    (println (status "SELECT a.b. FROM t"))
    (println (status "SELECT a.b.*.c FROM t"))
    (println (status (concat "SELECT " (pathText 200))))
    (println (status (concat "SELECT " (pathText 201))))
    (println (status (concat "SELECT (" (concat (pathText 199) ")"))))
    (println (status (concat "SELECT (" (concat (pathText 200) ")"))))
  })
