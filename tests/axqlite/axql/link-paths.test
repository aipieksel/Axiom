----
20,NULL,NULL,NULL

statement ok
DELETE FROM people WHERE id = 2

query
SELECT author.rowid, author.team.rowid, author.team.country.name FROM books WHERE id = 102
----
2,NULL,NULL

query
SELECT name, boss.boss.team.country.name FROM people WHERE id = 4
----
'Di',NULL

statement ok
UPDATE people SET boss = id

query
SELECT boss.boss.boss.team.country.name FROM people WHERE id = 1
----
'UK'


statement ok
CREATE TABLE star_targets (id INTEGER PRIMARY KEY, "*" TEXT)

statement ok
CREATE TABLE star_links (id INTEGER PRIMARY KEY, "*" LINK star_targets)

statement ok
CREATE TABLE star_base (via LINK star_links)

statement ok
INSERT INTO star_targets VALUES (1, 'literal star')

statement ok
INSERT INTO star_links VALUES (2, 1)

statement ok
INSERT INTO star_base VALUES (2)

query
SELECT via."*"."*", via."*".* FROM star_base
----
'literal star',1,'literal star'

query
SELECT "*"."*", "*".* FROM star_links
----
'literal star',1,'literal star'
