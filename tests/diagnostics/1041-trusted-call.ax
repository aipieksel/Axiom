; A call to a trusted encapsulation is not an unsafe operation of the
; caller's (R-B6, docs/memory-model.md MM-EXEC-9d). A function that
; says `;@axiom:effect(unsafe)` vouches for every well-typed call, so
; its callers need no tag.
;
; Accepted: `peek` reads a byte with `Str.strByte`, `heading` reads a
; vector slot with `Vec.vecGet`, and `useLocal` calls `loadAt`, a
; trusted function written here. `pure` claims purity over
; the call to `loadAt`, and the claim holds: the callee's `Unsafe`
; stays with it.
;
; Refused: `vouched` says `effect(unsafe)` over a body that only calls
; `loadAt`. It performs nothing unsafe itself, so the claim is
; unsupported, which is AX3010.
(import Str)
(import Vec)

(:: peek (-> String Int))
(fn (peek s)
  (strByte s 0))

(:: heading (-> (Vec String) String))
(fn (heading v)
  (vecGet v 0))

(:: loadAt (-> Int Int))
;@axiom:effect(unsafe)
(fn (loadAt a)
  (__load64 a 0))

(:: useLocal (-> Int Int))
(fn (useLocal a)
  (loadAt a))

(:: pure (-> Int Int))
;@axiom:effect(pure)
(fn (pure a)
  (loadAt a))

(:: vouched (-> Int Int))
;@axiom:effect(unsafe)
(fn (vouched a)
  (loadAt a))

(:: main ())
(fn (main)
  ())
