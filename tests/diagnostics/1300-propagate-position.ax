; A `String` error cannot leave a region (`AX3059`). A branch and a
; tail `?` propagate. `fine` is the control.
(import Str)
(import Err)

(:: get (-> Int (Result Int String)))
(fn (get n)
  (if (> n 0)
    (Ok n)
    (Err "negative")))

(:: inBranch (-> Int (Result Int String)))
(fn (inBranch n)
  (Ok
    (+ 1
      (if (> n 0)
        (get n)?
        0))))

(:: inRegion (-> Int (Result Int String)))
(fn (inRegion n)
  (Ok
    (+ 1
      (region r
        (get n)?))))

(:: fine (-> Int (Result Int String)))
(fn (fine n)
  (Ok (+ 1 (get n)?)))

(:: main ())
(fn (main)
  ())
