(import checked)
(import core)

; Syntax vectors cannot enter checked emission.
(:: unchecked (-> Nodes String))
;@axiom:effect(io)
(fn (unchecked declarations)
  (emitCheckedProgram declarations vecNew vecNew 0 false))

; Only the checking module constructs or changes the sealed handoff.
(:: forged CheckedProgram)
(fn (forged)
  (CheckedProgram :declarations vecNew :functions vecNew :available true))

(:: changed (-> CheckedProgram ()))
(fn (changed program)
  (set program.available true))

(:: escaped (-> CheckedProgram Nodes))
(fn (escaped program)
  program.declarations)
