; A signature-only declaration keeps the imported implementation's facts.
(import IO)
(import Str)
(import AmbA)
(import AmbB)

; The empty signature entry cannot hide IO from callers.
(:: writeOut (-> String Int))

(:: output Int)
(fn (output)
  (writeOut "still performs IO"))

; A redeclaration cannot change the imported function's parameter type.
(:: strLen (-> Int Int))

; A signature declares no implementation and cannot choose an ambiguous one.
(:: dup (-> Int Int))

(:: main Int)
(fn (main)
  0)
