; A program importing the standard library's raw memory layer.
;
; `Internal.Raw` reads and writes words at an address and reads a word
; back as a `String`, so only the library's own modules may import it
; (AX5002, docs/memory-model.md MM-EXEC-9g). The refusal is at the
; import, and again at each name the program uses from it.
(import Internal.Raw)

(:: peek (-> Int Int))
(fn (peek addr)
  (rawGetWord addr 0))

(:: main Int)
(fn (main)
  0)
