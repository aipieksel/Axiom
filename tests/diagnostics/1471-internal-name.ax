; A raw memory function reached without importing its module.
;
; `Str` imports `Internal.Raw`, so the name `rawAlloc` is in scope here
; without an import of its own. Naming it is still AX5002: what decides
; is that this file is not part of the standard library
; (docs/memory-model.md MM-EXEC-9g). `strLen` and `strByte` are the
; typed interface the program uses instead.
(import Str)

(:: scratch (-> Int Int))
(fn (scratch n)
  (rawAlloc n))

(:: first (-> String Int))
(fn (first s)
  (if (> (strLen s) 0)
    (strByte s 0)
    0))

(:: main Int)
(fn (main)
  (first "a"))
