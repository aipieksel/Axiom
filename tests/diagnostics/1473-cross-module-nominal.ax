; Two modules each declare a struct `P` with the same field. They are
; two types: a value of NominalA's `P` passed where NominalB's is
; declared is refused, and the message names both modules.
(import IO)
(import NominalA (mkA))
(import NominalB (useB))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let n (useB (mkA 3)))
    (println "{n}")
    0
  })
