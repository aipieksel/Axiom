; Field substitution must preserve the receiver's distinct rigid parameters.
(struct Pair (a b)
  (mut first : a)
  (second : b))

(struct Triple (a b c)
  (first : a)
  (second : b)
  (third : c))

(type Flipped (a b) (Pair b a))

(:: wrongRead (-> (Pair b a) a))
(fn (wrongRead pair)
  pair.first)

(:: wrongAlias (-> (Flipped a b) a))
(fn (wrongAlias pair)
  pair.first)

(:: wrongNestedRead (-> (Pair (Option b) a) (Option a)))
(fn (wrongNestedRead pair)
  pair.first)

(:: wrongCycledRead (-> (Triple b c a) a))
(fn (wrongCycledRead triple)
  triple.first)

(:: wrongWrite (-> (Pair b a) a Int))
(fn (wrongWrite pair value)
  (set pair.first value))

(:: wrongNestedWrite (-> (Pair (Option b) a) (Option a) Int))
(fn (wrongNestedWrite pair value)
  (set pair.first value))

(:: main Int)
(fn (main)
  0)
