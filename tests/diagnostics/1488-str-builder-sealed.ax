; A `StrBuilder`'s storage is reachable only from `Str`: a program that
; makes one with its constructor, reads the `String` it writes into, or
; resets its length to write over bytes already finished is AX3085 or
; AX3086. `fine` uses the builder through its functions and is the
; control.
(import Str)

(:: forged StrBuilder)
(fn (forged)
  (StrBuilder :bytes "abc" :len 0))

(:: storage (-> StrBuilder String))
(fn (storage b)
  b.bytes)

(:: rewind (-> StrBuilder ()))
(fn (rewind b)
  (set b.len 0))

(:: swap (-> StrBuilder String ()))
(fn (swap b s)
  (set b.bytes s))

(:: fine (-> StrBuilder String))
(fn (fine b)
  (strBuilderFinish (strBuilderPush b "abc")))

(:: main Int)
(fn (main)
  (strLen (fine strBuilderNew)))
