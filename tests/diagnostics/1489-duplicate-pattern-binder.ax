; A name bound twice in one pattern is AX3136, at the top level and
; nested. The control binds each name once, and `_` binds nothing, so
; it may repeat.
(data P
  (Pair Int Int))

(data Q
  (Box P Int))

(:: f (-> P Int))
(fn (f p)
  (match p
    ((Pair x x) x)))

(:: h (-> Q Int))
(fn (h q)
  (match q
    ((Box (Pair x x) _) x)))

(:: g (-> Q Int))
(fn (g q)
  (match q
    ((Box (Pair x y) _) (+ x y))
    ((Box _ z) z)))
