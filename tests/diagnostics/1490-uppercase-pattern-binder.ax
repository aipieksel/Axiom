; A bare binder that starts with a capital letter is AX3137: it binds
; every value, so it is not the constructor test it reads as. The
; parenthesised test and the lowercase binder are the controls.
(import IO)

(:: f (-> (Option Int) Int))
(fn (f o)
  (match o
    ((Some v) v)
    (Nothing 7)))

(:: g (-> (Option Int) Int))
(fn (g o)
  (match o
    ((Some v) v)
    ((None) 7)))

(:: k (-> (Option Int) Int))
(fn (k o)
  (match o
    ((Some v) v)
    (other 0)))
