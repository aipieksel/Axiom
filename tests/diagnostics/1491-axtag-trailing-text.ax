; Text after an AXTAG's closing parenthesis is AX3138: no reader sees
; it, so `strict` here would silently weaken the claim. The tag with
; `strict` inside its parentheses is the control.
(:: callIt (-> (-> Int Int) Int Int))
;@axiom:restrict(no-recursion) strict
(fn (callIt f n)
  (f n))

(:: callItOk (-> (-> Int Int) Int Int))
;@axiom:restrict(no-recursion,strict)
(fn (callItOk f n)
  (f n))
