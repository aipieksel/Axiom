; Traps the literals make certain are AX3140: division by a literal
; zero, a negative literal `vecGet` index, and a literal outside the
; range of a declared subtype. Computed operands are the controls:
; they keep their run-time checks.
(import Vec)

(subtype Percent is Int range 0..101)

(:: show (-> Percent Int))
(fn (show p)
  (as p Int))

(:: main Int)
(fn (main)
  {
    (let a (/ 1 0))
    (let b (vecGet (vecPush vecNew 1) -1))
    (let c (show 200))
    (+ a (+ b c))
  })

(:: dyn (-> Int Int Int))
(fn (dyn x y)
  {
    (let v (vecPush vecNew x))
    (+ (/ x y) (vecGet v y))
  })
