; A `Result` bound by `let` and never read is AX3046, as a discarded
; one in statement position is. Reading it, and binding it to `_` or
; to a name starting with `_`, are the controls.
(import Err)

(:: f (-> Int (Result Int Error)))
(fn (f n)
  (Ok n))

(:: main Int)
(fn (main)
  {
    (let r (f 1))
    (let _ (f 2))
    (let _kept (f 4))
    (match (f 3)
      ((Ok v) v)
      ((Err e) 0))
  })
