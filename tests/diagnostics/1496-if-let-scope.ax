; The names an `if let` pattern binds are in scope in the branch it
; chooses and nowhere else, so `n` in the else branch is AX3001. The
; second function reads `n` only where it is bound.
(:: f (-> (Option Int) Int))
(fn (f o)
  (if (let (Some n) o)
    n
    (+ n 1)))

(:: g (-> (Option Int) Int))
(fn (g o)
  (if (let (Some n) o)
    n
    0))
