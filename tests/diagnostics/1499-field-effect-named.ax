; A named function stored into a field that declares its effects is
; checked by its effect row: `shout` performs IO, and `Check.test`
; declares `effect(pure)`, so storing it is AX3142, whether the
; construction is written with labels or a macro builds it by position.
; `isPositive` is the control.
(import IO)

(struct Check
  ;@axiom:effect(pure)
  (test : (-> Int Bool)))

(macro (build c v) (c v))

(:: shout (-> Int Bool))
;@axiom:effect(io)
(fn (shout n)
  {
    (println "checked")
    (> n 0)
  })

(:: isPositive (-> Int Bool))
(fn (isPositive n)
  (> n 0))

(:: loud Check)
(fn (loud)
  (Check :test shout))

(:: built Check)
(fn (built)
  (build Check shout))

(:: quiet Check)
(fn (quiet)
  (Check :test isPositive))

(:: main Int)
(fn (main)
  {
    (let c quiet)
    (if (c.test 1)
      0
      1)
  })
