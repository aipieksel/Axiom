; A function stored from a parameter is one each caller chooses, so a
; field that declares its effects refuses it (AX3143): `wrap` stores
; its parameter, and `holed` builds the record through a field hole,
; whose lambda stores its own parameter. `fixed` stores a named
; function and is the control.
(struct Step
  ;@axiom:effect(pure)
  (next : (-> Int Int)))

(:: inc (-> Int Int))
(fn (inc n)
  (+ n 1))

(:: wrap (-> (-> Int Int) Step))
(fn (wrap f)
  (Step :next f))

(:: holed (-> (-> Int Int) Step))
(fn (holed)
  (Step :next _))

(:: fixed Step)
(fn (fixed)
  (Step :next inc))

(:: main Int)
(fn (main)
  {
    (let s fixed)
    (s.next (- 0 1))
  })
