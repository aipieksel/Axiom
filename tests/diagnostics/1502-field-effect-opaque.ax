; A call's result and a container's element are values the compiler
; can't follow to a function, so a field that declares its effects
; refuses both (AX3143). `local` binds a lambda first and is the
; control: a local the walk follows is checked as the lambda is.
(import Vec)

(struct Step
  ;@axiom:effect(pure)
  (next : (-> Int Int)))

(:: pick (-> Int Int Int))
(fn (pick n)
  (lambda (x) (+ x n)))

(:: fromCall Step)
(fn (fromCall)
  (Step :next (pick 1)))

(:: fromVec (-> (Vec (-> Int Int)) Step))
(fn (fromVec fs)
  (Step :next (vecGet fs 0)))

(:: local Step)
(fn (local)
  {
    (let f (lambda (x) (* x 3)))
    (Step :next f)
  })

(:: main Int)
(fn (main)
  {
    (let s local)
    (s.next 0)
  })
