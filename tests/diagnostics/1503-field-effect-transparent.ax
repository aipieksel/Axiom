; A stored function must not call a function it is given: what that
; argument performs is chosen at each call, and a call through the
; field is charged the declaration alone. `twice` calls its parameter,
; so storing it is AX3143; `square` is the control.
(struct Lift
  ;@axiom:effect(pure)
  (apply : (-> (-> Int Int) Int)))

(:: twice (-> (-> Int Int) Int))
(fn (twice f)
  (f (f 1)))

(:: square (-> (-> Int Int) Int))
(fn (square f)
  4)

(:: viaTwice Lift)
(fn (viaTwice)
  (Lift :apply twice))

(:: viaSquare Lift)
(fn (viaSquare)
  (Lift :apply square))

(:: main Int)
(fn (main)
  {
    (let l viaSquare)
    (- (l.apply (lambda (x) x)) 4)
  })
