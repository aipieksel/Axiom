; A lambda of two parameters is applied one argument at a time, and
; the first step builds the closure for the second: calling it
; performs `Alloc`. So a field of two parameters that declares
; `effect(pure)` refuses even `(lambda (a b) (== a b))` with AX3142, and
; the note says why. `Eq` declares `effect(alloc)` and is the control.
(struct Same
  ;@axiom:effect(pure)
  (eq : (-> Int Int Bool)))

(struct Eq
  ;@axiom:effect(alloc)
  (eq : (-> Int Int Bool)))

(:: same Same)
(fn (same)
  (Same :eq (lambda (a b) (== a b))))

(:: eq Eq)
(fn (eq)
  (Eq :eq (lambda (a b) (== a b))))

(:: main Int)
(fn (main)
  {
    (let e eq)
    (if (e.eq 1 1)
      0
      1)
  })
