; A field effect declaration the compiler can't read is AX3144: on a
; field that holds no function, `effect(unsafe)`, `effect(pure)` beside
; another effect, and an effect nothing declares. A list in one tag is
; AX3076, another checked key on a field is AX3077, and a slip of
; `effect` is AX3039. `ok` declares `effect(io)` and is the control.
(struct Parts
  ;@axiom:effect(pure)
  (count : Int)
  ;@axiom:effect(unsafe)
  (raw : (-> Int Int))
  ;@axiom:effect(pure)
  ;@axiom:effect(io)
  (both : (-> Int Int))
  ;@axiom:effect(teleport)
  (far : (-> Int Int))
  ;@axiom:effect(io, alloc)
  (listed : (-> Int Int))
  ;@axiom:restrict(no-io)
  (limited : (-> Int Int))
  ;@axiom:efect(pure)
  (slipped : (-> Int Int))
  ;@axiom:effect(io)
  (ok : (-> Int Int)))

(:: main Int)
(fn (main)
  0)
