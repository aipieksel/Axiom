; A link's width is `UInt8`, `UInt16` or `UInt32`, or a type variable a
; generic signature leaves open: anything else is AX3145, once per
; written type. `tight`, `aliased` (through the alias `Wide`) and
; `pass` are the controls.
(import Link)

(type Wide UInt32)

(struct Node
  (key : Int)
  (signed : (Link Node Int32))
  (word : (Link Node Int))
  (tight : (Link Node UInt8))
  (aliased : (Link Node Wide)))

(:: pass (-> (Link Node w) (Link Node w)))
(fn (pass l)
  l)

(:: widen (-> (Link Node UInt64) Int))
(fn (widen l)
  0)

(:: main Int)
(fn (main)
  0)
