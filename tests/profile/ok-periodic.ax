(import Mem)

(:: step (-> Int Int Int))
;@axiom:restrict(no-alloc, no-recursion, strict)
(fn (step buf i)
  {
    (memSetWord buf (% i 8) (* i i))
    (memGetWord buf (% i 8))
  })

(:: main Int)
(fn (main)
  {
    (let buf (memAlloc 64))
    (let mut i 0)
    (let mut acc 0)
    {
      (while (< i 1000)
        {
          (set acc (+ acc (step buf i)))
          (set i (+ i 1))
        })
      (% acc 256)
    }
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memAlloc (-> Int Int))
;@axiom:effect(unsafe)
(fn (memAlloc bytes)
  (__alloc bytes))

(:: memGetWord (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (memGetWord addr index)
  (__load64 addr index))

(:: memSetWord (-> Int Int a Int))
;@axiom:effect(unsafe)
(fn (memSetWord addr index value)
  {
    (__retainref value)
    (__store64 addr index (as value Int))
    addr
  })
