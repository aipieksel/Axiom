; The handler retains an argument allocated below its installation.
(import IO)
(import Str)

(effect Keep
  (keep :: (-> String Int)))

(struct Cell
  (mut s : String))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let c (Cell :s "empty"))
    (handle
      (region short
        (keep (concat "hel" "lo")))
      (Keep Alloc Mut)
      (lambda (s)
        {
          (set c.s s)
          0
        }
      ))
    (let replacement (strDup "fresh"))
    (println c.s)
    (println replacement)
  })
