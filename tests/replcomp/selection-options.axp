(import IO)
(import Str)
(import Vec)
(import replcomp)

(:: absent (-> (Option Int) Bool))
(fn (absent result)
  (match result
    ((None) true)
    ((Some _) false)))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs result wanted)
  (match result
    ((None) false)
    ((Some selected) (== selected wanted))))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let cands
      (vecPush (vecPush vecNew (ReplCand :label "first" :origin 1 :tag 0 :detail "one"))
        (ReplCand :label "second" :origin 1 :tag 0 :detail "two")))
    (let idle (ComplSt :start 0 :typed "f" :cands cands :sel None :rows 0))
    (let first (ComplSt :start 0 :typed "f" :cands cands :sel (Some 0) :rows 1))
    (say 1 (absent (replComplSelOf vecNew None)))
    (say 2 (absent (replComplSelOf vecNew (Some 0))))
    (say 3 (absent (replComplSelOf cands None)))
    (say 4 (indexIs (replComplSelOf cands (Some 0)) 0))
    (say 5 (indexIs (replComplSelOf cands (Some 1)) 1))
    (say 6 (absent (replComplSelOf cands (Some 2))))
    (say 7 (absent (replComplSelOf cands (Some -1))))
    (say 8 (absent (replComplSelOf cands (Some 999999))))
    (say 9 (absent (stSel idle)))
    (say 10 (indexIs (stSel first) 0))
    (say 11 (== (replComplPageBase cands None 80) 0))
    (say 12 (== (replComplPageBase cands (Some 2) 80) 0))
    (say 13 (== (replComplRows cands (Some 0) 80) (+ (replComplRows cands None 80) 1)))
    (say 14 (> (strLen (replComplMenu cands (Some 0) 80)) (strLen (replComplMenu cands None 80))))
  })
