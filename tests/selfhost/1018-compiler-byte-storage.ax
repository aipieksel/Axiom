; expect 42
; Actual compiler records save allocation space and retain exact flag values.
(import IO)
(import replhl)
(import expand)

(:: liveBytes Int)
(fn (liveBytes)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: blockCount (-> a Int))
;@axiom:effect(unsafe)
(fn (blockCount handle)
  (__load64 (- (as handle Int) 16) 0))

(:: bracketBytes Int)
(fn (bracketBytes)
  {
    (let warm (mkHlBrk 7 1 2 -1 99))
    (let before liveBytes)
    (let value (mkHlBrk 8 0 1 7 100))
    (let bytes (- liveBytes before))
    (if (&& (== (hlBrkPos warm) 7) (== (hlBrkSpan value) 100))
      bytes
      -1)
  })

(:: formatBytes Int)
(fn (formatBytes)
  {
    (let warm (mkFmtSpec 62 1 20 None None))
    (let precision (Some 12))
    (let radix (Some (as 120 UInt8)))
    (let before liveBytes)
    (let value (mkFmtSpec 60 0 100 precision radix))
    (let bytes (- liveBytes before))
    (if (&& (== (fmtSpecWidth warm) 20) (precisionIs value 12))
      bytes
      -1)
  })

(:: bracketValues Bool)
(fn (bracketValues)
  {
    (let value (mkHlBrk 1099511627776 1 2 -1 2199023255552))
    (&& (== (hlBrkPos value) 1099511627776)
      (&& (== (hlBrkOpen value) 1)
        (&& (== (hlBrkFam value) 2)
          (&& (== (hlBrkPartner value) -1) (== (hlBrkSpan value) 2199023255552)))))
  })

(:: precisionIs (-> FmtSpec Int Bool))
(fn (precisionIs spec want)
  (if (let (Some value) (fmtSpecPrec spec))
    (== value want)
    false))

(:: radixIs (-> FmtSpec Int Bool))
(fn (radixIs spec want)
  (if (let (Some value) (fmtSpecType spec))
    (== (as value Int) want)
    false))

(:: formatValues Bool)
(fn (formatValues)
  {
    (let value (mkFmtSpec 94 1 1099511627776 (Some 2199023255552) (Some (as 88 UInt8))))
    (&& (== (fmtSpecAlign value) 94)
      (&& (== (fmtSpecZero value) 1)
        (&& (== (fmtSpecWidth value) 1099511627776)
          (&& (precisionIs value 2199023255552) (radixIs value 88)))))
  })

(:: absentValues Bool)
(fn (absentValues)
  {
    (let value (mkFmtSpec 62 0 0 None None))
    (&& (== (fmtSpecAlign value) 62)
      (&& (== (fmtSpecZero value) 0)
        (&& (== (fmtSpecWidth value) 0)
          (if (let (Some _) (fmtSpecPrec value))
            false
            (if (let (Some _) (fmtSpecType value))
              false
              true)))))
  })

(:: stableViews Bool)
(fn (stableViews)
  {
    (let bracket (mkHlBrk 7 1 2 -1 99))
    (let spec (mkFmtSpec 62 1 20 (Some 6) (Some (as 120 UInt8))))
    (let bracketCount (blockCount bracket))
    (let specCount (blockCount spec))
    (let mut exact true)
    {
      (for i in 0..1000
        {
          (set exact (&& exact
                       (&& (== (hlBrkPos bracket) 7)
                         (&& (== (hlBrkOpen bracket) 1)
                           (&& (== (hlBrkFam bracket) 2)
                             (&& (== (hlBrkPartner bracket) -1) (== (hlBrkSpan bracket) 99)))))))
          (set exact (&& exact
                       (&& (== (fmtSpecAlign spec) 62)
                         (&& (== (fmtSpecZero spec) 1)
                           (&& (== (fmtSpecWidth spec) 20)
                             (&& (precisionIs spec 6) (radixIs spec 120)))))))
        })
      (&& exact
        (&& (> bracketCount 0)
          (&& (> specCount 0)
            (&& (== (blockCount bracket) bracketCount) (== (blockCount spec) specCount)))))
    }
  })

(:: invalidBracket (-> Int HlBrk))
(fn (invalidBracket k)
  (if (== k 0)
      (mkHlBrk 0 -1 0 -1 0)
    (== k 1)
      (mkHlBrk 0 2 0 -1 0)
    (== k 2)
      (mkHlBrk 0 256 0 -1 0)
    (== k 3)
      (mkHlBrk 0 0 -1 -1 0)
    (== k 4)
      (mkHlBrk 0 0 3 -1 0)
    (mkHlBrk 0 0 256 -1 0)))

(:: invalidFormatFlag (-> Int FmtSpec))
(fn (invalidFormatFlag k)
  (if (== k 0)
      (mkFmtSpec -1 0 0 None None)
    (== k 1)
      (mkFmtSpec 0 0 0 None None)
    (== k 2)
      (mkFmtSpec 256 0 0 None None)
    (== k 3)
      (mkFmtSpec 62 -1 0 None None)
    (== k 4)
      (mkFmtSpec 62 2 0 None None)
    (== k 5)
      (mkFmtSpec 62 256 0 None None)
    (== k 6)
      (mkFmtSpec 62 0 0 None (Some (as -1 UInt8)))
    (== k 7)
      (mkFmtSpec 62 0 0 None (Some (as 121 UInt8)))
    (mkFmtSpec 62 0 0 None (Some (as 256 UInt8)))))

(:: invalidFlag (-> Int Int))
(fn (invalidFlag k)
  (if (< k 6)
    {
      (invalidBracket k)
      0
    }
    {
      (invalidFormatFlag (- k 6))
      0
    }))

(:: guardedFlags Bool)
(fn (guardedFlags)
  {
    (let mut exact true)
    {
      (for k in 0..15
        {
          (let status (__axiom_recover __axiom_arena_mark (lambda (ignored) (invalidFlag k))))
          (set exact (&& exact (== status 80)))
        })
      exact
    }
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let bracket bracketBytes)
    (let spec formatBytes)
    (let bracketOK bracketValues)
    (let specOK formatValues)
    (let absentOK absentValues)
    (let stable stableViews)
    (let guarded guardedFlags)
    {
      (println bracket)
      (println spec)
      (println bracketOK)
      (println specOK)
      (println absentOK)
      (println stable)
      (println guarded)
      (if (&& (== bracket 48)
            (&& (== spec 48) (&& bracketOK (&& specOK (&& absentOK (&& stable guarded))))))
        42
        1)
    }
  })
