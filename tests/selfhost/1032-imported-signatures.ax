; expect 42
(import Vec)
(import Str)
(import Mem)

; Compatible imported signatures keep the implementation's type and effects.
(:: strLen (-> String Int))

; Type parameter spelling is local; the repeated parameter still agrees.
(:: vecGet (-> (Vec item) Int item))

; A real local implementation owns its signature and may shadow an import.
(:: memGetWord (-> Int Int Int))
(fn (memGetWord x y)
  (+ x y))

(:: main Int)
;@axiom:restrict(no-unsafe)
(fn (main)
  {
    (let values (vecPush vecNew "safe"))
    (if (== (strLen (vecGet values 0)) 4)
      (memGetWord 40 2)
      1)
  })
