; expect 42
(import core)
(import lexer)
(import parser)
(import checked)
(import codegen)
(import expand)
(import diag)
(import Vec)

(struct CheckedEdit
  (declarations : Nodes)
  (units : Units)
  (program : CheckedProgram))

(:: example (-> String CheckedEdit))
;@axiom:effect(io)
(fn (example source)
  {
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (let declarations (readAstNodes parsed 1))
    (let units vecNew)
    (vecPush units (CUnit2 :file "checked.ax" :src source :name "" :imports vecNew :library false))
    (let bares vecNew)
    (let fulls vecNew)
    (let mods vecNew)
    (let merged (resolveImports declarations bares fulls mods 0 "" units))
    (expandProgram declarations merged vecNew vecNew units bares fulls mods)
    (let result (checkExpandedProgram declarations merged units))
    (CheckedEdit :declarations merged :units units :program (checkedProgramOf result))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let source "(:: main Int) (fn (main) 42)")
    (let empty (example ""))
    (let same (example source))
    (vecSet same.declarations 0 (vecGet same.declarations 0))
    (let replaced (example source))
    (vecSet replaced.declarations 0 (vecGet replaced.declarations 1))
    (let appended (example source))
    (vecPush appended.declarations (vecGet appended.declarations 1))
    (let removed (example source))
    (vecPop removed.declarations)
    (let reordered (example source))
    (let first (vecGet reordered.declarations 0))
    (vecSet reordered.declarations 0 (vecGet reordered.declarations 1))
    (vecSet reordered.declarations 1 first)
    (let cleared (example source))
    (vecClear cleared.declarations)
    (let rechecked
      (checkExpandedProgram reordered.declarations reordered.declarations reordered.units))
    (if (&& (checkedDeclarationsUnchanged empty.program)
          (&& (checkedDeclarationsUnchanged same.program)
            (&& (! (checkedDeclarationsUnchanged replaced.program))
              (&& (! (checkedDeclarationsUnchanged appended.program))
                (&& (! (checkedDeclarationsUnchanged removed.program))
                  (&& (! (checkedDeclarationsUnchanged reordered.program))
                    (&& (! (checkedDeclarationsUnchanged cleared.program))
                      (&& (== (countErrorDiags rechecked.diagnostics) 0)
                        (checkedDeclarationsUnchanged (checkedProgramOf rechecked))))))))))
      42
      1)
  })
