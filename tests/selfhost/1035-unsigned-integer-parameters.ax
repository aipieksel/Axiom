; expect 103
(import Str)

(struct Box (a)
  (value : a))

; Int defaults remain accepted and keep their types through aliases,
; constructors, numeric expressions and later calls.
(fn (unsignedAdd x y)
  {
    (let alias x)
    (+ alias y)
  })

(fn (unsignedBox x)
  {
    (let box (Box :value x))
    box.value
  })

; Explicit signatures admit String, Bool and callback parameters.
(:: text (-> String Int))
;@axiom:pre((> (strLen value) 0))
(fn (text value)
  (+ (strLen value) (strLen value)))

(:: condition (-> Bool Int))
(fn (condition flag)
  (if flag
    10
    20))

(:: callback (-> (-> Int Int) Int))
(fn (callback f)
  (+ (f 1) (f 2)))

(:: increment (-> Int Int))
(fn (increment x)
  (+ x 1))

(:: main Int)
(fn (main)
  (+ (unsignedAdd 40 6)
    (+ (unsignedBox 38) (+ (text "hi") (+ (condition true) (callback increment))))))
