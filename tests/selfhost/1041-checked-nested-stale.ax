; expect 80
(import core)
(import parser)
(import checked)
(import CheckedNested)
(import Str)
(import Vec)

; A caller's same-named function must not replace the checked module's
; predicate. Removing that precondition makes this control answer 0.
(:: checkedSyntaxUnchanged (-> CheckedProgram Bool))
(fn (checkedSyntaxUnchanged program)
  true)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let example (nestedExample "(:: main Int) (fn (main) 42)"))
    (writeNodeChild (nestedMain example) 3 (mkEInt 43))
    (let ir (emitCheckedProgram example.program vecNew vecNew 0 false))
    (if (> (strLen ir) 0)
      0
      1)
  })
