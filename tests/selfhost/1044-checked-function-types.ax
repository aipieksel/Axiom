; expect 42
; Numeric representation follows the final checked function types,
; including unsigned and imported functions. Returning an arrow does
; not turn that arrow's parameters into this definition's parameters.
(import CheckedNumbers)

(fn (value)
  2.5)

(fn (fraction n)
  (/ (as n Float) 2.0))

(fn (relay n)
  (fraction n))

(fn (makeAdder n)
  (lambda (x) (+ n x)))

(:: makeFloatAdder (-> Int Float Float))
(fn (makeFloatAdder n)
  (lambda (x)
    (+ (as n Float) x)
  ))

(type Real Float)

(:: scale (-> Real Real))
(fn (scale x)
  (* x 4.0))

(:: main Int)
(fn (main)
  (if (&& (== (as (+ value value) Int) 5)
        (&& (== (as (+ (fraction 5) (fraction 5)) Int) 5)
          (&& (== (as (+ (relay 5) value) Int) 5)
            (&& (== (as (+ CheckedNumbers::value CheckedNumbers::value) Int) 2)
              (&& (== (as (+ (CheckedNumbers::fraction 5) CheckedNumbers::value) Int) 2)
                (&& (== (as (scale 2.5) Int) 10)
                  (&& (== (makeAdder 1 41) 42) (== (as (makeFloatAdder 1 2.5) Int) 3))))))))
    42
    1))
