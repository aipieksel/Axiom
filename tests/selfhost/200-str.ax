; expect 42
; The compatibility path, kept deliberately un-migrated: `__addr`
; resolves to a literal's raw bytes, and `strFromLit` scans them into a
; header. `310-strlit.ax` covers the direct form.
;
; Both lowerings have to stay covered because they differ - a literal
; in value position is the header, `(__addr lit)` is the bytes - and
; confusing them is silent rather than loud: `strFromLit` over a header
; would take the first eight bytes of the length word as text.
(import Str)

(:: main Int)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let s (strFromLit (__addr "hello")))
    (+ (strLen s) 37)
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memAllocMapped (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (memAllocMapped bytes map)
  {
    (let h (__alloc bytes))
    (if (== bytes 0)
      h
      {
        (let sw (__load64 (- h 8) 0))
        {
          (let encoded (& (>> sw 1) 16383))
          (let cnt
            (if (== encoded 1)
              (>> (__load64 (- h 32) 0) 3)
              encoded))
          {
            (let lim
              (if (> cnt 47)
                47
                cnt))
            {
              (__store64 (- h 8) 0 (| sw (<< (& map (- (<< 1 lim) 1)) 16)))
              h
            }
          }
        }
      })
  })

(:: memSetWord (-> Int Int a Int))
;@axiom:effect(unsafe)
(fn (memSetWord addr index value)
  {
    (__retainref value)
    (__store64 addr index (as value Int))
    addr
  })

(:: strWrap (-> Int Int String))
(fn (strWrap bytes len)
  (strWrapOwned bytes len 0))

(:: strWrapOwned (-> Int Int Int String))
;@axiom:effect(unsafe)
(fn (strWrapOwned bytes len owner)
  {
    (let s (memAllocMapped 24 4))
    {
      (memSetWord s 0 len)
      (memSetWord s 1 bytes)
      (memSetWord s 2 owner)
      (as s String)
    }
  })

(:: strFromLit (-> Int String))
(fn (strFromLit cstr)
  (strWrap cstr (cstrLen cstr 0)))

(:: cstrLen (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (cstrLen addr i)
  (if (== (__load8 addr i) 0)
    i
    (cstrLen addr (+ i 1))))
