; expect 42
(import core)
(import diag)
(import expand)
(import Str)
(import Vec)
(import Mem)
(import IO)
(import lexer)
(import parser)
(import typecheck)
(import codegen)
(import checked)
(import raw)

; Emission consumes the resolved, expanded and checked tree.
(:: checkedEmission (-> Nodes String String))
;@axiom:effect(io)
(fn (checkedEmission decls src)
  {
    (let bares vecNew)
    (let fulls vecNew)
    (let mods vecNew)
    (let units
      {
        (let v vecNew)
        {
          (vecPush v (CUnit2 :file "in.ax" :src src :name (Some "") :imports vecNew :library false))
          v
        }
      })
    (let eds vecNew)
    (let frames vecNew)
    (let tcode (checkedTargetCode "darwin-aarch64"))
    {
      (let allDecls (resolveImports decls bares fulls mods tcode "" units))
      {
        (expandProgram decls allDecls eds frames units bares fulls mods)
        (if (> (countErrorDiags eds) 0)
          ""
          ; the final check's sealed value is the emitter's one way in
          {
            (let checked (checkExpandedProgram decls allDecls units))
            (if (> (countErrorDiags checked.diagnostics) 0)
              ""
              (match checked.program
                ((Some program) (emitCheckedProgram program bares fulls tcode false))
                ((None) "")))
          })
      }
    }
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let src (unwrapOr (readFile "in.ax") ""))
    (if (== (strLen src) 0)
      7
      {
        (let pr (parseModuleWith (lex src) (scanAxtags src)))
        (if (== (memGetWord pr 0) 0)
          8
          {
            (let out (checkedEmission (readAstNodes pr 1) src))
            (if (> (strLen out) 10)
              42
              9)
          })
      })
  })
