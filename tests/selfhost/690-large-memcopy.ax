; expect 42
; A copy whose size exceeds the stack.
;
; `memCopy` walks one byte per step. Written as a self tail call that
; costs nothing where the compiler turns it into a jump - and stage1
; emits no tail-call optimisation at all, so it was a real call chain
; one frame deep per byte. Under a megabyte that is a hundred thousand
; frames and a SIGSEGV, reported from inside `memCopyFrom` in a
; program that did nothing wrong.
;
; It stayed hidden while the compiler's own output was small enough to
; fit, and surfaced the moment `typecheck.ax` grew - which is the worst
; way to meet a scalability limit: as an unrelated change appearing to
; break an unrelated test. `Mem`'s byte loops are `while` loops now,
; which need no optimisation to be flat.
;
; A megabyte is comfortably past where the recursive form died and
; comfortably inside the arena.
(import Mem)
(import Str)

(:: main Int)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let n 1048576)
    {
      (let src (memAlloc n))
      (let dst (memAlloc n))
      {
        (memSet src 65 n)
        (__store8 src (- n 1) 90)
        (memCopy dst src n)
        ; first byte, last byte, and a full compare
        (if (&& (== (__load8 dst 0) 65)
              (&& (== (__load8 dst (- n 1)) 90) (== (memCmp dst src n) 0)))
          42
          7)
      }
    }
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memAlloc (-> Int Int))
;@axiom:effect(unsafe)
(fn (memAlloc bytes)
  (__alloc bytes))

(:: memCopy (-> Int Int Int Int))
(fn (memCopy dst src count)
  (memCopyFrom dst src count 0))

(:: memSet (-> Int Int Int Int))
(fn (memSet addr value count)
  (memSetFrom addr value count 0))

(:: memCmp (-> Int Int Int Int))
(fn (memCmp a b count)
  (memCmpFrom a b count 0))

(:: memCopyFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memCopyFrom dst src count start)
  {
    (for i in start..count
      (__store8 dst i (__load8 src i)))
    dst
  })

(:: memSetFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memSetFrom addr value count start)
  {
    (for i in start..count
      (__store8 addr i value))
    addr
  })

(:: memCmpFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memCmpFrom a b count start)
  {
    (let mut i start)
    (let mut diff 0)
    {
      (while (&& (< i count) (== diff 0))
        {
          (set diff (- (__load8 a i) (__load8 b i)))
          (set i (+ i 1))
        })
      diff
    }
  })
