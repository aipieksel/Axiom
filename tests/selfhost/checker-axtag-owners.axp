(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: entry (-> String AxtagEnt))
(fn (entry text)
  (AxtagEnt :off 0 :content text))

(:: one (-> String Axtags))
(fn (one text)
  (vecPush vecNew (entry text)))

(:: stringIs (-> (Option String) String Bool))
(fn (stringIs found expected)
  (match found
    ((None) false)
    ((Some text) (strEq text expected))))

(:: tagCountIs (-> (Option Axtags) Int Bool))
(fn (tagCountIs found expected)
  (match found
    ((None) false)
    ((Some tags) (== (vecLen tags) expected))))

(:: namesAre (-> Names Names Bool))
(fn (namesAre actual expected)
  {
    (let mut good (== (vecLen actual) (vecLen expected)))
    (for i in 0..(vecLen actual)
      (if good
        (set good (strEq (vecGet actual i) (vecGet expected i)))))
    good
  })

(:: emptySignature (-> String ASTNode))
(fn (emptySignature name)
  {
    (let node (nodeBuildDSig name vecNew 0 0))
    (writeNodeAxtags node vecNew)
    node
  })

(:: context (-> String TC))
(fn (context source)
  (match (parseModuleWith (lex source) (scanAxtags source))
    ((ParseFailed error) __indexTrap)
    ((ParseSuccess declarations after)
      (tcNew declarations declarations
        (vecPush vecNew
          (CUnit2 :file "checker-tags.ax" :src source :name None :imports vecNew :library false)))
    )))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireEntries (-> String ()))
(fn (retireEntries text)
  {
    (let entries (vecPush vecNew (entry text)))
    (vecLen entries)
    ()
  })

(:: malformed (-> String Bool))
(fn (malformed text)
  {
    (let tc (context "(pub fn (test) 1)"))
    (checkOneContract tc (vecGet tc.allDecls 0) (entry text) (Some mkIntTy))
    (&& (== (vecLen tc.out) 1) (strEq (diagCode (vecGet tc.out 0)) "AX3050"))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (strEq (axtagKeyOf (entry "effect(pure)")) "effect"))
    (say 2 (strEq (axtagKeyOf (entry "pure")) "pure"))
    (say 3 (strEq (axtagKeyOf (entry "")) ""))
    (say 4 (strEq (axtagTextValue (entry "pre((> x 0))")) "(> x 0)"))
    (say 5 (strEq (axtagTextValue (entry "pre(open")) ""))
    (say 6 (isNone (axtagValueFrom vecNew "missing" 0)))
    (say 7
      (stringIs
        (axtagValueFrom (vecPush (one "deprecated(first)") (entry "deprecated(second)"))
          "deprecated" 0)
        "first"))
    (say 8 (== (declHasAxtagFrom (one "effect(pure)") "effect" 0) 0))
    (say 9 (== (vecLen (nodeAxtagsOf (nodeBuildDSig "absent" vecNew 0 0))) 0))
    (let empty (emptySignature "same"))
    (let absent (nodeBuildDSig "same" vecNew 0 0))
    (let tagged (nodeBuildDSig "same" vecNew 0 0))
    (writeNodeAxtags tagged (one "effect(pure)"))
    (say 10 (tagCountIs (nodeAxtagsOpt empty) 0))
    (say 11 (isNone (nodeAxtagsOpt absent)))
    (say 12 (isNone (sigAxtagsFrom vecNew "missing" 0)))
    (say 13 (tagCountIs (sigAxtagsFrom (vecPush vecNew empty) "same" 0) 0))
    (say 14 (tagCountIs (sigAxtagsFrom (vecPush (vecPush vecNew empty) tagged) "same" 0) 0))
    (say 15 (isNone (sigAxtagsFrom (vecPush (vecPush vecNew absent) tagged) "same" 0)))
    (say 16 (tagCountIs (sigAxtagsFrom (vecPush vecNew tagged) "Team$same" 0) 1))
    (let tc (context ";@axiom:effect(pure)\n(:: identity (-> Int Int))\n(pub fn (identity x) x)"))
    (say 17 (tagCountIs (sigAxtagsFor tc "identity") 1))
    (say 18 (== (declHasAxtagFrom (one "effect(pure)") "effect(pure)" 0) 1))
    (let restrictions vecNew)
    (restrictCollect (vecPush (one "restrict(no-io,no-alloc)") (entry "restrict(no-io,strict)"))
      restrictions 0)
    (say 19
      (namesAre restrictions (vecPush (vecPush (vecPush vecNew "no-io") "no-alloc") "strict")))
    (let ct vecNew)
    (ctCollect (one "ct()") ct 0)
    (say 20 (namesAre ct (vecPush vecNew "")))
    (say 21 (stringIs (isrVectorIn (one "isr()") 0) ""))
    (say 22 (isNone (isrVectorIn (one "isr") 0)))
    (say 23 (stringIs (isrVectorOf (one "isr(irq)") (one "isr(fault)")) "irq"))
    (say 24 (stringIs (isrVectorOf (one "isr()") (one "isr(fault)")) "fault"))
    (say 25 (== (tagsHaveIsr (one "isr(open") vecNew) 1))
    (say 26 (== (tagsClaimPure (one "effect(pure)") vecNew) 1))
    (say 27 (== (tagsClaimUnsafe tc vecNew (one "effect(unsafe)")) 1))
    (let syscalls vecNew)
    (syscallTagsInto syscalls (one "syscall(entropy,spawn,entropy)") 0)
    (say 28
      (namesAre syscalls (vecPush (vecPush vecNew (builtinEff "Entropy")) (builtinEff "Spawn"))))
    (say 29 (== (axtagContentSeen (one "effect(pure)") "effect(pure)" 0) 1))
    (say 30 (== (axtagContentSeen (one "effect(pure)") "effect(io)" 0) 0))
    (let emptySpan (contractSpanOf (entry "pre()")))
    (say 31 (&& (== (spanStart emptySpan) 0) (== (spanEnd emptySpan) 13)))
    (let span (contractSpanOf (entry "pre(true)")))
    (say 32 (&& (== (spanStart span) 12) (== (spanEnd span) 16)))
    (say 33 (strEq (contractLead (entry "pre(true)")) "true"))
    (say 34 (strEq (contractLead (entry "pre()")) ";@axiom:pre()"))
    (let atZero (entry ""))
    (say 35 (== atZero.off 0))
    (say 36 (malformed "pre(1)"))
    (say 37 (malformed "pre()"))
    (say 38 (malformed "pre(true false)"))
    (let good (context "(pub fn (test) 1)"))
    (checkOneContract good (vecGet good.allDecls 0) (entry "pre(true)") (Some mkIntTy))
    (say 39 (== (vecLen good.out) 0))
    (let text (strDup "owned"))
    (let before (count text))
    (retireEntries text)
    (say 40 (== (count text) before))
    (let owned (one text))
    (say 41 (== (count text) (+ before 1)))
    (say 42 (strEq (axtagKeyOf (vecGet owned 0)) "owned"))
    0
  })
