; The real validator and formatter, driven by the original argv.
(import driver)
(import fmtcli)
(import IO)
(import Sys)
(import Str)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let command subcommandName)
    (checkArgs command)
    (if (hasFlagAnywhere command "--help")
      {
        (writeStr stdout (helpForCommand command))
        0
      }
      (if (strEq command "fmt")
        runFormatter
        {
          (let operand (positionalFrom operandStart))
          (println "command={command}")
          (println "operand={operand}")
          0
        }))
  })
