; The real validator and formatter, driven by the original argv.
(import driver)
(import fmtcli)
(import IO)
(import Sys)
(import Str)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let command subcommandName)
    (checkArgs command)
    (if (hasFlagAnywhere command "--help")
      {
        (writeStr stdout
          (match command ((None) usageText) ((Some name) (helpForCommand name))))
        0
      }
      (if (match command ((None) false) ((Some name) (strEq name "fmt")))
        runFormatter
        {
          ; Empty text here is the harness's display of missing query results.
          (let operand (match (positionalFrom operandStart) ((None) "") ((Some text) text)))
          (let shownCommand (match command ((None) "") ((Some text) text)))
          (println "command={shownCommand}")
          (println "operand={operand}")
          0
        }))
  })
