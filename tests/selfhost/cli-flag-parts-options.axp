; Recognised zero arity and an empty inline value are present facts.
(import core)
(import driver)
(import IO)
(import Str)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: arityIs (-> String Int Bool))
(fn (arityIs name expected)
  (match (flagArity name)
    ((None) false)
    ((Some arity) (== arity expected))))

(:: valueIs (-> (Option String) String Bool))
(fn (valueIs value expected)
  (match value
    ((None) false)
    ((Some text) (strEq text expected))))

(:: temporaryValue (Option String))
(fn (temporaryValue)
  (flagValuePart (strDup "--input=alive")))

(:: discardPart (-> String Int))
(fn (discardPart text)
  (match (flagValuePart text)
    ((None) -1)
    ((Some value) (strLen value))))

(:: count (-> String Int))
;@axiom:effect(unsafe)
(fn (count text)
  (__load64 (as text Int) -2))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (arityIs "--check" 0))
    (say 2 (arityIs "--input" 1))
    (say 3 (isNone (flagArity "--unknown")))
    (say 4 (isNone (flagArity "")))
    (say 5 (isNone (flagArity "--input=x")))
    (say 6 (arityIs "-h" 0))
    (say 7 (arityIs "-o" 1))
    (say 8 (isNone (flagValuePart "--input")))
    (say 9 (valueIs (flagValuePart "--input=") ""))
    (say 10 (valueIs (flagValuePart "--opt=0") "0"))
    (say 11 (valueIs (flagValuePart "--input=a=b") "a=b"))
    (say 12 (valueIs (flagValuePart "=x") "x"))
    (say 13 (valueIs (flagValuePart "=") ""))
    (say 14 (strEq (flagNamePart "=x") ""))
    (say 15 (flagHasValuePart "--input="))
    (say 16 (! (flagHasValuePart "--input")))
    (say 17 (valueIs temporaryValue "alive"))
    (let text (strDup "--input=payload"))
    (let refs (count text))
    (discardPart text)
    (let before live)
    (for i in 0..20
      (discardPart text))
    (let after live)
    (say 18 (== refs (count text)))
    (say 19 (== before after))
    (let mut calls 0)
    (if (let (Some value) (flagValuePart "--input"))
      (set calls (+ calls 1)))
    (say 20 (== calls 0))
  })
