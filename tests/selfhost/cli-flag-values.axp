(import driver)
(import IO)
(import Sys)
(import Str)

(:: show (-> (Option String) ()))
;@axiom:effect(io)
(fn (show value)
  (match value
    ((None) (println "None"))
    ((Some text) { (let n (strLen text)) (println "Some {n}:{text}") })))

(:: discard (-> (Option String) Int))
(fn (discard value) (match value ((None) 0) ((Some text) (strLen text))))

(:: live Int)
(fn (live) (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let saved (flagValue "--input" 1))
    (discard (flagValue "--input" 1))
    (let before live)
    (for i in 0..20 (discard (flagValue "--input" 1)))
    (let after live)
    (show saved)
    (show (flagValueAt "--input" 1 1))
    (show (flagValueAt "--input" sysArgc sysArgc))
    (show (flagValue "--not-present" 1))
    (show (flagValue "--input" 3))
    (let balanced (== before after))
    (println "balanced={balanced}")
  })
