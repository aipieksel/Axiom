(import driver)
(import IO)
(import Sys)
(import Str)

(:: showIndex (-> (Option Int) ()))
;@axiom:effect(io)
(fn (showIndex value)
  (match value ((None) (println "None")) ((Some n) (println "Some {n}"))))

(:: showText (-> (Option String) ()))
;@axiom:effect(io)
(fn (showText value)
  (match value
    ((None) (println "None"))
    ((Some text) { (let n (strLen text)) (println "Some {n}:{text}") })))

(:: discard (-> (Option String) Int))
(fn (discard value) (match value ((None) 0) ((Some text) (strLen text))))

(:: live Int)
(fn (live) (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let saved (positionalFrom 1))
    (discard (positionalFrom 1))
    (let before live)
    (for i in 0..20 (discard (positionalFrom 1)))
    (let after live)
    (showIndex (positionalIndex 1))
    (showText saved)
    (showIndex subcommandIndex)
    (showText subcommandName)
    (showIndex (dashDashIndex 1))
    (let start operandStart)
    (println "start={start}")
    (showIndex (positionalIndex 0))
    (showIndex (positionalIndex sysArgc))
    (showIndex (positionalIndex (- 0 1)))
    (showIndex (dashDashIndex sysArgc))
    (showIndex (dashDashIndex (- 0 1)))
    (let balanced (== before after))
    (println "balanced={balanced}")
  })
