(import core)
(import lexer)
(import parser)
(import repl)
(import diag)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireSuccess (-> String ()))
(fn (retireSuccess name)
  {
    (let result (pOk name 3))
    (pResPos result)
    ()
  })

(:: retireFailure (-> String ()))
(fn (retireFailure name)
  {
    (let result (:: (pErrExp 4 name) (PResult String)))
    (pResPos result)
    ()
  })

(:: escapeValue (-> String (Option String)))
(fn (escapeValue name)
  (pResValue (pOk name 5)))

(:: escapeError (-> String String))
(fn (escapeError name)
  (pResExp (:: (pErrExp 4 name) (PResult Nodes))))

(:: translate (-> (PResult String) (PResult Nodes)))
(fn (translate result)
  (match result
    ((ParseSuccess value pos) (pOk vecNew pos))
    ((ParseFailed error) (ParseFailed error))))

(:: textIs (-> (Option String) String Bool))
(fn (textIs found expected)
  (match found
    ((None) false)
    ((Some value) (strEq value expected))))

(:: unitAt (-> (PResult ()) Int Bool))
(fn (unitAt result expected)
  (match result
    ((ParseSuccess value pos) (== pos expected))
    ((ParseFailed error) false)))

(:: declAt (-> String Bool Int Bool))
(fn (declAt source present expected)
  (match (parseDecl (lex source) 0)
    ((ParseFailed error) false)
    ((ParseSuccess found pos)
      (&& (== pos expected)
        (if present
          (isSome found)
          (isNone found)))
    )))

(:: templateIs (-> String Int Bool Bool))
(fn (templateIs source declCount exprPresent)
  (match (parseRuleTemplates (lex source) 0)
    ((ParseFailed error) false)
    ((ParseSuccess templates after)
      (&& (== (vecLen templates.declarations) declCount)
        (if exprPresent
          (isSome templates.expression)
          (isNone templates.expression)))
    )))

(:: compiled (-> ReplCompileResult Bool))
(fn (compiled result)
  (match result
    ((ReplCompileFailed diagnostics) false)
    ((ReplCompiled ir) (> (strLen ir) 0))))

(:: emptyFailure (-> ReplCompileResult Bool))
(fn (emptyFailure result)
  (match result
    ((ReplCompiled ir) false)
    ((ReplCompileFailed diagnostics) (== (vecLen diagnostics) 0))))

(:: retryFailure (-> ReplCompileResult Bool))
(fn (retryFailure result)
  (match result
    ((ReplCompiled ir) false)
    ((ReplCompileFailed diagnostics) (replIoRetryNeeded diagnostics))))

(:: hasText (-> (Option String) Bool))
(fn (hasText found)
  (match found
    ((None) false)
    ((Some text) (> (strLen text) 0))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (textIs (pResValue (pOk "" 0)) ""))
    (say 2 (== (pResPos (pOk "value" 7)) 7))
    (say 3 (isNone (pResValue (:: (pErr 0) (PResult String)))))
    (say 4 (pResFailed (:: (pErr 0) (PResult Nodes))))
    (say 5 (! (pResOk (:: (pErr 0) (PResult String)))))
    (say 6 (== (pResPos (:: (pErr 0) (PResult ASTNode))) 0))
    (say 7 (strEq (pResExp (:: (pErrExp 4 "expression") (PResult ASTNode))) "expression"))
    (say 8 (strEq (pResCode (:: (pErrCode 5 "AX2005") (PResult ASTNode))) "AX2005"))
    (say 9 (strEq (pResCode (:: (pErrQuote 2) (PResult ASTNode))) "quote"))
    (say 10 (== (pResPos (translate (pErrExp 8 "name"))) 8))
    (say 11 (strEq (pResExp (translate (pErrExp 8 "name"))) "name"))
    (say 12 (isSome (pResNode (pOk (mkTErr) 0))))
    (say 13 (isNone (pResNode (pErrExp 0 "expression"))))
    (say 14 (unitAt (skipParens (lex "(x)") 1 1) 3))
    (say 15 (declAt "" false 0))
    (say 16 (declAt "(fn (f) 1)" true 7))
    (say 17 (pResFailed (parseExpr (lex "(") 0)))
    (say 18 (pResFailed (parseModule (lex ")"))))
    (say 19 (templateIs "(+ x 1))" 0 true))
    (say 20 (templateIs "(fn (f) 1))" 1 false))
    (say 21 (templateIs "(helper x))" 1 true))
    (say 22 (pResFailed (parseRuleTemplates (lex "(") 0)))
    (let name (strDup "owned"))
    (let before (count name))
    (retireSuccess name)
    (say 23 (== (count name) before))
    (retireFailure name)
    (say 24 (== (count name) before))
    (let value (escapeValue name))
    (say 25 (textIs value "owned"))
    (say 26 (== (count name) (+ before 1)))
    (let context (escapeError name))
    (say 27 (strEq context "owned"))
    (say 28 (== (count name) (+ before 2)))
    (say 29 (emptyFailure (replTryCompile "(")))
    (say 30 (compiled (replTryCompile (replWrapper "" "1" "Int" 0))))
    (say 31 (retryFailure (replTryCompile (replWrapper "" "(println \"hello\")" "()" 0))))
    (say 32 (compiled (replTryCompile (replWrapper "" "(println \"hello\")" "()" 1))))
    (say 33 (textIs (typeExprAgainst "" "1") "Int"))
    (say 34 (hasText (replCompileExpr "" "(println \"hello\")" "()")))
    (say 35 (hasText (replCompileExpr "" "1" "Int")))
    0
  })
