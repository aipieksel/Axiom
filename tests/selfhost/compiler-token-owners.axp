(import core)
(import lexer)
(import parser)
(import lsp)
(import replhl)
(import diag)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: kindIs (-> Token TokenKind Bool))
(fn (kindIs token kind)
  (== (kindInt (tokenKind token)) (kindInt kind)))

(:: optLexeme (-> (Option Token) String Bool))
(fn (optLexeme found expected)
  (match found
    ((None) false)
    ((Some token) (strEq (tokenLexeme token) expected))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireToken (-> String ()))
(fn (retireToken name)
  {
    (let token (mkToken TK_IDENT name 0))
    (strLen (tokenLexeme token))
    ()
  })

(:: retireStream (-> String ()))
(fn (retireStream name)
  {
    (let rows (vecPush vecNew (mkToken TK_IDENT name 0)))
    (strLen (tokenLexeme (vecGet rows 0)))
    ()
  })

(:: escapeLexeme (-> String String))
(fn (escapeLexeme name)
  (tokenLexeme (vecGet (vecPush vecNew (mkToken TK_IDENT name 0)) 0)))

(:: escapePeek (-> String (Option Token)))
(fn (escapePeek name)
  (peekToken (vecPush vecNew (mkToken TK_IDENT name 0)) 0))

(:: poppedLexeme (-> String String))
(fn (poppedLexeme name)
  (tokenLexeme (vecPop (vecPush vecNew (mkToken TK_IDENT name 0)))))

(:: hasCode (-> String String Int Bool))
(fn (hasCode source expected start)
  (match (lexErrDiag (lex source) source)
    ((None) false)
    ((Some diagnostic)
      (&& (strEq (diagCode diagnostic) expected) (== (spanStart (diagSpan diagnostic)) start))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let token (mkToken TK_IDENT "name" (mkSpan 0 4)))
    (say 1 (kindIs token TK_IDENT))
    (say 2 (strEq (tokenLexeme token) "name"))
    (say 3 (&& (== (spanStart (tokenSpan token)) 0) (== (spanEnd (tokenSpan token)) 4)))
    (say 4 (strEq (tokenLexeme (mkToken TK_EOF "" 0)) ""))
    (say 5 (isNone (peekToken vecNew 0)))
    (say 6 (isNone (peekToken vecNew 9)))
    (let rows (vecPush vecNew token))
    (say 7 (optLexeme (peekToken rows 0) "name"))
    (say 8 (isNone (peekToken rows 1)))
    (say 9 (peekIs vecNew 0 TK_EOF))
    (say 10 (! (peekIs vecNew 0 TK_IDENT)))
    (let empty (lex ""))
    (say 11 (== (vecLen empty) 1))
    (say 12 (isSome (peekToken empty 0)))
    (say 13 (kindIs (vecGet empty 0) TK_EOF))
    (say 14 (peekIs empty 1 TK_EOF))
    (say 15 (isNone (lexErrDiag empty "")))
    (let forms (lex "(fn (f) -5)"))
    (say 16 (== (vecLen forms) 8))
    (say 17 (kindIs (vecGet forms 5) TK_INT))
    (say 18 (strEq (tokenLexeme (vecGet forms 5)) "-5"))
    (say 19 (pResOk (parseModule forms)))
    (say 20 (hasCode "@" "AX1001" 0))
    (say 21 (hasCode "\"open" "AX1002" 0))
    (say 22 (hasCode "'a" "AX1003" 0))
    (say 23 (hasCode "12bad" "AX1004" 0))
    (say 24 (hasCode "\"\\q\"" "AX1005" 1))
    (say 25 (hasCode "@ \"\\q\"" "AX1001" 0))
    (say 26 (hasCode "\"\\q\" @" "AX1005" 1))
    (let name (strDup "owned"))
    (let before (count name))
    (retireToken name)
    (say 27 (== (count name) before))
    (retireStream name)
    (say 28 (== (count name) before))
    (let child (escapeLexeme name))
    (say 29 (strEq child "owned"))
    (say 30 (== (count name) (+ before 1)))
    (let kept (escapePeek name))
    (say 31 (optLexeme kept "owned"))
    (let popped (poppedLexeme name))
    (say 32 (strEq popped "owned"))
    (say 33 (== (count name) (+ before 3)))
    (let flat (:: vecNew Tokens))
    (let bounds (:: vecNew Ints))
    (say 34 (== (lspRecoverBalance "(fn (a) 1" (lex "(fn (a) 1") flat bounds) 0))
    (say 35 (== (vecLen bounds) 2))
    (let slice (lspRecSlice flat 0 (vecLen flat)))
    (say 36 (pResOk (parseModule slice)))
    (say 37 (kindIs (vecLast slice) TK_EOF))
    (say 38 (kindIs (lspRecClose 2 0) TK_RBRACE))
    (say 39 (pResOk (lspParse "(fn (first) 1)\n(fn (broken)\n(fn (last) 3)")))
    (let highlighted (hlScan "(let mut x 1)"))
    (say 40 (> (vecLen (hlScanSpans highlighted)) 3))
    (let first (vecGet (hlScanSpans (hlScan "alpha")) 0))
    (say 41 (&& (== (hlSpanStart first) 0) (== (hlSpanEnd first) 5)))
    (let unicode (lex "'é' 1.5 x.y?"))
    (say 42 (&& (kindIs (vecGet unicode 0) TK_CHARLIT) (kindIs (vecGet unicode 1) TK_FLOAT)))
    (say 43 (kindIs (vecGet unicode (- (vecLen unicode) 2)) TK_QUESTION))
    (say 44 (isNone (lexErrDiag unicode "'é' 1.5 x.y?")))
    0
  })
