(import core)
(import diag)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n result)
  (println "{n} {result}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireInputs (-> String String String String Int))
(fn (retireInputs related help replacement note)
  {
    (let first
      (mkDiag 0 "AX3001" "probe" 0 "message" (diagRelated (mkSpan 0 1) related) (Some help)))
    (let second
      (mkDiagNote 0 "AX3001" "probe" 0 "message" (diagRelated (mkSpan 0 1) related) (Some help)
        note))
    (let third
      (mkDiagFix 0 "AX3001" "probe" 0 "message" None help (diagFix (mkSpan 0 1) replacement)))
    (let fourth
      (mkDiagFix2 0 "AX3001" "probe" 0 "message" None help (diagFix (mkSpan 0 1) replacement)
        (Some note)))
    17
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let missing (mkDiag 0 "AX3001" "probe" 0 "message" None None))
    (say 1 (== (diagSecCount missing) 0))
    (say 2 (== (diagHelpCount missing) 0))
    (say 3 (== (diagNoteCount missing) 0))
    (say 4 (isNone (diagLabel missing)))
    (let empty (mkDiag 0 "AX3001" "probe" 0 "message" None (Some "")))
    (say 5 (== (diagHelpCount empty) 1))
    (say 6 (&& (== (diagHelpCount empty) 1) (strEq (diagHelpMsg empty 0) "")))
    (say 7 (isNone (diagRelated 0 "absent")))
    (let related (mkDiag 0 "AX3001" "probe" 0 "message" (diagRelated (mkSpan 0 1) "") None))
    (say 8 (== (diagSecCount related) 1))
    (say 9
      (&& (== (diagSecCount related) 1)
        (&& (== (spanStart (diagSecSpan related 0)) 0) (== (spanEnd (diagSecSpan related 0)) 1))))
    (say 10 (&& (== (diagSecCount related) 1) (strEq (diagSecMsg related 0) "")))
    (say 11 (&& (== (diagSecCount related) 1) (== (diagSecUnit related 0) -1)))
    (say 12 (isNone (diagFix 0 "unused")))
    (let deletion
      (mkDiagFix 0 "AX3001" "probe" 0 "message" None "delete" (diagFix (mkSpan 0 1) "")))
    (say 13 (== (diagHelpCount deletion) 1))
    (say 14
      (if (let (Some edit) (diagHelpFix deletion 0))
        (&& (&& (== (spanStart edit.span) 0) (== (spanEnd edit.span) 1)) (strEq edit.text ""))
        false))
    (let plain (mkDiagFix 0 "AX3001" "probe" 0 "message" None "plain" (diagFix 0 "unused")))
    (say 15 (== (diagHelpCount plain) 1))
    (say 16 (isNone (diagHelpFix plain 0)))
    (let note (mkDiagNote 0 "AX3001" "probe" 0 "message" None None ""))
    (say 17 (== (diagNoteCount note) 1))
    (say 18 (strEq (diagNote note 0) ""))
    (let twice
      (mkDiagFix2 0 "AX3001" "probe" 0 "message" None "first" (diagFix (mkSpan 0 1) "replacement")
        (Some "")))
    (say 19 (== (diagHelpCount twice) 2))
    (say 20 (strEq (diagHelpMsg twice 1) ""))
    (say 21 (isNone (diagHelpFix twice 1)))
    (let once (mkDiagFix2 0 "AX3001" "probe" 0 "message" None "first" None None))
    (say 22 (== (diagHelpCount once) 1))
    (let cross
      (mkDiag 0 "AX3001" "probe" 0 "message"
        (Some (DLabel :span (mkSpan 0 1) :msg "cross" :unit 0)) None))
    (say 23 (&& (== (diagSecCount cross) 1) (== (diagSecUnit cross 0) 0)))
    (say 24 (&& (== (diagSecCount cross) 1) (strEq (diagSecMsg cross 0) "cross")))
    (let ownedRelated (strDup "related"))
    (let ownedHelp (strDup "help"))
    (let ownedReplacement (strDup "replacement"))
    (let ownedNote (strDup "note"))
    (let cr (count ownedRelated))
    (let ch (count ownedHelp))
    (let cf (count ownedReplacement))
    (let cn (count ownedNote))
    (say 25 (== (retireInputs ownedRelated ownedHelp ownedReplacement ownedNote) 17))
    (say 26 (== (count ownedRelated) cr))
    (say 27 (== (count ownedHelp) ch))
    (say 28 (== (count ownedReplacement) cf))
    (say 29 (== (count ownedNote) cn))
    (diagDisarmFixes twice)
    (say 30 (isNone (diagHelpFix twice 0)))
    (say 31 (== (diagHelpCount twice) 2))
  })
