(import core)
(import diag)
(import render)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: savedStarts (-> String Ints))
(fn (savedStarts text)
  (srcIxStartsVec (srcLineIndex text)))

(:: retireTable (-> SrcIx Int))
(fn (retireTable index)
  {
    (let indexes (:: vecNew SourceIndexes))
    (vecPush indexes index)
    (lineOfIx (indexForUnit indexes 0) 3)
  })

(:: retireInputVectors (-> Ints Ints Int))
(fn (retireInputVectors starts chars)
  {
    (let index (SrcIx :starts starts :chars chars))
    (let indexes (:: vecNew SourceIndexes))
    (vecPush indexes index)
    (vecLen (srcIxStarts (indexForUnit indexes 0)))
  })

(:: retireBuiltIndexes (-> Units Int))
(fn (retireBuiltIndexes units)
  {
    (let indexes (unitIndexes units))
    (vecLen indexes)
  })

(:: makeUnit (-> String String CUnit2))
(fn (makeUnit file text)
  (CUnit2 :file file :src text :name None :imports vecNew :library false))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let text "α\nz\n")
    (let index (srcLineIndex text))
    (say 1 (== (vecLen (srcIxStarts index)) 3))
    (say 2 (== (vecGet (srcIxStartsVec index) 1) 3))
    (say 3 (== (vecGet (srcIxChars index) 1) 2))
    (say 4 (== (vecGet (srcIxCharsVec index) 2) 4))
    (say 5 (== (lineOfIx index 3) 2))
    (say 6 (== (colOfIx text index 3) 1))
    (say 7 (== (charsToIx text index 3) 2))
    (let starts (savedStarts text))
    (say 8 (== (vecGet starts 2) 5))
    (let before (count index))
    (say 9 (== (retireTable index) 2))
    (say 10 (== (count index) before))
    (let ownStarts (:: (vecPush vecNew 0) Ints))
    (let ownChars (:: (vecPush vecNew 0) Ints))
    (let startCount (count ownStarts))
    (let charCount (count ownChars))
    (say 11 (== (retireInputVectors ownStarts ownChars) 1))
    (say 12 (== (count ownStarts) startCount))
    (say 13 (== (count ownChars) charCount))
    (let emptyTable (:: vecNew SourceIndexes))
    (say 14 (isNone (sourceIndexAt emptyTable 0)))
    (let emptyIndex (srcLineIndex ""))
    (let indexes (:: vecNew SourceIndexes))
    (vecPush indexes emptyIndex)
    (say 15
      (if (let (Some present) (sourceIndexAt indexes 0))
        (&& (== (vecLen present.starts) 1) (== (vecGet present.starts 0) 0))
        false))
    (say 16 (isNone (sourceIndexAt indexes -1)))
    (say 17 (isNone (sourceIndexAt indexes 1)))
    (say 18 (== (lineOfIx (indexForUnit indexes -1) 0) 1))
    (say 19 (== (lineOfIx (indexForUnit indexes 99) 0) 1))
    (let units (:: vecNew Units))
    (vecPush units (makeUnit "entry.ax" "abc"))
    (vecPush units (makeUnit "other.ax" "α\nz\n"))
    (let all (unitIndexes units))
    (say 20 (== (vecLen all) 2))
    (say 21
      (if (let (Some other) (sourceIndexAt all 1))
        (== (lineOfIx other 3) 2)
        false))
    (let short (:: vecNew SourceIndexes))
    (vecPush short (srcLineIndex "abc"))
    (let d (mkDiagBase 0 "AX3001" "probe" 0 "message" None))
    (diagAddSecondaryIn d (mkSpan 0 1) "related" 1)
    (say 22 (== (diagSecCross d 0 units short) 0))
    (say 23 (== (diagSecCross d 0 units all) 1))
    (say 24 (strEq (secNoteText d 0 units short) "related"))
    (say 25
      (strEq (jsonRelatedArray d "abc" (srcLineIndex "abc") units short)
        "[{\"label\":\"related\"}]"))
    (diagAddTrace d "expand" (mkSpan 0 1) 1)
    (say 26 (== (traceResolvable d 0 units short) 0))
    (say 27 (== (traceResolvable d 0 units all) 1))
    (say 28 (strEq (traceNoteText d 0 units short) "in this expansion of `expand`"))
    (say 29 (strEq (jsonTraceArray d units short) "[{\"macro\":\"expand\"}]"))
    (let negative (mkDiagBase 0 "AX3001" "probe" 0 "message" None))
    (diagAddTrace negative "negative" (mkSpan 0 1) -1)
    (say 30 (== (traceResolvable negative 0 units all) 0))
    (say 31 (strEq (jsonTraceArray negative units all) "[{\"macro\":\"negative\"}]"))
    (say 32 (strEq (traceNoteText negative 0 units all) "in this expansion of `negative`"))
    (say 33 (== (diagSecCross d 0 vecNew vecNew) 0))
    (say 34 (strEq (traceBlocks d units short 1) ""))
    (say 35 (== (traceGutterWidth d units short 3) 3))
    (retireBuiltIndexes units)
    (let bytesBefore (live))
    (for i in 0..20
      (retireBuiltIndexes units))
    (let growth (- (live) bytesBefore))
    (say 36 (== growth 0))
    (writeStr stderr (concat "index-growth " (concat (fmtInt growth) "\n")))
    (say 37 (strEq (renderDiagsUnits vecNew vecNew) ""))
    (say 38 (strEq (renderDiagsHumanUnits vecNew vecNew) ""))
    (say 39 (strEq (renderDiagsJsonUnits vecNew vecNew) ""))
    (say 40
      (strEq (renderDiagIx d "abc" "entry.ax" units (srcLineIndex "abc") short)
        "E AX3001 entry.ax:- probe \"message\" ^-:\"related\" &\"expand\""))
    (say 41
      (strEq (renderDiagIx negative "abc" "entry.ax" units (srcLineIndex "abc") all)
        "E AX3001 entry.ax:- probe \"message\" &\"negative\""))
    (let fallback (mkDiagBase 0 "AX3001" "probe" (mkSpan 0 1) "message" None))
    (let ds (:: vecNew Diags))
    (vecPush ds fallback)
    (let axdl (renderDiagsUnits ds units))
    (let human (renderDiagsHumanUnits ds units))
    (let json (renderDiagsJsonUnits ds units))
    (diagSetUnit fallback -1)
    (say 42 (strEq (renderDiagsUnits ds units) axdl))
    (say 43 (strEq (renderDiagsHumanUnits ds units) human))
    (say 44 (strEq (renderDiagsJsonUnits ds units) json))
  })
