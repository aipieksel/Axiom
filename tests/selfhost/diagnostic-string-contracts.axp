; Diagnostic text is present String data. Optional fields own their absence.
(import core)
(import diag)
(import render)
(import frontpack)
(import Str)
(import Vec)
(import IO)
(import Sys)
(import Err)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: count (-> String Int))
;@axiom:effect(unsafe)
(fn (count text)
  (__load64 (as text Int) -2))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: unit (-> String CUnit2))
(fn (unit text)
  (CUnit2 :file "text.ax" :src text :name None :imports vecNew :library false))

(:: retireUnit (-> String Int))
(fn (retireUnit text)
  (strLen (unitSrc (unit text))))

(:: retireEscaped (-> String Int))
(fn (retireEscaped text)
  (strLen (ctlEsc text)))

(:: retireText (-> String Int))
(fn (retireText text)
  {
    (let record (unit text))
    (let index (srcLineIndexTyped (unitSrc record)))
    (+ (vecLen index.starts) (strLen (ctlEsc (unitSrc record))))
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let empty (unit ""))
    (say 1 (strEq (unitSrc empty) ""))
    (let emptyIndex (srcLineIndexTyped (unitSrc empty)))
    (say 2 (== (vecLen emptyIndex.starts) 1))
    (say 3 (strEq (ctlEsc "") ""))
    (say 4 (strEq (ctlEsc "α clean") "α clean"))
    (say 5 (strEq (ctlEsc "\n\t\r") "\\n\\t\\r"))
    (let d (mkDiagBase 0 "AX3001" "probe" (mkSpan 0 1) "message" None))
    (diagAddSecondary d 0 "")
    (say 6 (strEq (diagSecMsg d 0) ""))
    (say 7 (strEq (jsonRelatedArray d "x" (srcLineIndex "x") vecNew vecNew) "[{\"label\":\"\"}]"))
    (say 8 (isNone (diagLabel d)))
    (diagSetLabel d "")
    (say 9
      (if (let (Some label) (diagLabel d))
        (strEq label "")
        false))
    (let block (labelBlock "x" (srcLineIndex "x") 1 0 1 94 "visible" ""))
    (say 10 (isSome (strFind block "visible" 0)))
    (let emptyBlock (labelBlock "x" (srcLineIndex "x") 1 0 1 94 "" ""))
    (say 11 (isNone (strFind emptyBlock "visible" 0)))
    (let text (strDup "source"))
    (let owners (count text))
    (retireUnit text)
    (say 12 (== (count text) owners))
    (retireEscaped text)
    (say 13 (== (count text) owners))
    (let escaped (strDup "a\nb\t"))
    (say 14 (strEq (ctlEsc escaped) "a\\nb\\t"))
    (retireText escaped)
    (let before (live))
    (for i in 0..20
      (retireText escaped))
    (let after (live))
    (say 15 (== before after))
    (say 16
      (match (readFile (sysArg 1))
        ((Err _) false)
        ((Ok source) (strEq source ""))))
    (say 17
      (match (readFile (sysArg 2))
        ((Err _) true)
        ((Ok _) false)))
    (let parsed (frontParse ""))
    (say 18
      (if (let (Some value) parsed)
        (strEq value.source "")
        false))
    (say 19
      (if (let (Some value) parsed)
        (if (let (Some decoded) (frontDecode (frontEncode value)))
          (strEq decoded.source "")
          false)
        false))
    (say 20 (isNone (frontDecode "broken")))
    (say 21 (strEq (unitSrc (unit "source")) "source"))
  })
