; Shared by the original and optional lookup implementations.
(import core)
(import doc)
(import IO)
(import Sys)
(import Str)
(import Vec)

(:: snapshot Int)
;@axiom:effect(io)
(fn (snapshot)
  {
    (let pages
      (DocSet
        :root ""
        :out (sysArg 1)
        :srcs (vecPush (vecPush vecNew "README.md") "docs/README.md")
        :outs (vecPush (vecPush vecNew "about.html") "index.html")
        :titles (vecPush (vecPush vecNew "About") "Start")
        :modFiles (vecPush (vecPush (vecPush vecNew "Fixture.ax") "Broken.ax") "Absent.ax")
        :modOuts
          (vecPush (vecPush (vecPush vecNew "modules/Fixture.html") "modules/Broken.html")
            "modules/Absent.html")
        :modNames (vecPush (vecPush (vecPush vecNew "Fixture") "Broken") "Absent")
        :modNamed (vecPush (vecPush (vecPush vecNew 1) 1) 1)))
    (for i in 0..2
      (docRenderPage pages i))
    (for i in 0..3
      (docRenderModule pages i))
    (let missing (docMissingIn "Fixture.ax"))
    (println "missing={missing}")
    (let absent (docMissingIn "Absent.ax"))
    (println "absent={absent}")
    0
  })

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (if (strEq (sysArg 1) "doc")
    docMain
    snapshot))
