; Optional insertion positions preserve the first line and nested buffers.
(import codegen)
(import core)
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say i good)
  (println
    (concat (fmtInt i)
      (if good
        " true"
        " false"))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: markIs (-> CG Int Bool))
(fn (markIs cg expected)
  (match (probeMark cg)
    ((None) false)
    ((Some actual) (== actual expected))))

(:: readMarker (-> CG Bool))
(fn (readMarker cg)
  (isSome (probeMark cg)))

(:: retireMarker (-> (Option Int) Int))
(fn (retireMarker marker)
  {
    (let cg newCG)
    (probeSetMark cg marker)
    17
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let direct newCG)
    (set direct.pairState.threads 1)
    (cgSetRegistry direct 0)
    (say 1 (isNone (probeMark direct)))
    (closeAllocaMark direct)
    (say 2 (&& (isNone (probeMark direct)) (== (vecLen direct.lines) 0)))
    (emitAlloca direct "%.direct")
    (say 3 (strEq (renderCG direct) "  %.direct = alloca i64\n"))
    (emitRecoverCell direct "%.recover" "8")
    (say 4
      (strEq (renderCG direct)
        "  %.direct = alloca i64\n  %.recover = alloca i64, i64 8, align 16\n"))
    (emitRegionCell direct "%.region")
    (say 5
      (strEq (vecGet direct.lines 2)
        "  %.region = alloca i64, i64 3, align 16 ; axiom region mark"))
    (let active newCG)
    (set active.pairState.threads 1)
    (cgSetRegistry active 0)
    (openAllocaMark active)
    (say 6 (markIs active 0))
    (say 7 (== (vecLen active.lines) 1))
    (emitAlloca active "%.a")
    (say 8 (&& (== (vecLen active.hoisted) 1) (== (vecLen active.lines) 1)))
    (emitRecoverCell active "%.r" "8")
    (emitRegionCell active "%.g")
    (say 9 (&& (== (vecLen active.hoisted) 3) (== (vecLen active.lines) 1)))
    (closeAllocaMark active)
    (let expected
      "  %.a = alloca i64\n  %.r = alloca i64, i64 8, align 16\n  %.g = alloca i64, i64 3, align 16 ; axiom region mark\n")
    (say 10 (strEq (renderCG active) expected))
    (say 11 (isNone (probeMark active)))
    (say 12 (== (vecLen active.hoisted) 0))
    (closeAllocaMark active)
    (say 13 (strEq (renderCG active) expected))
    (let header newCG)
    (emitLine header "define i64 @sample() {")
    (openAllocaMark header)
    (say 14 (markIs header 1))
    (emitAlloca header "%.slot")
    (emitLine header "  ret i64 0")
    (closeAllocaMark header)
    (say 15
      (strEq (renderCG header) "define i64 @sample() {\n  %.slot = alloca i64\n  ret i64 0\n"))
    (let empty newCG)
    (openAllocaMark empty)
    (closeAllocaMark empty)
    (say 16 (&& (isNone (probeMark empty)) (strEq (renderCG empty) "\n")))
    (let reset newCG)
    (set reset.hoisted (vecPush vecNew "orphan"))
    (openAllocaMark reset)
    (say 17 (== (vecLen reset.hoisted) 0))
    (let registry newCG)
    (cgSetRegistry registry 1)
    (emitRegionCell registry "%.direct4")
    (say 18
      (strEq (renderCG registry) "  %.direct4 = alloca i64, i64 4, align 16 ; axiom region mark\n"))
    (openAllocaMark registry)
    (emitRegionCell registry "%.queued4")
    (closeAllocaMark registry)
    (say 19
      (strEq (vecGet registry.lines 1)
        "  %.queued4 = alloca i64, i64 4, align 16 ; axiom region mark"))
    (let carrier (Some (- sysArgc 1)))
    (let before (count carrier))
    (let held newCG)
    (probeSetMark held carrier)
    (say 20 (== (count carrier) (+ before 1)))
    (say 21 (&& (readMarker held) (== (count carrier) (+ before 1))))
    (probeSetMark held carrier)
    (say 22 (== (count carrier) (+ before 1)))
    (probeSetMark held None)
    (say 23 (== (count carrier) before))
    (say 24 (&& (== (retireMarker carrier) 17) (== (count carrier) before)))
    (let nested newCG)
    (openAllocaMark nested)
    (emitAlloca nested "%.outer.a")
    (let outerMark (probeMark nested))
    (let outerBuffer nested.hoisted)
    (openAllocaMark nested)
    (emitAlloca nested "%.inner")
    (closeAllocaMark nested)
    (probeSetMark nested outerMark)
    (set nested.hoisted outerBuffer)
    (say 25 (markIs nested 0))
    (emitAlloca nested "%.outer.b")
    (closeAllocaMark nested)
    (say 26
      (strEq (renderCG nested)
        "  %.outer.a = alloca i64\n  %.outer.b = alloca i64\n  %.inner = alloca i64\n"))
    (say 27 (isNone (probeMark nested)))
    0
  })
