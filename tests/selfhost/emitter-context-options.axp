; Optional context slots own their payloads, handle absence and preserve
; module precedence. Lifted descriptors retire their typed child shares.
(import codegen)
(import parser)
(import core)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: missing (-> (Option a) Bool))
(fn (missing value)
  (if (let (Some _) value)
    false
    true))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: holdParams (-> Names Int))
(fn (holdParams value)
  {
    (let cg newCG)
    (probeParams cg value)
    (count value)
  })

(:: paramsChecks ())
;@axiom:effect(io)
(fn (paramsChecks)
  {
    (let cg newCG)
    (say 1 (missing cg.curParams))
    (say 2 (== (paramIndexOf cg "x") -1))
    (let names (vecPush vecNew (strDup "x")))
    (let before (count names))
    (probeParams cg names)
    (say 3 (== (count names) (+ before 1)))
    (say 4 (== (paramIndexOf cg "x") 0))
    (probeParams cg (vecPush vecNew "y"))
    (say 5 (== (count names) before))
    (say 6 (== (curParamIndex cg "x") -1))
    (say 7 (== (paramFloatByName cg "x") 0))
    (probeParams cg vecNew)
    (say 8 (== (paramIndexOf cg "y") -1))
    (let during (holdParams names))
    (say 9 (== (count names) before))
    (say 10 (== during (+ before 1)))
  })

(:: flagsChecks ())
;@axiom:effect(io)
(fn (flagsChecks)
  {
    (let cg newCG)
    (say 11 (missing cg.curFlags))
    (say 12 (== (paramIsFloat cg 0) 0))
    (let flags (vecPush (vecPush vecNew 1) 0))
    (let before (count flags))
    (probeFlags cg (Some flags))
    (say 13 (== (count flags) (+ before 1)))
    (say 14 (== (paramIsFloat cg 0) 1))
    (say 15 (== (paramFloatFlag cg 1) 0))
    (probeFlags cg (None))
    (say 16 (== (count flags) before))
    (say 17 (missing cg.curFlags))
    (say 18 (== (paramIsFloat cg 0) 0))
  })

(:: selfChecks ())
;@axiom:effect(io)
(fn (selfChecks)
  {
    (let cg newCG)
    (say 19 (missing cg.tcoName))
    (say 20 (! (probeSelfActive cg)))
    (let name (strDup "loop"))
    (let before (count name))
    (probeSelf cg (Some name))
    (say 21 (probeSelfActive cg))
    (say 22 (== (count name) (+ before 1)))
    (say 23 (probeSelfRestore cg "loop"))
    (say 24 (== (count name) (+ before 1)))
    (probeSelf cg (None))
    (say 25 (! (probeSelfActive cg)))
    (say 26 (== (count name) before))
  })

(:: moduleChecks ())
;@axiom:effect(io)
(fn (moduleChecks)
  {
    (let cg newCG)
    (say 27 (missing cg.curModule))
    (vecPush cg.mangleBares "x")
    (vecPush cg.mangleFulls "x")
    (vecPush cg.mangleBares "Local$x")
    (vecPush cg.mangleFulls "Local$x")
    (vecPush cg.mangleBares "$x")
    (vecPush cg.mangleFulls "Imported$x")
    (say 28 (strEq (mangledFor cg "x") "x"))
    (probeModule cg (Some "Local"))
    (say 29 (strEq (mangledFor cg "x") "Local$x"))
    (probeModule cg (Some "Other"))
    (say 30 (strEq (mangledFor cg "x") "Imported$x"))
    (probeModule cg (None))
    (say 31 (strEq (mangledFor cg "x") "x"))
    (let name (strDup "Local"))
    (let before (count name))
    (probeModule cg (Some name))
    (say 32 (== (count name) (+ before 1)))
    (probeModule cg (None))
    (say 33 (== (count name) before))
    (say 34 (missing cg.curModule))
  })

(:: holdDesc (-> String Names Bool Int))
(fn (holdDesc name params names)
  {
    (let desc (mkLamDesc name params (mkEInt 9) vecNew vecNew None))
    (if names
      (count params)
      (count name))
  })

(:: holdQueued (-> String Names Int))
(fn (holdQueued name params)
  {
    (let cg newCG)
    (vecPush cg.pendingLams (mkLamDesc name params (mkEInt 9) vecNew vecNew None))
    (count name)
  })

(:: descriptorChecks ())
;@axiom:effect(io)
(fn (descriptorChecks)
  {
    (let name (strDup "lifted"))
    (let params (vecPush vecNew "p"))
    (let nameBefore (count name))
    (let paramsBefore (count params))
    (let nameHeld (holdDesc name params false))
    (say 35 (== nameHeld (+ nameBefore 1)))
    (say 36 (== (count name) nameBefore))
    (let paramsHeld (holdDesc name params true))
    (say 37 (== paramsHeld (+ paramsBefore 1)))
    (say 38 (== (count params) paramsBefore))
    (let queued (holdQueued name params))
    (say 39 (== queued (+ nameBefore 1)))
    (say 40 (== (count name) nameBefore))
  })

(:: emptyModuleChecks ())
;@axiom:effect(io)
(fn (emptyModuleChecks)
  {
    (let cg newCG)
    (vecPush cg.mangleBares "x")
    (vecPush cg.mangleFulls "x")
    (vecPush cg.mangleBares "$x")
    (vecPush cg.mangleFulls "Imported$x")
    (probeModule cg (Some ""))
    (say 41 (! (missing cg.curModule)))
    (say 42 (strEq (mangledFor cg "x") "Imported$x"))
    (probeModule cg (None))
    (say 43 (strEq (mangledFor cg "x") "x"))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (paramsChecks)
    (flagsChecks)
    (selfChecks)
    (moduleChecks)
    (descriptorChecks)
    (emptyModuleChecks)
    0
  })
