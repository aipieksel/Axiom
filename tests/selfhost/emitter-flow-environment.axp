(import core)
(import Host)
(import parser)
(import lexer)
(import codegen)
(import checked)
(import Vec)
(import Str)
(import Mem)
(import IO)
(import Err)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: flagIs (-> (Option Int) Int Bool))
(fn (flagIs found expected)
  (match found
    ((Some flag) (== flag expected))
    ((None) false)))

(:: holdEnvironment (-> String Int))
(fn (holdEnvironment name)
  {
    (let env (envWith vecNew name 7))
    (count name)
  })

(:: popEnvironment (-> FlowEnv ()))
(fn (popEnvironment env)
  {
    (let retired (vecPop env))
    ()
  })

(:: holdMemoName (-> String Int))
(fn (holdMemoName name)
  {
    (let cg newCG)
    (let env (envWith vecNew name 11))
    (let node (mkEInt 0))
    (mutMemoAdd cg.pairState.mutMemo "key" node node vecNew env 5)
    (vecClear env)
    (count name)
  })

(:: retiredMemoName (-> String Int))
(fn (retiredMemoName name)
  {
    (let cg newCG)
    (let env (envWith vecNew name 11))
    (let node (mkEInt 0))
    (mutMemoAdd cg.pairState.mutMemo "key" node node vecNew env 5)
    (vecClear env)
    (mutMemoOpen cg)
    (count name)
  })

(:: emitSource (-> String String))
;@axiom:effect(io)
(fn (emitSource source)
  {
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (match parsed
      ((ParseFailed parseError1) "")
      ((ParseSuccess parsedValue1 parsedPos1)
        {
          (let declarations parsedValue1)
          (for declaration in declarations
            (writeNodeWord declaration 5 1))
          (let units
            (vecPush vecNew
              (CUnit2
                :file "flow-environment.ax"
                :src source
                :name (Some "")
                :imports vecNew
                :library false)))
          (let checked (checkExpandedProgram declarations declarations units))
          (match checked.program
            ((Some program)
              (emitCheckedProgram program vecNew vecNew (checkedTargetCode hostTarget) false)
            )
            ((None) ""))
        }
      ))
  })

(:: checks ())
;@axiom:effect(io)
(fn (checks)
  {
    (let empty (:: vecNew FlowEnv))
    (say 1 (isNone (envFlagOf empty "missing")))
    (let first (envWith empty "x" 0))
    (say 2 (flagIs (envFlagOf first "x") 0))
    (let signed (envWith first "negative" (- 0 1)))
    (say 3 (flagIs (envFlagOf signed "negative") (- 0 1)))
    (let mask (| MUST_BIT (| (paramBit 0) (| (wordBit 1) (ownerBit 2)))))
    (let wide (envWith signed "wide" mask))
    (say 4 (flagIs (envFlagOf wide "wide") mask))
    (say 5 (flagIs (envFlagOf wide "x") 0))
    (let shadow (envWith wide "x" 9))
    (say 6 (flagIs (envFlagOf shadow "x") 9))
    (say 7 (flagIs (envFlagOf first "x") 0))
    (say 8 (isNone (envFlagOf shadow "missing")))
    (say 9 (flagIs (envFlagFrom shadow "x" 0) 0))
    (say 10 (isNone (envFlagFrom shadow "x" (- 0 1))))
    (let names (vecPush (vecPush (vecPush vecNew "a") "b") "a"))
    (let many (:: vecNew FlowEnv))
    (envPushAll many names 3 0)
    (say 11 (&& (flagIs (envFlagOf many "a") 3) (flagIs (envFlagOf many "b") 3)))
    (let manyShadow (envWith many "a" 4))
    (say 12 (flagIs (envFlagOf manyShadow "a") 4))
    (say 13 (&& (== (vecLen names) 3) (strEq (vecGet names 2) "a")))
    (say 14 (&& (== (vecLen many) 3) (flagIs (envFlagOf many "a") 3)))
    (popEnvironment manyShadow)
    (say 15 (flagIs (envFlagOf manyShadow "a") 3))
    (vecClear manyShadow)
    (say 16 (isNone (envFlagOf manyShadow "a")))
    (say 17 (vecOwnsRefs many))
    (say 18 (flagIs (envFlagOf (envWith vecNew "" 7) "") 7))
    (let owned (strDup "owned"))
    (let before (count owned))
    (let owning (envWith vecNew owned 7))
    (say 19 (== (count owned) (+ before 1)))
    (let copied (envWith owning "other" 8))
    (say 20 (== (count owned) (+ before 1)))
    (vecClear owning)
    (say 21 (== (count owned) (+ before 1)))
    (say 22 (flagIs (envFlagOf copied "owned") 7))
    (vecClear copied)
    (say 23 (== (count owned) before))
    (let held (holdEnvironment owned))
    (say 24 (== held (+ before 1)))
    (say 25 (== (count owned) before))
    (let popped (envWith vecNew owned 7))
    (popEnvironment popped)
    (say 26 (== (vecLen popped) 0))
    (say 27 (== (count owned) before))
    (say 28 (== (vecLen empty) 0))
    (let cg newCG)
    (let node (mkEInt 0))
    (let key (strDup "memo"))
    (let params (vecPush vecNew "p"))
    (let memoEnv (envWith vecNew owned 11))
    (say 29 (isNone (probeMemoFlag cg key node node params memoEnv)))
    (mutMemoAdd cg.pairState.mutMemo key node node params memoEnv 5)
    (say 30 (flagIs (probeMemoFlag cg key node node params memoEnv) 5))
    (say 31 (flagIs (probeMemoFlag cg key node node params (envWith vecNew owned 11)) 5))
    (say 32 (== (mutMemoEnvEq memoEnv (envWith vecNew owned 11) 0) 1))
    (say 33 (== (mutMemoEnvEq memoEnv (envWith vecNew (strDup "owned") 11) 0) 0))
    (say 34 (== (mutMemoEnvEq memoEnv (envWith vecNew owned 12) 0) 0))
    (envPushAll memoEnv (vecPush vecNew "extra") 9 0)
    (say 35 (isNone (probeMemoFlag cg key node node params memoEnv)))
    (say 36 (flagIs (probeMemoFlag cg key node node params (envWith vecNew owned 11)) 5))
    (mutMemoAdd cg.pairState.mutMemo key node node params (envWith vecNew owned 11) 9)
    (say 37 (flagIs (probeMemoFlag cg key node node params (envWith vecNew owned 11)) 5))
    (say 38 (isNone (probeMemoFlag cg (strDup "memo") node node params (envWith vecNew owned 11))))
    (say 39
      (isNone (probeMemoFlag cg key node node (vecPush vecNew "p") (envWith vecNew owned 11))))
    (let cachedBefore (count owned))
    (let cached (holdMemoName owned))
    (say 40 (== cached (+ cachedBefore 1)))
    (say 41 (== (count owned) cachedBefore))
    (let retired (retiredMemoName owned))
    (say 42 (== retired cachedBefore))
    (mutMemoOpen cg)
    (say 43 (&& (== (vecLen cg.pairState.mutMemo) 0) (== cg.pairState.mutMemoDepth 1)))
    (let parameters (vecPush (vecPush vecNew "x") "y"))
    (let variable (mkEVar "x"))
    (say 44 (== (flowMask cg variable parameters vecNew) (paramBit 0)))
    (say 45 (== (flowMask cg variable parameters (envWith vecNew "x" 0)) 0))
    (let maskEnv (envWith vecNew "x" mask))
    (say 46 (== (flowMask cg variable parameters maskEnv) (& mask (- MUST_BIT 1))))
    (say 47 (== (mustFlow cg variable parameters maskEnv) (& mask (- MUST_BIT 1))))
    (say 48 (== (mustFlow cg variable parameters (envWith vecNew "x" 1)) 0))
    (say 49 (== (tailOwned cg variable parameters (envWith vecNew "x" 1)) 1))
    (say 50 (== (tailOwned cg variable parameters (envWith vecNew "x" 0)) 0))
    (say 51 (== (tailOwned cg (setNodeDefScope (mkEVar "x")) vecNew (envWith vecNew "x" 1)) 0))
    (say 52 (== (probeValueOwned cg variable (envWith vecNew "x" 1)) 1))
    (let captures (envWith (envWith vecNew "x" (| MUST_BIT (paramBit 0))) "x" (wordBit 1)))
    (say 53 (== (lamCaptureFrom variable captures 0) (| (paramBit 0) (wordBit 1))))
    (say 54 (== (lamCaptureFrom (mkEVar "other") captures 0) 0))
    (say 55 (== (lamCaptureFrom variable captures 1) (wordBit 1)))
    (let mutBody (nodeBuildESet "slot" (mkEVar "y") 0 0))
    (let mutInit (mkEVar "x"))
    (let flow (mutFlag cg "slot" mutInit mutBody parameters vecNew))
    (say 56 (== flow (| (paramBit 0) (paramBit 1))))
    (let memoSize (vecLen cg.pairState.mutMemo))
    (say 57
      (&& (== (mutFlag cg "slot" mutInit mutBody parameters vecNew) flow)
        (== (vecLen cg.pairState.mutMemo) memoSize)))
    (mutMemoClose cg)
    (say 58 (&& (== (vecLen cg.pairState.mutMemo) memoSize) (== cg.pairState.mutMemoDepth 0)))
    (let pattern (mkEApp (mkEApp (mkEVar "Ctor") (mkEVar "a")) (mkEVar "b")))
    (let unknown (envWithPat cg vecNew pattern 42))
    (say 59 (&& (flagIs (envFlagOf unknown "a") 42) (flagIs (envFlagOf unknown "b") 42)))
    (addTypeNamed cg.types "Ctor" TF_DATA 2 0 0 vecNew (Some vecNew)
      (Some (vecPush (vecPush vecNew mkIntTy) mkStringTy)))
    (let known (envWithPat cg vecNew pattern 42))
    (say 60 (&& (flagIs (envFlagOf known "a") 0) (flagIs (envFlagOf known "b") 42)))
    (say 61 (== (vecLen (envWithPat cg known nilNode 99)) 2))
    (let repeated (mkEApp (mkEApp (mkEVar "Ctor") (mkEVar "same")) (mkEVar "same")))
    (say 62 (flagIs (envFlagOf (envWithPat cg vecNew repeated 42) "same") 42))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (> sysArgc 1)
    {
      (writeStr stdout (emitSource (unwrapOr (readFile (sysArg 1)) "")))
      0
    }
    {
      (checks)
      0
    }))
