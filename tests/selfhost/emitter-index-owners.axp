; Name indexes own their typed parts, preserve lookup precedence and
; distinguish an absent index from an empty built index.
(import codegen)
(import parser)
(import lexer)
(import core)
(import Intern)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: absent (-> (Option a) Bool))
(fn (absent value)
  (if (let (Some _) value)
    false
    true))

(:: declarations Nodes)
(fn (declarations)
  {
    (let out nodesNew)
    (vecPush out (mkDFnAt "zero" vecNew (mkEInt 0) 0))
    (vecPush out (mkDFnAt "work" (vecPush vecNew "x") (mkEInt 1) 0))
    (vecPush out (mkDFnAt "work" (vecPush (vecPush vecNew "x") "y") (mkEInt 2) 0))
    (vecPush out (mkDFnAt "main" (vecPush vecNew "arg") (mkEInt 0) 0))
    (let ext (parseModule (lex "(extern \"c\" (foreignZero :: Int (symbol \"foreign_symbol\")))")))
    (vecPush out (vecGet (readAstNodes ext 1) 0))
    out
  })

(:: addName (-> CG String String ()))
(fn (addName cg bare full)
  {
    (vecPush cg.mangleBares bare)
    (vecPush cg.mangleFulls full)
    ()
  })

(:: lookupChecks ())
;@axiom:effect(io)
(fn (lookupChecks)
  {
    (let cg newCG)
    (say 1 (absent cg.bareIntern))
    (say 2 (absent cg.bareFirst))
    (say 3 (strEq (mangledForCg cg "missing") "missing"))
    (set cg.decls declarations)
    (say 4 (isNullaryFnCg cg "zero"))
    (say 5 (isDefinedFnCg cg "work"))
    (say 6 (== (fnArityOfCg cg "work") 1))
    (say 7 (== (fnDefArityCg cg "work") -1))
    (addName cg "value" "Entry$value")
    (addName cg "value" "Wrong$value")
    (addName cg "Local$value" "Local$value")
    (addName cg "$value" "Imported$value")
    (addName cg "$entry$value" "Entry$value")
    (say 8 (strEq (mangledForCg cg "value") "Entry$value"))
    (buildNameIndexes cg)
    (say 9 (! (absent cg.bareIntern)))
    (say 10 (! (absent cg.bareFirst)))
    (say 11 (isNullaryFnCg cg "zero"))
    (say 12 (! (isDefinedFnCg cg "zero")))
    (say 13 (isDefinedFnCg cg "work"))
    (say 14 (! (isNullaryFnCg cg "work")))
    (say 15 (== (fnArityOfCg cg "work") 1))
    (say 16 (== (fnDefArityCg cg "work") 1))
    (say 17 (! (isDefinedFnCg cg "missing")))
    (say 18 (== (fnArityOfCg cg "missing") 0))
    (say 19 (== (fnDefArityCg cg "missing") -1))
    (say 20 (isNullaryFnCg cg "foreignZero"))
    (say 21 (isNullaryFnCg cg "foreign_symbol"))
    (say 22 (== (fnDefArityCg cg "foreignZero") -1))
    (say 23 (== (fnArityOfCg cg "__axiom_user_main") 1))
    (say 24 (strEq (mangledForCg cg "main") "__axiom_user_main"))
    (say 25 (strEq (mangledForCg cg "value") "Entry$value"))
    (set cg.curModule (Some "Local"))
    (say 26 (strEq (mangledForCg cg "value") "Local$value"))
    (set cg.curModule (Some "Other"))
    (say 27 (strEq (mangledForCg cg "value") "Imported$value"))
    (set cg.curModule (None))
    (say 28 (strEq (mangledForCg cg "value") "Entry$value"))
    (let oldIndex cg.bareFirst)
    (if (let (Some index) oldIndex)
      {
        (let before (count oldIndex))
        (buildNameIndexes cg)
        (say 29 (== (count oldIndex) (- before 1)))
      }
      (say 29 false))
    (set cg.bareFirst (None))
    (set cg.curModule (Some "Local"))
    (say 30 (strEq (mangledForCg cg "value") "Local$value"))
    (buildNameIndexes cg)
    (set cg.bareIntern (None))
    (say 31 (strEq (mangledForCg cg "value") "Local$value"))
    (let empty newCG)
    (buildNameIndexes empty)
    (say 32 (! (absent empty.bareFirst)))
    (say 33 (! (isNullaryFnCg empty "missing")))
    (say 34 (== (fnDefArityCg empty "missing") -1))
  })

(:: holdIndex (-> Ints InternState Ints Int))
(fn (holdIndex first names flags)
  {
    (let cg newCG)
    (let index (DeclIndex :first first :names names :nullary flags :defined flags :arity flags))
    (set cg.bareFirst (Some index))
    (count first)
  })

(:: ownerChecks ())
;@axiom:effect(io)
(fn (ownerChecks)
  {
    (let first (vecPush vecNew 0))
    (let names internNewTyped)
    (let flags (vecPush vecNew 0))
    (let firstBefore (count first))
    (let namesBefore (count names))
    (let flagsBefore (count flags))
    (let during (holdIndex first names flags))
    (say 35 (== during (+ firstBefore 1)))
    (say 36 (== (count first) firstBefore))
    (say 37 (== (count names) namesBefore))
    (say 38 (== (count flags) flagsBefore))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (lookupChecks)
    (ownerChecks)
    0
  })
