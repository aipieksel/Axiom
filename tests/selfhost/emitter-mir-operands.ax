; expect 0
; MIR operands are compiler-owned text, including constants and register names.
(import codegen)
(import mir)
(import raw)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(type OperandTexts Strings)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: operands (-> Int OperandTexts))
(fn (operands count)
  {
    (let values (vecWithCapacity count))
    (for i in 0..count
      (vecPush values ""))
    values
  })

(:: textAt (-> OperandTexts Int String))
(fn (textAt values index)
  (vecGet values index))

(:: instruction (-> Int Int Int Int String MInst))
(fn (instruction op dst a b name)
  (MInst :op op :dst dst :a a :b b :name name :args vecNew :tgt -1 :alt -1))

(:: fixture MFunc)
(fn (fixture)
  {
    (let instructions
      (vecPush
        (vecPush
          (vecPush
            (vecPush (vecPush vecNew (instruction MO_CONST 2 17 0 ""))
              (instruction MO_CONST 3 -3 0 ""))
            (instruction MO_BIN 4 0 2 "add"))
          (instruction MO_BIN 5 3 4 "slt"))
        (instruction MO_BIN 6 4 4 "add")))
    (let block
      (MBlock
        :id 0
        :params vecNew
        :instrs instructions
        :term (vecPush vecNew (instruction MT_RET -1 6 0 ""))))
    (MFunc
      :name "metadata"
      :params (vecPush (vecPush vecNew 0) 1)
      :pnames (vecPush (vecPush vecNew "a") "odd name")
      :blocks (vecPush vecNew block)
      :nreg 7)
  })

(:: expectedBody String)
(fn (expectedBody)
  "  %.t0 = add i64 %a, 17\n  %.c1 = icmp slt i64 -3, %.t0\n  %.t2 = zext i1 %.c1 to i64\n  %.t3 = add i64 %.t0, %.t0\n")

(:: countOf (-> String Int))
;@axiom:effect(unsafe)
(fn (countOf value)
  (__load64 (as value Int) -2))

(:: ledgerChecks (-> MFunc Int ()))
;@axiom:effect(io)
(fn (ledgerChecks function cg)
  {
    (let values (operands 7))
    (say 1 (&& (== (vecLen values) 7) (vecOwnsRefs values)))
    (say 2 (strEq (textAt values 6) ""))
    (say 3 (== (mirParamOps values function.params function.pnames 0) 0))
    (say 4 (strEq (textAt values 0) "%a"))
    (say 5 (strEq (textAt values 1) "%\"odd name\""))
    (mirParamOps values function.params function.pnames 0)
    (say 6 (strEq (textAt values 1) "%\"odd name\""))
    (let block (vecGet function.blocks 0))
    (say 7 (== (mirEmitInsts cg block.instrs values 0) cg))
    (say 8 (strEq (textAt values 2) "17"))
    (say 9 (strEq (textAt values 3) "-3"))
    (say 10 (strEq (textAt values 4) "%.t0"))
    (say 11 (strEq (textAt values 5) "%.t2"))
    (say 12 (strEq (textAt values 6) "%.t3"))
    (say 13 (strEq (renderCG cg) expectedBody))
    (let held (textAt values 6))
    (let count (countOf held))
    (let copies (vecPush vecNew held))
    (say 14 (== (countOf held) (+ count 1)))
    (vecClear values)
    (say 15 (== (countOf held) count))
    (say 16 (strEq (vecGet copies 0) "%.t3"))
    (vecClear copies)
    (say 17 (== (countOf held) (- count 1)))
    (say 18 (strEq held "%.t3"))
    (vecClear (memGetWordVec cg 0))
    (memSetWord cg 1 0)
  })

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

; Reset output between iterations; only the ledger is created in this scope.
(:: emissionRound (-> MFunc Nodes Strings Int Bool))
;@axiom:effect(io)
(fn (emissionRound function emptyArgs emptyRegs cg)
  {
    (mirEmitFn cg function MIR_ON)
    (let good (&& (strEq (renderCG cg) expectedBody) (strEq (memGetWordStr cg 2) "%.t3")))
    (vecClear (memGetWordVec cg 0))
    (memSetWord cg 1 0)
    (emitArgsRegs emptyArgs cg emptyRegs 0 "metadata-only" 0)
    good
  })

(:: soakChecks (-> MFunc Int ()))
;@axiom:effect(io)
(fn (soakChecks function cg)
  {
    (let emptyArgs (:: vecNew Nodes))
    (let emptyRegs (:: vecNew Strings))
    (let mut good true)
    (for i in 0..16
      (if (! (emissionRound function emptyArgs emptyRegs cg))
        (set good false)))
    (say 19 good)
    (let before (live))
    (for i in 0..1000
      (if (! (emissionRound function emptyArgs emptyRegs cg))
        (set good false)))
    (let growth (- (live) before))
    (say 20 (== growth 0))
    (say 21 good)
    (say 22 (&& (== (vecLen (memGetWordVec cg 0)) 0) (strEq (memGetWordStr cg 2) "")))
    (eprintln "mir-operand-soak-growth {growth}")
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let function fixture)
    (let cg newCG)
    (ledgerChecks function cg)
    (soakChecks function cg)
    0
  })
