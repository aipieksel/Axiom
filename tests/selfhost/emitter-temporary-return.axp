(import Str)
(import Vec)
(import IO)
(import Mem)

(struct Entry
  (value : String))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

; Observe only live typed owners. No retired allocation is read.
(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: direct (-> String Entry))
(fn (direct value)
  (Entry :value value))

(:: temporary (-> String Entry))
(fn (temporary value)
  (vecGet (vecPush vecNew (Entry :value value)) 0))

(:: genericTemporary (-> a a))
(fn (genericTemporary value)
  (vecGet (vecPush vecNew value) 0))

(:: nestedTemporary (-> String Entry))
(fn (nestedTemporary value)
  (vecGet (vecGet (vecPush vecNew (vecPush vecNew (Entry :value value))) 0) 0))

(:: ownedPop (-> String Entry))
(fn (ownedPop value)
  (vecPop (vecPush vecNew (Entry :value value))))

(:: ownedPopString (-> String String))
(fn (ownedPopString value)
  (vecPop (vecPush vecNew value)))

(:: conditionalOwnedPop (-> String Bool Entry))
(fn (conditionalOwnedPop value select)
  (if select
    (vecPop (vecPush vecNew (Entry :value value)))
    (Entry :value value)))

(:: matchOwnedPop (-> String (Option Int) Entry))
(fn (matchOwnedPop value select)
  (match select
    ((Some _) (vecPop (vecPush vecNew (Entry :value value))))
    ((None) (Entry :value value))))

(:: ownedParameter (-> (Vec Entry) Entry))
(fn (ownedParameter rows)
  (vecPop rows))

(:: genericPop (-> a a))
(fn (genericPop value)
  (vecPop (vecPush vecNew value)))

(:: retirePop (-> String Int))
(fn (retirePop value)
  {
    (let row (ownedPop value))
    17
  })

(:: retirePopString (-> String Int))
(fn (retirePopString value)
  {
    (let result (ownedPopString value))
    17
  })

(:: retireConditionalPop (-> String Bool Int))
(fn (retireConditionalPop value select)
  {
    (let row (conditionalOwnedPop value select))
    17
  })

(:: retireMatchPop (-> String (Option Int) Int))
(fn (retireMatchPop value select)
  {
    (let row (matchOwnedPop value select))
    17
  })

(:: retireOwnedParameter (-> String Bool))
(fn (retireOwnedParameter value)
  {
    (let rows (vecPush vecNew (Entry :value value)))
    (let row (ownedParameter rows))
    (&& (== (vecLen rows) 0) (&& (== (count row) 1) (strEq row.value value)))
  })

(:: conditionalTemporary (-> String Bool Entry))
(fn (conditionalTemporary value select)
  (if select
    (vecGet (vecPush vecNew (Entry :value value)) 0)
    (Entry :value value)))

(:: matchTemporary (-> String (Option Int) Entry))
(fn (matchTemporary value select)
  (match select
    ((Some index) (vecGet (vecPush vecNew (Entry :value value)) index))
    ((None) (Entry :value value))))

(:: borrowed (-> (Vec Entry) Entry))
(fn (borrowed rows)
  (vecGet rows 0))

(:: retire0 (-> String Int))
(fn (retire0 value)
  {
    (let row (direct value))
    17
  })

(:: retire1 (-> String Int))
(fn (retire1 value)
  {
    (let row (temporary value))
    17
  })

(:: retire2 (-> String Int))
(fn (retire2 value)
  {
    (let row (nestedTemporary value))
    17
  })

(:: retire3 (-> String Int))
(fn (retire3 value)
  {
    (let row (conditionalTemporary value true))
    17
  })

(:: retire4 (-> String Int))
(fn (retire4 value)
  {
    (let row (conditionalTemporary value false))
    17
  })

(:: retire5 (-> String Int))
(fn (retire5 value)
  {
    (let row (matchTemporary value (Some 0)))
    17
  })

(:: retire6 (-> String Int))
(fn (retire6 value)
  {
    (let row (matchTemporary value None))
    17
  })

(:: retireBorrowed (-> String Bool))
(fn (retireBorrowed value)
  {
    (let rows (vecPush vecNew (Entry :value value)))
    (let row (borrowed rows))
    (vecClear rows)
    (&& (== (count row) 1) (strEq row.value value))
  })

(:: nonTail (-> String Bool))
(fn (nonTail value)
  {
    (let row (vecGet (vecPush vecNew (Entry :value value)) 0))
    (&& (== (count row) 1) (strEq row.value value))
  })

(:: stringTemporary (-> String String))
(fn (stringTemporary value)
  (vecGet (vecPush vecNew (strDup value)) 0))

(:: retireString (-> String Int))
(fn (retireString value)
  {
    (let result (stringTemporary value))
    17
  })

(:: scalarTemporary Int)
(fn (scalarTemporary)
  (vecGet (vecPush vecNew 42) 0))

(:: retirePushedPop (-> (Vec Entry) String Int))
(fn (retirePushedPop rows value)
  {
    (let row (vecPop (vecPush rows (Entry :value value))))
    (if (&& (== (count row) 1) (strEq row.value value))
      17
      0)
  })

(:: retireNestedPop (-> (Vec Entry) String Int))
(fn (retireNestedPop rows value)
  {
    (let row (vecPop (vecPush vecNew (vecPop (vecPush rows (Entry :value value))))))
    (if (&& (== (count row) 1) (strEq row.value value))
      17
      0)
  })

(:: markedHolder (-> (Vec Entry) (Vec Int) String (Vec Entry)))
(fn (markedHolder rows events value)
  {
    (vecPush events 1)
    (vecPush rows (Entry :value value))
  })

(:: retireMarkedPop (-> (Vec Entry) (Vec Int) String Int))
(fn (retireMarkedPop rows events value)
  {
    (let row (vecPop (markedHolder rows events value)))
    (vecPush events 2)
    (if (strEq row.value value)
      17
      0)
  })

(:: popScalar (-> Int Int))
(fn (popScalar n)
  (vecPop (vecPush vecNew n)))

(:: held Int)
(fn (held)
  {
    (let stats memStats)
    stats.heldBytes
  })

(:: popLoop (-> Int Int))
(fn (popLoop n)
  {
    (let mut i 0)
    (let mut total 0)
    (while (< i n)
      {
        (set total (+ total (popScalar i)))
        (set i (+ i 1))
      })
    total
  })

(:: retireTwoPopped (-> String Int))
(fn (retireTwoPopped value)
  {
    (let row (vecPop (vecPush (vecPush vecNew (Entry :value value)) (Entry :value value))))
    (if (strEq row.value value)
      17
      0)
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let value (strDup "dynamic owned child"))
    (let before0 (count value))
    (say 1 (== (retire0 value) 17))
    (say 2 (== (count value) before0))
    (let before1 (count value))
    (say 3 (== (retire1 value) 17))
    (say 4 (== (count value) before1))
    (let before2 (count value))
    (say 5 (== (retire2 value) 17))
    (say 6 (== (count value) before2))
    (let before3 (count value))
    (say 7 (== (retire3 value) 17))
    (say 8 (== (count value) before3))
    (let before4 (count value))
    (say 9 (== (retire4 value) 17))
    (say 10 (== (count value) before4))
    (let before5 (count value))
    (say 11 (== (retire5 value) 17))
    (say 12 (== (count value) before5))
    (let before6 (count value))
    (say 13 (== (retire6 value) 17))
    (say 14 (== (count value) before6))
    (let beforeBorrowed (count value))
    (say 15 (retireBorrowed value))
    (say 16 (== (count value) beforeBorrowed))
    (let beforeNonTail (count value))
    (say 17 (nonTail value))
    (say 18 (== (count value) beforeNonTail))
    (say 19 (== (genericTemporary 42) 42))
    (say 20 (== (genericTemporary 0) 0))
    (say 21 (== (genericTemporary -17) -17))
    ; Generic callers still have a separate retained-share limitation. These
    ; two cases check their values without weakening the strict comparison.
    (say 22 (strEq (genericTemporary value) value))
    (say 23
      {
        (let genericRow (genericTemporary (Entry :value value)))
        (strEq genericRow.value value)
      })
    (say 24
      {
        (let poppedRow (ownedPop value))
        (strEq poppedRow.value value)
      })
    (say 25 (strEq (stringTemporary value) value))
    (say 26 (== (retireString value) 17))
    (say 27 (== scalarTemporary 42))
    (let beforePop (count value))
    (say 28 (== (retirePop value) 17))
    (say 29 (== (count value) beforePop))
    (let beforePopString (count value))
    (say 30 (== (retirePopString value) 17))
    (say 31 (== (count value) beforePopString))
    (let beforeConditionalPop (count value))
    (say 32 (== (retireConditionalPop value true) 17))
    (say 33 (== (count value) beforeConditionalPop))
    (let beforeConditionalOther (count value))
    (say 34 (== (retireConditionalPop value false) 17))
    (say 35 (== (count value) beforeConditionalOther))
    (let beforeMatchPop (count value))
    (say 36 (== (retireMatchPop value (Some 0)) 17))
    (say 37 (== (count value) beforeMatchPop))
    (let beforeMatchOther (count value))
    (say 38 (== (retireMatchPop value None) 17))
    (say 39 (== (count value) beforeMatchOther))
    (let beforeOwnedParameter (count value))
    (say 40 (retireOwnedParameter value))
    (say 41 (== (count value) beforeOwnedParameter))
    (say 42 (== (genericPop 42) 42))
    (say 43 (== (genericPop 0) 0))
    (say 44 (== (genericPop -17) -17))
    (let rows vecNew)
    (let beforeRows (count rows))
    (let beforePushedValue (count value))
    (say 45 (== (retirePushedPop rows value) 17))
    (say 46 (== (count rows) beforeRows))
    (say 47 (== (count value) beforePushedValue))
    (say 48 (== (vecLen rows) 0))
    (let beforeNestedRows (count rows))
    (let beforeNestedValue (count value))
    (say 49 (== (retireNestedPop rows value) 17))
    (say 50 (== (count rows) beforeNestedRows))
    (say 51 (== (count value) beforeNestedValue))
    (let events vecNew)
    (let beforeMarkedRows (count rows))
    (let beforeMarkedValue (count value))
    (say 52 (== (retireMarkedPop rows events value) 17))
    (say 53 (&& (== (vecLen events) 2) (&& (== (vecGet events 0) 1) (== (vecGet events 1) 2))))
    (say 54 (== (count rows) beforeMarkedRows))
    (say 55 (== (count value) beforeMarkedValue))
    (popLoop 2000)
    (let beforeLoop held)
    (let total (popLoop 2000))
    (let afterLoop held)
    (say 56 (== total 1999000))
    (say 57 (== afterLoop beforeLoop))
    (let beforeTwo (count value))
    (say 58 (== (retireTwoPopped value) 17))
    (say 59 (== (count value) beforeTwo))
  })
