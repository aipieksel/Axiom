(import core)
(import lexer)
(import parser)
(import lsp)
(import Cereal)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: idx (-> (Option Int) (Option Int) Bool))
(fn (idx actual expected)
  (match expected
    ((None) (isNone actual))
    ((Some want)
      (match actual
        ((None) false)
        ((Some got) (== got want)))
    )))

(:: at (-> String String Int))
(fn (at source needle)
  (match (strFind source needle 0)
    ((None) __indexTrap)
    ((Some i) i)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (idx (lspAxqlArgIndex "axqSql") (Some 0)))
    (say 2 (idx (lspAxqlArgIndex "axqExec") (Some 1)))
    (say 3 (idx (lspAxqlArgIndex "axqExecBatch") (Some 1)))
    (say 4 (idx (lspAxqlArgIndex "axqPrepare") (Some 1)))
    (say 5 (idx (lspAxqlArgIndex "") None))
    (say 6 (idx (lspAxqlArgIndex "other") None))
    (say 7 (idx (lspAxqlArgIndex "AXQSQL") None))
    (say 8 (idx (lspAxqlDigitsAt "0" 0) (Some 0)))
    (say 9 (idx (lspAxqlDigitsAt "12x" 0) (Some 12)))
    (say 10 (idx (lspAxqlDigitsAt "a42" 1) (Some 42)))
    (say 11 (idx (lspAxqlDigitsAt "" 0) None))
    (say 12 (idx (lspAxqlDigitsAt "x" 0) None))
    (say 13 (idx (lspAxqlDigitsAt "1" 1) None))
    (say 14 (idx (lspAxqlDigitsAt "1" -1) None))
    (say 15 (idx (lspAxqlDigitsAt "1" 2) None))
    (say 16 (idx (lspAxqlErrOffset "abc" "line 1, column 1") (Some 0)))
    (say 17 (idx (lspAxqlErrOffset "abc" "line 1, column 2") (Some 1)))
    (say 18 (idx (lspAxqlErrOffset "abc" "line 1, column 99") (Some 3)))
    (say 19 (idx (lspAxqlErrOffset "a\nbc" "line 2, column 2") (Some 3)))
    (say 20 (idx (lspAxqlErrOffset "" "line 1, column 1") (Some 0)))
    (say 21 (idx (lspAxqlErrOffset "abc" "other") None))
    (say 22 (idx (lspAxqlErrOffset "abc" "line x, column 1") None))
    (say 23 (idx (lspAxqlErrOffset "abc" "line 0, column 1") None))
    (say 24 (idx (lspAxqlErrOffset "abc" "line 1, column 0") None))
    (say 25 (idx (lspAxqlErrOffset "abc" "line 1") None))
    (say 26 (idx (lspAxqlErrOffset "a\nb" "line 9, column 1") (Some 3)))
    (say 27 (isNone (lspAxqlRefusal "SELECT 1" false)))
    (say 28 (isSome (lspAxqlRefusal "SELECT * FROM" false)))
    (say 29 (isNone (lspAxqlRefusal "SELECT 1; SELECT 2" true)))
    (say 30 (isSome (lspAxqlRefusal "not sql" true)))
    (say 31 (idx (lspRecOpenString "" (lex "")) None))
    (say 32 (idx (lspRecOpenString "\"unfinished" (lex "\"unfinished")) (Some 0)))
    (say 33 (idx (lspRecOpenString "x \"unfinished" (lex "x \"unfinished")) (Some 2)))
    (say 34 (idx (lspRecOpenString "\"closed\"" (lex "\"closed\"")) None))
    (say 35 (idx (lspRecOpenString "; \"ignored" (lex "; \"ignored")) None))
    (say 36 (idx (lspRecOpenString "\"\\q\"" (lex "\"\\q\"")) None))
    (say 37 (idx (lspRecEnclosing (lex "((x))") 2) (Some 1)))
    (say 38 (idx (lspRecEnclosing (lex "((x))") 3) (Some 1)))
    (say 39 (idx (lspRecEnclosing (lex "((x))") 5) None))
    (say 40 (idx (lspRecEnclosing (lex "()") 0) None))
    (say 41 (idx (lspRecEnclosing (lex "()") 1) (Some 0)))
    (say 42 (idx (lspRecEnclosing (lex "") 0) None))
    (say 43 (idx (lspRecEnclosing (lex "()") -1) None))
    (say 44 (idx (lspRecEnclosing (lex "()") 9) None))
    (say 45 (idx (lspRecGroupOf (lex "((x))") 0) (Some 0)))
    (say 46 (idx (lspRecGroupOf (lex "((x))") 1) (Some 1)))
    (say 47 (idx (lspRecGroupOf (lex "((x))") 2) (Some 1)))
    (say 48 (idx (lspRecGroupOf (lex "((x))") 3) (Some 1)))
    (say 49 (idx (lspRecGroupOf (lex "((x))") 4) (Some 0)))
    (say 50 (idx (lspRecGroupOf (lex "x") 0) None))
    (say 51 (idx (lspRecGroupOf (lex "()") 9) None))
    (say 52 (== (vecLen (lspRepairWiden (lex "()") None vecNew)) 0))
    (say 53 (== (vecLen (lspRepairWiden (lex "()") (Some 0) vecNew)) 0))
    (say 54 (> (vecLen (lspRepairWiden (lex "((x))") (Some 1) vecNew)) 0))
    (say 55 (== (vecLen (lspRecoverStrings "x" (lex "x") 0)) (vecLen (lex "x"))))
    (say 56 (== (vecLen (lspRecoverStrings "\"x" (lex "\"x") 0)) (vecLen (lex "\"x"))))
    (say 57 (isSome (lspAxqlLitAt "(axqSql \"SELECT 1\")" (at "(axqSql \"SELECT 1\")" "SELECT"))))
    (say 58
      (isSome (lspAxqlLitAt "(axqExec db \"SELECT 1\")" (at "(axqExec db \"SELECT 1\")" "SELECT"))))
    (say 59 (isNone (lspAxqlLitAt "(axqExec \"SELECT 1\")" (at "(axqExec \"SELECT 1\")" "SELECT"))))
    (say 60 (isNone (lspAxqlLitAt "(other \"SELECT 1\")" (at "(other \"SELECT 1\")" "SELECT"))))
    (say 61 (isNone (lspAxqlLitAt "(axqSql \"SELECT 1\")" (at "(axqSql \"SELECT 1\")" "axqSql"))))
    (say 62 (isNone (lspAxqlLitAt "\"SELECT 1\"" (at "\"SELECT 1\"" "SELECT"))))
    (say 63
      (isSome
        (lspAxqlLitAt "(Axql::axqSql \"SELECT 1\")" (at "(Axql::axqSql \"SELECT 1\")" "SELECT"))))
    0
  })
