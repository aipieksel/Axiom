(import core)
(import lexer)
(import parser)
(import lsp)
(import replcomp)
(import typecheck)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: same (-> (Option ASTNode) ASTNode Bool))
(fn (same found expected)
  (match found
    ((None) false)
    ((Some node) (nodeSame node expected))))

(:: fnNode (-> String Int ASTNode))
(fn (fnNode name span)
  (mkDFnAt name vecNew (mkEInt 1) span))

(:: sigNode (-> String Int ASTNode))
(fn (sigNode name span)
  (setNodeTyChild (mkDSigAt name vecNew span) mkIntTy))

(:: foreign (-> ASTNode String ASTNode))
(fn (foreign node module)
  {
    (writeNodeText node 8 module)
    node
  })

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireFound (-> Nodes ()))
(fn (retireFound declarations)
  {
    (let found (lspFindDecl declarations "same" (- (vecLen declarations) 1)))
    (isSome found)
    ()
  })

(:: escapeFound (Option ASTNode))
(fn (escapeFound)
  (lspFindDecl (vecPush vecNew (fnNode "escaped" (mkSpan 0 7))) "escaped" 0))

(:: parse (-> String Nodes))
(fn (parse source)
  (match (parseModule (lex source))
    ((ParseFailed error) __indexTrap)
    ((ParseSuccess declarations after) declarations)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (isNone (lspFindDecl vecNew "missing" -1)))
    (say 2 (isNone (lspFindImported vecNew "missing" -1)))
    (say 3 (isNone (lspFindSig vecNew "missing" -1)))
    (say 4 (isNone (lspFindImportedSig vecNew "missing" -1)))
    (say 5 (isNone (lspFindFn vecNew "missing" -1)))
    (say 6 (isNone (lspFindImportedFn vecNew "missing" -1)))
    (let first (fnNode "same" (mkSpan 0 4)))
    (let last (fnNode "same" (mkSpan 8 12)))
    (let noSpan (fnNode "same" 0))
    (let sig (sigNode "same" (mkSpan 14 18)))
    (let data (nodeBuildDData "same" vecNew 0 (mkSpan 20 24)))
    (let pair (vecPush (vecPush vecNew first) last))
    (say 7 (same (lspFindDecl pair "same" 1) last))
    (say 8 (same (lspFindDecl (vecPush pair noSpan) "same" 2) last))
    (say 9 (same (lspFindDecl (vecPush pair sig) "same" 2) last))
    (say 10 (same (lspFindDecl (vecPush vecNew data) "same" 0) data))
    (let qualified (fnNode "Peer$same" (mkSpan 0 4)))
    (say 11 (isNone (lspFindDecl (vecPush vecNew qualified) "same" 0)))
    (let impFirst (foreign (fnNode "Peer$same" (mkSpan 0 4)) "Peer"))
    (let impLast (foreign (fnNode "Other$same" (mkSpan 8 12)) "Other"))
    (let imported (vecPush (vecPush vecNew impFirst) impLast))
    (say 12 (same (lspFindImported imported "same" 1) impLast))
    (say 13 (isNone (lspFindImported pair "same" 1)))
    (say 14 (same (lspFindImported (vecPush vecNew impFirst) "same" 0) impFirst))
    (let emptyModule (foreign (fnNode "same" (mkSpan 0 4)) ""))
    (say 15 (same (lspFindImported (vecPush vecNew emptyModule) "same" 0) emptyModule))
    (let impNoSpan (foreign (fnNode "Last$same" 0) "Last"))
    (say 16 (same (lspFindImported (vecPush imported impNoSpan) "same" 2) impLast))
    (let sigLast (sigNode "same" (mkSpan 25 29)))
    (say 17 (same (lspFindSig (vecPush (vecPush vecNew sig) sigLast) "same" 1) sigLast))
    (say 18 (isNone (lspFindSig pair "same" 1)))
    (say 19 (same (lspFindSig (vecPush (vecPush vecNew sig) (sigNode "same" 0)) "same" 1) sig))
    (let poison mkTErr)
    (let poisonSig (setNodeTyChild (sigNode "poison" (mkSpan 0 6)) poison))
    (say 20 (same (lspFindSig (vecPush vecNew poisonSig) "poison" 0) poisonSig))
    (let qualifiedSig (sigNode "Peer$same" (mkSpan 0 4)))
    (say 21 (isNone (lspFindSig (vecPush vecNew qualifiedSig) "same" 0)))
    (let impSig (foreign qualifiedSig "Peer"))
    (let impSigLast (foreign (sigNode "Other$same" (mkSpan 6 10)) "Other"))
    (say 22
      (same (lspFindImportedSig (vecPush (vecPush vecNew impSig) impSigLast) "same" 1) impSigLast))
    (say 23 (isNone (lspFindImportedSig (vecPush vecNew sig) "same" 0)))
    (say 24 (same (lspFindImportedSig (vecPush vecNew impSig) "same" 0) impSig))
    (let emptyModuleSig (foreign (sigNode "same" (mkSpan 0 4)) ""))
    (say 25 (same (lspFindImportedSig (vecPush vecNew emptyModuleSig) "same" 0) emptyModuleSig))
    (say 26 (same (lspFindFn pair "same" 1) last))
    (say 27 (same (lspFindFn (vecPush (vecPush (vecPush vecNew first) data) sig) "same" 2) first))
    (say 28 (same (lspFindFn (vecPush pair noSpan) "same" 2) last))
    (say 29 (same (lspFindFn (vecPush vecNew qualified) "Peer$same" 0) qualified))
    (say 30 (same (lspFindImportedFn imported "same" 1) impLast))
    (say 31 (isNone (lspFindImportedFn pair "same" 1)))
    (say 32 (same (lspFindImportedFn (vecPush imported (foreign data "Peer")) "same" 2) impLast))
    (say 33 (same (lspFindDecl pair "same" 0) first))
    (say 34 (isNone (lspFindDecl pair "same" -1)))
    (let emptyName (fnNode "" (mkSpan 0 1)))
    (say 35 (same (lspFindDecl (vecPush vecNew emptyName) "" 0) emptyName))
    (let before (count last))
    (retireFound pair)
    (say 36 (== (count last) before))
    (let held (lspFindDecl pair "same" 1))
    (say 37 (== (count last) (+ before 1)))
    (let escaped escapeFound)
    (for i in 0..16
      (strDup "lookup result owns its declaration"))
    (say 38
      (match escaped
        ((None) false)
        ((Some node) (strEq (nodeAName node) "escaped"))))
    (say 39
      (match (lspFindSig (vecPush vecNew poisonSig) "poison" 0)
        ((None) false)
        ((Some node) (nodeSame (nodeTyChild node) poison))))
    (let src ";; signature docs\n(:: same Int)\n(fn (same) 1)")
    (let declarations (parse src))
    (let declaration (vecGet declarations 1))
    (say 40 (strEq (replComplSigOf src declarations declaration) "Int"))
    (say 41 (strEq (replComplSigOf src vecNew declaration) ""))
    (say 42 (strEq (replComplSigOf src declarations (vecGet declarations 0)) "Int"))
    (say 43 (same (lspFindImportedFn (vecPush imported impNoSpan) "same" 2) impLast))
    (let impSigNoSpan (foreign (sigNode "Last$same" 0) "Last"))
    (say 44
      (same (lspFindImportedSig (vecPush (vecPush vecNew impSig) impSigNoSpan) "same" 1) impSig))
    0
  })
