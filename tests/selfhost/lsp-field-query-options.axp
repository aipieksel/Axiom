(import core)
(import lexer)
(import parser)
(import lsp)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: same (-> (Option ASTNode) ASTNode Bool))
(fn (same found expected)
  (match found
    ((None) false)
    ((Some node) (nodeSame node expected))))

(:: index (-> (Option Int) Int Bool))
(fn (index found expected)
  (match found
    ((None) false)
    ((Some actual) (== actual expected))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: stampModule (-> ASTNode String ASTNode))
(fn (stampModule node module)
  {
    (writeNodeText node 8 module)
    node
  })

(:: retireFound (-> Nodes ()))
(fn (retireFound fields)
  {
    (let found (lspStructFieldNode fields "item" 0))
    (isSome found)
    ()
  })

(:: escapeFound (Option ASTNode))
(fn (escapeFound)
  (lspStructFieldNode
    (vecPush vecNew (nodeBuildFieldType (strDup "escaped") mkTErr 0 (mkSpan 0 7))) "escaped" 0))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (isNone (lspSpineHead nilNode)))
    (let head (mkEVarAt "Box" (mkSpan 0 3)))
    (say 2 (same (lspSpineHead head) head))
    (say 3 (same (lspSpineHead (mkEApp head (mkEInt 1))) head))
    (let poison mkTErr)
    (say 4 (same (lspSpineHead poison) poison))
    (say 5 (isNone (lspStructFieldNode vecNew "item" 0)))
    (let first (setNodeTyChild (nodeBuildFieldType "item" poison 0 (mkSpan 0 4)) poison))
    (let last (nodeBuildFieldType "item" mkIntTy 0 (mkSpan 8 12)))
    (let fields (vecPush (vecPush vecNew first) last))
    (say 6 (same (lspStructFieldNode fields "item" 0) first))
    (say 7 (same (lspStructFieldNode fields "item" 1) last))
    (say 8 (isNone (lspStructFieldNode fields "absent" 0)))
    (say 9 (isNone (lspStructFieldNode fields "item" 2)))
    (say 10 (same (lspFieldNodeAt fields "item" 0 0) first))
    (say 11 (same (lspFieldNodeAt fields "item" 9 0) last))
    (say 12 (isNone (lspFieldNodeAt fields "item" 20 0)))
    (say 13 (isNone (lspFieldNodeAt fields "absent" 1 0)))
    (let structure (nodeBuildDStruct "Box" fields vecNew (mkSpan 0 3)))
    (let newer (nodeBuildDStruct "Box" fields vecNew (mkSpan 8 11)))
    (let noSpan (nodeBuildDStruct "Box" fields vecNew 0))
    (let structs (vecPush (vecPush vecNew structure) newer))
    (say 14 (same (lspFindTypeDecl structs "Box" 1) newer))
    (say 15 (same (lspFindTypeDecl (vecPush structs noSpan) "Box" 2) newer))
    (say 16 (isNone (lspFindTypeDecl structs "absent" 1)))
    (say 17 (isNone (lspFindTypeDecl structs "Box" -1)))
    (say 18 (same (lspFindStructField structs "Box" "item") newer))
    (say 19 (isNone (lspFindStructField structs "Box" "absent")))
    (say 20 (isNone (lspFindStructField structs "absent" "item")))
    (let imported (stampModule (nodeBuildDStruct "Box" fields vecNew (mkSpan 16 19)) ""))
    (say 21 (same (lspFindTypeImported (vecPush structs imported) "Box" 3) imported))
    (say 22 (isNone (lspFindTypeImported structs "Box" 1)))
    (let ctorFirst (nodeBuildCtor "Make" 0 vecNew (mkSpan 0 4)))
    (let ctorLast (nodeBuildCtor "Make" 0 vecNew (mkSpan 8 12)))
    (let ctors (vecPush (vecPush vecNew ctorFirst) ctorLast))
    (say 23 (index (lspCtorIndex ctors "Make" 0) 0))
    (say 24 (index (lspCtorIndex ctors "Make" 1) 1))
    (say 25 (isNone (lspCtorIndex ctors "absent" 0)))
    (say 26 (isNone (lspCtorIndex ctors "Make" 2)))
    (say 27 (same (lspViewCtorIn ctors "Make") ctorFirst))
    (say 28 (isNone (lspViewCtorIn ctors "absent")))
    (let dataFirst (nodeBuildDData "First" ctors 0 (mkSpan 0 5)))
    (let dataLast (nodeBuildDData "Last" (vecPush vecNew ctorLast) 0 (mkSpan 8 12)))
    (let declarations (vecPush (vecPush vecNew dataFirst) dataLast))
    (say 29 (same (lspFindCtorData declarations "Make" 1) dataLast))
    (say 30 (same (lspViewFindCtor declarations "Make" 0) ctorFirst))
    (say 31 (isNone (lspViewFindCtor declarations "Make" 1)))
    (say 32 (same (lspCtorNodeOf (Some dataFirst) "Make") ctorFirst))
    (say 33 (isNone (lspCtorNodeOf None "Make")))
    (say 34 (isNone (lspCtorNodeOf (Some dataFirst) "absent")))
    (let hidden
      (nodeBuildDData "Hidden" (vecPush vecNew (nodeBuildCtor "Make" 0 vecNew 0)) 0 (mkSpan 20 26)))
    (say 35 (isNone (lspCtorNodeOf (Some hidden) "Make")))
    (say 36
      (same (lspFindCtorData (vecPush declarations (nodeBuildDData "NoSpan" ctors 0 0)) "Make" 2)
        dataLast))
    (let importedData (stampModule (nodeBuildDData "Peer" ctors 0 (mkSpan 20 24)) "Peer"))
    (say 37
      (same (lspFindCtorDataImported (vecPush declarations importedData) "Make" 3) importedData))
    (say 38 (isNone (lspFindCtorDataImported declarations "Make" 1)))
    (say 39 (same (lspViewFindCtor (vecPush declarations importedData) "Make" 1) ctorFirst))
    (say 40 (isNone (lspFindStructField declarations "First" "item")))
    (say 41 (strEq (lspFieldEffectsSaid None) ""))
    (say 42 (strEq (lspFieldEffectsSaid (Some first)) ""))
    (let before (count first))
    (retireFound fields)
    (say 43 (== (count first) before))
    (let held (lspStructFieldNode fields "item" 0))
    (say 44 (== (count first) (+ before 1)))
    (let escaped escapeFound)
    (for i in 0..16
      (strDup "owning query result"))
    (say 45
      (match escaped
        ((None) false)
        ((Some node) (strEq (nodeAName node) "escaped"))))
    (say 46
      (match (lspStructFieldNode fields "item" 0)
        ((None) false)
        ((Some node) (nodeSame (nodeTyChild node) poison))))
    (say 47 (isNone (lspFindCtorData vecNew "Make" -1)))
    (say 48 (isNone (lspViewFindCtor vecNew "Make" 0)))
    (say 49 (lspFixDeclNames dataFirst "Make"))
    (say 50 (! (lspFixDeclNames dataFirst "absent")))
    (let unit (mkEUnitAt 0))
    (say 51 (same (lspSpineHead unit) unit))
    (say 52 (isNone (lspSpineHead (mkEApp nilNode (mkEInt 1)))))
    (let emptyField (nodeBuildFieldType "" poison 0 0))
    (say 53 (same (lspStructFieldNode (vecPush vecNew emptyField) "" 0) emptyField))
    (let emptyStruct (nodeBuildDStruct "Empty" vecNew vecNew (mkSpan 0 5)))
    (say 54 (same (lspFindTypeDecl (vecPush vecNew emptyStruct) "Empty" 0) emptyStruct))
    (say 55 (isNone (lspFindStructField (vecPush vecNew emptyStruct) "Empty" "missing")))
    (say 56 (index (lspCtorIndex (vecPush vecNew (nodeBuildCtor "" 0 vecNew 0)) "" 0) 0))
    (let spanlessCtor (vecGet (nodeBChildren hidden) 0))
    (say 57 (same (lspViewCtorIn (nodeBChildren hidden) "Make") spanlessCtor))
    (let emptyTags (nodeBuildFieldType "tags" mkIntTy 0 (mkSpan 0 4)))
    (writeNodeAxtags emptyTags (:: vecNew Axtags))
    (say 58
      (match (nodeAxtagsOpt emptyTags)
        ((None) false)
        ((Some tags) (&& (== (vecLen tags) 0) (strEq (lspFieldEffectsSaid (Some emptyTags)) "")))))
    0
  })
