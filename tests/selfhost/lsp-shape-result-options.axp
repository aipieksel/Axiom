(import core)
(import parser)
(import lexer)
(import typecheck)
(import lsp)
(import Vec)
(import IO)
(import Str)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say i good)
  (println "{i} {good}"))

(:: same (-> (Option ASTNode) ASTNode Bool))
(fn (same result expected)
  (match result
    ((None) false)
    ((Some value) (nodeSame value expected))))

(:: shape (-> (Option ASTNode) String Bool))
(fn (shape result expected)
  (match result
    ((None) false)
    ((Some value) (strEq (tyRender value) expected))))

(:: index (-> (Option Int) Int Bool))
(fn (index result expected)
  (match result
    ((None) false)
    ((Some value) (== value expected))))

(:: parsed (-> String Nodes))
(fn (parsed source)
  (match (parseModule (lex source))
    ((ParseFailed _) __indexTrap)
    ((ParseSuccess declarations _) declarations)))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: retireBinding (-> ASTNode ()))
(fn (retireBinding value)
  {
    (let pairs (vecPush vecNew (TypeBinding :name "a" :ty value)))
    (let result (lspShapeBindGet pairs "a"))
    (isSome result)
    ()
  })

(:: escapedBinding (Option ASTNode))
(fn (escapedBinding)
  (lspShapeBindGet (vecPush vecNew (TypeBinding :name "a" :ty (mkTVar "alive"))) "a"))

(:: exprShape (-> String String (Option ASTNode)))
(fn (exprShape source owner)
  {
    (let decls (parsed source))
    (match (lspFindFn decls owner (- (vecLen decls) 1))
      ((None) __indexTrap)
      ((Some decl) (lspShapeOf decls (lspNavOccurrences source decls) (nodeCChild decl) 16)))
  })

(:: fieldOf (-> String ASTNode ASTNode))
(fn (fieldOf name ty)
  {
    (let field (nodeBuildFieldFlagsPlain name 0 0))
    (setNodeTyChild field ty)
    field
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let int mkIntTy)
    (let text mkStringTy)
    (let poison mkTErr)
    (let unit mkUnitTy)
    (let arrow (mkTArr int (mkTArr text unit)))
    (say 1 (same (lspShapeApplyArrow int 0) int))
    (say 2 (isNone (lspShapeApplyArrow int 1)))
    (say 3 (isNone (lspShapeApplyArrow nilNode 0)))
    (say 4 (isNone (lspShapeApplyArrow poison 0)))
    (say 5 (shape (lspShapeApplyArrow arrow 1) "(String -> ())"))
    (say 6 (same (lspShapeApplyArrow arrow 2) unit))
    (say 7 (isNone (lspShapeApplyArrow arrow 3)))
    (say 8 (shape (lspShapeBuiltinTy "+" 2) "Int"))
    (say 9 (shape (lspShapeBuiltinTy "==" 2) "Bool"))
    (say 10 (shape (lspShapeBuiltinTy "&&" 2) "Bool"))
    (say 11 (isNone (lspShapeBuiltinTy "missing" 0)))
    (say 12 (isNone (lspShapeBuiltinTy "+" 3)))
    (let params (vecPush (vecPush vecNew "a") "b"))
    (say 13 (index (lspShapeParamAt params "a" 0) 0))
    (say 14 (index (lspShapeParamAt params "b" 0) 1))
    (say 15 (isNone (lspShapeParamAt params "z" 0)))
    (say 16 (isNone (lspShapeParamAt params "a" 2)))
    (say 17 (isNone (lspShapeParamAt params "a" -1)))
    (say 18 (index (lspShapeParamAt (vecPush vecNew "") "" 0) 0))
    (let pairs
      (vecPush (vecPush vecNew (TypeBinding :name "a" :ty int)) (TypeBinding :name "a" :ty text)))
    (say 19 (same (lspShapeBindGet pairs "a") int))
    (say 20 (same (lspShapeBindGetIn pairs "a" 1) text))
    (say 21 (isNone (lspShapeBindGet pairs "z")))
    (say 22 (isNone (lspShapeBindGetIn pairs "a" -1)))
    (say 23 (same (lspShapeBindGet (vecPush vecNew (TypeBinding :name "" :ty unit)) "") unit))
    (say 24 (same (lspShapeBindGet (vecPush vecNew (TypeBinding :name "a" :ty poison)) "a") poison))
    (say 25 (isNone (lspShapeBindGet (vecPush vecNew (TypeBinding :name "a" :ty nilNode)) "a")))
    (let bindings (:: vecNew TypeEnv))
    (say 26 (== (lspShapeBind (mkTVar "a") None params bindings) 1))
    (say 27 (== (vecLen bindings) 0))
    (say 28 (== (lspShapeBind (mkTVar "a") (Some int) params bindings) 1))
    (say 29 (same (lspShapeBindGet bindings "a") int))
    (say 30 (== (lspShapeBind (mkTVar "a") (Some text) params bindings) 0))
    (say 31 (== (lspShapeBind (mkTVar "z") (Some int) params bindings) 1))
    (say 32 (== (lspShapeBind poison (Some int) params bindings) 0))
    (say 33 (== (lspShapeBind (mkTVar "b") (Some poison) params bindings) 1))
    (say 34 (isNone (lspShapeBindGet bindings "b")))
    (say 35 (shape (lspShapeConBuild "" vecNew vecNew 0 vecNew) ""))
    (say 36 (isNone (lspShapeConBuild "Pair" params bindings 0 vecNew)))
    (say 37 (shape (lspShapeConBuild "One" (vecPush vecNew "a") bindings 0 vecNew) "One Int"))
    (say 38 (isNone (lspShapeCon vecNew vecNew "One" params (vecPush vecNew int) vecNew 16)))
    (say 39 (shape (lspShapeCon vecNew vecNew "Empty" vecNew vecNew vecNew 16) "Empty"))
    (let var (mkTVar "a"))
    (let arguments (vecPush (vecPush vecNew text) unit))
    (say 40 (same (lspShapeSubst var params arguments) text))
    (let unbound (mkTVar "z"))
    (say 41 (same (lspShapeSubst unbound params arguments) unbound))
    (say 42 (same (lspShapeSubst poison params arguments) poison))
    (say 43 (same (lspShapeSubst unit params arguments) unit))
    (say 44 (isNone (lspShapeSubst nilNode params arguments)))
    (say 45 (isNone (lspShapeSubst var params vecNew)))
    (say 46 (isNone (lspShapeSubst var params (vecPush vecNew nilNode))))
    (say 47 (shape (lspShapeSubst (mkTArr var (mkTVar "b")) params arguments) "(String -> ())"))
    (say 48
      (shape (lspShapeSubst (mkTCon "Box" (vecPush vecNew var)) params arguments) "Box String"))
    (say 49 (isNone (lspShapeSubst (mkTArr nilNode int) params arguments)))
    (say 50 (isNone (lspShapeSubstVec (vecPush vecNew nilNode) params arguments 0 vecNew)))
    (say 51
      (match (lspShapeSubstVec vecNew params arguments 0 vecNew)
        ((None) false)
        ((Some xs) (== (vecLen xs) 0))))
    (say 52 (same (lspShapeJoin (Some int) (Some mkIntTy)) int))
    (say 53 (isNone (lspShapeJoin (Some int) (Some text))))
    (say 54 (isNone (lspShapeJoin None (Some int))))
    (say 55 (isNone (lspShapeJoin (Some int) None)))
    (say 56 (isNone (lspShapeJoin (Some poison) (Some poison))))
    (say 57 (same (lspShapeJoin (Some unit) (Some unit)) unit))
    (say 58 (isNone (lspShapeOf vecNew vecNew nilNode 16)))
    (say 59 (shape (lspShapeOf vecNew vecNew (mkEUnitAt 0) 16) "()"))
    (say 60 (shape (lspShapeOf vecNew vecNew (mkEInt 0) 16) "Int"))
    (say 61 (shape (lspShapeOf vecNew vecNew (mkEVar "true") 16) "Bool"))
    (say 62 (isNone (lspShapeOf vecNew vecNew (mkEVar "missing") 16)))
    (say 63 (isNone (lspShapeBegin vecNew vecNew vecNew 16)))
    (say 64
      (shape (lspShapeBegin vecNew vecNew (vecPush (vecPush vecNew (mkEInt 1)) (mkEUnitAt 0)) 16)
        "()"))
    (say 65 (shape (lspShapeOf vecNew vecNew (mkEIf (mkEInt 1) (mkEInt 2) (mkEInt 3)) 16) "Int"))
    (say 66 (isNone (lspShapeOf vecNew vecNew (mkEIf (mkEInt 1) (mkEInt 2) (mkEUnitAt 0)) 16)))
    (let arm (nodeBuildMArmPlain nilNode (mkEInt 3) 0))
    (say 67 (shape (lspShapeArmBody vecNew vecNew arm 16) "Int"))
    (say 68 (isNone (lspShapeArmBody vecNew vecNew nilNode 16)))
    (say 69 (isNone (lspShapeArmBody vecNew vecNew (mkEInt 1) 16)))
    (say 70 (isNone (lspShapeMatch vecNew vecNew vecNew 16)))
    (say 71 (shape (lspShapeMatch vecNew vecNew (vecPush (vecPush vecNew arm) arm) 16) "Int"))
    (say 72
      (isNone
        (lspShapeMatch vecNew vecNew
          (vecPush (vecPush vecNew arm) (nodeBuildMArmPlain nilNode (mkEUnitAt 0) 0)) 16)))
    (say 73
      (shape (lspShapeApp vecNew vecNew (mkEApp (mkEApp (mkEVar "+") (mkEInt 1)) (mkEInt 2)) 16)
        "Int"))
    (say 74 (isNone (lspShapeApp vecNew vecNew (mkEApp (mkEVar "Peer::f") (mkEInt 1)) 16)))
    (say 75 (isNone (lspShapeApp vecNew vecNew (mkEApp (mkEInt 1) (mkEInt 2)) 16)))
    (say 76 (shape (exprShape "(fn (f) { (let local 7) local })" "f") "Int"))
    (say 77 (shape (exprShape "(:: f (-> String String)) (fn (f value) value)" "f") "String"))
    (say 78 (shape (exprShape "(pub struct Box (value : Int)) (fn (f) (Box 3))" "f") "Box"))
    (say 79 (shape (exprShape "(pub struct Box (a) (value : a)) (fn (f) (Box 3))" "f") "Box Int"))
    (say 80
      (shape
        (exprShape "(pub struct Box (a) (value : a)) (fn (f) { (let box (Box 3)) box.value })" "f")
        "Int"))
    (say 81
      (shape (lspShapeCtorVar (parsed "(pub data Choice (Stop) (More Int))") "Stop") "Choice"))
    (say 82 (isNone (lspShapeCtorVar (parsed "(pub data Choice a (Stop) (More a))") "Stop")))
    (say 83 (isNone (lspShapeCtorVar (parsed "(pub data Choice (More Int))") "More")))
    (say 84 (isNone (lspShapeCtorVar vecNew "Missing")))
    (let held (mkTVar "owned"))
    (let before (count held))
    (retireBinding held)
    (say 85 (== before (count held)))
    (say 86 (shape escapedBinding "alive"))
    (say 87 (shape (lspShapeConBuild "Empty" vecNew vecNew 0 vecNew) "Empty"))
    (say 88 (isNone (lspShapeJoin (Some nilNode) (Some unit))))
    (say 89 (isNone (lspShapeApplyArrow (mkTArr int nilNode) 1)))
    (say 90 (isNone (lspShapeOf vecNew vecNew poison 16)))
    (say 91 (isNone (lspShapeSpine nilNode vecNew)))
    (say 92 (same (lspShapeSpine int vecNew) int))
    (let callee (mkEVar "call"))
    (let first (mkEInt 1))
    (let second (mkEInt 2))
    (let argumentsOut (:: vecNew Nodes))
    (say 93 (same (lspShapeSpine (mkEApp (mkEApp callee first) second) argumentsOut) callee))
    (say 94 (&& (== (vecLen argumentsOut) 2) (nodeSame (vecGet argumentsOut 0) first)))
    (say 95 (nodeSame (vecGet argumentsOut 1) second))
    (say 96
      (match (lspShapeFieldTys vecNew 0 vecNew)
        ((None) false)
        ((Some fields) (== (vecLen fields) 0))))
    (say 97
      (match (lspShapeFieldTys nilNodes 0 vecNew)
        ((None) false)
        ((Some fields) (== (vecLen fields) 0))))
    (let missingField (fieldOf "v" nilNode))
    (say 98 (isNone (lspShapeFieldTys (vecPush vecNew missingField) 0 vecNew)))
    (let poisonedField (fieldOf "v" poison))
    (say 99
      (match (lspShapeFieldTys (vecPush vecNew poisonedField) 0 vecNew)
        ((None) false)
        ((Some fields) (nodeSame (vecGet fields 0) poison))))
    (let ordinaryField (fieldOf "v" int))
    (say 100
      (match (lspShapeFieldTys (vecPush vecNew ordinaryField) 0 vecNew)
        ((None) false)
        ((Some fields) (nodeSame (vecGet fields 0) int))))
    (say 101 (isNone (lspShapeApp vecNew vecNew (mkEApp nilNode (mkEInt 1)) 16)))
    (let wildcard (mkTVar "_"))
    (say 102 (same (lspShapeSubst wildcard params arguments) wildcard))
    (say 103 (== (lspShapeBind int None params vecNew) 1))
    (say 104 (== (lspShapeBind int (Some nilNode) params vecNew) 1))
    (let broken (nodeBuildDStruct "Broken" (vecPush vecNew missingField) vecNew (mkSpan 0 1)))
    (say 105
      (isNone
        (lspShapeUpCon (vecPush vecNew broken) vecNew "Broken" (vecPush vecNew (mkEInt 1)) 16)))
    (say 106 (isNone (lspShapeSpine (mkEApp nilNode (mkEInt 1)) vecNew)))
    (say 107 (index (lspShapeBuiltinRes "+") 1))
    (say 108 (index (lspShapeBuiltinRes "<") 2))
    (say 109 (index (lspShapeBuiltinRes "!") 3))
    (say 110 (isNone (lspShapeBuiltinRes "missing")))
    (say 111 (isNone (lspShapeBuiltinRes "")))
    0
  })
