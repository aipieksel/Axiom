(import core)
(import lexer)
(import parser)
(import lsp)
(import Cereal)
(import Vec)
(import Str)
(import IO)

(:: parsed (-> String Nodes))
(fn (parsed source)
  (match (parseModule (lex source))
    ((ParseFailed _) __indexTrap)
    ((ParseSuccess nodes _) nodes)))

(:: at (-> String String Int))
(fn (at source needle)
  (match (strFind source needle 0)
    ((None) __indexTrap)
    ((Some offset) offset)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: indexIs (-> (Option Int) (Option Int) Bool))
(fn (indexIs actual expected)
  (match expected
    ((None) (isNone actual))
    ((Some wanted)
      (match actual
        ((None) false)
        ((Some got) (== got wanted)))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let kids (vecPush (vecPush (vecPush (vecPush vecNew 1) 4) 5) 9))
    (let blockChain (vecPush (vecPush (vecPush (vecPush vecNew 0) 0) 1) 4))
    (let nestedChain (vecPush (vecPush (vecPush (vecPush blockChain 1) 0) 2) 3))
    (let macroSource "(macro (identity value) value)\n(fn (use) 1)")
    (let macroDecls (parsed macroSource))
    (let importSource "(import B)\n(import A)\n")
    (let chunks (:: vecNew (Vec LspImportChunk)))
    (let sorted (:: vecNew (Vec LspImportChunk)))
    (say 1 (indexIs (lspViewCallAt "" 0) None))
    (say 2 (indexIs (lspViewCallAt "x" 0) None))
    (say 3 (indexIs (lspViewCallAt "(f)" 0) (Some 0)))
    (say 4 (indexIs (lspViewCallAt "(f)" 1) (Some 0)))
    (say 5 (indexIs (lspViewCallAt "(f (g x))" 7) (Some 3)))
    (say 6 (indexIs (lspViewCallAt "(f)" 3) None))
    (say 7 (indexIs (lspViewCallAt "x" -1) None))
    (say 8 (indexIs (lspViewCallAt "x" 2) None))
    (say 9 (indexIs (lspViewCallAt "(f" 2) (Some 0)))
    (say 10 (indexIs (lspHeaderOpen "(f)" 1) (Some 0)))
    (say 11 (indexIs (lspHeaderOpen "(  f)" 3) (Some 0)))
    (say 12 (indexIs (lspHeaderOpen "f" 0) None))
    (say 13 (indexIs (lspHeaderOpen "(fn f 1)" 4) None))
    (say 14 (indexIs (lspHeaderOpen "" 0) None))
    (say 15 (indexIs (lspHeaderOpen "(f)" -1) None))
    (say 16 (indexIs (lspHeaderOpen "(f)" 4) None))
    (say 17 (indexIs (lspHeaderOpen "  (f)" 3) (Some 2)))
    (say 18 (indexIs (lspHeaderOpen "(" 1) (Some 0)))
    (say 19 (indexIs (lspFixLastColons "::a" 1) (Some 0)))
    (say 20 (indexIs (lspFixLastColons "a::b::c" 5) (Some 4)))
    (say 21 (indexIs (lspFixLastColons "a::b" 2) (Some 1)))
    (say 22 (indexIs (lspFixLastColons "abc" 1) None))
    (say 23 (indexIs (lspFixLastColons "" -2) None))
    (say 24 (indexIs (lspFixLastColons ":" -1) None))
    (say 25 (indexIs (lspFixLastColons "::" 2) None))
    (say 26 (indexIs (lspFixLastColons "::" 0) (Some 0)))
    (say 27 (indexIs (lspFixKidHolding kids 1 4 0) (Some 0)))
    (say 28 (indexIs (lspFixKidHolding kids 2 3 0) (Some 0)))
    (say 29 (indexIs (lspFixKidHolding kids 5 9 0) (Some 1)))
    (say 30 (indexIs (lspFixKidHolding kids 2 8 0) None))
    (say 31 (indexIs (lspFixKidHolding kids 0 1 0) None))
    (say 32 (indexIs (lspFixKidHolding kids 1 4 1) None))
    (say 33 (indexIs (lspFixKidHolding kids 5 9 1) (Some 1)))
    (say 34 (indexIs (lspFixKidHolding kids 1 4 -1) None))
    (say 35 (indexIs (lspFixKidHolding vecNew 0 0 0) None))
    (say 36 (indexIs (lspFixKidHolding (vecPush vecNew 1) 1 1 0) None))
    (say 37 (indexIs (lspFixStatementAt "{x}" blockChain) (Some 0)))
    (say 38 (indexIs (lspFixStatementAt "{{x}}" nestedChain) (Some 1)))
    (say 39 (indexIs (lspFixStatementAt "(x)" blockChain) None))
    (say 40 (indexIs (lspFixStatementAt "" vecNew) None))
    (say 41 (indexIs (lspFixStatementAt "" blockChain) None))
    (say 42 (indexIs (lspFixStatementAt "{" (vecPush vecNew 0)) None))
    (say 43 (indexIs (lspOrganizeStart "(import A)" 0) (Some 0)))
    (say 44 (indexIs (lspOrganizeStart "  (import A)" 2) (Some 0)))
    (say 45 (indexIs (lspOrganizeStart "x(import A)" 1) None))
    (say 46 (indexIs (lspOrganizeStart ";;; docs\n(import A)" 9) (Some 0)))
    (say 47 (indexIs (lspOrganizeStart ";;! module\n(import A)" 11) (Some 11)))
    (say 48 (indexIs (lspOrganizeStart "" 0) None))
    (say 49 (indexIs (lspOrganizeStart "(import A)" -1) None))
    (say 50 (indexIs (lspOrganizeStart "(import A)" 10) None))
    (say 51 (indexIs (lspOrganizeEnd "(import A)" 10) (Some 10)))
    (say 52 (indexIs (lspOrganizeEnd "(import A)\n" 10) (Some 10)))
    (say 53 (indexIs (lspOrganizeEnd "(import A)\r\n" 10) (Some 10)))
    (say 54 (indexIs (lspOrganizeEnd "(import A) ; tail" 10) (Some 17)))
    (say 55 (indexIs (lspOrganizeEnd "(import A) extra" 10) None))
    (say 56 (indexIs (lspOrganizeEnd "" 0) (Some 0)))
    (say 57 (indexIs (lspOrganizeEnd "x" -1) None))
    (say 58 (indexIs (lspOrganizeEnd "x" 2) None))
    (say 59 (indexIs (lspMacroSiteAt macroSource macroDecls 0) (Some 0)))
    (say 60 (indexIs (lspMacroSiteAt macroSource macroDecls (at macroSource "identity")) (Some 0)))
    (say 61 (indexIs (lspMacroSiteAt macroSource macroDecls (at macroSource "use")) None))
    (say 62 (indexIs (lspMacroSiteAt macroSource macroDecls (strLen macroSource)) None))
    (say 63 (indexIs (lspMacroSiteAt "" vecNew 0) None))
    (say 64 (indexIs (lspHlChainEnd "A::b" 0 4) (Some 4)))
    (say 65 (indexIs (lspHlChainEnd "A.B::c.d" 0 8) (Some 8)))
    (say 66 (indexIs (lspHlChainEnd "a.b" 0 3) None))
    (say 67 (indexIs (lspHlChainEnd "abc" 0 3) None))
    (say 68 (indexIs (lspHlChainEnd "A::b rest" 0 9) (Some 4)))
    (say 69 (indexIs (lspHlChainEnd "" 0 0) None))
    (say 70 (indexIs (lspHlChainEnd "A::b" -1 4) None))
    (say 71 (indexIs (lspHlChainEnd "A::b" 0 5) None))
    (say 72 (strEq (lspFixAfterColons "::a") "a"))
    (say 73 (strEq (lspFixAfterColons "A::b::c") "c"))
    (say 74 (strEq (lspFixAfterColons "abc") "abc"))
    (say 75 (strEq (lspFixAfterColons "") ""))
    (say 76 (lspFixDescend "(+ 1 2)" 0 7 3 4 vecNew))
    (say 77 (! (lspFixDescend "(+ 1 2)" 0 7 3 6 vecNew)))
    (say 78 (== (spanEnd (lspSymbolExtent "(fn (f p) p)" (mkSpan 5 6))) 12))
    (say 79 (== (lspSymbolExtent "  (fn (f p) p)" (mkSpan 7 8)) 0))
    (say 80 (== (spanStart (lspSymbolExtent "  (struct Box)" (mkSpan 10 13))) 2))
    (say 81
      (==
        (nodeTag
          (match (lspParamTypeAt "(:: f (-> Int Int))\n(fn (f p) p)"
                   (parsed "(:: f (-> Int Int))\n(fn (f p) p)") 26 "p")
            ((None) mkTErr)
            ((Some ty) ty)))
        TAG_T_CON))
    (say 82 (isNone (lspParamTypeAt "(fn (f) 1)" (parsed "(fn (f) 1)") 5 "p")))
    (say 83 (isNone (lspParamTypeAt "(fn (f p) p)" (parsed "(fn (f p) p)") 10 "p")))
    (say 84
      (lspOrganizeCollect importSource (parsed importSource) (lex importSource) chunks sorted))
    (say 85 (== (vecLen chunks) 2))
    (say 86 (== (vecLen sorted) 2))
    (say 87 (! (lspOrganizeCollect importSource (parsed importSource) vecNew vecNew vecNew)))
    0
  })
