(import core)
(import lexer)
(import parser)
(import diag)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs result expected)
  (match result
    ((None) false)
    ((Some index) (== index expected))))

(:: absent (-> (Option Int) Bool))
(fn (absent result)
  (match result
    ((None) true)
    ((Some index) false)))

(:: openingSource (-> Int String))
(fn (openingSource count)
  {
    (let parts vecNew)
    (for i in 0..count
      (vecPush parts "("))
    (catStrs parts)
  })

(:: depthRefused Bool)
(fn (depthRefused)
  (match (parseModuleWith (lex (openingSource (+ parseMaxDepth 1))) vecNew)
    ((ParseFailed error) (&& (strEq error.code "AX2005") (== error.pos parseMaxDepth)))
    ((ParseSuccess nodes after) false)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (absent (externLibBadAt "")))
    (say 2 (absent (externLibBadAt "foo_12.bar+-")))
    (say 3 (indexIs (externLibBadAt "/bad") 0))
    (say 4 (indexIs (externLibBadAt "a/b") 1))
    (say 5 (indexIs (externLibBadAt "abc\n!") 3))
    (say 6 (indexIs (externLibBadAt "é") 0))
    (say 7 (indexIs (externLibBadAt "\0") 0))
    (let names (vecPush (vecPush (vecPush vecNew (mkEVar "x")) (mkEVar "y")) (mkEVar "x")))
    (say 8 (absent (namedFieldIndex vecNew "x")))
    (say 9 (indexIs (namedFieldIndex names "x") 0))
    (say 10 (indexIs (namedFieldIndex names "y") 1))
    (say 11 (absent (namedFieldIndex names "X")))
    (say 12 (absent (nestOverflowTok (lex "") 0)))
    (say 13 (indexIs (nestOverflowTok (lex "(") 0) 0))
    (say 14 (indexIs (nestOverflowTok (lex "((") 1) 1))
    (say 15 (absent (nestOverflowTok (lex "()") 1)))
    (say 16 (absent (nestOverflowTok (lex "){x}") 1)))
    (say 17 (indexIs (nestOverflowTok (lex ")((") 1) 2))
    (say 18 (absent (nestOverflowTok (lex "[]") 1)))
    (say 19 (indexIs (nestOverflowTok (lex "[{") 1) 1))
    (say 20 (absent (nestOverflowTok (lex "\"(\"") 0)))
    (say 21 (absent (nestOverflowTok (lex ";(\n") 0)))
    (say 22 (absent (nestOverflowTok (lex "([{}])") 3)))
    (say 23 (indexIs (nestOverflowTok (lex "([{") 2) 2))
    (say 24 (absent (nestOverflowTok (lex (openingSource parseMaxDepth)) parseMaxDepth)))
    (say 25
      (indexIs (nestOverflowTok (lex (openingSource (+ parseMaxDepth 1))) parseMaxDepth)
        parseMaxDepth))
    (say 26 depthRefused)
    (let plain "\"ab\"")
    (let valid "\"a\\nb\"")
    (let bad "\"a\\qb\"")
    (let doubled "\"a\\\\qb\"")
    (say 27 (absent (badEscapeIn plain 0 (strLen plain))))
    (say 28 (absent (badEscapeIn valid 0 (strLen valid))))
    (say 29 (indexIs (badEscapeIn bad 0 (strLen bad)) 2))
    (say 30 (absent (badEscapeIn doubled 0 (strLen doubled))))
    (let prefixed (concat "xx" bad))
    (say 31 (indexIs (badEscapeIn prefixed 2 (strLen prefixed)) 4))
    (let badTokens (lex bad))
    (say 32 (peekIs badTokens 0 TK_ERROR_ESC))
    (say 33 (== (spanStart (tokenSpan (vecGet badTokens 0))) 2))
    (say 34 (== (spanEnd (tokenSpan (vecGet badTokens 0))) 4))
    (say 35
      (match (lexErrDiag badTokens bad)
        ((None) false)
        ((Some error) (strEq (diagCode error) "AX1005"))))
    (say 36 (peekIs (lex valid) 0 TK_STRING))
    (say 37 (peekIs (lex doubled) 0 TK_STRING))
  })
