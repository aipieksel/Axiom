(import core)
(import lexer)
(import parser)
(import frontpack)
(import diag)
(import Vec)
(import IO)

(:: report (-> String ()))
;@axiom:effect(io)
(fn (report source)
  {
    (println "SOURCE {source}")
    (let tokens (lex source))
    (let result (parseModule tokens))
    (let ds vecNew)
    (match result
      ((ParseFailed error) (vecPush ds (parseErrDiag tokens result source)))
      ((ParseSuccess declarations after) ()))
    (writeStr stdout
      (renderDiagsUnits ds
        (vecPush vecNew
          (CUnit2 :file "typeparams.ax" :src source :name None :imports vecNew :library false))))
    (match (frontParse source)
      ((None) (println "NO_PACKET"))
      ((Some parsed) (println (frontEncode parsed))))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (report "(data Plain (Plain))")
    (report "(data Empty () (Empty))")
    (report "(data Pair a b (Pair a b))")
    (report "(struct Plain (value : Int))")
    (report "(struct Empty () (value : Int))")
    (report "(struct Box (a) (value : a))")
    (report "(data")
    (report "(data X (a) (Ctor a)")
    0
  })
