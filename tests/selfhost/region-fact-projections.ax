; expect 42
; Absent facts produce no keys; present zero facts remain a real answer.
(import typecheck)
(import symbols)
(import axir)
(import core)
(import Vec)
(import Str)

(:: main Int)
(fn (main)
  {
    (let entries (:: vecNew (Vec FnEnt)))
    (regFn entries "projection" mkIntTy)
    (let entry (vecGet entries 0))
    (let params (vecPush (vecPush vecNew "left") "right"))
    (let absent vecNew)
    (symMirMetas entry params 0 absent)
    (let absentGood (== (vecLen absent) 0))
    (let zero (rgnFactsNew 0))
    (let zeroGood (strEq (axirRegionLine zero 0) "region 0 - 0 0 0\n"))
    (let facts (rgnFactsNew 2))
    (set entry.rgn (Some facts))
    (let present vecNew)
    (symMirMetas entry params 0 present)
    (let presentGood (&& (== (vecLen present) 1) (strEq (vecGet present 0) "mir-params=2")))
    (rgnSetResultCUR facts)
    (rgnSetUnknown facts)
    (let annotated vecNew)
    (symMirMetas entry params 1 annotated)
    (let flagsGood
      (&& (== (vecLen annotated) 4)
        (&& (strEq (vecGet annotated 0) "mir-params=2")
          (&& (strEq (vecGet annotated 1) "mir-result-fresh")
            (&& (strEq (vecGet annotated 2) "mir-incomplete")
              (strEq (vecGet annotated 3) "mir-truncated"))))))
    (let rawGood (strEq (axirRegionLine facts 2) "region 0 0,0 0 1 1\n"))
    (set entry.rgn None)
    (symMirMetas entry params 0 annotated)
    (if (&& absentGood
          (&& zeroGood (&& presentGood (&& flagsGood (&& rawGood (== (vecLen annotated) 4))))))
      42
      1)
  })
