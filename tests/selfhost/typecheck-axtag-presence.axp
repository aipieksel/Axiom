; Tag presence, empty values and consumer policy remain separate facts.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import Str)
(import Vec)
(import IO)

(:: entry (-> String AxtagEnt))
(fn (entry text)
  (AxtagEnt :off 0 :content text))

(:: one (-> String Axtags))
(fn (one text)
  (vecPush vecNew (entry text)))

(:: two (-> String String Axtags))
(fn (two first second)
  (vecPush (one first) (entry second)))

(:: tagged (-> String Axtags ASTNode))
(fn (tagged name tags)
  {
    (let d (nodeBuildDSig name vecNew 0 0))
    (writeNodeAxtags d tags)
    d
  })

(:: stringIs (-> (Option String) String Bool))
(fn (stringIs value expected)
  (match value
    ((None) false)
    ((Some text) (strEq text expected))))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: context (-> String TC))
(fn (context source)
  (match (parseModuleWith (lex source) (scanAxtags source))
    ((ParseFailed error) __indexTrap)
    ((ParseSuccess declarations after)
      (tcNew declarations declarations
        (vecPush vecNew
          (CUnit2 :file "presence.ax" :src source :name None :imports vecNew :library false)))
    )))

(:: trapPolicy (-> Axtags Int))
(fn (trapPolicy tags)
  {
    (let tc (context "(effect Alarm (ring :: (-> Int Int)))"))
    (writeNodeAxtags (vecGet (tcEffectsVec tc) 0) tags)
    (effectDeclTraps tc "Alarm")
  })

(:: temporaryValue (Option String))
(fn (temporaryValue)
  (axtagValueOf (tagged "temp" (one (strDup "deprecated(dynamic text)"))) "deprecated"))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (isNone (axtagValueFrom vecNew "key" 0)))
    (say 2 (isNone (axtagValueFrom (one "other(value)") "key" 0)))
    (say 3 (stringIs (axtagValueFrom (one "key") "key" 0) ""))
    (say 4 (stringIs (axtagValueFrom (one "key()") "key" 0) ""))
    (say 5 (stringIs (axtagValueFrom (one "key(open") "key" 0) ""))
    (say 6 (stringIs (axtagValueFrom (one "key(use (f x))") "key" 0) "use (f x)"))
    (say 7 (stringIs (axtagValueFrom (two "key(first)" "key(second)") "key" 0) "first"))
    (say 8 (stringIs (axtagValueFrom (two "key()" "key(second)") "key" 0) ""))
    (say 9 (stringIs (axtagValueFrom (two "other()" "key(second)") "key" 0) "second"))
    (say 10 (stringIs (axtagValueFrom (two "key(first)" "key(second)") "key" 1) "second"))
    (say 11 (isNone (axtagValueFrom (one "key(value)") "key" 1)))
    (say 12 (isNone (axtagValueOf (nodeBuildDSig "absent" vecNew 0 0) "key")))
    (say 13 (stringIs (axtagValueOf (tagged "empty" (one "key()")) "key") ""))
    (say 14 (stringIs temporaryValue "dynamic text"))
    (say 15 (stringIs (axtagValueFrom (one "") "" 0) ""))
    (say 16 (isNone (axtagValueFrom (one "Key(value)") "key" 0)))
    (say 17 (stringIs (axtagValueFrom (one "key( value )") "key" 0) " value "))
    (say 18 (stringIs (axtagValueFrom (one "key(value) ignored") "key" 0) "value"))
    (let absent (tagged "empty" vecNew))
    (let empty (tagged "empty" (one "deprecated()")))
    (let first (tagged "old" (one "deprecated(use (f x))")))
    (let second (nodeBuildDFn "old" vecNew (mkEInt 0) 0))
    (writeNodeAxtags second (one "deprecated(second)"))
    (let nonfunction (mkEInt 0))
    (writeNodeAxtags nonfunction (one "deprecated(ignored)"))
    (let declarations
      (vecPush (vecPush (vecPush (vecPush (vecPush vecNew absent) empty) first) nonfunction)
        second))
    (let indexed (deprecatedBuild declarations vecNew 0))
    (say 19 (== (vecLen indexed) 2))
    (say 20 (nodeSame (vecGet indexed 0) first))
    (say 21 (nodeSame (vecGet indexed 1) second))
    (say 22 (== (vecLen (deprecatedBuild (vecPush vecNew empty) vecNew 0)) 0))
    (say 23 (isNone (deprecatedFrom vecNew "old" 0)))
    (say 24 (isNone (deprecatedFrom indexed "missing" 0)))
    (say 25 (stringIs (deprecatedFrom (vecPush vecNew absent) "empty" 0) ""))
    (say 26 (stringIs (deprecatedFrom (vecPush vecNew empty) "empty" 0) ""))
    (say 27 (stringIs (deprecatedFrom indexed "old" 0) "use (f x)"))
    (say 28
      (stringIs
        (deprecatedFrom
          (vecPush (vecPush vecNew absent) (tagged "empty" (one "deprecated(later)"))) "empty" 0)
        ""))
    (say 29 (stringIs (deprecatedFrom indexed "Team$old" 0) "use (f x)"))
    (say 30 (stringIs (deprecatedFrom indexed "old" 1) "second"))
    (say 31 (== (effectDeclTraps (tcNew vecNew vecNew vecNew) "missing") 0))
    (say 32 (== (trapPolicy vecNew) 0))
    (say 33 (== (trapPolicy (one "unhandled()")) 0))
    (say 34 (== (trapPolicy (one "unhandled(trap)")) 1))
    (say 35 (== (trapPolicy (one "unhandled(Trap)")) 0))
    (say 36 (== (trapPolicy (one "unhandled(trap )")) 0))
    (say 37 (== (trapPolicy (one "unhandled(trap")) 0))
    (say 38 (== (trapPolicy (two "unhandled()" "unhandled(trap)")) 0))
    (say 39 (== (trapPolicy (two "unhandled(trap)" "unhandled(abort)")) 1))
    (say 40 (== (trapPolicy (two "unhandled(abort)" "unhandled(trap)")) 0))
    (say 41 (== (trapPolicy (one "unhandled")) 0))
    (say 42 (== (trapPolicy (one "different(trap)")) 0))
  })
