; expect 42
; Borrow IDs and capture names are optional lookups. A present empty
; name stays Some, and origin scans retain first winner and start index.
(import core)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)

(:: captureStringIs (-> (Option String) String Bool))
(fn (captureStringIs value expected)
  (match value
    ((None) false)
    ((Some name) (strEq name expected))))

(:: borrowIdentifierChecks Bool)
(fn (borrowIdentifierChecks)
  {
    (let body (mkEInt 0))
    (let named (nodeBuildELam (vecPush vecNew "parallel$_scope") body 0 0))
    (let empty (nodeBuildELam (vecPush vecNew "parallel$_") body 0 0))
    (let ordinary (nodeBuildELam (vecPush vecNew "value") body 0 0))
    (let multiple (nodeBuildELam (vecPush (vecPush vecNew "parallel$_scope") "other") body 0 0))
    (&& (captureStringIs (capSpawnBorrowId named) "scope")
      (&& (captureStringIs (capSpawnBorrowId empty) "")
        (&& (isNone (capSpawnBorrowId ordinary)) (isNone (capSpawnBorrowId multiple)))))
  })

(:: captureOriginChecks Bool)
(fn (captureOriginChecks)
  {
    (let names (vecPush (vecPush (vecPush vecNew "first") "second") ""))
    (let origins (vecPush (vecPush (vecPush vecNew 1) 1) 2))
    (&& (isNone (rgnCaptureFrom vecNew vecNew 0 0))
      (&& (captureStringIs (rgnCaptureFrom names origins 0 0) "first")
        (&& (captureStringIs (rgnCaptureFrom names origins 0 1) "second")
          (&& (captureStringIs (rgnCaptureFrom names origins 1 0) "")
            (isNone (rgnCaptureFrom names origins 2 0))))))
  })

(:: captureContextChecks Bool)
(fn (captureContextChecks)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let declaration (nodeBuildDFn "metadata" vecNew (mkEInt 0) 0))
    (let lam (nodeBuildELam vecNew (mkEInt 0) 0 0))
    (if (let (Some entry) (findFnEnt tc "+"))
      {
        ; Metadata queries only: no traversal, region inference or escape pass.
        (let context (rgnCtxNew tc declaration entry 0))
        (vecPush context.capNames "first")
        (vecPush context.capOrigins 1)
        (vecPush context.capNames "")
        (vecPush context.capOrigins 2)
        (&& (isNone (rgnCaptureFor context nilNode 0))
          (&& (isNone (rgnCaptureFor context (mkEInt 1) 0))
            (&& (captureStringIs (rgnCaptureFor context lam 0) "first")
              (&& (captureStringIs (rgnCaptureFor context lam 1) "")
                (&& (isNone (rgnCaptureFor context lam 2))
                  (&& (capNotBorrowed tc None "value" mkStringTy 0)
                    (capNotBorrowed tc (Some "") "value" mkStringTy 0)))))))
      }
      false)
  })

(:: captureDedupChecks Bool)
(fn (captureDedupChecks)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let firstSpan (mkSpan 1 3))
    (let secondSpan (mkSpan 5 7))
    (let first (mkEVarAt "first" firstSpan))
    (let second (mkEVarAt "second" secondSpan))
    (vecPush (tcScopeVec tc) (SEnt :name "first" :mutable 0 :bsp 0 :ty mkStringTy :used 0))
    (vecPush (tcScopeVec tc) (SEnt :name "second" :mutable 0 :bsp 0 :ty mkStringTy :used 0))
    (let occurrences (vecPush (vecPush (vecPush vecNew first) first) second))
    (let seen vecNew)
    (capReport tc occurrences 0 seen)
    (if (&& (== (vecLen seen) 2) (== (countErrorDiags (tcOutVec tc)) 2))
      (&& (strEq (vecGet seen 0) "first")
        (&& (strEq (vecGet seen 1) "second")
          (&& (strEq (diagCode (vecGet (tcOutVec tc) 0)) "AX3064")
            (&& (== (diagSpan (vecGet (tcOutVec tc) 0)) firstSpan)
              (== (diagSpan (vecGet (tcOutVec tc) 1)) secondSpan)))))
      false)
  })

(:: captureShadowChecks Bool)
(fn (captureShadowChecks)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (vecPush (tcScopeVec tc) (SEnt :name "shared" :mutable 0 :bsp 0 :ty mkStringTy :used 0))
    (let occurrence (mkEVarAt "shared" (mkSpan 1 3)))
    (checkSpawnCaptures tc (nodeBuildELam (vecPush vecNew "shared") occurrence 0 0))
    (vecPush (tcScopeVec tc) (SEnt :name "shared" :mutable 0 :bsp 0 :ty mkIntTy :used 0))
    (let seen vecNew)
    (capReport tc (vecPush vecNew occurrence) 0 seen)
    (&& (== (vecLen seen) 0) (== (countErrorDiags (tcOutVec tc)) 0))
  })

(:: main Int)
(fn (main)
  (if (borrowIdentifierChecks)
    (if (captureOriginChecks)
      (if (captureContextChecks)
        (if (captureDedupChecks)
          (if (captureShadowChecks)
            42
            5)
          4)
        3)
      2)
    1))
