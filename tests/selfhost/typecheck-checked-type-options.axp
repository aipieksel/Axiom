(import core)
(import parser)
(import typecheck)
(import Vec)
(import Str)
(import IO)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: sameType (-> (Option ASTNode) ASTNode Bool))
(fn (sameType found wanted)
  (match found
    ((None) false)
    ((Some ty) (nodeSame ty wanted))))

(:: stamped (-> ASTNode ASTNode))
(fn (stamped ty)
  {
    (let expression (mkEInt 1))
    (setNodeBinderTyChild expression ty)
    expression
  })

(:: context (-> Int RgnCtx))
(fn (context report)
  {
    (let checker (tcNew vecNew vecNew vecNew))
    (let parameters (vecPush (vecPush vecNew "first") "second"))
    (let declaration (nodeBuildDFn "probe" parameters (mkEInt 0) 0))
    (let functions vecNew)
    (regFn functions "probe" mkIntTy)
    (rgnCtxNew checker declaration (vecGet functions 0) report)
  })

(:: parameterOrigin (-> (Option ASTNode) Int Int))
(fn (parameterOrigin signature index)
  {
    (let rc (context 0))
    (rgnBindTypedParams rc (nodeBNames rc.decl) 0 16 signature)
    (vecGet (rgnOrigs rc) index)
  })

(:: fieldOrigin (-> (Option ASTNode) Int))
(fn (fieldOrigin checked)
  {
    (let rc (context 0))
    (rgnBind rc "owner" 4 0)
    (rgnBind rc "value" 2 0)
    (let value (mkEVar "value"))
    (if (let (Some ty) checked)
      (setNodeBinderTyChild value ty))
    (rgnSetField rc (nodeBuildESetf (mkEVar "owner") "field" value 0))
    (vecGet (rgnFlowsFrom rc.facts) 1)
  })

(:: handlerErrors (-> (Option ASTNode) Int))
(fn (handlerErrors checked)
  {
    (let rc (context 1))
    (let handler (mkEVar "unseen"))
    (setNodeSpan handler (mkSpan 0 1))
    (if (let (Some ty) checked)
      (setNodeBinderTyChild handler ty))
    (rgnHandlerValue rc handler)
    (vecLen rc.tc.out)
  })

(:: checks ())
;@axiom:effect(io)
(fn (checks)
  {
    (let missing (mkEInt 0))
    (let integer mkIntTy)
    (let string mkStringTy)
    (let poison mkTErr)
    (let wildcard mkSilentWild)
    (say 1 (isNone (rgnCheckedTy nilNode)))
    (say 2 (isNone (rgnCheckedTy missing)))
    (say 3 (sameType (rgnCheckedTy (stamped integer)) integer))
    (say 4 (sameType (rgnCheckedTy (stamped string)) string))
    (say 5 (sameType (rgnCheckedTy (stamped poison)) poison))
    (say 6 (sameType (rgnCheckedTy (stamped wildcard)) wildcard))
    (let declaration (mkEVar "stamp-owner"))
    (let integerStamp (nodeBuildEvstampResultPlain integer 0 declaration))
    (say 7 (sameType (rgnCheckedTy (stamped integerStamp)) integer))
    (say 8
      (sameType (rgnCheckedTy (stamped (nodeBuildEvstampResultPlain poison 0 declaration))) poison))
    (say 9
      (sameType (rgnCheckedTy (stamped (nodeBuildEvstampResultPlain wildcard 0 declaration)))
        wildcard))
    (say 10 (isNone (rgnCheckedTy (stamped (nodeBuildEvstampResultPlain nilNode 0 declaration)))))
    (rgnCheckedTy (stamped integerStamp))
    (say 11 (nodeSame (nodeCChild integerStamp) declaration))
    (say 12 (== (parameterOrigin None 0) 16))
    (say 13 (== (parameterOrigin (Some (mkTArr integer integer)) 0) 0))
    (say 14 (== (parameterOrigin (Some (mkTArr string integer)) 0) 16))
    (say 15 (== (parameterOrigin (Some poison) 0) 16))
    (say 16 (== (parameterOrigin (Some wildcard) 0) 16))
    (say 17 (== (parameterOrigin (Some integer) 0) 16))
    (say 18 (== (parameterOrigin (Some (mkTArr integer integer)) 1) 16))
    (say 19 (== (parameterOrigin (Some (mkTArr wildcard integer)) 0) 16))
    (say 20 (== (handlerErrors None) 1))
    (say 21 (== (handlerErrors (Some poison)) 0))
    (say 22 (== (handlerErrors (Some wildcard)) 1))
    (say 23 (== (fieldOrigin (Some integer)) 0))
    (say 24 (== (fieldOrigin None) 1))
    (say 25 (== (fieldOrigin (Some string)) 1))
    (say 26 (== (fieldOrigin (Some poison)) 1))
    (say 27 (== (fieldOrigin (Some wildcard)) 1))
    (say 28 (== (fieldOrigin (Some integerStamp)) 0))
    (say 29 (== (probeComputeCast (Some integer)) 0))
    (say 30 (== (probeComputeCast None) 1))
    (say 31 (== (probeComputeCast (Some poison)) 1))
    (say 32 (== (probeComputeCast (Some wildcard)) 1))
    (say 33 (probeDiagnosticGood 0))
    (say 34 (probeDiagnosticGood 1))
    (say 35 (probeDiagnosticGood 2))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (> sysArgc 1)
    {
      (writeStr stdout (probeDiagnosticText (strToInt (sysArg 1))))
      0
    }
    {
      (checks)
      0
    }))
