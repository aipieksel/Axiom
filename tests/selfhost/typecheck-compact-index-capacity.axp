(import core)
(import typecheck)
(import Vec)
(import Str)
(import Fmt)
(import IO)
(import Mem)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: sameEntry (-> (Option FnEnt) FnEnt Bool))
(fn (sameEntry found wanted)
  (if (let (Some value) found)
    (addrEq (addrOf value) (addrOf wanted))
    false))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let functions (:: vecNew (Vec FnEnt)))
    (regFn functions "first" mkIntTy)
    (let first (vecGet functions 0))
    (let index (fnIdxBuildSized functions 0))
    (say 1 (probeIndexCompact index))
    (for i in 0..300
      {
        (let one (:: vecNew (Vec FnEnt)))
        (regFn one (concat "limit" (fmtInt i)) mkIntTy)
        (fnIdxAdd index (vecGet one 0))
      })
    (say 2 (! (probeIndexCompact index)))
    (say 3 (== (probeIndexEntries index) 301))
    (say 4 (== (probeIndexNodes index) 255))
    (say 5 (== (probeIndexBuckets index) 19))
    (say 6 (sameEntry (fnIdxGet index "first") first))
    (say 7 (isSome (fnIdxGet index "limit299")))
    (say 8 (isNone (fnIdxGet index "limit300")))
    (regFn functions "first" mkStringTy)
    (fnIdxAdd index (vecLast functions))
    (say 9 (sameEntry (fnIdxGet index "first") first))
    (regFn functions "Module$hidden" mkBoolTy)
    (let qualified (vecLast functions))
    (fnIdxAdd index qualified)
    (say 10 (sameEntry (fnIdxGetQual index "Module" "hidden") qualified))
    (let privateRows (privIdxBuild (Some (vecPush vecNew "Module$hidden"))))
    (say 11 (isNone (fnIdxGetVisible index privateRows "Module$hidden" None)))
    (say 12
      (sameEntry (fnIdxGetVisible index privateRows "Module$hidden" (Some "Module")) qualified))
    0
  })
