(import core)
(import typecheck)
(import Vec)
(import Str)
(import Sys)
(import Fmt)
(import IO)

(type LegacyIndex (Vec (Vec FnEnt)))

(:: legacyAdd (-> LegacyIndex FnEnt Int))
(fn (legacyAdd buckets entry)
  {
    (vecPush (vecGet buckets (% (fnIdxHash entry.name) (vecLen buckets))) entry)
    0
  })

(:: legacyBuild (-> (Vec FnEnt) Int LegacyIndex))
(fn (legacyBuild functions hint)
  {
    (let count
      (if (> hint (vecLen functions))
        hint
        (vecLen functions)))
    (let buckets (:: vecNew LegacyIndex))
    (for i in 0..(fnIdxBuckets count)
      (vecPush buckets vecNew))
    (for entry in functions
      (legacyAdd buckets entry))
    buckets
  })

(:: legacyGet (-> LegacyIndex String (Option FnEnt)))
(fn (legacyGet buckets name)
  (fnIdxScan (vecGet buckets (% (fnIdxHash name) (vecLen buckets))) name 0))

(:: printMemory (-> Int Int Int Int Int Int Int Bool ()))
;@axiom:effect(io)
(fn (printMemory count held filed mapped heldAfter filedAfter mappedAfter found)
  {
    (let allocated (- heldAfter held))
    (let live (- allocated (- filedAfter filed)))
    (let mappedDelta (- mappedAfter mapped))
    (println "{count} {allocated} {live} {mappedDelta} {found}")
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let count
      (if (strEq (sysArg 1) "large")
        10000
        1000))
    (let functions (:: vecNew (Vec FnEnt)))
    (for i in 0..count
      (regFn functions (concat "Module$function" (fmtInt i)) mkIntTy))
    (let held (__axiom_mem_stat 0))
    (let filed (__axiom_mem_stat 1))
    (let mapped (__axiom_mem_stat 2))
    (if (strEq (sysArg 2) "legacy")
      {
        (let index (legacyBuild functions count))
        (let heldAfter (__axiom_mem_stat 0))
        (let filedAfter (__axiom_mem_stat 1))
        (let mappedAfter (__axiom_mem_stat 2))
        (let found (isSome (legacyGet index (concat "Module$function" (fmtInt (- count 1))))))
        (printMemory count held filed mapped heldAfter filedAfter mappedAfter found)
      }
      {
        (let index (fnIdxBuildSized functions count))
        (let heldAfter (__axiom_mem_stat 0))
        (let filedAfter (__axiom_mem_stat 1))
        (let mappedAfter (__axiom_mem_stat 2))
        (let found (isSome (fnIdxGet index (concat "Module$function" (fmtInt (- count 1))))))
        (printMemory count held filed mapped heldAfter filedAfter mappedAfter found)
      })
    0
  })
