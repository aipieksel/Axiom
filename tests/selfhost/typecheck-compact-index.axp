(import core)
(import typecheck)
(import parser)
(import Vec)
(import Link)
(import Str)
(import Fmt)
(import Mem)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: sameEntry (-> (Option FnEnt) FnEnt Bool))
(fn (sameEntry found wanted)
  (if (let (Some value) found)
    (addrEq (addrOf value) (addrOf wanted))
    false))

(:: entry (-> String FnEnt))
(fn (entry name)
  {
    (let functions (:: vecNew (Vec FnEnt)))
    (regFn functions name mkIntTy)
    (vecGet functions 0)
  })

(:: indexFrom (-> FnEnt FnIndex))
(fn (indexFrom entry)
  (fnIdxBuildSized (vecPush vecNew entry) 0))

(:: indexFromName (-> String FnIndex))
(fn (indexFromName name)
  {
    (let functions (:: vecNew (Vec FnEnt)))
    (regFn functions name mkIntTy)
    (fnIdxBuildSized functions 0)
  })

(:: holdIndex (-> FnEnt Int))
(fn (holdIndex entry)
  {
    (let index (indexFrom entry))
    (count entry)
  })

(:: holdName (-> String Int))
(fn (holdName name)
  {
    (let index (indexFromName name))
    (count name)
  })

(:: collision (-> String Int Int String))
(fn (collision target buckets start)
  {
    (let candidate (concat "candidate" (fmtInt start)))
    (if (== (% (fnIdxHash candidate) buckets) (% (fnIdxHash target) buckets))
      candidate
      (collision target buckets (+ start 1)))
  })

(:: lookupChecks ())
;@axiom:effect(io)
(fn (lookupChecks)
  {
    (let empty (fnIdxBuildSized vecNew 0))
    (say 1 (isNone (fnIdxGet empty "missing")))
    (say 2 (probeIndexCompact empty))
    (say 3 (== (probeIndexBuckets empty) 17))
    (say 4 (&& (== (sizeof FnIndexNode) 8) (== (sizeof FnIndexBucket) 8)))
    (let first (entry "duplicate"))
    (let second (entry "duplicate"))
    (set second.ty mkStringTy)
    (let functions (vecPush (vecPush vecNew first) second))
    (let index (fnIdxBuildSized functions 0))
    (say 5 (sameEntry (fnIdxGet index "duplicate") first))
    (say 6 (isNone (fnIdxGet index "absent")))
    (say 7 (sameEntry (fnIdxGetVisible index None "duplicate" None) first))
    (say 8 (== (probeIndexEntries index) 2))
    (say 9 (== (probeIndexNodes index) 2))
    (say 10 (probeIndexScalarNodes index))
    (say 11 (probeIndexScalarBuckets index))
    (let key (collision "duplicate" (probeIndexBuckets index) 0))
    (let other (entry key))
    (fnIdxAdd index other)
    (say 12 (sameEntry (fnIdxGet index key) other))
    (say 13 (sameEntry (fnIdxGet index "duplicate") first))
    (set first.ty mkBoolTy)
    (say 14
      (if (let (Some found) (fnIdxGet index "duplicate"))
        (strEq (tyRender found.ty) "Bool")
        false))
    (let qualified (entry "Module$local"))
    (fnIdxAdd index qualified)
    (say 15 (sameEntry (fnIdxGetQual index "Module" "local") qualified))
    (say 16 (isNone (fnIdxGetQual index "Other" "local")))
    (say 17 (isNone (fnIdxGet index "local")))
    (let privateNames (vecPush vecNew "Module$local"))
    (let privateRows (privIdxBuild (Some privateNames)))
    (say 18 (isNone (fnIdxGetVisible index privateRows "Module$local" None)))
    (say 19
      (sameEntry (fnIdxGetVisible index privateRows "Module$local" (Some "Module")) qualified))
    (say 20 (sameEntry (fnIdxGetVisible index None "Module$local" None) qualified))
  })

(:: growthChecks ())
;@axiom:effect(io)
(fn (growthChecks)
  {
    (let first (entry "first"))
    (let index (indexFrom first))
    (let originalPool (probeIndexPoolAddress index))
    (for i in 0..512
      (fnIdxAdd index (entry (concat "grown" (fmtInt i)))))
    (say 21 (addrEq originalPool (probeIndexPoolAddress index)))
    (say 22 (sameEntry (fnIdxGet index "first") first))
    (say 23 (== (probeIndexEntries index) 513))
    (say 24 (== (probeIndexNodes index) 513))
    (say 25 (probeIndexCompact index))
    (say 26 (isSome (fnIdxGet index "grown511")))
    (say 27 (isNone (fnIdxGet index "grown512")))
    (say 28 (probeIndexScalarNodes index))
  })

(:: ownerChecks ())
;@axiom:effect(io)
(fn (ownerChecks)
  {
    (let owner (entry "owned"))
    (let before (count owner))
    (let during (holdIndex owner))
    (say 29 (== during (+ before 1)))
    (say 30 (== (count owner) before))
    (let name (strDup "retired-entry-child"))
    (let nameBefore (count name))
    (let nameDuring (holdName name))
    (say 31 (== nameDuring (+ nameBefore 1)))
    (say 32 (== (count name) nameBefore))
    (let independent (indexFromName "independent"))
    (say 33 (isSome (fnIdxGet independent "independent")))
    (let first (entry "fallback"))
    (let second (entry "fallback"))
    (let functions (vecPush (vecPush vecNew first) second))
    (let fallback (fnIdxBuildSized functions 4294967296))
    (say 34 (! (probeIndexCompact fallback)))
    (say 35 (== (probeIndexBuckets fallback) 17))
    (say 36 (== (probeIndexNodes fallback) 0))
    (say 37 (sameEntry (fnIdxGet fallback "fallback") first))
    (say 38 (isNone (fnIdxGet fallback "missing")))
    (let qualified (entry "Module$hidden"))
    (fnIdxAdd fallback qualified)
    (say 39 (sameEntry (fnIdxGetQual fallback "Module" "hidden") qualified))
    (let privateRows (privIdxBuild (Some (vecPush vecNew "Module$hidden"))))
    (say 40 (isNone (fnIdxGetVisible fallback privateRows "Module$hidden" None)))
    (say 41
      (sameEntry (fnIdxGetVisible fallback privateRows "Module$hidden" (Some "Module")) qualified))
    (let suffix (fnSufIdxBuildSized functions 0))
    (say 42 (sameEntry (fnSufIdxGet suffix "fallback") first))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (lookupChecks)
    (growthChecks)
    (ownerChecks)
    0
  })
