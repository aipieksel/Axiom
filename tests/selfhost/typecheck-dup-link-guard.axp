(import core)
(import parser)
(import typecheck)
(import Vec)
(import Str)
(import IO)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs found expected)
  (match found
    ((Some index) (== index expected))
    ((None) false)))

(:: heldName (-> String Bool Int))
(fn (heldName name packed)
  {
    (let index
      (probeDupNew 0
        (if packed
          1
          0)))
    (dupIdxPut index name NS_VALUE 0)
    (count name)
  })

(:: checks ())
;@axiom:effect(io)
(fn (checks)
  {
    (let index (probeDupNew 0 2))
    (say 1 (isNone (firstDefiner index 1 NS_VALUE "missing")))
    (say 2 (probeDupCompact index))
    (dupIdxPut index "same" NS_VALUE 0)
    (say 3 (&& (== (probeDupNames index) 1) (== (probeDupWide index) 0)))
    (say 4 (isNone (firstDefiner index 0 NS_VALUE "same")))
    (say 5 (indexIs (firstDefiner index 1 NS_VALUE "same") 0))
    (say 6 (isNone (firstDefiner index 1 NS_SIG "same")))
    (say 7 (isNone (firstDefiner index 2 NS_VALUE "missing")))
    (dupIdxPut index "same" NS_SIG 1)
    (say 8 (&& (probeDupCompact index) (== (probeDupNames index) 2)))
    (say 9 (indexIs (firstDefiner index 2 NS_SIG "same") 1))
    (dupIdxPut index "same" NS_TYPE 2)
    (say 10
      (&& (! (probeDupCompact index))
        (&& (== (probeDupNames index) 2) (== (probeDupWide index) 1))))
    (say 11 (indexIs (firstDefiner index 3 NS_TYPE "same") 2))
    (dupIdxPut index "same" NS_VALUE 3)
    (say 12 (indexIs (firstDefiner index 4 NS_VALUE "same") 0))
    (dupIdxPut index "late" NS_VALUE 4)
    (say 13 (isNone (firstDefiner index 4 NS_VALUE "late")))
    (say 14 (indexIs (firstDefiner index 5 NS_VALUE "late") 4))
    (for i in 0..30
      (dupIdxPut index "growth" NS_VALUE (+ i 5)))
    (say 15 (&& (== (probeDupNames index) 2) (== (probeDupWide index) 33)))
    (say 16 (indexIs (firstDefiner index 40 NS_VALUE "same") 0))
    (let edge (probeDupNew 0 2))
    (dupIdxPut edge "edge" NS_VALUE 2)
    (say 17 (&& (probeDupCompact edge) (indexIs (firstDefiner edge 3 NS_VALUE "edge") 2)))
    (dupIdxPut edge "edge" NS_VALUE 3)
    (say 18
      (&& (! (probeDupCompact edge))
        (&& (== (probeDupNames edge) 1) (indexIs (firstDefiner edge 4 NS_VALUE "edge") 2))))
    (let wide (probeDupNew 0 2))
    (dupIdxPut wide "wide" NS_VALUE 3)
    (say 19 (&& (== (probeDupNames wide) 0) (indexIs (firstDefiner wide 4 NS_VALUE "wide") 3)))
    (let maximum 4294967295)
    (let full (probeDupNew 0 maximum))
    (dupIdxPut full "maximum" NS_VALUE maximum)
    (say 20
      (&& (probeDupCompact full)
        (indexIs (firstDefiner full (+ maximum 1) NS_VALUE "maximum") maximum)))
    (dupIdxPut full "wider" NS_VALUE (+ maximum 1))
    (say 21
      (&& (! (probeDupCompact full))
        (indexIs (firstDefiner full (+ maximum 2) NS_VALUE "wider") (+ maximum 1))))
    (say 22 (isNone (firstDefiner full (+ maximum 1) NS_VALUE "wider")))
    (let zero (probeDupNew 0 0))
    (dupIdxPut zero "zero" NS_VALUE 0)
    (say 23 (&& (== (probeDupNames zero) 0) (indexIs (firstDefiner zero 1 NS_VALUE "zero") 0)))
    (let negativeCapacity (probeDupNew 0 (- 0 1)))
    (dupIdxPut negativeCapacity "zero" NS_VALUE 0)
    (say 24 (&& (== (probeDupLimit negativeCapacity) 0) (== (probeDupWide negativeCapacity) 1)))
    (say 25 (== (probeDupLimit (probeDupNew 0 (+ maximum 1))) maximum))
    (let hugeHint (probeDupNew (+ maximum 1) maximum))
    (say 26 (&& (! (probeDupCompact hugeHint)) (== (probeDupBuckets hugeHint) 1)))
    (dupIdxPut hugeHint "small" NS_VALUE 0)
    (say 27
      (&& (== (probeDupNames hugeHint) 0) (indexIs (firstDefiner hugeHint 1 NS_VALUE "small") 0)))
    (let negativeHint (probeDupNew (- 0 1) 2))
    (say 28 (&& (! (probeDupCompact negativeHint)) (== (probeDupBuckets negativeHint) 1)))
    (let namespaces (probeDupNew 0 0))
    (dupIdxPut namespaces "ns" 999 7)
    (say 29 (indexIs (firstDefiner namespaces 8 NS_SIG "ns") 7))
    (say 30 (isNone (firstDefiner namespaces 8 NS_TYPE "ns")))
    (dupIdxPut zero "" NS_VALUE 1)
    (say 31 (indexIs (firstDefiner zero 2 NS_VALUE "") 1))
    (let name (strDup "owned"))
    (let before (count name))
    (let packedHeld (heldName name true))
    (say 32 (== packedHeld (+ before 1)))
    (say 33 (== (count name) before))
    (let wideHeld (heldName name false))
    (say 34 (== wideHeld (+ before 1)))
    (say 35 (== (count name) before))
    (say 36 (indexIs (firstDefiner (probeDupReturned true) 1 NS_VALUE "survivor") 0))
    (say 37 (indexIs (firstDefiner (probeDupReturned false) 1 NS_VALUE "survivor") 0))
    (let grown (probeDupNew 0 64))
    (dupIdxPut grown "first" NS_VALUE 0)
    (for i in 1..32
      (dupIdxPut grown "other" NS_VALUE i))
    (say 38
      (&& (== (probeDupNames grown) 32)
        (&& (probeDupCompact grown) (indexIs (firstDefiner grown 33 NS_VALUE "first") 0))))
    (dupIdxPut wide "wide" NS_VALUE 1)
    (say 39 (&& (== (probeDupNames wide) 0) (indexIs (firstDefiner wide 4 NS_VALUE "wide") 3)))
    (say 40 (indexIs (firstDefiner wide 2 NS_VALUE "wide") 1))
    (say 41 (indexIs (firstDefiner namespaces 8 999 "ns") 7))
    (say 42 (strEq (probeDupDiagnostic 0 0) (probeDupDiagnostic 0 maximum)))
    (say 43 (strEq (probeDupDiagnostic 1 2) (probeDupDiagnostic 1 maximum)))
    (say 44 (&& (probeDupDiagnosticGood 2 0) (probeDupDiagnosticGood 3 0)))
    (say 45 (probeDupWideOwners wide))
    (say 46 (indexIs (firstDefiner (probeDupFromDecls 0) 1 NS_VALUE "from-source") 0))
    (say 47 (indexIs (firstDefiner (probeDupFromDecls 8) 1 NS_VALUE "from-source") 0))
    (say 48 (isNone (firstDefiner zero (- 0 1) NS_VALUE "zero")))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (> sysArgc 1)
    (if (strEq (sysArg 1) "negative")
      {
        (dupIdxPut (probeDupNew 0 2) "bad" NS_VALUE (- 0 1))
        0
      }
      {
        (writeStr stdout (probeDupDiagnostic (strToInt (sysArg 1)) (strToInt (sysArg 2))))
        0
      })
    {
      (checks)
      0
    }))
