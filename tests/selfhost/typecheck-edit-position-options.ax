; expect 42
; Source edit lookups retain valid offset zero and distinguish missing
; recovery anchors. Fix text, ranges and prose-only suppression stay exact.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)

(:: editPositionIs (-> (Option Int) Int Bool))
(fn (editPositionIs result expected)
  (match result
    ((None) false)
    ((Some value) (== value expected))))

(:: editContext (-> String Nodes TC))
(fn (editContext source declarations)
  {
    (let units vecNew)
    (vecPush units
      (CUnit2 :file "edit-options.ax" :src source :name (Some "") :imports vecNew :library false))
    (tcNew declarations declarations units)
  })

(:: editDiagnostic Diag)
(fn (editDiagnostic)
  (mkDiag SEV_ERROR "AX3005" "non-exhaustive-match" (mkSpan 1 2) "probe" 0 0 0))

(:: fixIs (-> Diag Int Int Int String Bool))
(fn (fixIs diagnostic index start end text)
  {
    (let span (diagHelpFixSpan diagnostic index))
    (if (== span 0)
      false
      (&& (== (spanStart span) start)
        (&& (== (spanEnd span) end)
          (if (let (Some replacement) (diagHelpFixText diagnostic index))
            (strEq replacement text)
            false))))
  })

(:: scannerPositionChecks Bool)
(fn (scannerPositionChecks)
  {
    (let nested "(call \"a)\" #| ) |# ')' ; )\n (inner))")
    (&& (editPositionIs (formEndFrom "()" 0) 2)
      (&& (editPositionIs (formEndFrom nested 0) (strLen nested))
        (&& (editPositionIs (formEndFrom "(x)(y)" 3) 6)
          (&& (isNone (formEndFrom "(" 0))
            (&& (isNone (formEndFrom "name)" 0))
              (&& (isNone (formEndFrom "()" (- 0 1)))
                (&& (isNone (formEndFrom "()" 2))
                  (&& (editPositionIs (formOpenBefore "(name)" 1) 0)
                    (&& (editPositionIs (formOpenBefore "((name))" 2) 0)
                      (&& (isNone (formOpenBefore "name" 0))
                        (&& (isNone (formOpenBefore "()" 4))
                          (&& (editPositionIs (headOpenBefore "(match x)" 7 "match") 0)
                            (&& (editPositionIs (headOpenBefore "(match\nx)" 7 "match") 0)
                              (&& (isNone (headOpenBefore "(wrong x)" 7 "match"))
                                (isNone (headOpenBefore "" 1 "match"))))))))))))))))
  })

(:: matchPositionChecks Bool)
(fn (matchPositionChecks)
  {
    (let source "(match x\n  ((Zero) 0))")
    (let scrutinee (mkEVarAt "x" (mkSpan 7 8)))
    (let pattern (nodeBuildPCon0 "Zero" 0 0 (mkSpan 13 17)))
    (let arm (nodeBuildMArm pattern (mkEInt 0) 0 0))
    (let arms (vecPush vecNew arm))
    (let zeroArm (nodeBuildMArm (nodeBuildPCon0 "Zero" 0 0 (mkSpan 2 6)) (mkEInt 0) 0 0))
    (&& (editPositionIs (armOpenOf source arm) 11)
      (&& (editPositionIs (armFormEnd source arm) 21)
        (&& (editPositionIs (matchCloseAt source scrutinee arms) 21)
          (&& (editPositionIs (matchArmIndent source scrutinee arms) 2)
            (&& (editPositionIs (armOpenOf "((Zero) 0)" zeroArm) 0)
              (&&
                (editPositionIs (matchArmIndent "((Zero) 0)" scrutinee (vecPush vecNew zeroArm)) 0)
                (&& (editPositionIs (scrutFormEnd "(match x)" scrutinee) 8)
                  (&& (editPositionIs (matchCloseAt "(match x)" scrutinee vecNew) 8)
                    (&& (editPositionIs (matchArmIndent "(match x)" scrutinee vecNew) 2)
                      (&& (isNone (matchCloseAt "(match x nope)" scrutinee vecNew))
                        (&& (isNone (matchCloseAt "(match x" scrutinee vecNew))
                          (&& (isNone (armOpenOf source (mkEInt 0)))
                            (&&
                              (isNone
                                (armFormEnd source (nodeBuildMArm (mkEVar "Zero") (mkEInt 0) 0 0)))
                              (&& (isNone (scrutFormEnd source (mkEVar "missingSpan")))
                                (isNone
                                  (scrutFormEnd source
                                    (mkEVarAt "bad" (mkSpan 50 60))))))))))))))))))
  })

(:: matchFixPositionChecks Bool)
(fn (matchFixPositionChecks)
  {
    (let source "(match x\n ((None) 0))")
    (let scrutinee (mkEVarAt "x" (mkSpan 7 8)))
    (let arm (nodeBuildMArm (nodeBuildPCon0 "None" 0 0 (mkSpan 12 16)) (mkEInt 0) 0 0))
    (let arms (vecPush vecNew arm))
    (let matrix (vecPush vecNew (vecPush vecNew (nodeAChild arm))))
    (let tc (editContext source vecNew))
    (let diagnostic editDiagnostic)
    (matchFixHelps tc diagnostic arms (mkTCon "Option" (vecPush vecNew mkIntTy)) scrutinee matrix
      (vecPush vecNew "Some"))
    (let recovery editDiagnostic)
    (matchFixHelps (editContext "(match x" vecNew) recovery vecNew
      (mkTCon "Option" (vecPush vecNew mkIntTy)) scrutinee vecNew (vecPush vecNew "Some"))
    (if (&& (== (diagHelpCount diagnostic) 2) (== (diagHelpCount recovery) 1))
      (&&
        (fixIs diagnostic 0 (- (strLen source) 1) (- (strLen source) 1)
          "\n ((Some _) (todo \"Some\"))")
        (&& (fixIs diagnostic 1 0 0 "(import IO (todo))\n")
          (&& (== (diagHelpFixSpan recovery 0) 0)
            (strEq (diagHelpMsg recovery 0)
              "add the missing arms, or a wildcard `_` arm to catch the rest"))))
      false)
  })

(:: importFixPositionChecks Bool)
(fn (importFixPositionChecks)
  {
    (let source "(import IO.Tools (print))")
    (let imported (nodeBuildDImport "IO" (vecPush vecNew "print") 0 (mkSpan 8 10)))
    (let listSource "(import IO (print))")
    (let diagnostic editDiagnostic)
    (importTodoHelp (editContext listSource (vecPush vecNew imported)) diagnostic listSource)
    (let bareSource "(import IO)")
    (let bare (nodeBuildDImport "IO" vecNew 0 (mkSpan 8 10)))
    (let bareDiagnostic editDiagnostic)
    (importTodoHelp (editContext bareSource (vecPush vecNew bare)) bareDiagnostic bareSource)
    (let otherSource "(import Vec)")
    (let other (nodeBuildDImport "Vec" vecNew 0 (mkSpan 8 11)))
    (let otherDiagnostic editDiagnostic)
    (importTodoHelp (editContext otherSource (vecPush vecNew other)) otherDiagnostic otherSource)
    (&& (editPositionIs (importListOpen source imported) 17)
      (&& (isNone (importListOpen bareSource bare))
        (&& (isNone (importListOpen source (nodeBuildDImport "IO" vecNew 0 0)))
          (if (&& (== (diagHelpCount diagnostic) 1) (== (diagHelpCount otherDiagnostic) 1))
            (&& (fixIs diagnostic 0 17 17 " todo")
              (&& (== (diagHelpCount bareDiagnostic) 0)
                (fixIs otherDiagnostic 0 12 12 "\n(import IO (todo))")))
            false))))
  })

(:: effectFixPositionChecks Bool)
(fn (effectFixPositionChecks)
  {
    (let source "(fn (main) 0)")
    (let declaration (nodeBuildDFn "main" vecNew (mkEInt 0) (mkSpan 5 9)))
    (let tc (editContext source (vecPush vecNew declaration)))
    (emitUndeclaredEffect tc declaration "IO")
    (let generated
      (editContext "macro main"
        (vecPush vecNew (nodeBuildDFn "main" vecNew (mkEInt 0) (mkSpan 6 10)))))
    (emitUndeclaredEffect generated (vecGet generated.allDecls 0) "IO")
    (&& (editPositionIs (effectTagInsertAt source 5) 0)
      (&& (editPositionIs (effectTagInsertAt "(fn answer 42)" 4) 0)
        (&& (isNone (effectTagInsertAt "macro main" 6))
          (&& (isNone (effectTagInsertAt source (- 0 1)))
            (&& (isNone (effectTagInsertAt source (strLen source)))
              (if (&& (== (vecLen (tcOutVec tc)) 1) (== (vecLen (tcOutVec generated)) 1))
                (&& (strEq (diagCode (vecGet (tcOutVec tc) 0)) "AX3042")
                  (&& (fixIs (vecGet (tcOutVec tc) 0) 0 0 0 ";@axiom:effect(io)\n")
                    (== (diagHelpFixSpan (vecGet (tcOutVec generated) 0) 0) 0)))
                false))))))
  })

(:: unsafeEffectFixPositionChecks Bool)
(fn (unsafeEffectFixPositionChecks)
  {
    (let source "(fn (main) (__load8 0 0))")
    (let declaration (nodeBuildDFn "main" vecNew (mkEInt 0) (mkSpan 5 9)))
    (let site (mkEVarAt "__load8" (mkSpan 12 19)))
    (let tc (editContext source (vecPush vecNew declaration)))
    (emitUndeclaredUnsafe tc declaration site 0 vecNew 0)
    (let generatedDecl (nodeBuildDFn "main" vecNew (mkEInt 0) (mkSpan 7 11)))
    (let generated (editContext "(macro main __load8)" (vecPush vecNew generatedDecl)))
    (emitUndeclaredUnsafe generated generatedDecl site 0 vecNew 0)
    (if (&& (== (vecLen (tcOutVec tc)) 1) (== (vecLen (tcOutVec generated)) 1))
      (&& (strEq (diagCode (vecGet (tcOutVec tc) 0)) "AX3073")
        (&& (fixIs (vecGet (tcOutVec tc) 0) 0 0 0 ";@axiom:effect(unsafe)\n")
          (== (diagHelpFixSpan (vecGet (tcOutVec generated) 0) 0) 0)))
      false)
  })

(:: main Int)
(fn (main)
  (if (scannerPositionChecks)
    (if (matchPositionChecks)
      (if (matchFixPositionChecks)
        (if (importFixPositionChecks)
          (if (effectFixPositionChecks)
            (if (unsafeEffectFixPositionChecks)
              42
              6)
            5)
          4)
        3)
      2)
    1))
