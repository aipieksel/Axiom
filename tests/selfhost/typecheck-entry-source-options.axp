; Entry-source absence is distinct from an empty source file.
(import core)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: context (-> (Option String) TC))
(fn (context source)
  {
    (let units (:: vecNew Units))
    (if (let (Some text) source)
      (vecPush units
        (CUnit2 :file "source.ax" :src text :name None :imports vecNew :library false)))
    (tcNew vecNew vecNew units)
  })

(:: sourceIs (-> (Option String) String Bool))
(fn (sourceIs source expected)
  (match source
    ((None) false)
    ((Some text) (strEq text expected))))

(:: count (-> String Int))
;@axiom:effect(unsafe)
(fn (count source)
  (__load64 (as source Int) -2))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: retireSource (-> TC Int))
(fn (retireSource tc)
  (if (let (Some text) (tcEntrySrc tc))
    (strLen text)
    -1))

(:: temporarySource (Option String))
(fn (temporarySource)
  (tcEntrySrc (context (Some (strDup "alive")))))

(:: matchProbe (-> (Option String) Int Diag))
(fn (matchProbe source unit)
  {
    (let tc (context source))
    (set tc.curUnit unit)
    (let scrutinee (mkEVarAt "x" (mkSpan 7 8)))
    (let arm (nodeBuildMArm (nodeBuildPCon0 "None" 0 0 (mkSpan 12 16)) (mkEInt 0) 0 0))
    (let arms (vecPush vecNew arm))
    (let matrix (vecPush vecNew (vecPush vecNew (nodeAChild arm))))
    (let d (mkDiagBase 0 "AX3005" "non-exhaustive-match" (mkSpan 7 8) "probe" None))
    (matchFixHelps tc d arms (mkTCon "Option" (vecPush vecNew mkIntTy)) scrutinee matrix
      (vecPush vecNew "Some"))
    d
  })

(:: effectProbe (-> (Option String) Int Bool Diag))
(fn (effectProbe source unit unsafe)
  {
    (let tc (context source))
    (set tc.curUnit unit)
    (let d (nodeBuildDFn "main" vecNew (mkEInt 0) (mkSpan 5 9)))
    (if unsafe
      (emitUndeclaredUnsafe tc d (mkEVarAt "__load8" (mkSpan 12 19)) 0 vecNew 0)
      (emitUndeclaredEffect tc d "IO"))
    (vecGet (tcOutVec tc) 0)
  })

(:: hasFix (-> Diag Bool))
(fn (hasFix d)
  (if (> (diagHelpCount d) 0)
    (isSome (diagHelpFix d 0))
    false))

(:: proseOnly (-> Diag Bool))
(fn (proseOnly d)
  (if (> (diagHelpCount d) 0)
    (isNone (diagHelpFix d 0))
    false))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let absent (context None))
    (let empty (context (Some "")))
    (let source (strDup "body"))
    (let present (context (Some source)))
    (say 1 (isNone (tcEntrySrc absent)))
    (say 2 (sourceIs (tcEntrySrc empty) ""))
    (say 3 (sourceIs (tcEntrySrc present) "body"))
    (set present.curUnit 1)
    (say 4 (isNone (tcEntrySrc present)))
    (set present.curUnit -1)
    (say 5 (isNone (tcEntrySrc present)))
    (set present.curUnit 0)
    (say 6 (sourceIs (tcEntrySrc present) "body"))
    (say 7 (sourceIs temporarySource "alive"))
    (let before (count source))
    (say 8 (== (retireSource present) 4))
    (say 9 (== (count source) before))
    (let bytesBefore (live))
    (for i in 0..20
      (retireSource present))
    (let bytesAfter (live))
    (say 10 (== bytesBefore bytesAfter))
    (say 11 (== (count source) before))
    (let mut calls 0)
    (if (let (Some text) (tcEntrySrc absent))
      (set calls (+ calls 1)))
    (say 12 (== calls 0))
    (let matching "(match x\n ((None) 0))")
    (say 13 (hasFix (matchProbe (Some matching) 0)))
    (say 14 (proseOnly (matchProbe None 0)))
    (say 15 (proseOnly (matchProbe (Some "") 0)))
    (say 16 (proseOnly (matchProbe (Some matching) 1)))
    (let function "(fn (main) (__load8 0 0))")
    (say 17 (hasFix (effectProbe (Some function) 0 false)))
    (say 18 (proseOnly (effectProbe None 0 false)))
    (say 19 (proseOnly (effectProbe (Some "") 0 false)))
    (say 20 (proseOnly (effectProbe (Some function) 1 false)))
    (say 21 (hasFix (effectProbe (Some function) 0 true)))
    (say 22 (proseOnly (effectProbe None 0 true)))
    (say 23 (proseOnly (effectProbe (Some "") 0 true)))
    (say 24 (proseOnly (effectProbe (Some function) 1 true)))
  })
