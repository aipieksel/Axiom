(import core)
(import lexer)
(import parser)
(import typecheck)
(import Vec)
(import Str)
(import Fmt)
(import Mem)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: foundName (-> (Option String) String Bool))
(fn (foundName result wanted)
  (match result
    ((None) false)
    ((Some name) (strEq name wanted))))

(:: ambiguous (-> TC String ()))
(fn (ambiguous checker name)
  {
    (tyIdxAddData checker (DataEnt :name name :ctors vecNew :module (Some "A") :arity 0))
    (tyIdxAddData checker (DataEnt :name name :ctors vecNew :module (Some "B") :arity 0))
  })

(:: typeSearchChecks ())
;@axiom:effect(io)
(fn (typeSearchChecks)
  {
    (let checker (tcNew vecNew vecNew vecNew))
    (let first (mkTCon "FirstMissing" vecNew))
    (let second (mkTCon "SecondMissing" vecNew))
    (say 1 (isNone (tyUnknownCon checker nilNode)))
    (say 2 (isNone (tyUnknownCon checker mkIntTy)))
    (say 3 (foundName (tyUnknownCon checker first) "FirstMissing"))
    ; Empty names are valid values at the typed AST helper boundary.
    (say 4 (foundName (tyUnknownCon checker (mkTCon "" vecNew)) ""))
    (say 5
      (foundName (tyUnknownCon checker (mkTCon "MissingHead" (vecPush vecNew first)))
        "MissingHead"))
    (say 6 (foundName (tyUnknownCon checker (mkTCon "Vec" (vecPush vecNew first))) "FirstMissing"))
    (say 7 (foundName (tyUnknownCon checker (mkTArr first second)) "FirstMissing"))
    (say 8 (foundName (tyUnknownCon checker (mkTArr mkIntTy second)) "SecondMissing"))
    (say 9
      (foundName (tyUnknownCon checker (mkTTup (vecPush (vecPush vecNew first) second)))
        "FirstMissing"))
    (say 10 (foundName (tyUnknownCon checker (mkTPtr first)) "FirstMissing"))
    (say 11 (isNone (tyUnknownCon checker (mkTTup vecNew))))
    (say 12 (isNone (tyUnknownConVec checker vecNew 0)))
    (say 13 (isNone (tyUnknownCon checker mkTErr)))
    (say 14 (isNone (tyUnknownCon checker (mkTVar "a"))))
    (say 15
      (foundName (tyUnknownConVec checker (vecPush (vecPush vecNew first) second) 1)
        "SecondMissing"))
    (ambiguous checker "FirstAmbiguous")
    (ambiguous checker "SecondAmbiguous")
    (let one (mkTCon "FirstAmbiguous" vecNew))
    (let two (mkTCon "SecondAmbiguous" vecNew))
    (say 16 (isNone (tyAmbigCon checker nilNode)))
    (say 17 (isNone (tyAmbigCon checker mkIntTy)))
    (say 18 (foundName (tyAmbigCon checker one) "FirstAmbiguous"))
    (say 19 (foundName (tyAmbigCon checker (mkTCon "Vec" (vecPush vecNew one))) "FirstAmbiguous"))
    (say 20 (foundName (tyAmbigCon checker (mkTArr one two)) "FirstAmbiguous"))
    (say 21 (foundName (tyAmbigCon checker (mkTArr mkIntTy two)) "SecondAmbiguous"))
    (say 22
      (foundName (tyAmbigCon checker (mkTTup (vecPush (vecPush vecNew one) two))) "FirstAmbiguous"))
    (say 23 (foundName (tyAmbigCon checker (mkTPtr one)) "FirstAmbiguous"))
    (say 24 (isNone (tyAmbigCon checker mkTErr)))
    (say 25
      (&& (isNone (tyAmbigConVec checker vecNew 0)) (isNone (tyAmbigConVec checker nilNodes 0))))
    (say 26
      (foundName (tyAmbigConVec checker (vecPush (vecPush vecNew one) two) 1) "SecondAmbiguous"))
  })

(:: applicationNode ASTNode)
(fn (applicationNode)
  (nodeBuildEApp (mkEVar "pending") (mkEInt 0) vecNew 0))

(:: holdPendingName (-> TC String Int))
(fn (holdPendingName checker name)
  {
    (set checker.curSigVars (vecPush vecNew name))
    (evNotePendingApplication checker applicationNode mkIntTy)
    (set checker.curSigVars vecNew)
    (count name)
  })

(:: evidenceChecks ())
;@axiom:effect(io)
(fn (evidenceChecks)
  {
    (let checker (tcNew vecNew vecNew vecNew))
    (say 27 (== (vecLen (evPendingOf checker)) 0))
    (evSettle checker)
    (say 28 (== (vecLen (evPendingOf checker)) 0))
    (let application applicationNode)
    (set checker.curSigVars (vecPush vecNew "signaturevar"))
    (evNotePendingApplication checker application (mkTVar "signaturevar"))
    (say 29 (== (vecLen (evPendingOf checker)) 1))
    (let current (vecPush vecNew "differentvar"))
    (set checker.curSigVars current)
    (evSettle checker)
    (say 30 (== (nodeTy application) 2))
    (say 31 (addrEq (addrOf checker.curSigVars) (addrOf current)))
    (say 32 (== (vecLen (evPendingOf checker)) 0))
    (let unknown applicationNode)
    (setNodeTyWord unknown 7)
    (evNotePendingApplication checker unknown (mkTVar "_i_unresolved"))
    (evSettle checker)
    (say 33 (== (nodeTy unknown) 7))
    (let declaration (mkEVar "original-declaration"))
    (let parameter (mkTVar "_i_parameter"))
    (let actual (mkTVar "_i_argument"))
    (let words (vecPush vecNew (- 0 1)))
    (let environment (vecPush vecNew (TypeBinding :name "a" :ty parameter)))
    (let stamp (nodeBuildEvstampCallPlain declaration words environment))
    (setNodeTyNames stamp (vecPush vecNew "a"))
    (evNotePending checker stamp parameter actual)
    (tyPin actual mkStringTy)
    (let otherDeclaration (mkEVar "current-declaration"))
    (set checker.curDeclNode (Some otherDeclaration))
    (evSettle checker)
    (say 34 (== (vecGet words 0) 1))
    (say 35 (nodeSame (nodeAChild stamp) declaration))
    (say 36
      (match checker.curDeclNode
        ((None) false)
        ((Some node) (nodeSame node otherDeclaration))))
    (vecSet words 0 EV_LAMARG)
    (evNotePending checker stamp parameter actual)
    (evSettle checker)
    (say 37 (== (vecGet words 0) EV_LAMARG))
    (evNotePendingNode checker application actual 0)
    (say 38 (== (vecLen (evPendingOf checker)) 0))
    (evNotePendingNode checker application mkIntTy (- 0 1))
    (say 39 (== (vecLen (evPendingOf checker)) 0))
    (let name (strDup "owned-pending-context"))
    (let before (count name))
    (let during (holdPendingName checker name))
    (say 40 (== during (+ before 1)))
    (evSettle checker)
    (say 41 (== (count name) before))
    (say 42 (== (vecLen (evPendingOf checker)) 0))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (typeSearchChecks)
    (evidenceChecks)
    0
  })
