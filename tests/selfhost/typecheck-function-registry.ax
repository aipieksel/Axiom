; expect 42
; Function tables, indexes and graph paths retain FnEnt references.
; Missing names are None, exact lookup does not become suffix lookup,
; and appending after index creation preserves first-match order.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)

(:: checkedSource (-> String TC))
(fn (checkedSource source)
  {
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (let declarations (readAstNodes parsed 1))
    (let units vecNew)
    (vecPush units (CUnit2 :file "registry.ax" :src source :name "" :imports vecNew :library false))
    (checkModuleTcTyped declarations declarations units)
  })

(:: entry (-> String Int FnEnt))
(fn (entry name arity)
  (FnEnt
    :name name
    :ty mkIntTy
    :paramCount arity
    :isBuiltin 0
    :isEffectOp 0
    :effects vecNew
    :eparams vecNew
    :calls vecNew
    :rgn None
    :unsafe 0
    :uses vecNew
    :mayCalls vecNew
    :pending 0
    :scoped vecNew
    :compute vecNew
    :restrictions vecNew
    :lambdaCast NoLambdaCast))

(:: callerIndexChecks (-> TC Bool))
(fn (callerIndexChecks tc)
  {
    (let index (callersIdxBuild tc tc.allDecls))
    (if (&& (isNone (callersIdxFind index "missingCallee"))
          (isNone (callersIdxFind vecNew "missingCallee")))
      (if (let (Some helper) (callersIdxFind index "helper"))
        (if (let (Some writer) (callersIdxFind index "write"))
          {
            (let mainIndex (vecGet helper.idxs 0))
            (let helperIndex (vecGet writer.idxs 0))
            (callersIdxPut index "helper" mainIndex)
            (callersIdxPut index "helper" mainIndex)
            (callersIdxPut index "insertionOrder" mainIndex)
            (callersIdxPut index "insertionOrder" helperIndex)
            (callersIdxPut index "insertionOrder" mainIndex)
            (if (let (Some ordered) (callersIdxFind index "insertionOrder"))
              (&& (== (vecLen helper.idxs) 1)
                (&& (strEq (nodeAName (vecGet tc.allDecls mainIndex)) "main")
                  (&& (strEq (nodeAName (vecGet tc.allDecls helperIndex)) "helper")
                    (&& (== (vecLen ordered.idxs) 2)
                      (&& (== (vecGet ordered.idxs 0) mainIndex)
                        (== (vecGet ordered.idxs 1) helperIndex))))))
              false)
          }
          false)
        false)
      false)
  })

(:: graphOptionChecks (-> TC Bool))
(fn (graphOptionChecks tc)
  {
    (let first (entry "cycleFirst" 1))
    (let second (entry "cycleSecond" 1))
    (let possible (entry "possibleWrite" 1))
    (vecPush first.calls second.name)
    (vecPush second.calls first.name)
    (vecPush possible.mayCalls "write")
    (tcPushFn tc first)
    (tcPushFn tc second)
    (tcPushFn tc possible)
    (if (&& (isNone (graphWitness tc None "IO"))
          (&& (isNone (graphCycle tc None))
            (&& (isNone (graphWitness tc (Some first) "IO"))
              (&& (isNone (graphWitness tc (Some possible) "IO"))
                (isNone (graphCycle tc (findFnEnt tc "main")))))))
      (if (let (Some cycle) (graphCycle tc (Some first)))
        (if (let (Some mayPath) (graphWitnessMay tc (Some possible) "IO"))
          (if (let (Some ownPath) (graphWitness tc (findFnEnt tc "write") "IO"))
            (&& (== (vecLen cycle) 3)
              (&& (strEq (fnEntName (vecGet cycle 0)) first.name)
                (&& (strEq (fnEntName (vecGet cycle 1)) second.name)
                  (&& (strEq (fnEntName (vecGet cycle 2)) first.name)
                    (&& (== (vecLen mayPath) 2)
                      (&& (strEq (fnEntName (vecGet mayPath 1)) "write")
                        (&& (== (vecLen ownPath) 1)
                          (strEq (fnEntName (vecGet ownPath 0)) "write"))))))))
            false)
          false)
        false)
      false)
  })

(:: main Int)
(fn (main)
  {
    (let tc
      (checkedSource
        "(extern \"demo\" (write :: (-> Int Int)))\n(:: helper (-> Int Int))\n;@axiom:effect(io)\n;@axiom:effect(unsafe)\n(pub fn (helper value) (write value))\n(:: main Int)\n;@axiom:effect(io)\n(pub fn (main) (helper 42))\n"))
    (let bad
      (checkedSource
        "(:: helper (-> Int Int))\n(pub fn (helper value) value)\n(:: main Int)\n(pub fn (main) (helper \"bad\"))\n"))
    (tcPushFn tc (entry "First$duplicate" 1))
    (tcPushFn tc (entry "Second$duplicate" 2))
    (if (&& (== (countErrorDiags (tcOutVec tc)) 0)
          (&& (== (countErrorDiags (tcOutVec bad)) 1)
            (&& (isNone (findFnEnt tc "missingFunction")) (isNone (fnEntExact tc "duplicate")))))
      (if (let (Some found) (findFnEnt tc "duplicate"))
        (if (&& (strEq found.name "First$duplicate") (== found.paramCount 1))
          {
            (let pathFound (graphWitness tc (findFnEnt tc "main") "IO"))
            (if (let (Some path) pathFound)
              (if (== (vecLen path) 3)
                (if (&& (strEq (fnEntName (vecGet path 0)) "main")
                      (&& (strEq (fnEntName (vecGet path 1)) "helper")
                        (strEq (fnEntName (vecGet path 2)) "write")))
                  (if (graphOptionChecks tc)
                    (if (callerIndexChecks tc)
                      42
                      9)
                    8)
                  5)
                4)
              6)
          }
          3)
        2)
      1)
  })
