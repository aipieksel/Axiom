(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: lookupOne (-> a (Vec a)))
(fn (lookupOne value)
  (vecPush vecNew value))

(:: lookupTwo (-> a a (Vec a)))
(fn (lookupTwo first second)
  (vecPush (lookupOne first) second))

(:: lookupThree (-> a a a (Vec a)))
(fn (lookupThree first second third)
  (vecPush (lookupTwo first second) third))

(:: lookupNodes (-> String Nodes))
(fn (lookupNodes source)
  (expectParsed (parseModuleWith (lex source) (scanAxtags source))))

(:: optionalTextIs (-> (Option String) String Bool))
(fn (optionalTextIs candidate expected)
  (if (let (Some text) candidate)
    (strEq text expected)
    false))

(:: optionalBodyIs (-> (Option ASTNode) Int Bool))
(fn (optionalBodyIs candidate expected)
  (if (let (Some body) candidate)
    (&& (== (nodeTag body) TAG_E_INT) (== (nodeA body) expected))
    false))

(:: lookupHelp (-> String diag::Diag))
(fn (lookupHelp source)
  {
    (let decls (lookupNodes source))
    (let tc (tcNew decls decls vecNew))
    (let diagnostic (mkDiagBase SEV_ERROR "AX3005" "test" 0 "missing" ""))
    (importTodoHelp tc diagnostic source)
    diagnostic
  })

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index passed)
  (println "{index} {passed}"))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let functions
      (lookupNodes
        "(fn (first) 11)\n(fn (second) 22)\n(fn (normal) 1)\n(fn (panic) (while true ()))\n"))
    (writeNodeText (vecGet functions 0) 1 "One$run")
    (writeNodeText (vecGet functions 1) 1 "Two$run")
    (say 1 (isNone (findFnDecl vecNew "run")))
    (say 2
      (if (let (Some found) (findFnDecl functions "run"))
        (strEq (nodeAName found) "One$run")
        false))
    (say 3 (isNone (findFnDecl functions "One$run")))
    (say 4 (optionalBodyIs (findFnBody functions "run") 11))
    (say 5 (isNone (findFnBody functions "absent")))
    (let incomplete (lookupNodes "(fn (unfinished) 1)"))
    (writeNodeChild (vecGet incomplete 0) 3 nilNode)
    (say 6
      (&& (isSome (findFnDecl incomplete "unfinished"))
        (isNone (findFnBody incomplete "unfinished"))))
    (let signatures
      (lookupNodes
        "(:: produced (-> Int a))\n(:: identity (-> a a))\n(:: demanded (-> (-> a Int) Int))\n(:: both (-> (-> a Int) b))\n"))
    (say 7 (optionalTextIs (resultOnlyVarOf (vecGet signatures 0)) "a"))
    (say 8 (isNone (resultOnlyVarOf (vecGet signatures 1))))
    (say 9 (isNone (demandedVarOf (vecGet signatures 1))))
    (say 10 (optionalTextIs (demandedVarOf (vecGet signatures 2)) "a"))
    (say 11 (optionalTextIs (resultOnlyVarOf (vecGet signatures 3)) "b"))
    (say 12 (optionalTextIs (demandedVarOf (vecGet signatures 3)) "a"))
    (say 13 (isNone (firstResultOnly vecNew vecNew 0)))
    (say 14 (optionalTextIs (firstResultOnly (lookupOne "a") (lookupTwo "a" "b") 0) "b"))
    (say 15 (optionalTextIs (firstResultOnly vecNew (lookupOne "") 0) ""))
    (say 16 (isNone (firstDemanded (lookupOne "a") (lookupOne "a") 0)))
    (say 17 (optionalTextIs (firstDemanded (lookupTwo "a" "b") (lookupOne "a") 0) "b"))
    (say 18 (optionalTextIs (firstDemanded (lookupOne "") vecNew 0) ""))
    (say 19 (isNone (divHeadName nilNode)))
    (say 20 (isNone (divHeadName (nodeBuildEIntPlain 1 0 0))))
    (say 21 (optionalTextIs (divHeadName (mkEApp (mkEVar "Module$call") (mkEInt 1))) "call"))
    (say 22 (== (divCall functions "sysExitWith" vecNew 0) 1))
    (say 23 (== (divCall functions "absent" vecNew 0) 0))
    (say 24 (== (divCall functions "panic" vecNew 0) 1))
    (let survivors (divFixpoint functions (lookupThree "normal" "panic" "absent")))
    (say 25 (&& (== (vecLen survivors) 1) (strEq (vecGet survivors 0) "panic")))
    (let imports (lookupNodes "(import Vec)\n(import IO (println))\n(import Str)\n"))
    (say 26 (isNone (lastImportOf vecNew None 0 None)))
    (say 27
      (if (let (Some found) (lastImportOf imports (Some "IO") 0 None))
        (strEq (nodeAName found) "IO")
        false))
    (say 28
      (if (let (Some found) (lastImportOf imports None 0 None))
        (strEq (nodeAName found) "Str")
        false))
    (say 29 (isNone (lastImportOf imports (Some "Missing") 0 None)))
    (say 30 (isNone (lastImportOf imports (Some "") 0 None)))
    (let reordered (lookupTwo (vecGet imports 2) (vecGet imports 0)))
    (say 31
      (if (let (Some found) (lastImportOf reordered None 0 None))
        (strEq (nodeAName found) "Str")
        false))
    (let noImports (lookupHelp "(:: main Int)\n(fn (main) 0)\n"))
    (say 32
      (&& (== (diagHelpCount noImports) 1)
        (strEq (diagHelpFixText noImports 0) "(import IO (todo))\n")))
    (say 33 (== (spanStart (diagHelpFixSpan noImports 0)) 0))
    (let otherImport (lookupHelp "(import Str)\n(:: main Int)\n(fn (main) 0)\n"))
    (say 34
      (&& (== (diagHelpCount otherImport) 1)
        (strEq (diagHelpFixText otherImport 0) "\n(import IO (todo))")))
    (let listedIO (lookupHelp "(import IO (println))\n(:: main Int)\n(fn (main) 0)\n"))
    (say 35 (&& (== (diagHelpCount listedIO) 1) (strEq (diagHelpFixText listedIO 0) " todo")))
    (let bareIO (lookupHelp "(import IO)\n(:: main Int)\n(fn (main) 0)\n"))
    (say 36 (== (diagHelpCount bareIO) 0))
    0
  })
