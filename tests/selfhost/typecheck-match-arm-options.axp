(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Vec)
(import Str)
(import Mem)
(import IO)
(import Sys)
(import raw)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: sameType (-> (Option ASTNode) ASTNode Bool))
(fn (sameType found wanted)
  (match found
    ((None) false)
    ((Some ty) (nodeSame ty wanted))))

(struct Collected
  (result : ASTNode)
  (types : ArmTypes))

(:: collect (-> TC Nodes ASTNode Int Collected))
(fn (collect checker arms fallback discard)
  {
    (let types (:: vecNew ArmTypes))
    (let caught (memAlloc 8))
    (memSetWord caught 0 0)
    (let result
      (checkArms checker arms 0 vecNew caught fallback mkIntTy mkIntTy (:: None (Option ASTNode))
        types discard))
    (Collected :result result :types types)
  })

(:: rejected ASTNode)
(fn (rejected)
  (nodeBuildMFor "not-a-pattern" (mkEInt 0) vecNew (mkSpan 1 2)))

(:: retireRows (-> ASTNode Bool))
(fn (retireRows ty)
  {
    (let rows (:: vecNew ArmTypes))
    (vecPush rows (:: None (Option ASTNode)))
    (vecPush rows (Some ty))
    (vecOwnsRefs rows)
  })

(:: checks ())
;@axiom:effect(io)
(fn (checks)
  {
    (let integer mkIntTy)
    (let string mkStringTy)
    (let poison mkTErr)
    (let wildcard mkSilentWild)
    (let unit mkUnitTy)
    (let body (nodeBuildEInt 1 0 0 (mkSpan 10 11)))
    (let checker (tcNew vecNew vecNew vecNew))
    (say 1 (isNone (armTypeOpt nilNode)))
    (say 2 (sameType (armTypeOpt poison) poison))
    (say 3 (sameType (armTypeOpt wildcard) wildcard))
    (say 4 (sameType (armTypeOpt unit) unit))
    (say 5 (isNone (armJoin checker None poison body 0)))
    (say 6 (isNone (armJoin checker None wildcard body 0)))
    (say 7 (sameType (armJoin checker None integer body 0) integer))
    (say 8 (sameType (armJoin checker (Some integer) poison body 0) integer))
    (say 9 (sameType (armJoin checker (Some integer) wildcard body 0) integer))
    (say 10 (sameType (armJoin checker (Some integer) string body 0) integer))
    (say 11
      (&& (== (vecLen checker.out) 1)
        (&& (strEq (diagCode (vecGet checker.out 0)) "AX3004")
          (== (spanStart (diagSpan (vecGet checker.out 0))) 10))))
    (let dropped (tcNew vecNew vecNew vecNew))
    (say 12
      (&& (sameType (armJoin dropped (Some integer) string body 1) integer)
        (== (vecLen dropped.out) 0)))
    (say 13
      (if (let (Some ty) (armJoin dropped (Some integer) unit body 0))
        (tyIsUnit ty)
        false))
    (say 14
      (if (let (Some ty) (armJoin dropped (Some unit) string body 0))
        (tyIsUnit ty)
        false))
    (let rows (:: vecNew ArmTypes))
    (say 15 (matchArmsAgree dropped rows 0 None))
    (say 16 (! (matchArmsUnit rows 0)))
    (vecPush rows (:: None (Option ASTNode)))
    (say 17 (vecOwnsRefs rows))
    (vecPush rows (Some poison))
    (vecPush rows (Some wildcard))
    (vecPush rows (Some integer))
    (say 18 (matchArmsAgree dropped rows 0 None))
    (say 19 (! (matchArmsUnit rows 0)))
    (vecPush rows (Some string))
    (say 20 (! (matchArmsAgree dropped rows 0 None)))
    (vecPush rows (Some unit))
    (say 21 (matchArmsUnit rows 0))
    (let owned (mkTCon (strDup "Owned") vecNew))
    (let before (count owned))
    (let owners (:: vecNew ArmTypes))
    (vecPush owners (:: None (Option ASTNode)))
    (vecPush owners (Some owned))
    (say 22 (vecOwnsRefs owners))
    (say 23 (== (count owned) (+ before 1)))
    (vecClear owners)
    (say 24 (== (count owned) before))
    (vecPush owners (:: None (Option ASTNode)))
    (for i in 0..20
      (vecPush owners (Some owned)))
    (say 25 (&& (vecOwnsRefs owners) (> (vecCap owners) 8)))
    (say 26 (== (count owned) (+ before 20)))
    (vecClear owners)
    (say 27 (== (count owned) before))
    (vecPush owners (Some owned))
    (vecPush owners (:: None (Option ASTNode)))
    (say 28 (vecOwnsRefs owners))
    (vecSet owners 0 (:: None (Option ASTNode)))
    (say 29 (== (count owned) before))
    (say 30 (isNone (vecGet owners 0)))
    (let collecting (tcNew vecNew vecNew vecNew))
    (pushScope collecting.scope "value" 0 0 owned)
    (let query rejected)
    (let normal (nodeBuildMArm (mkEVar "bound") (mkEVar "value") 0 0))
    (let arms (vecPush (vecPush vecNew query) normal))
    (let checked (collect collecting arms integer 0))
    (say 31
      (&& (== (vecLen checked.types) 2)
        (&& (isNone (vecGet checked.types 0)) (sameType (vecGet checked.types 1) owned))))
    (say 32 (vecOwnsRefs checked.types))
    (say 33 (nodeSame checked.result owned))
    (say 34
      (&& (== (vecLen collecting.out) 1) (strEq (diagCode (vecGet collecting.out 0)) "AX3028")))
    (let skipped (collect (tcNew vecNew vecNew vecNew) (vecPush vecNew rejected) integer 0))
    (say 35 (&& (nodeSame skipped.result integer) (isNone (vecGet skipped.types 0))))
    (let emptyArm (nodeBuildMArm (mkEVar "_") nilNode 0 0))
    (let emptyChecked (collect (tcNew vecNew vecNew vecNew) (vecPush vecNew emptyArm) integer 0))
    (say 36 (&& (tyIsUnit emptyChecked.result) (matchArmsUnit emptyChecked.types 0)))
    (say 37 (== (vecLen collecting.scope) 1))
    (discardArms collecting arms checked.types 0)
    (say 38 (&& (== (nodeTag query) TAG_M_FOR) (== (nodeTag (nodeBChild normal)) TAG_E_BEGIN)))
    (let untouched (nodeBuildMArm (mkEVar "_") (mkEInt 2) 0 0))
    (discardArms collecting (vecPush vecNew untouched) (:: vecNew ArmTypes) 0)
    (say 39 (== (nodeTag (nodeBChild untouched)) TAG_E_INT))
    (say 40 (== (armTailSpan nilNode) 0))
    (say 41 (== (spanStart (armTailSpan body)) 10))
    (let tail (nodeBuildEInt 2 0 0 (mkSpan 20 21)))
    (let block (nodeBuildEBegin (vecPush (vecPush vecNew body) tail) 0 0 (mkSpan 5 6)))
    (say 42 (== (spanStart (armTailSpan block)) 20))
    (say 43 (== (spanStart (armTailSpan (mkELetAt "local" body block (mkSpan 2 3)))) 20))
    (say 44 (== (armTailSpan (nodeBuildEBegin vecNew 0 0 (mkSpan 5 6))) 0))
    (say 45 (== (armTailSpan (mkELetAt "local" body nilNode (mkSpan 2 3))) 0))
    (say 46
      (==
        (spanStart
          (armTailSpan
            (nodeBuildEBegin (vecPush (vecPush vecNew body) (mkEInt 0)) 0 0 (mkSpan 5 6))))
        10))
    (let resultChecker (tcNew vecNew vecNew vecNew))
    (let resultBody (nodeBuildEInt 1 0 0 (mkSpan 30 31)))
    (let resultArm (nodeBuildMArm (mkEVar "_") resultBody 0 0))
    (discardArms resultChecker (vecPush vecNew resultArm)
      (vecPush (:: vecNew ArmTypes) (Some (mkTCon "Err$Result" vecNew))) 0)
    (say 47
      (&& (== (vecLen resultChecker.out) 1)
        (strEq (diagCode (vecGet resultChecker.out 0)) "AX3046")))
    (say 48 (== (nodeTag resultBody) TAG_E_BEGIN))
    (let recovering (tcNew vecNew vecNew vecNew))
    (collect recovering
      (vecPush (vecPush vecNew rejected)
        (nodeBuildMArm (mkEVar "_") (mkEVarAt "missing" (mkSpan 40 41)) 0 0))
      integer 0)
    (say 49
      (&& (== (vecLen recovering.out) 2)
        (&& (strEq (diagCode (vecGet recovering.out 0)) "AX3028")
          (strEq (diagCode (vecGet recovering.out 1)) "AX3001"))))
    (say 50 (probeCaseGood 0))
    (say 51 (probeCaseGood 1))
    (say 52 (probeCaseGood 2))
    (say 53 (probeCaseGood 3))
    (say 54 (probeCaseGood 4))
    (say 55 (probeCaseGood 5))
    (let beforeClear (count owned))
    (vecClear checked.types)
    (say 56 (== (count owned) (- beforeClear 1)))
    (let beforeDeath (count owned))
    (let retired (retireRows owned))
    (say 57 (&& retired (== (count owned) beforeDeath)))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (> sysArgc 1)
    {
      (writeStr stdout (probeCaseText (strToInt (sysArg 1))))
      0
    }
    {
      (checks)
      0
    }))
