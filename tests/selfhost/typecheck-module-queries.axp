; Module lookup absence, valid unit zero and import visibility remain distinct.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)

(:: parsed (-> String Nodes))
(fn (parsed source)
  (match (parseModule (lex source))
    ((ParseFailed error) __indexTrap)
    ((ParseSuccess declarations position) declarations)))

(:: declaration (-> String (Option String) ASTNode))
(fn (declaration source moduleName)
  {
    (let node (vecGet (parsed source) 0))
    (if (let (Some name) moduleName)
      (writeNodeText node 8 name))
    node
  })

(:: unit (-> (Option String) CUnit2))
(fn (unit name)
  (CUnit2 :file "module.ax" :src "" :name name :imports vecNew :library false))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs found expected)
  (match found
    ((None) false)
    ((Some index) (== index expected))))

(:: importChecks (-> Nodes String Strings Diags))
(fn (importChecks declarations moduleName names)
  {
    (let out vecNew)
    (checkImportNameList moduleName names 9 declarations out 0 0)
    out
  })

(:: diagnosticIs (-> Diags Int String Bool))
(fn (diagnosticIs diagnostics index message)
  (if (< index (vecLen diagnostics))
    (&& (strEq (diagCode (vecGet diagnostics index)) "AX3023")
      (strEq (diagMsg (vecGet diagnostics index)) message))
    false))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let imported (unit (Some "Owner")))
    (let entry (unit None))
    (let empty (unit (Some "")))
    (let units (vecPush (vecPush vecNew entry) imported))
    (let repeated (vecPush (vecPush (vecPush vecNew imported) entry) imported))
    (say 1 (isNone (unitIndexForFrom vecNew "Owner" 0)))
    (say 2 (indexIs (unitIndexForFrom (vecPush vecNew imported) "Owner" 0) 0))
    (say 3 (indexIs (unitIndexForFrom units "Owner" 0) 1))
    (say 4 (isNone (unitIndexForFrom units "Missing" 0)))
    (say 5 (indexIs (unitIndexForFrom (vecPush vecNew empty) "" 0) 0))
    (say 6 (isNone (unitIndexForFrom (vecPush vecNew entry) "" 0)))
    (say 7 (indexIs (unitIndexForFrom repeated "Owner" 0) 0))
    (say 8 (indexIs (unitIndexForFrom repeated "Owner" 1) 2))
    (say 9 (isNone (unitIndexForFrom repeated "Owner" 3)))
    (say 10 (== (unitIndexFor vecNew None) 0))
    (say 11 (== (unitIndexFor units (Some "Missing")) 0))
    (say 12 (== (unitIndexFor units (Some "Owner")) 1))
    (say 13 (== (unitIndexFor (vecPush (vecPush vecNew entry) empty) (Some "")) 1))
    (say 14 (== (unitIndexFor (vecPush vecNew empty) (Some "")) 0))
    (say 15 (indexIs (unitIndexForFrom units (strDup "Owner") 0) 1))
    (let visible (declaration "(pub fn (visible) 1)" (Some "Owner")))
    (let hidden (declaration "(fn (hidden) 2)" (Some "Owner")))
    (let root (declaration "(pub fn (root) 3)" None))
    (let unnamed (declaration "(pub fn (unnamed) 4)" (Some "")))
    (let declarations (vecPush (vecPush (vecPush (vecPush vecNew visible) hidden) root) unnamed))
    (say 16 (declaredInModule declarations "Owner" "visible" 0))
    (say 17 (exportedFromModule declarations "Owner" "visible" 0))
    (say 18 (declaredInModule declarations "Owner" "hidden" 0))
    (say 19 (! (exportedFromModule declarations "Owner" "hidden" 0)))
    (say 20 (! (declaredInModule declarations "Owner" "missing" 0)))
    (say 21 (! (exportedFromModule declarations "Owner" "missing" 0)))
    (say 22 (! (declaredInModule declarations "Other" "visible" 0)))
    (say 23 (! (declaredInModule declarations "" "root" 0)))
    (say 24 (declaredInModule declarations "" "unnamed" 0))
    (say 25 (exportedFromModule declarations "" "unnamed" 0))
    (say 26 (! (declaredInModule declarations "Owner" "root" 0)))
    (say 27 (! (declaredInModule declarations "Owner" "visible" 4)))
    (say 28 (! (exportedFromModule declarations "Owner" "visible" 4)))
    (let duplicate (declaration "(fn (visible) 5)" (Some "Owner")))
    (say 29 (exportedFromModule (vecPush (vecPush vecNew duplicate) visible) "Owner" "visible" 0))
    (say 30 (declaredInModule declarations (strDup "Owner") (strDup "visible") 0))
    (let external (declaration "(pub extern \"demo\" (yes :: Int) (no :: Int))" (Some "Owner")))
    (writeNodeWord (vecGet (nodeCChildren external) 0) 5 1)
    (writeNodeWord (vecGet (nodeCChildren external) 1) 5 0)
    (let externs (vecPush vecNew external))
    (say 31 (declaredInModule externs "Owner" "yes" 0))
    (say 32 (exportedFromModule externs "Owner" "yes" 0))
    (say 33 (declaredInModule externs "Owner" "no" 0))
    (say 34 (! (exportedFromModule externs "Owner" "no" 0)))
    (say 35 (! (declaredInModule externs "Owner" "missing" 0)))
    (writeNodeWord external 5 0)
    (say 36 (! (exportedFromModule externs "Owner" "yes" 0)))
    (say 37 (== (vecLen (importChecks declarations "Owner" (vecPush vecNew "visible"))) 0))
    (say 38
      (diagnosticIs (importChecks declarations "Owner" (vecPush vecNew "hidden")) 0
        "module `Owner` declares `hidden` but does not export it"))
    (say 39
      (diagnosticIs (importChecks declarations "Owner" (vecPush vecNew "missing")) 0
        "module `Owner` declares no `missing`"))
    (let diagnostics
      (importChecks declarations "Owner"
        (vecPush (vecPush (vecPush vecNew "visible") "hidden") "missing")))
    (say 40
      (&& (== (vecLen diagnostics) 2)
        (&& (diagnosticIs diagnostics 0 "module `Owner` declares `hidden` but does not export it")
          (diagnosticIs diagnostics 1 "module `Owner` declares no `missing`"))))
    (say 41 (== (vecLen (importChecks declarations "Owner" vecNew)) 0))
  })
