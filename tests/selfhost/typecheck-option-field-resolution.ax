; expect 42
; None's element placeholder is pinned by the other branch. Reading
; and assigning fields must resolve that pin before inspecting its tag.
(import Str)

(struct Item
  (mut value : Int))

(:: item (Option Item))
(fn (item)
  (Some (Item :value 21)))

(:: readItem (-> Bool Int))
(fn (readItem empty)
  {
    (let found
      (if empty
        None
        item))
    (if (let (Some value) found)
      value.value
      0)
  })

(:: writeItem (-> Bool Int))
(fn (writeItem empty)
  {
    (let found
      (if empty
        None
        item))
    (if (let (Some value) found)
      {
        (set value.value 21)
        value.value
      }
      0)
  })

(:: main Int)
(fn (main)
  (if (&& (== (readItem true) 0) (== (writeItem true) 0))
    (+ (readItem false) (writeItem false))
    1))
