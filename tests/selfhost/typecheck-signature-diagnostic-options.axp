(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

; Diagnostic metadata only: a known lexical origin and an outer destination.
; No traversal, lifetime inference or fixpoint is run by these helpers.
(:: diagnosticContext (-> Int String Int RgnCtx))
(fn (diagnosticContext report capture origin)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let entries (regFn vecNew "metadata" mkIntTy))
    (let declaration (nodeBuildDFn "metadata" vecNew (mkEInt 0) (mkSpan 0 1)))
    (let rc (rgnCtxNew tc declaration (vecGet entries 0) report))
    (vecPush rc.formParents 0)
    (vecPush rc.formNames "inner")
    (vecPush rc.extentSpans (mkSpan 10 15))
    (vecPush rc.capNames capture)
    (vecPush rc.capOrigins origin)
    rc
  })

; option probes begin
(:: checkedFunction (-> (Option ASTNode) Names ASTNode TC))
(fn (checkedFunction signature params body)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (if (let (Some ty) signature)
      {
        (regFn tc.fns "probe" ty)
        (fnIdxNote tc (vecGet tc.fns (- (vecLen tc.fns) 1)))
      })
    (tcCheckFn tc (nodeBuildDFn "probe" params body (mkSpan 0 1)))
    tc
  })

(:: inferredTypeIs (-> TC String Bool))
(fn (inferredTypeIs tc expected)
  (if (let (Some ent) (findFnEnt tc "probe"))
    (strEq (tyRender ent.ty) expected)
    false))

(:: diagnosticCodeIs (-> RgnCtx Int Int (Option ASTNode) String Bool))
(fn (diagnosticCodeIs rc bad span value expected)
  {
    (rgnEmitEscape rc bad span "the outer binding" "" value)
    (if (== (vecLen rc.tc.out) 1)
      (strEq (diagCode (vecGet rc.tc.out 0)) expected)
      false)
  })

(:: runOptions ())
;@axiom:effect(io)
(fn (runOptions)
  {
    (let names (vecPush (vecPush vecNew "x") "y"))
    (let tc (tcNew vecNew vecNew vecNew))
    (let types (:: vecNew Nodes))
    (bindFnParams tc names types None 0)
    (say 1 (&& (tyIsBareInt (vecGet types 0)) (tyIsBareInt (vecGet types 1))))
    (say 2 (== (tcCounter tc) 2))
    (let arrowTc (tcNew vecNew vecNew vecNew))
    (let arrowTypes (:: vecNew Nodes))
    (let text mkStringTy)
    (bindFnParams arrowTc names arrowTypes (Some (mkTArr text mkIntTy)) 0)
    (say 3 (nodeSame (vecGet arrowTypes 0) text))
    (say 4 (strEq (nodeAName (vecGet arrowTypes 1)) "_t1"))
    (say 5 (== (tcCounter arrowTc) 2))
    (let missing (checkedFunction None names (mkEVar "x")))
    (say 6 (== (tcCounter missing) 2))
    (say 7 (== (vecLen missing.out) 0))
    (say 8 (isNone (findFnEnt missing "probe")))
    (say 9 (&& (isNone missing.curDeclNode) (isNone missing.curModule)))
    (say 10 (&& (== (vecLen missing.scope) 0) (== (vecLen missing.curSigVars) 0)))
    (let declared
      (checkedFunction (Some (mkTArr mkIntTy mkIntTy)) (vecPush vecNew "x") (mkEVar "x")))
    (say 11
      (&& (== (tcCounter declared) 1)
        (&& (== (vecLen declared.out) 0) (== (vecGet declared.curCallable 0) 0))))
    (let minted (checkedFunction (Some (mkTVar "_fn_probe")) names (mkEVar "x")))
    (say 12 (== (tcCounter minted) 2))
    (say 13 (inferredTypeIs minted "(Int -> (Int -> Int))"))
    (say 14 (== (vecLen minted.out) 0))
    (let poison (checkedFunction (Some mkTErr) vecNew (mkEInt 1)))
    (say 15 (&& (== (tcCounter poison) 0) (== (vecLen poison.out) 0)))
    (let unit (checkedFunction (Some mkUnitTy) vecNew (mkEInt 1)))
    (say 16 (&& (== (tcCounter unit) 0) (== (vecLen unit.out) 0)))
    (let variable (mkTVar "a"))
    (let generic
      (checkedFunction (Some (mkTArr variable variable)) (vecPush vecNew "x") (mkEVar "x")))
    (say 17 (&& (== (tcCounter generic) 1) (== (vecLen generic.out) 0)))
    (let wireMissing (tcNew vecNew vecNew vecNew))
    ; Existing FnEnt.ty parser-wire boundary: absent type, present registry entry.
    (regFn wireMissing.fns "probe" nilNode)
    (fnIdxNote wireMissing (vecGet wireMissing.fns (- (vecLen wireMissing.fns) 1)))
    (tcCheckFn wireMissing (nodeBuildDFn "probe" (vecPush vecNew "x") (mkEVar "x") (mkSpan 0 1)))
    (say 18 (&& (== (tcCounter wireMissing) 1) (== (vecLen wireMissing.out) 0)))
    (let lam (nodeBuildELam vecNew (mkEInt 0) 0 0))
    (let span (mkSpan 1 4))
    (let absent (diagnosticContext 1 "stale" 2))
    (say 19 (diagnosticCodeIs absent 65 span None "AX3060"))
    (say 20 (== (diagSecCount (vecGet absent.tc.out 0)) 1))
    (say 21 (== (spanStart (diagSecSpan (vecGet absent.tc.out 0) 0)) 10))
    (say 22 (diagnosticCodeIs (diagnosticContext 1 "captured" 2) 65 span (Some lam) "AX3062"))
    (say 23
      (diagnosticCodeIs (diagnosticContext 1 "captured" 2) 65 span (Some (mkEInt 1)) "AX3060"))
    (say 24 (diagnosticCodeIs (diagnosticContext 1 "captured" 2) 65 span (Some mkTErr) "AX3060"))
    (let emptyName (diagnosticContext 1 "" 2))
    (say 25 (diagnosticCodeIs emptyName 65 span (Some lam) "AX3062"))
    (say 26 (strStartsWith (diagMsg (vecGet emptyName.tc.out 0)) "the closure captures ``"))
    (let reportOff (diagnosticContext 0 "captured" 2))
    (rgnEmitEscape reportOff 65 span "the outer binding" "" (Some lam))
    (say 27 (== (vecLen reportOff.tc.out) 0))
    (let noBad (diagnosticContext 1 "captured" 2))
    (rgnEmitEscape noBad 0 span "the outer binding" "" (Some lam))
    (say 28 (== (vecLen noBad.tc.out) 0))
    (let duplicate (diagnosticContext 1 "captured" 2))
    (vecPush duplicate.tc.rgnRefused span)
    (rgnEmitEscape duplicate 65 span "the outer binding" "" (Some lam))
    (say 29 (== (vecLen duplicate.tc.out) 0))
    (say 30 (diagnosticCodeIs (diagnosticContext 1 "captured" 1) 65 span (Some lam) "AX3060"))
    (say 31 (&& (== absent.changed 0) (== absent.facts.resultCUR 0)))
  })

; option probes end
; diagnostics begin
(:: runDiagnostics ())
;@axiom:effect(io)
(fn (runDiagnostics)
  {
    (let source "abcdefghijklmnopqrstuvwxyz0123456789\n")
    (let units
      (vecPush vecNew
        (CUnit2 :file "diagnostic-value.ax" :src source :name None :imports vecNew :library false)))
    (let lam (nodeBuildELam vecNew (mkEInt 0) 0 0))
    (let span (mkSpan 1 4))
    (let absent (diagnosticContext 1 "stale" 2))
    (rgnEmitEscape absent 65 span "the outer binding" " - synthetic flow" None)
    (writeStr stdout (renderDiagsUnits absent.tc.out units))
    (let captured (diagnosticContext 1 "captured" 2))
    (rgnEmitEscape captured 65 span "the outer binding" " - concrete value" (Some lam))
    (writeStr stdout (renderDiagsUnits captured.tc.out units))
    (let empty (diagnosticContext 1 "" 2))
    (rgnEmitEscape empty 65 span "the outer binding" "" (Some lam))
    (writeStr stdout (renderDiagsUnits empty.tc.out units))
    (let ordinary (diagnosticContext 1 "stale" 2))
    (rgnEmitEscape ordinary 65 span "the outer binding" "" (Some (mkEInt 1)))
    (writeStr stdout (renderDiagsUnits ordinary.tc.out units))
  })

; diagnostics end
(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (runOptions)
    (writeStr stdout "DIAGNOSTICS\n")
    (runDiagnostics)
    0
  })
