; Trivia lookup preserves byte zero and keeps exhausted input absent.
(import core)
(import parser)
(import typecheck)
(import Str)
(import Vec)
(import IO)

(:: positionIs (-> (Option Int) Int Bool))
(fn (positionIs found expected)
  (match found
    ((None) false)
    ((Some position) (== position expected))))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: matchEnd (-> String (Option Int)))
(fn (matchEnd source)
  (matchCloseAt source (mkEVarAt "x" (mkSpan 7 8)) vecNew))

(:: closesAtEnd (-> String Bool))
(fn (closesAtEnd source)
  (positionIs (matchEnd source) (- (strLen source) 1)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (positionIs (skipTrivia ")" 0) 0))
    (say 2 (positionIs (skipTrivia "token" 0) 0))
    (say 3 (positionIs (skipTrivia " \t\r\n)" 0) 4))
    (say 4 (positionIs (skipTrivia "text)" 4) 4))
    (say 5 (isNone (skipTrivia "" 0)))
    (say 6 (isNone (skipTrivia " \t\r\n" 0)))
    (say 7 (isNone (skipTrivia "x" 1)))
    (say 8 (isNone (skipTrivia "x" 4)))
    (say 9 (isNone (skipTrivia ";" 0)))
    (say 10 (isNone (skipTrivia "; )" 0)))
    (say 11 (positionIs (skipTrivia "; )\n)" 0) 4))
    (say 12 (positionIs (skipTrivia "#| ) |#)" 0) 7))
    (say 13 (positionIs (skipTrivia "#| outer #| ) |# end |#)" 0) 23))
    (say 14 (isNone (skipTrivia "#| ) |#" 0)))
    (say 15 (isNone (skipTrivia "#| )" 0)))
    (say 16 (positionIs (skipTrivia "\";)\"" 0) 0))
    (say 17 (positionIs (skipTrivia "';'" 0) 0))
    (say 18 (positionIs (skipTrivia "#" 0) 0))
    (say 19 (positionIs (skipTrivia "#x" 0) 0))
    (say 20 (positionIs (skipTrivia (strDup " ;comment\n x") 0) 11))
    (say 21 (isNone (skipTrivia "x" -1)))
    (say 22 (closesAtEnd "(match x)"))
    (say 23 (closesAtEnd "(match x \t)"))
    (say 24 (closesAtEnd "(match x ; )\n)"))
    (say 25 (closesAtEnd "(match x #| ) |#)"))
    (say 26 (closesAtEnd "(match x #| nested #| ) |# |#)"))
    (say 27 (isNone (matchEnd "(match x")))
    (say 28 (isNone (matchEnd "(match x ;)")))
    (say 29 (isNone (matchEnd "(match x #| ) |#")))
    (say 30 (isNone (matchEnd "(match x nope)")))
    (say 31 (isNone (matchEnd "(match x \"ignore)\")")))
    (say 32 (isNone (matchEnd "(match x ')')")))
    (say 33 (isNone (matchEnd "(match x #|unterminated)")))
    (say 34 (positionIs (matchEnd "(match x)# tail") 8))
  })
