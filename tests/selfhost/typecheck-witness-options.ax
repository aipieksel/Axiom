; expect 42
; Optional validation witnesses preserve the first offending node.
; A real error type is still a witness; it is never absence.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)

; Fixture inputs must parse before semantic assertions run.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: witnessIs (-> (Option ASTNode) ASTNode Bool))
(fn (witnessIs found expected)
  (match found
    ((None) false)
    ((Some node) (nodeSame node expected))))

(:: witnessContext (-> String TC))
(fn (witnessContext source)
  {
    (let declarations (expectParsed (parseModuleWith (lex source) (scanAxtags source))))
    (let units vecNew)
    (vecPush units
      (CUnit2
        :file "witness-options.ax"
        :src source
        :name (Some "")
        :imports vecNew
        :library false))
    (tcNew declarations declarations units)
  })

(:: freeVariableChecks Bool)
(fn (freeVariableChecks)
  {
    (let params (vecPush vecNew "a"))
    (let first (mkTVar "b"))
    (let second (mkTVar "c"))
    (let types (vecPush (vecPush vecNew first) second))
    (let fields (vecPush vecNew (setNodeTyChild (mkField "value" 0) first)))
    (let ctor (setNodeTyChildren (mkCtor "Case" 1 (vecPush vecNew 0)) types))
    (&& (isNone (aliasFreeVar nilNode params))
      (&& (isNone (aliasFreeVar (mkTVar "") params))
        (&& (isNone (aliasFreeVar (mkTVar "a") params))
          (&& (isNone (aliasFreeVar mkTErr params))
            (&& (witnessIs (aliasFreeVar (mkTArr first second) params) first)
              (&& (witnessIs (aliasFreeVar (mkTArr (mkTVar "a") second) params) second)
                (&& (witnessIs (aliasFreeVar (mkTPtr first) params) first)
                  (&& (witnessIs (aliasFreeVarVec types params 0) first)
                    (&& (isNone (aliasFreeVarVec vecNew params 0))
                      (&& (witnessIs (dataFreeVar (vecPush vecNew ctor) params 0) first)
                        (&& (isNone (dataFreeVar vecNew params 0))
                          (&& (witnessIs (structFreeVar fields params 0) first)
                            (isNone (structFreeVar vecNew params 0))))))))))))))
  })

(:: renderingChecks Bool)
(fn (renderingChecks)
  {
    (let tc (witnessContext ""))
    (let functionTy (mkTArr mkIntTy mkIntTy))
    (let errorTy mkTErr)
    (let missingField (nodeBuildFieldFlagsPlain "missing" 0 0))
    (let fields
      (vecPush (vecPush vecNew (setNodeTyChild (mkField "good" 0) mkIntTy))
        (setNodeTyChild (mkField "bad" 0) functionTy)))
    (let missingWitness
      (match (showDerivableFields tc (vecPush vecNew missingField) vecNew 0)
        ((None) false)
        ((Some ty) (&& (== (nodeTag ty) TAG_T_VAR) (strEq (nodeAName ty) "?")))))
    (let missingType
      (match (showDerivable tc nilNode vecNew)
        ((None) false)
        ((Some ty) (&& (== (nodeTag ty) TAG_T_VAR) (strEq (nodeAName ty) "?")))))
    (let result (showEnsure tc (mkTVar "a") (mkSpan 1 3)))
    (&& (isNone (showDerivable tc mkIntTy vecNew))
      (&& (isNone (showDerivableVec tc (vecPush vecNew mkIntTy) vecNew 0))
        (&& (isNone (showDerivableCtors tc vecNew mkIntTy vecNew 0))
          (&& (witnessIs (showDerivable tc errorTy vecNew) errorTy)
            (&& (witnessIs (showDerivableFields tc fields vecNew 0) functionTy)
              (&& missingWitness
                (&& missingType
                  (&& (isNone result)
                    (if (== (vecLen (tcOutVec tc)) 1)
                      (&& (strEq (diagCode (vecGet (tcOutVec tc) 0)) "AX3025")
                        (strEq (diagMsg (vecGet (tcOutVec tc) 0))
                          "`format` cannot render `a`: it holds a value whose type is a type variable"))
                      false)))))))))
  })

(:: castWitnessChecks Bool)
(fn (castWitnessChecks)
  {
    (let literal (mkEInt 7))
    (let second (mkEInt 8))
    (let head (mkEIf (mkEVar "test") (mkEVar "yes") (mkEVar "no")))
    (&& (isNone (castTypeBadPart nilNode))
      (&& (isNone (castTypeBadPart (mkEVar "Int")))
        (&& (isNone (castTypeBadPart mkIntTy))
          (&& (isNone (castTypeBadArgs vecNew 0))
            (&& (witnessIs (castTypeBadPart literal) literal)
              (&& (witnessIs (castTypeBadPart (mkEApp head (mkEVar "Int"))) head)
                (&& (witnessIs (castTypeBadPart (mkEApp (mkEVar "Vec") literal)) literal)
                  (witnessIs (castTypeBadArgs (vecPush (vecPush vecNew literal) second) 0)
                    literal))))))))
  })

(:: aliasDiagnosticChecks Bool)
(fn (aliasDiagnosticChecks)
  {
    (let tc (witnessContext "(type Invalid a (-> b c))\n"))
    (tcCheckAliasDecls tc tc.allDecls 0)
    (if (== (vecLen (tcOutVec tc)) 1)
      (&& (strEq (diagMsg (vecGet (tcOutVec tc) 0)) "undeclared type parameter `b`")
        (== (nodeTag (nodeBChild (vecGet tc.allDecls 0))) TAG_T_ERR))
      false)
  })

(:: main Int)
(fn (main)
  (if (freeVariableChecks)
    (if (renderingChecks)
      (if (castWitnessChecks)
        (if (aliasDiagnosticChecks)
          42
          4)
        3)
      2)
    1))
