; Raw memory: allocation, copying, filling, comparison.
(import IO)

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    (let a (memAlloc 8))
    (let b (memAlloc 8))
    {
      (println (memGetByte a 0))
      (memPutByte a 0 65)
      (memPutByte a 1 66)
      (memPutByte a 2 67)
      (println (memGetByte a 2))
      (memCopy b a 3)
      (println (memCmp a b 3))
      (memPutByte b 2 68)
      (println (memCmp a b 3))
      (println (memCmp b a 3))
      (memSet a 0 8)
      (println (memGetByte a 1))
      (memSetWord a 0 123456789)
      (println (as (memGetWord a 0) Int))
      (println (as (memGetWord a 1) Int))
      0
    }
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memAlloc (-> Int Int))
;@axiom:effect(unsafe)
(fn (memAlloc bytes)
  (__alloc bytes))

(:: memCopy (-> Int Int Int Int))
(fn (memCopy dst src count)
  (memCopyFrom dst src count 0))

(:: memSet (-> Int Int Int Int))
(fn (memSet addr value count)
  (memSetFrom addr value count 0))

(:: memCmp (-> Int Int Int Int))
(fn (memCmp a b count)
  (memCmpFrom a b count 0))

(:: memCopyFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memCopyFrom dst src count start)
  {
    (for i in start..count
      (__store8 dst i (__load8 src i)))
    dst
  })

(:: memSetFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memSetFrom addr value count start)
  {
    (for i in start..count
      (__store8 addr i value))
    addr
  })

(:: memCmpFrom (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memCmpFrom a b count start)
  {
    (let mut i start)
    (let mut diff 0)
    {
      (while (&& (< i count) (== diff 0))
        {
          (set diff (- (__load8 a i) (__load8 b i)))
          (set i (+ i 1))
        })
      diff
    }
  })

(:: memGetWord (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (memGetWord addr index)
  (__load64 addr index))

(:: memSetWord (-> Int Int a Int))
;@axiom:effect(unsafe)
(fn (memSetWord addr index value)
  {
    (__retainref value)
    (__store64 addr index (as value Int))
    addr
  })

(:: memGetByte (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (memGetByte addr index)
  (__load8 addr index))

(:: memPutByte (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (memPutByte addr index value)
  {
    (__store8 addr index value)
    addr
  })
