; A packed word's Link field must check its width before masking it.
; Index 254 fits UInt8 as link 255; index 255 needs link 256 and traps.
(import IO)
(import Vec)
(import Link)

(struct Packed word
  (next : (Link Int UInt8))
  (tag : UInt8))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let nodes (:: vecNew (Vec Int)))
    (for i in 0..256
      (vecPush nodes i))
    (let small (Packed :next (linkTo nodes 254) :tag (as 7 UInt8)))
    (let index (linkIndex small.next))
    (println "stored {index}")
    (let large (Packed :next (linkTo nodes 255) :tag (as 9 UInt8)))
    (let overflowIndex (linkIndex large.next))
    (println "overflow survived: {overflowIndex}")
  })
