; A `main` answering `(Result () Error)` with success: `(Ok ())`
; carries the unit word 0, so the process exits 0 (ERR-REC-4). Before
; this form was understood, the `Ok` block's address reached the exit
; status.
(import Err)
(import IO)

(:: main (Result () Error))
;@axiom:effect(io)
(fn (main)
  {
    (println "unit ok")
    (Ok ())
  })
