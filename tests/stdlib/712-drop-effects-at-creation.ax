; A drop's effects count where the value was made, not where it drops.
; `swap` forbids IO and stores a new file over the old one, whose owner
; closes it right there; the restriction holds, because the IO was
; declared by `openPath`, which made the file. This case holds that
; limit in place: the day a drop's effects count where the value drops,
; `swap` is refused and this case changes with it.
(import IO)
(import Err)

(struct Box
  (mut file : File))

(:: swap (-> Box File Int))
;@axiom:restrict(no-io)
(fn (swap b f)
  {
    (set b.file f)
    0
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (openPath nullDevice oRdonly)
    ((Ok a)
      (match (openPath nullDevice oRdonly)
        ((Ok b)
          {
            (let r (swap (Box :file a) b))
            (println "no-io holds across the replaced file's close: {r}")
            r
          }
        )
        ((Err e) 2))
    )
    ((Err e) 1)))
