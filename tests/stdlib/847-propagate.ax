; `e?` answers the `Ok` payload of `e`, and when `e` is an `Err` the
; enclosing body answers that `Err` (docs/reference.md, "Propagate an
; error with `?`"). Each shape below runs once with every step
; succeeding and once with a step failing, and prints what it answered;
; `trace` records the order the steps ran in, so a rewrite that moved
; an effect past the `?`, or ran one after the error, shows in the
; output.
(import IO)
(import Str)
(import Fmt)
(import Vec)

(:: step (-> (Vec String) String Bool (Result Int String)))
(fn (step trace name ok)
  {
    (vecPush trace name)
    (if ok
      (Ok (strLen name))
      (Err (concat name " failed")))
  })

; A chain of `let`s, each binding through a `?`.
(:: chain (-> (Vec String) Bool (Result Int String)))
(fn (chain trace ok)
  {
    (let a (step trace "a" true)?)
    (let b (step trace "bb" ok)?)
    (Ok (+ a b))
  })

; `?` in an argument: the arguments before it still run first, and the
; ones after it never run when it fails.
(:: args (-> (Vec String) Bool (Result Int String)))
(fn (args trace ok)
  (Ok (+ (+ (step trace "x" true)? (step trace "yy" ok)?) (step trace "zzz" true)?)))

; A statement in a block, and an `if` test.
(:: block (-> (Vec String) Bool (Result Int String)))
(fn (block trace ok)
  {
    (step trace "first" true)?
    (if (> (step trace "test" ok)? 0)
      (Ok 1)
      (Ok 2))
  })

; In tail position, through an `if` branch and a `match` arm.
(:: branches (-> (Vec String) Int (Result Int String)))
(fn (branches trace n)
  (if (> n 0)
    {
      (let v (step trace "pos" (> n 1))?)
      (Ok (* v 10))
    }
    (match n
      (0 (Ok 0))
      (_
        {
          (let w (step trace "neg" false)?)
          (Ok w)
        }
      ))))

; Stacked: the inner `?` runs first, then the outer one.
(:: nested (-> (Vec String) Bool (Result Int String)))
(fn (nested trace ok)
  {
    (let r (wrap trace ok)??)
    (Ok r)
  })

(:: wrap (-> (Vec String) Bool (Result (Result Int String) String)))
(fn (wrap trace ok)
  {
    (vecPush trace "wrap")
    (Ok (step trace "inner" ok))
  })

; A branch whose value is used. `Err` skips the addition.
(:: inBranch (-> (Vec String) Int (Result Int String)))
(fn (inBranch trace n)
  (Ok
    (+ 1
      (if (> n 0)
        (step trace "br" true)?
        0))))

; A `let` body whose value is used.
(:: inLetBody (-> (Vec String) Int (Result Int String)))
(fn (inLetBody trace n)
  (Ok
    (+ 1
      {
        (let m (+ n 1))
        (step trace "lt" (> m 0))?
      })))

; A loop. The failing step stops the loop and skips the `Ok`.
(:: inLoop (-> (Vec String) Int (Result Int String)))
(fn (inLoop trace n)
  {
    (let mut i 0)
    {
      (while (< i n)
        {
          (step trace "lp" (< i 2))?
          (set i (+ i 1))
        })
      (Ok i)
    }
  })

; A region may answer a `Result` of scalars. The error is an `Int`,
; so it does not point into the memory the region reclaims.
(:: inRegion (-> (Vec String) Bool (Result Int Int)))
(fn (inRegion trace ok)
  {
    (vecPush trace "rg")
    (region r
      (if ok
        (Ok 3)
        (Err 7)))
  })

; A handler's body propagates the same way.
(:: inHandle (-> (Vec String) Bool (Result Int String)))
(fn (inHandle trace ok)
  {
    (vecPush trace "hd")
    (let answer
      (if ok
        (Ok 4)
        (Err "no")))
    (Ok
      (handle
        (answer)?
        (Alloc)
        (lambda (v) v)))
  })

; A function that answers `Option` propagates with `?` the same way.
(:: findDigit (-> Int (Option Int)))
(fn (findDigit n)
  (if (> n 0)
    (Some n)
    (None)))

(:: twiceDigit (-> Int (Option Int)))
(fn (twiceDigit n)
  {
    (let v (findDigit n)?)
    (Some (* v 2))
  })

; A lambda is its own body: its `?` answers the lambda.
(:: viaLambda (-> (Vec String) Bool (Result Int String)))
(fn (viaLambda trace ok)
  {
    (let f (lambda (n) (Ok (+ n (step trace "lam" ok)?))))
    (f 100)
  })

(:: joined (-> (Vec String) String))
(fn (joined xs)
  {
    (let mut out "")
    (let mut i 0)
    {
      (while (< i (vecLen xs))
        {
          (set out (if (== i 0)
            (vecGet xs i)
            (concat (concat out ",") (vecGet xs i))))
          (set i (+ i 1))
        })
      (if (== (vecLen xs) 0)
        "(none)"
        out)
    }
  })

(:: show (-> String (Vec String) (Result Int String) Int))
;@axiom:effect(io)
(fn (show name trace r)
  {
    (let steps (joined trace))
    {
      (match r
        ((Ok v) (println "{name}: Ok {v} after {steps}"))
        ((Err e) (println "{name}: Err {e} after {steps}")))
      (vecClear trace)
      0
    }
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let t vecNew)
    {
      (show "chain" t (chain t true))
      (show "chain" t (chain t false))
      (show "args" t (args t true))
      (show "args" t (args t false))
      (show "block" t (block t true))
      (show "block" t (block t false))
      (show "branches" t (branches t 2))
      (show "branches" t (branches t 1))
      (show "branches" t (branches t 0))
      (show "branches" t (branches t -1))
      (show "nested" t (nested t true))
      (show "nested" t (nested t false))
      (show "lambda" t (viaLambda t true))
      (show "lambda" t (viaLambda t false))
      (show "inBranch" t (inBranch t 3))
      (show "inBranch" t (inBranch t 0))
      (show "inLetBody" t (inLetBody t 1))
      (show "inLoop" t (inLoop t 2))
      (show "inLoop" t (inLoop t 4))
      (let regionOk (inRegion t true))
      (let regionSteps (joined t))
      (match regionOk
        ((Ok v) (println "inRegion: Ok {v} after {regionSteps}"))
        ((Err e) (println "inRegion: Err {e} after {regionSteps}")))
      (vecClear t)
      (let regionBad (inRegion t false))
      (let regionBadSteps (joined t))
      (match regionBad
        ((Ok v) (println "inRegion: Ok {v} after {regionBadSteps}"))
        ((Err e) (println "inRegion: Err {e} after {regionBadSteps}")))
      (vecClear t)
      (show "inHandle" t (inHandle t true))
      (show "inHandle" t (inHandle t false))
      (match (twiceDigit 4)
        ((Some v) (println "option: Some {v}"))
        ((None) (println "option: None")))
      (match (twiceDigit 0)
        ((Some v) (println "option: Some {v}"))
        ((None) (println "option: None")))
    }
  })
