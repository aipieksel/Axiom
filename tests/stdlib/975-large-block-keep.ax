; Keeping a large block preserves bytes and uses a reusable capacity.
(import IO)
(import Mem)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let mark (__axiom_arena_mark))
    (let p (memAlloc 65552))
    (__store64 p 0 123)
    (__store64 p 8193 456)
    (let kept (__axiom_arena_reset_keeping mark p 65552))
    (let mut failures 0)
    (if (! (&& (== (__load64 kept 0) 123) (== (__load64 kept 8193) 456)))
      (set failures (+ failures 1)))
    (if (! (== (__load64 (- kept 32) 0) 131072))
      (set failures (+ failures 2)))
    (__retain kept)
    (__release kept)
    (let reused (memAlloc 70000))
    (if (! (&& (== kept reused) (&& (== (__load64 reused 0) 0) (== (__load64 reused 8193) 0))))
      (set failures (+ failures 4)))
    ; A snapshot larger than the marked chunk must keep reusing space.
    ; Dirty the suffix after each keep so reuse must scrub later blocks.
    (let largeMark (__axiom_arena_mark))
    (let scratch (memAlloc 2097152))
    (__store64 scratch 0 321)
    (let mut snapshot (memAlloc 2097152))
    (__store64 snapshot 0 123)
    (__store64 snapshot 8192 456)
    (__store64 snapshot 262143 789)
    (let mut i 0)
    (let mut mapped 0)
    (while (< i 36)
      {
        (set snapshot (__axiom_arena_reset_keeping largeMark snapshot 2097152))
        (if (!
              (&& (== (__load64 snapshot 0) 123)
                (&& (== (__load64 snapshot 8192) 456) (== (__load64 snapshot 262143) 789))))
          (set failures (| failures 8)))
        (let suffix (memAlloc 64))
        (if (! (&& (== (__load64 suffix 0) 0) (== (__load64 suffix 7) 0)))
          (set failures (| failures 16)))
        (__store64 suffix 0 999)
        (__store64 suffix 7 888)
        (set i (+ i 1))
        (if (== i 4)
          (set mapped (__axiom_mem_stat 2)))
      })
    (if (> (- (__axiom_mem_stat 2) mapped) 4194304)
      (set failures (| failures 32)))
    (println failures)
    failures
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memAlloc (-> Int Int))
;@axiom:effect(unsafe)
(fn (memAlloc bytes)
  (__alloc bytes))
