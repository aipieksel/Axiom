; A bare lowercase name in a match arm is a binder: it matches every
; value. A bare capitalised name that names no constructor is AX3137
; (tests/diagnostics/1490-uppercase-pattern-binder.ax).
(import IO)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (match 7
      (n (println (+ n 1))))
    0
  })
