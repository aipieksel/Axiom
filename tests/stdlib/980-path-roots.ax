; Roots, joins and lexical cleaning use this target's path separators.
(import IO)
(import Path)
(import Str)
(import Sys.Platform (pathBackslashSeparates))

(:: windows Bool)
(fn (windows)
  (== pathBackslashSeparates 1))

(:: sameBool (-> Bool Bool Bool))
(fn (sameBool a b)
  (if a
    b
    (! b)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println (! (pathIsAbsolute "")))
    (println (pathIsAbsolute "/work"))
    (println (sameBool (pathIsAbsolute "C:/work") windows))
    (println (sameBool (pathIsAbsolute "z:\\work") windows))
    (println (sameBool (pathIsAbsolute "\\work") windows))
    (println (sameBool (pathIsAbsolute "\\\\server\\share\\work") windows))
    (println (! (pathIsAbsolute "C:work")))
    (println (! (pathIsAbsolute "1:/work")))
    (println
      (strEq (pathJoin "base" "C:/work")
        (if windows
          "C:/work"
          "base/C:/work")))
    (println
      (strEq (pathWithSlash "C:\\work\\")
        (if windows
          "C:\\work\\"
          "C:\\work\\/")))
    (println
      (strEq (pathClean "C:/a/../../b")
        (if windows
          "C:/b"
          "b")))
    (println
      (strEq (pathClean "C:\\a\\..\\b")
        (if windows
          "C:\\b"
          "C:\\a\\..\\b")))
    (println
      (strEq (pathClean "\\\\server\\share\\a\\..\\..\\b")
        (if windows
          "\\\\server\\share\\b"
          "\\\\server\\share\\a\\..\\..\\b")))
    (println (strEq (pathClean "//") "/"))
    (println
      (strEq (pathClean "C:foo/../bar")
        (if windows
          "C:bar"
          "bar")))
    (println
      (strEq (pathClean "C:foo/../../bar")
        (if windows
          "C:../bar"
          "../bar")))
    (println
      (strEq (pathClean "C:.")
        (if windows
          "C:"
          "C:.")))
    (println
      (strEq (pathJoin "base" "C:work")
        (if windows
          "C:work"
          "base/C:work")))
    (println
      (strEq (pathJoin "C:/base" "C:work")
        (if windows
          "C:/base/work"
          "C:/base/C:work")))
    (println
      (strEq (pathJoin "C:/base" "c:work")
        (if windows
          "c:/base/work"
          "C:/base/c:work")))
    (println
      (strEq (pathJoin "D:/base" "C:work")
        (if windows
          "C:work"
          "D:/base/C:work")))
    (println
      (strEq (pathJoin "C:" "work")
        (if windows
          "C:work"
          "C:/work")))
    (println
      (strEq (pathJoin "C:/base" "/work")
        (if windows
          "C:/work"
          "/work")))
    (println
      (strEq (pathJoin "//server/share/base" "/work")
        (if windows
          "//server/share/work"
          "/work")))
  })
