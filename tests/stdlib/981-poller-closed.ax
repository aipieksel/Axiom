; exit 85: waiting on a closed poller checks its owner on every target.
(import IO)
(import Err)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (pollerNew 4)
    ((Err _) 2)
    ((Ok p)
      {
        (println "closing poller")
        (let _ (pollerClose p))
        (let _ (pollerWait p 0))
        (println "UNREACHABLE")
        1
      }
    )))
