; A negative capacity stops the program with status 77 before anything
; is allocated, as `strAlloc` does for a negative length.
(import IO)
(import Str)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println "before")
    (let b (strBuilderWithCapacity (- 0 1)))
    (let n (strBuilderLen b))
    (println "unreachable {n}")
  })
