; `strBuilderPushByte` takes a `Byte`, so 255 is appended and 256 stops
; the program with status 80 at the call.
(import IO)
(import Str)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let b strBuilderNew)
    (strBuilderPushByte b 255)
    (let n (strBuilderLen b))
    (println "pushed 255, len {n}")
    (let k (+ 255 1))
    (strBuilderPushByte b k)
    (println "unreachable")
  })
