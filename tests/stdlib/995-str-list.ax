; A `StrList` keeps many strings in two blocks. Strings read back keep
; their bytes after later pushes move the list's storage, and the
; in-place readers agree with the copies.
(import IO)
(import Str)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let words (strListNew))
    {
      (for w in (strSplit "the quick brown fox jumps over the lazy dog" 32)
        (strListPush words w))
      (let first (strListGet words 0))
      (for i in 0..2000
        (strListPush words "padding to make the storage move"))
      (println (strListLen words))
      (println first)
      (println (strListGet words 3))
      (println (strListByteLen words 2))
      (println (strListByte words 1 0))
      (println (strListEq words 8 "dog"))
      (println (strListEq words 8 "dot"))
      (println (strListEq words 6 "the"))
      (println (strListGet words 2008))
    }
  })
