; A vector grown far past a megabyte keeps every element: from 200,000
; ints, inside one ordinary block, to three million, inside a
; reservation that grows in place (MM-ALLOC-26). Then it is dropped
; and grown again, so a released reservation leaves nothing behind.
(import IO)
(import Vec)

(:: fill (-> Int Int Int))
(fn (fill n salt)
  {
    (let v (:: vecNew (Vec Int)))
    {
      (for i in 0..n
        (vecPush v (+ i salt)))
      (let mut sum 0)
      (for x in v
        (set sum (+ sum x)))
      (+ (* (vecLen v) 1000000000000) (% sum 1000000007))
    }
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println (fill 200000 0))
    (println (fill 3000000 0))
    (println (fill 3000000 7))
    (println (fill 5000000 1))
  })
