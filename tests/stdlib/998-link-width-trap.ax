; A link is a word until it is stored in a field with a width; the
; store is where it must fit. Index 255 is 256 as a link, one more
; than a `UInt8` field holds, so the second store stops the program
; with status 80 (docs/memory-model.md MM-VAL-10b).
(import IO)
(import Vec)
(import Link)

(struct Cell
  (val : Int)
  (mut next : (Link Cell UInt8)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let cells (:: vecNew (Vec Cell)))
    (for i in 0..300
      (vecPush cells (Cell :val i :next linkNone)))
    (let c (vecGet cells 0))
    (set c.next (linkTo cells 254))
    (let fits (linkIndex c.next))
    (println "stored {fits}")
    (set c.next (linkTo cells 255))
  })
