; A word struct packs several fixed-width fields into one machine word
; (docs/memory-model.md MM-VAL-10a). A `(Vec Node)` is a vector of
; those words. Replacing an element builds a new word.
(import IO)
(import Vec)
(import Link)

(struct Node word
  (key : Int32)
  (left : (Link Node UInt16))
  (right : (Link Node UInt16)))

(struct Pair word
  (lo : Int8)
  (hi : UInt8))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let nodes (:: vecNew (Vec Node)))
    (vecPush nodes (Node :key (as 50 Int32) :left linkNone :right linkNone))
    (vecPush nodes (Node :key (as -3 Int32) :left linkNone :right linkNone))
    (let root (linkTo nodes 0))
    (let n (vecGet nodes 0))
    (vecSet nodes 0 (Node :key n.key :left root :right n.right))
    (let m (vecGet nodes 0))
    (let neg (vecGet nodes 1))
    (let p (Pair :lo (as -2 Int8) :hi (as 200 UInt8)))
    (let key m.key)
    (let idx (linkIndex m.left))
    (let nkey neg.key)
    (let lo p.lo)
    (let hi p.hi)
    (println "{key} {idx} {nkey} {lo} {hi}")
  })
