; Test-only resource count. Probe failures must stop the fixture: a
; fabricated zero would let every balanced-close assertion pass.
(import IO)
(import Err)
(import Vec)

(pub :: openCount Int)
;@axiom:effect(io)
(pub fn (openCount)
  (match (listDir "/dev/fd")
    ((Ok entries) (vecLen entries))
    ((Err e) (die (errorText e) 1))))
