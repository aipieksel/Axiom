; Test-only Windows counterpart of the POSIX descriptor probe.
; GetProcessHandleCount writes a DWORD and returns a BOOL. Both are
; 32-bit values even though the portable extern ABI uses Int words.
(import IO)
(import Str)

(extern "kernel32"
  (processSelf :: Int (symbol "GetCurrentProcess"))
  (processHandleCount :: (-> Int Int Int) (symbol "GetProcessHandleCount"))
  (lastError :: Int (symbol "GetLastError")))

(pub :: openCount Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (openCount)
  {
    (let count (__alloc 8))
    (__store64 count 0 0)
    (if (== (& (processHandleCount processSelf count) 4294967295) 0)
      (die (concat "GetProcessHandleCount failed: " (fmtInt (& lastError 4294967295))) 1)
      (& (__load64 count 0) 4294967295))
  })
