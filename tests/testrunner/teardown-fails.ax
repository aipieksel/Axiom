; A `teardown` that traps. The failure belongs to the test it
; closed, so that test FAILs and the run exits 1: teardown runs
; inside the test's own recovery point, not outside it.
(import Test)

(:: testClosesBadly Int)
;@axiom:effect(io)
(fn (testClosesBadly)
  {
    (assertEq "the test itself holds" 1 1)
    0
  })

(:: teardown Int)
(fn (teardown)
  (/ 1 z))

; The divisor is `z` rather than the literal 0, so the division traps
; at run time: a literal zero divisor is AX3140 at compile time.
(:: z Int)
(fn (z)
  0)
