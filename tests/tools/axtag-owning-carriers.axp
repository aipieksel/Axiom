; Annotation entries and their text remain owned across copy and packet views.
(import core)
(import lexer)
(import parser)
(import expand)
(import frontpack)
(import symbols)
(import nolint)
(import diag)
(import Str)
(import Vec)
(import Fmt)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: escaped (-> String Axtags))
(fn (escaped payload)
  {
    (let original (vecPush vecNew (AxtagEnt :off 0 :content payload)))
    (axtagSlice original 0 1)
  })

(:: during (-> String Int))
(fn (during payload)
  {
    (let tags (escaped payload))
    (if (== (vecLen tags) 1)
      (count payload)
      0)
  })

(:: first (-> (Option Axtags) Int String Bool))
(fn (first candidate offset text)
  (match candidate
    ((None) false)
    ((Some tags)
      (if (== (vecLen tags) 1)
        {
          (let tag (vecGet tags 0))
          (&& (== tag.off offset) (strEq tag.content text))
        }
        false)
    )))

(:: copied (-> String (Option Axtags)))
(fn (copied source)
  (match (frontParse source)
    ((None) None)
    ((Some parsed)
      (match (frontDecode (frontEncode parsed))
        ((None) None)
        ((Some result)
          (if (== (vecLen result.decls) 0)
            None
            (nodeAxtagsOpt (vecGet result.decls 0)))
        ))
    )))

(:: escapedUnion (-> String Axtags))
(fn (escapedUnion payload)
  (axtagProbeUnion (vecPush vecNew (AxtagEnt :off 0 :content payload))
    (vecPush (vecPush vecNew (AxtagEnt :off 8 :content payload))
      (AxtagEnt :off 16 :content "other"))))

(:: duringUnion (-> String Int))
(fn (duringUnion payload)
  {
    (let tags (escapedUnion payload))
    (if (== (vecLen tags) 2)
      (count payload)
      0)
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let absent (nodeWireEmpty TAG_D_FN))
    (say 1 (isNone (nodeAxtagsOpt absent)))
    (say 2 (&& (! (vecIsNull (nodeAxtagsOf absent))) (== (vecLen (nodeAxtagsOf absent)) 0)))
    (let empty (nodeWireEmpty TAG_D_FN))
    (writeNodeAxtags empty vecNew)
    (say 3
      (match (nodeAxtagsOpt empty)
        ((None) false)
        ((Some tags) (== (vecLen tags) 0))))
    (let source ";@axiom:\n(fn (blank) 1)")
    (let scanned (scanAxtags source))
    (say 4 (== (vecLen scanned) 1))
    (let blank (vecGet scanned 0))
    (say 5 (== blank.off 0))
    (say 6 (strEq blank.content ""))
    (say 7 (first (copied source) 0 ""))
    (say 8 (isNone (copied "(fn (plain) 1)")))
    (let tags
      (vecPush (vecPush vecNew (AxtagEnt :off 0 :content "first"))
        (AxtagEnt :off 8 :content "second")))
    (let slice (axtagSlice tags 1 2))
    (say 9 (first (Some slice) 8 "second"))
    (vecPush slice (AxtagEnt :off 16 :content "third"))
    (say 10 (== (vecLen tags) 2))
    (let zero (axtagSlice tags 1 1))
    (say 11 (&& (! (vecIsNull zero)) (== (vecLen zero) 0)))
    (let payload (strDup "retained-tag-content"))
    (let before (count payload))
    (say 12 (== (during payload) (+ before 1)))
    (say 13 (== (count payload) before))
    (say 14 (first (Some (escaped (strDup "outlived-input"))) 0 "outlived-input"))
    (let pre (AxtagEnt :off 0 :content "pre((> n 0))"))
    (let post (AxtagEnt :off 20 :content "post((> result 0))"))
    (say 15 (strEq (contractKeyOf pre) "pre"))
    (say 16 (strEq (contractTextOf pre) "(> n 0)"))
    (say 17 (== (contractBaseOf pre) 12))
    (say 18 (isSome (contractExprOf pre)))
    (say 19 (isNone (contractExprOf (AxtagEnt :off 0 :content "pre()"))))
    (say 20 (isNone (contractExprOf (AxtagEnt :off 0 :content "pre((> n 0) trailing)"))))
    (let signature (nodeWireEmpty TAG_D_SIG))
    (writeNodeText signature 1 "f")
    (say 21 (isNone (contractSigTags vecNew "f" 0)))
    (writeNodeAxtags signature vecNew)
    (say 22
      (match (contractSigTags (vecPush vecNew signature) "f" 0)
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (writeNodeAxtags signature (vecPush vecNew pre))
    (let body (nodeWireEmpty TAG_D_FN))
    (writeNodeText body 1 "f")
    (writeNodeAxtags body (vecPush vecNew post))
    (let combined (contractTagsFor (vecPush vecNew signature) body))
    (say 23 (== (vecLen combined) 2))
    (say 24 (strEq (contractKeyOf (vecGet combined 0)) "pre"))
    (say 25 (strEq (contractKeyOf (vecGet combined 1)) "post"))
    (say 26 (== (contractTagCount combined 0) 1))
    (say 27 (== (contractTagCount vecNew 0) 0))
    (let invocation (nodeWireEmpty TAG_D_FN))
    (let made (vecPush vecNew invocation))
    (expGiveTags invocation made None)
    (say 28 (isNone (nodeAxtagsOpt invocation)))
    (expGiveTags invocation made (Some vecNew))
    (say 29
      (match (nodeAxtagsOpt invocation)
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (let tagged (nodeWireEmpty TAG_D_FN))
    (writeNodeAxtags tagged (vecPush vecNew (AxtagEnt :off 0 :content "author")))
    (let second (nodeWireEmpty TAG_D_FN))
    (let generated (vecPush (vecPush vecNew tagged) second))
    (expGiveTags tagged generated (Some (vecPush vecNew (AxtagEnt :off 0 :content "invocation"))))
    (say 30 (first (nodeAxtagsOpt tagged) 0 "author"))
    (say 31 (first (nodeAxtagsOpt second) 0 "invocation"))
    (say 32 (first (copied ";@axiom:effect(pure)\n(fn (owned) 1)") 0 "effect(pure)"))
    (let union
      (axtagProbeUnion (vecPush vecNew (AxtagEnt :off 0 :content "same"))
        (vecPush (vecPush vecNew (AxtagEnt :off 8 :content "same"))
          (AxtagEnt :off 16 :content "other"))))
    (say 33 (== (vecLen union) 2))
    (say 34
      {
        (let tag (vecGet union 0))
        (&& (== tag.off 0) (strEq tag.content "same"))
      })
    (say 35
      {
        (let tag (vecGet union 1))
        (&& (== tag.off 16) (strEq tag.content "other"))
      })
    (let ownedUnion (strDup "owned-union-content"))
    (let beforeUnion (count ownedUnion))
    (say 36 (== (duringUnion ownedUnion) (+ beforeUnion 1)))
    (say 37 (== (count ownedUnion) beforeUnion))
    (let map smNew)
    (smTags map absent "none")
    (say 38
      (match (axtagProbeLookup map "none")
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (let importNode (nodeWireEmpty TAG_D_IMPORT))
    (writeNodeAxtags importNode (vecPush vecNew (AxtagEnt :off 0 :content "nolint(AX6001)")))
    (let warning (mkDiag SEV_WARNING "AX6001" "probe" 0 "warning" 0 0 ""))
    (let error (mkDiag SEV_ERROR "AX6001" "probe" 0 "error" 0 0 ""))
    (let quieted
      (nolintQuietDiags (vecPush vecNew importNode) (vecPush (vecPush vecNew warning) error)))
    (say 39 (&& (== (vecLen quieted) 1) (== (diagSev (vecGet quieted 0)) SEV_ERROR)))
    (say 40 (== (vecLen (nolintQuietDiags (vecPush vecNew empty) (vecPush vecNew warning))) 1))
    0
  })
