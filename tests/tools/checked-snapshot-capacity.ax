; The runner supplies the production snapshot walker with a constant hash,
; making every distinct node exercise its collision and growth path.
(import CheckedSnapshotProbe)
(import core)
(import parser)
(import Vec)
(import Map)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let seen mapNew)
    (say 1 (! (probeVisit nilNode seen)))
    (say 2 (== (mapLen seen) 0))
    (let first (mkEInt 42))
    (say 3 (probeVisit first seen))
    (say 4 (== (probeBucketCapacity seen) 1))
    (say 5 (== (probeBucketCount seen) 1))
    (say 6 (! (probeVisit first seen)))
    (say 7 (== (probeBucketLength seen) 1))
    (let second (mkEInt 42))
    (say 8 (probeVisit second seen))
    (say 9 (== (probeBucketCapacity seen) 2))
    (say 10 (== (probeBucketCount seen) 1))
    (let third (mkEInt 73))
    (say 11 (probeVisit third seen))
    (say 12 (== (probeBucketCapacity seen) 4))
    (say 13 (== (probeBucketLength seen) 3))
    (say 14 (&& (! (probeVisit first seen)) (! (probeVisit second seen))))
    (say 15 (&& (== (mapLen seen) 1) (probeBucketMembers seen first second third)))
    (let shared (mkEInt 17))
    (let children (vecPush (vecPush vecNew shared) shared))
    (let parent (mkEBegin children))
    (let roots (vecPush vecNew parent))
    (let snapshot (probeSnapshot roots))
    (say 16 (== (probeNodeCount snapshot) 2))
    (say 17 (probeUnchanged snapshot))
    (writeNodeWord shared 1 18)
    (say 18 (! (probeUnchanged snapshot)))
    (let cycleChildren vecNew)
    (let cycle (mkEBegin cycleChildren))
    (vecPush cycleChildren cycle)
    (let cycleSnapshot (probeSnapshot (vecPush vecNew cycle)))
    (say 19 (== (probeNodeCount cycleSnapshot) 1))
    (say 20 (probeUnchanged cycleSnapshot))
    (vecPush cycleChildren (mkEInt 91))
    (say 21 (! (probeUnchanged cycleSnapshot)))
    0
  })
