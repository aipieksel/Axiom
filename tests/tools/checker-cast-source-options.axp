; Cast source values distinguish absent operands from present poison and types.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(struct CastProbe
  (checker : TC)
  (expression : ASTNode)
  (answer : ASTNode))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: expression (-> String ASTNode))
(fn (expression source)
  (expectParsed (parseExpr (lex source) 0)))

(:: probe (-> String String CastProbe))
(fn (probe source name)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (castProbeCollectors tc)
    (let node (expression source))
    (CastProbe :checker tc :expression node :answer (checkCastForm tc node name))
  })

(:: countCode (-> TC String Int))
(fn (countCode tc code)
  {
    (let mut count 0)
    (for diagnostic in (tcOutVec tc)
      (if (strEq (diagCode diagnostic) code)
        (set count (+ count 1))))
    count
  })

(:: errors (-> CastProbe Int))
(fn (errors checked)
  (countErrorDiags (tcOutVec checked.checker)))

(:: numeric (-> String ASTNode (Option ASTNode) CastProbe))
(fn (numeric source target from)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let node (expression source))
    (rewriteNumericAs tc node target from)
    (CastProbe :checker tc :expression node :answer target)
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let size (probe "(sizeof Int)" "sizeof"))
    (let align (probe "(alignof Float)" "alignof"))
    (say 1 (strEq (tyRender size.answer) "Int"))
    (say 2 (== (errors size) 0))
    (say 3 (== (castProbeForgeCount size.checker) 0))
    (say 4 (strEq (tyRender align.answer) "Int"))
    (say 5 (== (errors align) 0))
    (let missing (probe "(__ascribe Int)" "cast"))
    (say 6 (strEq (tyRender missing.answer) "Int"))
    (say 7 (== (errors missing) 1))
    (say 8 (== (countCode missing.checker "AX3013") 1))
    (say 9 (== (nodeResWord missing.expression) 0))
    (say 10 (== (castProbeForgeCount missing.checker) 0))
    (let literal (probe "(__ascribe 7)" "cast"))
    (say 11 (== (nodeTag literal.answer) TAG_T_ERR))
    (say 12 (== (countCode literal.checker "AX3002") 1))
    (say 13 (== (countCode literal.checker "AX3013") 0))
    (let identity (probe "(__ascribe Int 7)" "cast"))
    (say 14 (== (nodeResWord identity.expression) 3))
    (say 15 (== (errors identity) 0))
    (let unitFrom (probe "(__ascribe Int ())" "cast"))
    (let unitTo (probe "(__ascribe () 7)" "cast"))
    (say 16 (== (countCode unitFrom.checker "AX3139") 1))
    (say 17 (== (countCode unitTo.checker "AX3139") 1))
    (let toFloat (probe "(__as_numeric Float 7)" "__as_numeric"))
    (let toInt (probe "(__as_numeric Int 7.5)" "__as_numeric"))
    (say 18 (strEq (nodeAName (spineHead toFloat.expression)) "__intToFloat"))
    (say 19 (strEq (nodeAName (spineHead toInt.expression)) "__floatToInt"))
    (say 20 (== (errors toFloat) 0))
    (say 21 (== (errors toInt) 0))
    (let toByte (probe "(__as_numeric UInt8 7)" "__as_numeric"))
    (say 22 (strEq (nodeAName (spineHead toByte.expression)) "cast"))
    (say 23 (== (nodeC (spineHead toByte.expression)) (+ (* 64 256) 72)))
    (let numericMissing (probe "(__as_numeric Float)" "__as_numeric"))
    (say 24 (== (countCode numericMissing.checker "AX3013") 1))
    (say 25 (== (countCode numericMissing.checker "AX3004") 1))
    (say 26 (strEq (nodeAName (spineHead numericMissing.expression)) "cast"))
    (let byteMissing (probe "(__as_numeric UInt8)" "__as_numeric"))
    (say 27 (== (countCode byteMissing.checker "AX3004") 1))
    (say 28 (== (nodeC (spineHead byteMissing.expression)) 72))
    (let ascribed (probe "(__ascribe String 7)" "__ascribe"))
    (let ascribeMissing (probe "(__ascribe String)" "__ascribe"))
    (say 29 (== (countCode ascribed.checker "AX3004") 1))
    (say 30 (== (countCode ascribeMissing.checker "AX3013") 1))
    (say 31 (== (countCode ascribeMissing.checker "AX3004") 0))
    (let poisoned (probe "(__ascribe String missing)" "cast"))
    (say 32 (== (countCode poisoned.checker "AX3001") 1))
    (say 33 (== (countCode poisoned.checker "AX3013") 0))
    (say 34 (== (castProbeForgeCount poisoned.checker) 0))
    (let forged (probe "(__ascribe String 7)" "cast"))
    (say 35 (== (castProbeForgeCount forged.checker) 3))
    (let missingReference (probe "(__ascribe String)" "cast"))
    (say 36 (== (castProbeForgeCount missingReference.checker) 0))
    (let dropped (probe "(sizeof Int missing)" "sizeof"))
    (say 37 (== (countCode dropped.checker "AX3001") 1))
    (say 38 (== (countCode dropped.checker "AX3069") 1))
    (let pending (probe "(as (lambda (value) value) (-> String String))" "cast"))
    (say 39 (strEq (tyRender pending.answer) "(String -> String)"))
    (say 40 (== (errors pending) 0))
    (say 41 (== (vecLen pending.checker.scope) 0))
    (let noSource (numeric "(__as_numeric Float)" mkFloatTy None))
    (say 42 (== (countCode noSource.checker "AX3004") 1))
    (say 43 (strEq (nodeAName (spineHead noSource.expression)) "cast"))
    (let poisonSource (numeric "(__as_numeric Float missing)" mkFloatTy (Some mkTErr)))
    (say 44 (== (countCode poisonSource.checker "AX3004") 1))
    (let integerSource (numeric "(__as_numeric Float 7)" mkFloatTy (Some mkIntTy)))
    (say 45 (strEq (nodeAName (spineHead integerSource.expression)) "__intToFloat"))
    (say 46 (== (errors integerSource) 0))
    (let unitSource (numeric "(__as_numeric Float ())" mkFloatTy (Some mkUnitTy)))
    (say 47 (== (countCode unitSource.checker "AX3004") 1))
    (say 48 (strEq (tyRender poisoned.answer) "String"))
    0
  })
