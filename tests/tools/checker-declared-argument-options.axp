; Missing declarations leave pending arguments unchanged until a real type exists.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: pending (-> String ASTNode))
(fn (pending name)
  (nodeBuildELam (vecPush vecNew name) (mkEVarAt name 0) 0 0))

(:: same (-> (Option ASTNode) ASTNode Bool))
(fn (same candidate expected)
  (match candidate
    ((None) false)
    ((Some actual) (nodeSame actual expected))))

(:: retainedScope BScope)
(fn (retainedScope)
  (bsNew (vecPush vecNew (strDup "argument")) (vecPush vecNew 0) vecNew
    (Some (mkTArr (mkTCon (strDup "OwnedArgument") vecNew) mkIntTy))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let before (tcCounter tc))
    (let arrow (mkTArr mkStringTy mkStringTy))
    (let integer mkIntTy)
    (let poison mkTErr)
    (let wild (mkTVar ""))
    (let unknown (pending "value"))
    (say 1 (nodeSame (groundArgByDecl tc integer None 0) integer))
    (say 2 (nodeSame (groundArgByDecl tc integer (Some arrow) 0) integer))
    (say 3 (nodeSame (groundArgByDecl tc nilNode None 0) nilNode))
    (say 4 (nodeSame (groundArgByDecl tc nilNode (Some arrow) 0) nilNode))
    (say 5 (nodeSame (groundArgByDecl tc unknown None 0) unknown))
    (say 6 (nodeSame (lamStamp unknown) nilNode))
    (say 7 (== (vecLen tc.scope) 0))
    (say 8 (== (tcCounter tc) before))
    (say 9 (nodeSame (groundArgByDecl tc unknown (Some integer) 0) unknown))
    (say 10 (nodeSame (groundArgByDecl tc unknown (Some poison) 0) unknown))
    (say 11 (nodeSame (groundArgByDecl tc unknown (Some wild) 0) unknown))
    (say 12 (nodeSame (groundArgByDecl tc unknown (Some nilNode) 0) unknown))
    (say 13 (== (tcCounter tc) before))
    (say 14 (== (countErrorDiags (tcOutVec tc)) 0))
    (let grounded (groundArgByDecl tc unknown (Some arrow) 0))
    (say 15 (== (nodeTag grounded) TAG_T_ARR))
    (say 16 (strEq (tyRender (nodeAChild grounded)) "String"))
    (say 17 (strEq (tyRender (nodeBChild grounded)) "String"))
    (say 18 (== (stampIsArrow (lamStamp unknown)) 1))
    (say 19 (== (vecLen tc.scope) 0))
    (say 20 (nodeSame (groundArgByDecl tc unknown (Some arrow) 0) grounded))
    (say 21 (nodeSame (groundArgByDecl tc unknown None 0) unknown))
    (say 22 (nodeSame (groundArgByDecl tc unknown (Some integer) 0) unknown))
    (let recursive (pending "recursive"))
    (setLamStamp recursive mkProgStamp)
    (say 23 (nodeSame (groundArgByDecl tc recursive None 0) recursive))
    (say 24 (== (nodeTag (groundArgByDecl tc recursive (Some arrow) 0)) TAG_T_ERR))
    (say 25 (== (countErrorDiags (tcOutVec tc)) 1))
    (setLamStamp recursive mkTErr)
    (say 26 (== (nodeTag (groundArgByDecl tc recursive (Some arrow) 0)) TAG_T_ERR))
    (say 27 (== (countErrorDiags (tcOutVec tc)) 1))
    (pushScope tc.scope "outer" 0 0 integer)
    (let prefix (vecPush vecNew (SEnt :name "captured" :mutable 0 :bsp 0 :ty mkStringTy :used 0)))
    (let partial (nodeBuildELam (vecPush vecNew "ignored") (mkEVarAt "captured" 0) 0 0))
    (setLamStamp partial (mkPartialRec prefix 1 0))
    (let result (groundArgByDecl tc partial (Some (mkTArr integer mkStringTy)) 0))
    (say 28 (strEq (tyRender result) "(Int -> String)"))
    (say 29 (== (stampIsArrow (lamStamp partial)) 1))
    (say 30 (== (vecLen tc.scope) 1))
    (say 31 (strEq (sEntName (vecGet tc.scope 0)) "outer"))
    (say 32 (== (vecLen prefix) 1))
    (say 33 (== (countErrorDiags (tcOutVec tc)) 1))
    (let absent (bsNew vecNew vecNew vecNew None))
    (let present (bsNew (vecPush vecNew "value") vecNew vecNew (Some arrow)))
    (say 34 (isNone (bsFnTy absent)))
    (say 35 (same (bsFnTy present) arrow))
    (say 36 (same (bsParamTy present (BoundParam 0)) (nodeAChild arrow)))
    (say 37 (isNone (bsParamTy absent (BoundParam 0))))
    (say 38 (same (bsFnTy (bsNew vecNew vecNew vecNew (Some poison))) poison))
    (say 39 (same (bsFnTy (bsNew vecNew vecNew vecNew (Some wild))) wild))
    (say 40
      (match (bsFnTy (bsNew vecNew vecNew vecNew (Some mkUnitTy)))
        ((None) false)
        ((Some ty) (tyIsUnit ty))))
    (let owned retainedScope)
    (say 41 (strEq (vecGetStr (bsParamsVec owned) 0) "argument"))
    (say 42
      (match (bsParamTy owned (BoundParam 0))
        ((None) false)
        ((Some ty) (strEq (nodeAName ty) "OwnedArgument"))))
    (say 43 (same (bsFnTy (bsWith present "local" BoundOpaque)) arrow))
    (say 44 (same (bsFnTy (bsLambda present (vecPush vecNew "x"))) arrow))
    (say 45 (isNone (bsParamTy present (BoundParam 99))))
    (say 46 (isNone (bsFnTy (bsNew vecNew vecNew vecNew (curFnSigTy tc)))))
    0
  })
