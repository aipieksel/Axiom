; Effect and macro lookups retain declaration identity and explicit absence.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: named (-> (Option ASTNode) String Bool))
(fn (named candidate expected)
  (match candidate
    ((Some declaration) (strEq (nodeAName declaration) expected))
    ((None) false)))

(:: expression (-> String ASTNode))
(fn (expression body)
  {
    (let parsed (parseModule (lex (concat (concat "(pub fn (expression) " body) ")"))))
    (nodeCChild (vecGet (expectParsed parsed) 0))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let parsed
      (parseModule
        (lex
          "(effect Ask (ask :: (-> Int Int))) (effect Log (log :: (-> String Int))) (effect Many (one :: Int) (two :: Int)) (pub :: shadow (-> Int Int))")))
    (let declarations (expectParsed parsed))
    (let tc (tcNew declarations declarations vecNew))
    (let ask (vecPush vecNew (mkEVar "Ask")))
    (let builtins (vecPush (vecPush vecNew (mkEVar "Pure")) (mkEVar "IO")))
    (let both (vecPush (vecPush vecNew (mkEVar "Ask")) (mkEVar "Log")))
    (say 1 (== (countErrorDiags (tcOutVec tc)) 0))
    (say 2 (isNone (findEffectDecl tc "Missing")))
    (say 3 (named (findEffectDecl tc "Ask") "Ask"))
    (say 4 (named (findEffectDeclCI (tcEffectsVec tc) "aSk" 0) "Ask"))
    (say 5 (isNone (findEffectDeclCI (tcEffectsVec tc) "missing" 0)))
    (say 6 (strEq (canonicalEffectName tc "aSk") "Ask"))
    (say 7 (strEq (canonicalEffectName tc "unknown") "unknown"))
    (say 8 (isNone (handleOpDecl tc vecNew 0 None)))
    (say 9 (isNone (handleOpDecl tc builtins 0 None)))
    (say 10 (named (handleOpDecl tc ask 0 None) "Ask"))
    (say 11 (named (handleOpDecl tc (vecPush ask (mkEVar "Pure")) 0 None) "Ask"))
    (say 12 (isNone (handleOpDecl tc both 0 None)))
    (say 13 (isNone (handleOpDecl tc (vecPush vecNew (mkEVar "Many")) 0 None)))
    (say 14 (isNone (handleOpDecl tc (vecPush vecNew (mkEVar "Missing")) 0 None)))
    (say 15
      (named (handleOpDecl tc (vecPush (vecPush vecNew (mkEVar "Missing")) (mkEVar "Ask")) 0 None)
        "Ask"))
    (say 16
      (if (let (Some arrow) (handleOpType tc ask))
        (== (nodeTag arrow) TAG_T_ARR)
        false))
    (say 17 (isNone (handleOpType tc builtins)))
    (say 18 (isNone (handleOpType tc both)))
    (let noFields (nodeBuildDEffect "NoFields" (vecPush vecNew "noFields") nilNodes 0))
    (vecPush (tcEffectsVec tc) noFields)
    (say 19 (isNone (handleOpType tc (vecPush vecNew (mkEVar "NoFields")))))
    (let noArrow
      (nodeBuildDEffect "NoArrow" (vecPush vecNew "noArrow")
        (vecPush vecNew (nodeBuildFieldType "noArrow" nilNode 0 0)) 0))
    (vecPush (tcEffectsVec tc) noArrow)
    (say 20 (isNone (handleOpType tc (vecPush vecNew (mkEVar "NoArrow")))))
    (let poison
      (nodeBuildDEffect "Poison" (vecPush vecNew "poison")
        (vecPush vecNew (nodeBuildFieldType "poison" mkTErr 0 0)) 0))
    (vecPush (tcEffectsVec tc) poison)
    (say 21
      (if (let (Some arrow) (handleOpType tc (vecPush vecNew (mkEVar "Poison"))))
        (== (nodeTag arrow) TAG_T_ERR)
        false))
    (let before (countErrorDiags (tcOutVec tc)))
    (checkHandler tc (mkEInt 0) None)
    (say 22 (== (countErrorDiags (tcOutVec tc)) before))
    (checkHandler tc (expression "(lambda (value) (+ value 1))") (handleOpType tc ask))
    (say 23 (== (countErrorDiags (tcOutVec tc)) before))
    (checkHandler tc (mkEInt 0) (Some mkTErr))
    (say 24 (== (countErrorDiags (tcOutVec tc)) before))
    (let macros (:: vecNew Nodes))
    (let first (nodeBuildDMacro "repeat" vecNew (mkEInt 1) 0))
    (let last (nodeBuildDMacro "repeat" vecNew (mkEInt 2) 0))
    (vecPush macros first)
    (vecPush macros last)
    (say 25
      (if (let (Some macro) (isMacroVisible macros "repeat" None 1))
        (nodeSame macro last)
        false))
    (say 26 (isNone (isMacroVisible macros "missing" None 1)))
    (say 27 (isNone (isMacroVisible macros "repeat" None -1)))
    (let private (nodeBuildDMacro "secret" vecNew (mkEInt 3) 0))
    (writeNodeText private 8 "Owner")
    (vecPush macros private)
    (say 28 (isNone (isMacroVisible macros "secret" None 2)))
    (say 29 (named (isMacroVisible macros "secret" (Some "Owner") 2) "secret"))
    (say 30 (isNone (macroQualVisible macros "secret" "Owner" None 2)))
    (say 31 (named (macroQualVisible macros "secret" "Owner" (Some "Owner") 2) "secret"))
    (writeNodeWord private 5 1)
    (say 32 (named (macroQualVisible macros "secret" "Owner" None 2) "secret"))
    (say 33 (isNone (macroQualVisible macros "secret" "Other" None 2)))
    (let emptyModule (nodeBuildDMacro "emptyModule" vecNew (mkEInt 4) 0))
    (writeNodeText emptyModule 8 "")
    (writeNodeWord emptyModule 5 1)
    (vecPush macros emptyModule)
    (say 34 (named (macroQualVisible macros "emptyModule" "" None 3) "emptyModule"))
    (let imported (nodeBuildDMacro "shadow" vecNew (mkEInt 5) 0))
    (writeNodeText imported 8 "Import")
    (writeNodeWord imported 5 1)
    (vecPush (tcMacrosVec tc) imported)
    (say 35 (== (isMacroName tc "shadow") 0))
    (say 36 (== (isMacroName tc "Import$shadow") 1))
    (set tc.curModule (Some "Import"))
    (say 37 (== (isMacroName tc "shadow") 1))
    (say 38 (== (isMacroName tc "Import$shadow") 1))
    (say 39 (== (isMacroName tc "Missing$shadow") 0))
    (say 40 (== (isMacroName tc "missing") 0))
    0
  })
