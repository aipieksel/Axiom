; Captured initializer absence preserves lexical environments and stored effects.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: sameNode (-> (Option ASTNode) ASTNode Bool))
(fn (sameNode found expected)
  (match found
    ((Some node) (nodeSame node expected))
    ((None) false)))

(:: bindingInit (-> (Vec FieldLambdaBinding) Int (Option ASTNode)))
(fn (bindingInit bindings index)
  {
    (let binding (vecGet bindings index))
    binding.initialiser
  })

(:: unknown (-> StoredFnVal Bool))
(fn (unknown value)
  (match value
    ((UnknownFn) true)
    ((KnownFn _) false)
    ((DeferredFn _) false)
    ((NonCallableFn) false)))

(:: known (-> StoredFnVal String Bool))
(fn (known value expected)
  (match value
    ((KnownFn callable)
      (match callable
        ((NamedFn entry) (strEq entry.name expected))
        ((LambdaFn _) false))
    )
    ((UnknownFn) false)
    ((DeferredFn _) false)
    ((NonCallableFn) false)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let nodes
      (expectParsed (parseModule (lex "(pub :: identity (-> Int Int)) (pub fn (identity x) x)"))))
    (let tc (tcNew nodes nodes vecNew))
    (let owner (vecGet nodes 1))
    (let stack (FsStack :names vecNew :inits vecNew :envs vecNew))
    (fsPush stack (vecPush (vecPush vecNew "parameter") "opaque") 0)
    (say 1 (== (fsLen stack) 2))
    (say 2 (isNone (vecGet stack.inits 0)))
    (say 3 (isNone (vecGet stack.inits 1)))
    (say 4 (&& (== (vecGet stack.envs 0) 0) (== (vecGet stack.envs 1) 1)))
    (let initializer (mkEVarAt "identity" 0))
    (fsBind stack "first" (Some initializer) 2)
    (fsBind stack "alias" (Some (mkEVarAt "first" 0)) 3)
    (fsBind stack "mutable" None 4)
    (say 5 (sameNode (vecGet stack.inits 2) initializer))
    (say 6 (known (fsClassify tc owner (mkEVarAt "first" 0) stack (fsLen stack)) "identity"))
    (say 7 (known (fsClassify tc owner (mkEVarAt "alias" 0) stack (fsLen stack)) "identity"))
    (say 8 (unknown (fsClassify tc owner (mkEVarAt "parameter" 0) stack (fsLen stack))))
    (say 9 (unknown (fsClassify tc owner (mkEVarAt "mutable" 0) stack (fsLen stack))))
    (let poison mkTErr)
    (let wild (mkTVar ""))
    (fsBind stack "poison" (Some poison) 5)
    (fsBind stack "wild" (Some wild) 6)
    (say 10 (sameNode (vecGet stack.inits 5) poison))
    (say 11 (sameNode (vecGet stack.inits 6) wild))
    (say 12 (unknown (fsClassify tc owner (mkEVarAt "poison" 0) stack (fsLen stack))))
    (say 13 (unknown (fsClassify tc owner (mkEVarAt "wild" 0) stack (fsLen stack))))
    (fsBind stack "first" None 7)
    (say 14 (unknown (fsClassify tc owner (mkEVarAt "first" 0) stack (fsLen stack))))
    (say 15 (known (fsClassify tc owner (mkEVarAt "alias" 0) stack (fsLen stack)) "identity"))
    (vecPush stack.names "pattern")
    (fsFillCols stack)
    (say 16 (&& (== (vecLen stack.inits) 9) (== (vecLen stack.envs) 9)))
    (say 17 (isNone (vecGet stack.inits 8)))
    (say 18 (== (vecGet stack.envs 8) 0))
    (let bindings (fieldLambdaBindings stack 7))
    (say 19 (== (vecLen bindings) 7))
    (say 20 (isNone (bindingInit bindings 0)))
    (say 21 (sameNode (bindingInit bindings 2) initializer))
    (say 22 (sameNode (bindingInit bindings 5) poison))
    (say 23 (sameNode (bindingInit bindings 6) wild))
    (let bound (fieldLambdaScope tc bindings))
    (say 24 (isNone (bsValsOf bound "parameter")))
    (say 25 (isNone (bsValsOf bound "mutable")))
    (say 26 (isSome (bsValsOf bound "first")))
    (say 27 (isSome (bsValsOf bound "alias")))
    (say 28 (isNone (bsValsOf bound "poison")))
    (let lambda
      (nodeBuildELam (vecPush vecNew "x") (mkEApp (mkEVarAt "alias" 0) (mkEVarAt "x" 0)) 0 0))
    (say 29
      (match (fsClassify tc owner lambda stack 7)
        ((DeferredFn closure)
          (&& (== (vecLen closure.bindings) 7)
            (sameNode (bindingInit closure.bindings 2) initializer))
        )
        ((KnownFn _) false)
        ((UnknownFn) false)
        ((NonCallableFn) false)))
    (fsPopTo stack 2)
    (say 30 (&& (== (fsLen stack) 2) (&& (== (vecLen stack.inits) 2) (== (vecLen stack.envs) 2))))
    (say 31 (sameNode (bindingInit bindings 2) initializer))
    (say 32 (isSome (bsValsOf (fieldLambdaScope tc bindings) "alias")))
    (say 33 (== (countErrorDiags (tcOutVec tc)) 0))
    0
  })
