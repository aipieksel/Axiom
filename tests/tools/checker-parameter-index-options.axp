; Parameter witnesses retain the first bad or unused index, including zero.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: at (-> (Option Int) Int Bool))
(fn (at result expected)
  (match result
    ((Some index) (== index expected))
    ((None) false)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let valid (vecPush (vecPush (vecPush vecNew "a") "b") "c"))
    (let repeated (vecPush (vecPush (vecPush vecNew "a") "a") "B"))
    (let uppercase (vecPush (vecPush (vecPush vecNew "B") "a") "a"))
    (say 1 (isNone (aliasBadParam nilNames 0)))
    (say 2 (isNone (aliasBadParam vecNew 0)))
    (say 3 (isNone (aliasBadParam valid 0)))
    (say 4 (at (aliasBadParam uppercase 0) 0))
    (say 5 (at (aliasBadParam (vecPush (vecPush vecNew "a") "B") 0) 1))
    (say 6 (at (aliasBadParam repeated 0) 1))
    (say 7 (at (aliasBadParam repeated 1) 1))
    (say 8 (at (aliasBadParam repeated 2) 2))
    (say 9 (isNone (aliasBadParam valid (vecLen valid))))
    (say 10 (isNone (aliasFirstUnused nilNames vecNew 0)))
    (say 11 (isNone (aliasFirstUnused vecNew vecNew 0)))
    (say 12 (isNone (aliasFirstUnused valid valid 0)))
    (say 13 (at (aliasFirstUnused valid (vecPush (vecPush vecNew "b") "c") 0) 0))
    (say 14 (at (aliasFirstUnused valid (vecPush vecNew "a") 0) 1))
    (say 15 (at (aliasFirstUnused valid vecNew 2) 2))
    (say 16 (isNone (aliasFirstUnused valid vecNew (vecLen valid))))
    (let a (mkTVar "a"))
    (let b (mkTVar "b"))
    (let params (vecPush (vecPush vecNew "a") "b"))
    (say 17 (isNone (aliasUnusedParam (mkTArr a b) params)))
    (say 18 (at (aliasUnusedParam a params) 1))
    (say 19 (at (aliasUnusedParam b params) 0))
    (say 20 (at (aliasUnusedParam (mkTVar "free") params) 0))
    (say 21 (at (aliasUnusedParam mkTErr params) 0))
    (say 22 (at (aliasUnusedParam nilNode params) 0))
    (say 23 (isNone (aliasUnusedParam (mkTArr a b) nilNames)))
    (say 24 (isNone (aliasUnusedParam (mkTArr a b) vecNew)))
    0
  })
