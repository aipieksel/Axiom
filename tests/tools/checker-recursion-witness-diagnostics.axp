; First witnesses retain their node and traversal order behind typed Options.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: checkSource (-> String String ()))
;@axiom:effect(io)
(fn (checkSource name source)
  {
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (let declarations (pResNodes parsed))
    (let units
      (vecPush vecNew
        (CUnit2 :file name :src source :name (Some "") :imports vecNew :library false)))
    (let tc (tcNew declarations declarations units))
    (tcWalkDecls tc 0)
    (writeStr stdout (renderDiagsUnits (tcOutVec tc) units))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (checkSource "1005-recursion-in-scrutinee.ax"
      "; A self-recursive call in the scrutinee of a `match`. AX3045.\n; One warning per offending match, on the call: `total2` answers the\n; call bare, `nest` nests one deeper inside a larger scrutinee.\n; `total` is the arm-tail shape and draws nothing: the recursive call\n; stands in an arm, where it is a tail call. `queried` calls another\n; function in its scrutinee and draws nothing either: only the\n; enclosing function counts.\n(:: step (-> Int (Option Int)))\n(fn (step n)\n  (if (<= n 0)\n    (None)\n    (Some (- n 1))))\n\n(:: total (-> Int Int Int))\n(fn (total n acc)\n  (if (== n 0)\n    acc\n    (match (step n)\n      ((None) acc)\n      ((Some v) (total (- n 1) (+ acc v))))))\n\n(:: total2 (-> Int Int (Option Int)))\n(fn (total2 n acc)\n  (if (== n 0)\n    (Some acc)\n    (match (total2 (- n 1) (+ acc 1))\n      ((None) (None))\n      ((Some x) (Some x)))))\n\n(:: queried (-> Int Int))\n(fn (queried n)\n  (match (step n)\n    ((None) 0)\n    ((Some v) v)))\n\n(:: nest (-> Int Int))\n(fn (nest n)\n  (match (+ (nest n) 1)\n    (0 0)\n    (_ 1)))\n\n(:: main Int)\n(fn (main)\n  (match (total2 10 0)\n    ((None) 0)\n    ((Some x) (+ x (total 10 0)))))\n")
    (checkSource "1489-duplicate-pattern-binder.ax"
      "; A name bound twice in one pattern is AX3136, at the top level and\n; nested. The control binds each name once, and `_` binds nothing, so\n; it may repeat.\n(data P\n  (Pair Int Int))\n\n(data Q\n  (Box P Int))\n\n(:: f (-> P Int))\n(fn (f p)\n  (match p\n    ((Pair x x) x)))\n\n(:: h (-> Q Int))\n(fn (h q)\n  (match q\n    ((Box (Pair x x) _) x)))\n\n(:: g (-> Q Int))\n(fn (g q)\n  (match q\n    ((Box (Pair x y) _) (+ x y))\n    ((Box _ z) z)))\n")
    0
  })
