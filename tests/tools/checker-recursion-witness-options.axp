; First witnesses retain their node and traversal order behind typed Options.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: sameWitness (-> (Option ASTNode) ASTNode Bool))
(fn (sameWitness candidate expected)
  (match candidate
    ((Some node) (nodeSame node expected))
    ((None) false)))

(:: finds (-> ASTNode ASTNode Bool))
(fn (finds source expected)
  (sameWitness (selfCallIn source "Module$recur" "recur" 0 0) expected))

(:: misses (-> ASTNode Bool))
(fn (misses source)
  (isNone (selfCallIn source "Module$recur" "recur" 0 0)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let one (mkEApp (mkEVar "recur") (mkEInt 1)))
    (let two (mkEApp (mkEVar "Module$recur") (mkEInt 2)))
    (let bare (mkEVar "recur"))
    (let first (mkEVar "x"))
    (let last (mkEVar "x"))
    (let binders (vecPush (vecPush (vecPush vecNew first) (mkEVar "y")) last))
    (let shadowArm (nodeBuildMArm bare one 0 0))
    (let unshadowedArm (nodeBuildMArm (mkEVar "other") two 0 0))
    (let arms (vecPush (vecPush vecNew shadowArm) unshadowedArm))
    (say 1 (sameWitness (patBinderFirst binders "x" 0) first))
    (say 2 (sameWitness (patBinderFirst binders "x" 1) last))
    (say 3 (isNone (patBinderFirst binders "missing" 0)))
    (say 4 (isNone (patBinderFirst binders "x" 3)))
    (say 5 (isNone (patBinderFirst vecNew "x" 0)))
    (say 6 (misses nilNode))
    (say 7 (misses (mkEInt 3)))
    (say 8 (misses bare))
    (say 9 (sameWitness (selfCallIn bare "Module$recur" "recur" 1 0) bare))
    (say 10 (isNone (selfCallIn one "Module$recur" "recur" 0 1)))
    (say 11 (finds one one))
    (say 12 (finds two two))
    (say 13 (misses (mkEApp (mkEVar "other") (mkEInt 0))))
    (say 14 (finds (mkEApp (mkEVar "other") one) one))
    (say 15 (finds (mkEApp (mkEApp (mkEVar "other") one) two) one))
    (say 16 (finds (nodeBuildELet "recur" one two 0) one))
    (say 17 (misses (nodeBuildELet "recur" (mkEInt 0) two 0)))
    (say 18 (finds (nodeBuildELet "other" (mkEInt 0) two 0) two))
    (say 19 (misses (nodeBuildELetm "recur" (mkEInt 0) two 0)))
    (say 20 (finds (nodeBuildELetm "other" one two 0) one))
    (say 21 (misses (nodeBuildELam (vecPush vecNew "recur") one 0 0)))
    (say 22 (finds (nodeBuildELam (vecPush vecNew "other") one 0 0) one))
    (say 23 (finds (nodeBuildEIf one two (mkEInt 0) 0) one))
    (say 24 (finds (nodeBuildEIf (mkEInt 0) one two 0) one))
    (say 25 (finds (nodeBuildEIf (mkEInt 0) (mkEInt 0) two 0) two))
    (say 26
      (finds (nodeBuildEBegin (vecPush (vecPush (vecPush vecNew (mkEInt 0)) one) two) 0 0 0) one))
    (say 27 (isNone (selfCallInVec vecNew "recur" "recur" 0 0 0)))
    (say 28 (isNone (selfCallInVec nilNodes "recur" "recur" 0 0 0)))
    (say 29 (sameWitness (selfCallInArms arms "Module$recur" "recur" 0 0 0) two))
    (say 30 (isNone (selfCallInArms arms "Module$recur" "recur" 0 0 2)))
    (say 31 (finds (nodeBuildEMatch one arms 0 0) one))
    (say 32 (finds (nodeBuildEMatch (mkEInt 0) arms 0 0) two))
    (say 33 (finds (nodeBuildEField one "field" 0 0) one))
    (say 34 (finds (nodeBuildESet "slot" one 0 0) one))
    (say 35 (finds (nodeBuildESetf one "field" two 0) one))
    (say 36 (finds (nodeBuildESetf (mkEInt 0) "field" two 0) two))
    (say 37 (finds (nodeBuildEWhile one (vecPush vecNew two) 0 0) one))
    (say 38 (finds (nodeBuildEWhile (mkEInt 0) (vecPush vecNew two) 0 0) two))
    (say 39 (finds (nodeBuildERegion "local" one 0 0) one))
    (say 40 (finds (nodeBuildEHandle one vecNew two 0) one))
    (say 41 (finds (nodeBuildEHandle (mkEInt 0) vecNew two 0) two))
    (say 42 (finds (nodeBuildESubcheck one (vecPush vecNew two) nilNode 0) one))
    (say 43 (finds (nodeBuildESubcheck (mkEInt 0) (vecPush vecNew two) one 0) two))
    (say 44 (finds (nodeBuildESubcheck (mkEInt 0) vecNew one 0) one))
    (say 45 (misses (nodeBuildESubcheck (mkEInt 0) vecNew nilNode 0)))
    (say 46 (misses mkTErr))
    0
  })
