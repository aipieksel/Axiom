; Existing renderer refusals keep their exact AX3025 bytes and spans.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let source "(data Bad (Bad Foreign))")
    (let tokens (lex source))
    (let nodes (expectParsed (parseModule tokens)))
    (let units
      (vecPush vecNew
        (CUnit2
          :file "renderer-refusals.ax"
          :src source
          :name (Some "")
          :imports vecNew
          :library false)))
    (let tc (tcNew nodes nodes units))
    (let span (tokenSpan (vecGet tokens 2)))
    (showHelperName tc "Fmt" "fmtInt" span)
    (showHelperName tc "Vec" "vecNew" span)
    (showEnsure tc (mkTCon "Bad" vecNew) span)
    (showEnsure tc (mkTCon "Foreign" vecNew) span)
    (showEnsure tc (mkTVar "a") span)
    (writeStr stdout (renderDiagsUnits (tcOutVec tc) units))
    0
  })
