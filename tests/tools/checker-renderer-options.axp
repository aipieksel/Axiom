; Missing renderer dependencies roll back generated rows, including recursive ones.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: context (-> String TC))
(fn (context source)
  {
    (let nodes (pResNodes (parseModule (lex source))))
    (let units
      (vecPush vecNew
        (CUnit2
          :file "renderer-options.ax"
          :src source
          :name (Some "")
          :imports vecNew
          :library false)))
    (tcNew nodes nodes units)
  })

(:: signature (-> TC String ASTNode ()))
(fn (signature tc name ty)
  {
    (let sig (nodeBuildDSig name nilWords 0 0))
    (writeNodeChild sig 6 ty)
    (tcCollectSig tc sig)
    ()
  })

(:: helpers (-> TC ()))
(fn (helpers tc)
  {
    (signature tc "concat" (mkTArr mkStringTy (mkTArr mkStringTy mkStringTy)))
    (signature tc "strLen" (mkTArr mkStringTy mkIntTy))
    (signature tc "strByte" (mkTArr mkStringTy (mkTArr mkIntTy mkIntTy)))
    (signature tc "strFromByte" (mkTArr mkIntTy mkStringTy))
    (signature tc "fmtInt" (mkTArr mkIntTy mkStringTy))
    (signature tc "fmtUIntWord" (mkTArr mkIntTy mkStringTy))
    (signature tc "fmtFloat" (mkTArr (mkTCon "Float" vecNew) mkStringTy))
    (signature tc "vecLen" (mkTArr mkVecIntTy mkIntTy))
    (signature tc "vecGet" (mkTArr mkVecIntTy (mkTArr mkIntTy mkIntTy)))
    (signature tc "vecPush" (mkTArr mkVecIntTy (mkTArr mkIntTy mkVecIntTy)))
    (signature tc "vecNew" mkVecIntTy)
  })

(:: named (-> (Option String) String Bool))
(fn (named result expected)
  (match result
    ((Some name) (strEq name expected))
    ((None) false)))

(:: noEmptyNodes (-> Nodes Bool))
(fn (noEmptyNodes nodes)
  {
    (let mut good true)
    (for node in nodes
      (if (! (noEmptyVars node))
        (set good false)))
    good
  })

(:: noEmptyVars (-> ASTNode Bool))
(fn (noEmptyVars node)
  (if (nodeSame node nilNode)
    true
    {
      (let tag (nodeTag node))
      (if (== tag TAG_E_VAR)
        (> (strLen (nodeAName node)) 0)
        (if (== tag TAG_E_APP)
          (&& (noEmptyVars (nodeAChild node)) (noEmptyVars (nodeBChild node)))
          (if (== tag TAG_E_IF)
            (&& (noEmptyVars (nodeAChild node))
              (&& (noEmptyVars (nodeBChild node)) (noEmptyVars (nodeCChild node))))
            (if (== tag TAG_E_LET)
              (&& (noEmptyVars (nodeBChild node)) (noEmptyVars (nodeCChild node)))
              (if (== tag TAG_E_MATCH)
                (&& (noEmptyVars (nodeAChild node)) (noEmptyNodes (nodeBChildren node)))
                (if (== tag TAG_M_ARM)
                  (noEmptyVars (nodeBChild node))
                  (if (== tag TAG_E_BEGIN)
                    (noEmptyNodes (nodeAChildren node))
                    (if (== tag TAG_E_FIELD)
                      (noEmptyVars (nodeAChild node))
                      true))))))))
    }))

(:: generatedBodies (-> TC Bool))
(fn (generatedBodies tc)
  {
    (let mut good true)
    (for declaration in (tcAllDeclsVec tc)
      (if (== (nodeTag declaration) TAG_D_FN)
        (if (|| (nodeSame (nodeCChild declaration) nilNode)
              (! (noEmptyVars (nodeCChild declaration))))
          (set good false))))
    good
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let tc (context "(data Tree (End) (Next Tree String))"))
    (let span (tokenSpan (vecGet (lex "renderer") 0)))
    (let initialDecls (vecLen (tcAllDeclsVec tc)))
    (let initialFns (vecLen (tcFnsVec tc)))
    (say 1 (isNone (showHelperName tc "Fmt" "fmtInt" span)))
    (say 2 (== (countErrorDiags (tcOutVec tc)) 1))
    (let head (mkEVarAt "format#" span))
    (showRewriteTo tc head "Fmt" "fmtInt" span)
    (say 3 (strEq (nodeAName head) "format#"))
    (say 4 (isNone (showIntegerExpr tc (mkEInt 4) "UInt16" span)))
    (say 5 (isSome (showFieldExpr tc mkBoolTy (showVar "true" span) span)))
    (say 6 (isNone (showCat tc (showLit "a" span) (showLit "b" span) span)))
    (say 7 (isNone (showEnsure tc (mkTCon "Foreign" vecNew) span)))
    (say 8 (isNone (showEnsureString tc span)))
    (say 9
      (&& (== (vecLen (tcAllDeclsVec tc)) initialDecls) (== (vecLen (tcFnsVec tc)) initialFns)))
    (say 10 (isNone (showEnsureString tc span)))
    (say 11 (isNone (fnEntExact tc "show#String#quoted")))
    (say 12 (isNone (showEnsureSeen tc span)))
    (signature tc "concat" (mkTArr mkStringTy (mkTArr mkStringTy mkStringTy)))
    (say 13 (isNone (showEnsure tc mkCharTy span)))
    (say 14 (&& (isNone (fnEntExact tc "show#Char")) (isNone (fnEntExact tc "show#Char#utf8"))))
    (say 15 (== (vecLen (tcFnsVec tc)) (+ initialFns 1)))
    (say 16 (isNone (showEnsure tc mkCharTy span)))
    (helpers tc)
    (let keepTy (mkTArr mkIntTy mkIntTy))
    (signature tc "userKeep" keepTy)
    (let declsBefore (vecLen (tcAllDeclsVec tc)))
    (let fnsBefore (vecLen (tcFnsVec tc)))
    (let errorsBefore (countErrorDiags (tcOutVec tc)))
    (let tree (mkTCon "Tree" vecNew))
    (say 17 (isNone (showEnsure tc tree span)))
    (say 18 (&& (== (vecLen (tcAllDeclsVec tc)) declsBefore) (== (vecLen (tcFnsVec tc)) fnsBefore)))
    (say 19 (isNone (fnEntExact tc "show#Tree")))
    (say 20 (isNone (fnEntExact tc "show#String#quoted")))
    (say 21 (isNone (fnEntExact tc "show#seen")))
    (say 22 (isNone (showEnsure tc tree span)))
    (say 23 (== (countErrorDiags (tcOutVec tc)) (+ errorsBefore 2)))
    (say 24 (named (showHelperName tc "Str" "concat" span) "concat"))
    (signature tc "vecPop" (mkTArr mkVecIntTy mkIntTy))
    (say 25 (named (showEnsure tc tree span) "show#Tree"))
    (say 26 (== (vecLen (tcAllDeclsVec tc)) (+ declsBefore 10)))
    (say 27 (== (vecLen (tcFnsVec tc)) (+ fnsBefore 6)))
    (let declsReady (vecLen (tcAllDeclsVec tc)))
    (say 28 (named (showEnsure tc tree span) "show#Tree"))
    (say 29 (== (vecLen (tcAllDeclsVec tc)) declsReady))
    (say 30 (generatedBodies tc))
    (say 31 (named (showEnsureString tc span) "show#String#quoted"))
    (say 32 (named (showEnsureSeen tc span) "show#seen"))
    (say 33 (named (showEnsure tc mkCharTy span) "show#Char"))
    (say 34 (generatedBodies tc))
    (say 35 (isSome (showUtf8Ladder tc span)))
    (say 36 (isSome (showIntegerExpr tc (mkEInt 4) "UInt16" span)))
    (signature tc "Fmt$fmtInt" (mkTArr mkIntTy mkStringTy))
    (say 37 (named (showHelperName tc "Fmt" "fmtInt" span) "Fmt$fmtInt"))
    (say 38 (isSome (showFieldExpr tc mkStringTy (showVar "text" span) span)))
    (say 39 (isSome (showFieldExpr tc mkCharTy (showVar "letter" span) span)))
    (let errorCount (countErrorDiags (tcOutVec tc)))
    (tcWalkDecls tc 0)
    (say 40 (== (countErrorDiags (tcOutVec tc)) errorCount))
    (say 41 (isSome (findFnEnt tc "fmtInt")))
    (say 42 (isSome (findFnEnt tc "show#Tree")))
    (let noIndices (context "(data Plain (Plain))"))
    (set noIndices.fnIdx None)
    (set noIndices.fnSufIdx None)
    (say 43 (isNone (showEnsureString noIndices span)))
    (say 44 (&& (isNone noIndices.fnIdx) (isNone noIndices.fnSufIdx)))
    (say 45 (named (showEnsure noIndices (mkTCon "Plain" vecNew) span) "show#Plain"))
    (say 46 (generatedBodies noIndices))
    (say 47
      (strEq (diagMsg (vecGet (tcOutVec tc) (- errorCount 1)))
        "`format` renders with `Vec`'s `vecPop`, and `Vec` is not loaded here"))
    (say 48
      (if (let (Some entry) (fnEntExact tc "userKeep"))
        (nodeSame entry.ty keepTy)
        false))
    (let missingHead (mkEVarAt "format#" span))
    (let argument (showVar "plain" span))
    (let application (nodeBuildEApp missingHead argument nilWords span))
    (showRewriteGen noIndices application missingHead argument (mkTCon "Plain" vecNew) 1)
    (say 49 (strEq (nodeAName missingHead) "format#"))
    (say 50 (nodeSame (nodeBChild application) argument))
    0
  })
