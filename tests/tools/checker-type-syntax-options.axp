; Semantic type-declaration lookups distinguish missing from present syntax.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import diag)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: named (-> (Option ASTNode) String Bool))
(fn (named candidate expected)
  (match candidate
    ((Some declaration) (strEq (nodeAName declaration) expected))
    ((None) false)))

(:: boundsCount (-> (Option Nodes) Int Bool))
(fn (boundsCount candidate count)
  (match candidate
    ((Some bounds) (== (vecLen bounds) count))
    ((None) false)))

(:: expression (-> String ASTNode))
(fn (expression body)
  {
    (let parsed (parseModule (lex (concat (concat "(pub fn (expression) " body) ")"))))
    (nodeCChild (vecGet (expectParsed parsed) 0))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let parsed
      (parseModule
        (lex
          "(pub type Amount Int) (pub type Identity a a) (subtype Positive is Int range 1..10) (subtype NonNeg is Int range 0) (pub struct Record (value : Int)) (pub :: take (-> Positive Int))")))
    (let declarations (expectParsed parsed))
    (let hidden (nodeBuildDAlias "Hidden" (mkTCon "Int" vecNew) vecNew 0))
    (writeNodeText hidden 8 "Owner")
    (vecPush declarations hidden)
    (let visible (nodeBuildDAlias "Exported" (mkTCon "Float" vecNew) vecNew 0))
    (writeNodeText visible 8 "Owner")
    (writeNodeWord visible 5 1)
    (vecPush declarations visible)
    (let tc (tcNew declarations declarations vecNew))
    (let word (mkTCon "Int" vecNew))
    (let positive (mkTCon "Positive" vecNew))
    (say 1 (== (countErrorDiags (tcOutVec tc)) 0))
    (say 2 (isNone (tcAliasFind tc "Missing")))
    (say 3 (isNone (tcAliasFind tc "Int")))
    (say 4 (isNone (tcAliasFind tc "Record")))
    (say 5 (named (tcAliasFind tc "Amount") "Amount"))
    (say 6 (isNone (tySubtypeDecl tc word)))
    (say 7 (isNone (tySubtypeDecl tc (mkTVar "a"))))
    (say 8 (isNone (tySubtypeDecl tc mkTErr)))
    (say 9 (named (tySubtypeDecl tc positive) "Positive"))
    (say 10 (named (tySubtypeBase tc positive) "Int"))
    (say 11 (isNone (tySubtypeBase tc word)))
    (say 12 (boundsCount (tySubtypeBounds tc positive) 2))
    (say 13 (boundsCount (tySubtypeBounds tc (mkTCon "NonNeg" vecNew)) 1))
    (say 14 (isNone (tySubtypeBounds tc word)))
    (say 15 (== (subtypeArgAction tc positive positive) 1))
    (say 16 (== (subtypeArgAction tc positive word) 2))
    (say 17 (== (subtypeArgAction tc word positive) 1))
    (say 18 (== (subtypeArgAction tc positive (mkTCon "String" vecNew)) 0))
    (say 19 (== (subtypeArgAction tc positive mkTErr) 1))
    (say 20 (strEq (nodeAName (showBaseOf tc positive)) "Int"))
    (say 21 (nodeSame (showBaseOf tc nilNode) nilNode))
    (say 22 (strEq (nodeAName (tyExpandAliases tc (mkTCon "Amount" vecNew) 0)) "Int"))
    (say 23
      (strEq (nodeAName (tyExpandAliases tc (mkTCon "Identity" (vecPush vecNew word)) 0)) "Int"))
    (say 24 (== (nodeTag (tyExpandAliases tc (mkTCon "Identity" vecNew) 0)) TAG_T_ERR))
    (say 25 (isNone (tcAliasFind tc "Hidden")))
    (say 26 (isNone (tcAliasFind tc "Owner$Hidden")))
    (say 27 (named (tcAliasFind tc "Owner$Exported") "Exported"))
    (set tc.curModule (Some "Owner"))
    (say 28 (named (tcAliasFind tc "Hidden") "Hidden"))
    (say 29 (named (tcAliasFind tc "Owner$Hidden") "Hidden"))
    (set tc.curModule None)
    (say 30 (isNone (tcAliasFind tc "Hidden")))
    (let empty (nodeBuildDSubtype "Unbounded" word vecNew 0))
    (tyIdxPut tc "Unbounded" None (TySubtype empty))
    (say 31 (boundsCount (tySubtypeBounds tc (mkTCon "Unbounded" vecNew)) 0))
    (say 32 (isNone (tySubtypeBounds tc (mkTCon "Absent" vecNew))))
    (let cast (expression "(as 4 Positive)"))
    (let castTy (checkExprH tc cast 0))
    (say 33 (strEq (nodeAName castTy) "Positive"))
    (say 34 (== (nodeTag cast) TAG_E_SUBCHECK))
    (let call (expression "(take 4)"))
    (let callTy (checkExprH tc call 0))
    (say 35 (strEq (nodeAName callTy) "Int"))
    (say 36 (== (nodeTag (nodeBChild call)) TAG_E_SUBCHECK))
    (let declaration (nodeBuildDFn "returned" vecNew (mkEInt 4) 0))
    (say 37 (nodeSame (maybeWrapSubtypeReturn tc declaration positive word) positive))
    (say 38 (== (nodeTag (nodeCChild declaration)) TAG_E_SUBCHECK))
    (let ordinary (nodeBuildDFn "ordinary" vecNew (mkEInt 4) 0))
    (say 39 (nodeSame (maybeWrapSubtypeReturn tc ordinary word word) word))
    (say 40 (== (nodeTag (nodeCChild ordinary)) TAG_E_INT))
    (say 41 (== (countErrorDiags (tcOutVec tc)) 0))
    0
  })
