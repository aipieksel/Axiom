(import core)
(import driver)
(import diag)
(import render)
(import Vec)
(import Str)
(import IO)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let ir
      "; axiom-asm-file 0 \"present.ax\"\n; axiom-asm-file 1 \"empty.ax\"\n; axiom-asm-file 2 \"missing.ax\"\n; axiom-asm-site 0 0 0-5 6-10 bad-3 9-2 0-99\n; axiom-asm-site 5 1 0-1\n; axiom-asm-site 6 2 0-1\n; axiom-asm-site 7 0 00-05 0-5\n")
    (let text
      "<inline asm>:1:1: error: bad opcode\n  BAD r0\nnote: !srcloc = 0\n<inline asm>:1:1: error: bad opcode\n  BAD r1\nnote: !srcloc = 0\nerror: no registers at line 1\nerror: malformed at line 2\nerror: reversed at line 3\nerror: outside at line 4\nerror: empty source at line 5\nerror: failed read at line 6\n<inline asm>:1:1: error: bad opcode\n  BAD r2\nnote: !srcloc = 7\n<inline asm>:1:1: error: bad opcode\n  BAD r3\nnote: !srcloc = 8\nerror: unmapped at line 999\nerror: no metadata\n")
    (let ds vecNew)
    (let units vecNew)
    (let missing (asmFailDiags text ir ds units))
    (let diagnosticCount (vecLen ds))
    (let unitCount (vecLen units))
    (let unitZero (asmUnitFor units "present.ax"))
    (let afterCount (vecLen units))
    (let presentLength (strLen (unitSrc (vecGet units 0))))
    (let emptyLength (strLen (unitSrc (vecGet units 1))))
    (let missingLength (strLen (unitSrc (vecGet units 2))))
    (println "unmapped {missing}")
    (println "diagnostics {diagnosticCount} units {unitCount}")
    (println "unit0 {unitZero} count {afterCount}")
    (println "source lengths {presentLength} {emptyLength} {missingLength}")
    (writeStr stdout (renderDiagsFormat FMT_AI ds units))
    0
  })
