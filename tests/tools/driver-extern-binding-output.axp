(import core)
(import lexer)
(import parser)
(import rustbind)
(import IO)
(import Vec)

(:: declarations (-> String Nodes))
(fn (declarations source)
  (match (parseModule (lex source))
    ((ParseSuccess nodes position) nodes)
    ((ParseFailed error) __indexTrap)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let api
      (declarations
        "(pub :: nullary Int) (pub fn (nullary) 7) (pub :: word (-> Int Int)) (pub fn (word x) x) (pub :: borrowed (-> String String)) (pub fn (borrowed s) s) (pub :: malformed (-> Int Int)) (pub fn (malformed x) x) (pub :: unsupported (-> (-> Int Int) Int)) (pub fn (unsupported f) 0) (pub fn (unsigned) 1)"))
    (setNodeTyChild (vecGet api 6) (mkTArr (mkTCon "Int" vecNew) nilNode))
    (setNodeTyChild (vecGet api 8)
      (mkTArr (mkTArr (mkTCon "Int" vecNew) (mkTCon "Int" vecNew)) nilNode))
    (println (rustBindingOf api (rbPubNames api) "extern-options.ax"))
    0
  })
