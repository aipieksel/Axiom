(import Sys)
(import Str)
(import IO)
(import Err)
(import Fmt)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let log (strBuilderNew))
    (for i in 0..sysArgc
      {
        (let arg (sysArg i))
        (strBuilderPush log (concat (fmtInt i) (concat ":" (concat arg "\n"))))
      })
    (let _ (appendFile "tools.log" (strBuilderFinish log)))
    (let tool (sysArg 0))
    (let mode (sysEnv "AXIOM_TEST_OPT_MODE"))
    (if (&& (strEq tool "opt") (strStartsWith mode "fail"))
      (if (strEq mode "fail19")
        19
        7)
      {
        (let mut output "")
        (for i in 1..(- sysArgc 1)
          (if (strEq (sysArg i) "-o")
            (set output (sysArg (+ i 1)))))
        (if (&& (! (strEq mode "no-output")) (! (strEq output "")))
          (match (writeFile output (concat tool " output\n"))
            ((Ok _) ())
            ((Err _) ())))
        0
      })
  })
