(import core)
(import driver)
(import Str)
(import Vec)
(import Sys)
(import IO)
(import Err)

(:: levelOf (-> String Int))
(fn (levelOf text)
  (match text
    ("-1" -1)
    ("0" 0)
    ("2" 2)
    ("9" 9)
    (_ 1)))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (if (strEq (sysArg 1) "build")
    {
      (let status
        (buildToExecutable "; optimiser outcome fixture\n" (sysArg 2) (levelOf (sysArg 3))
          (if (strEq (sysArg 4) "keep")
            1
            0)
          vecNew))
      (println "status {status}")
      0
    }
    (match (probeRunOpt (sysArg 2) (levelOf (sysArg 3)) (sysArg 4))
      ((Ok path)
        {
          (println "ok {path}")
          0
        }
      )
      ((Err status)
        {
          (println "err {status}")
          0
        }
      ))))
