(import core)
(import driver)
(import Sys)
(import Str)
(import IO)
(import Err)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (let mode (sysArg 1))
    (if (strEq mode "phase")
      (probePhase (sysArg 2))
      (if (strEq mode "pipeline")
        {
          (let status (buildToExecutable (unwrapOr (readFile "large.ll") "") "output" 0 0 vecNew))
          (println "status {status}")
        }
        (match (buildSplit "" "input.ll" "split" "output" 2 vecNew)
          ((SplitUnavailable) (println "unavailable"))
          ((SplitFinished result)
            (match result
              ((Ok _) (println "success"))
              ((Err status) (println "failed {status}")))
          ))))
    (let drained (probeDrain 0))
    (println "drained {drained}")
    0
  })
