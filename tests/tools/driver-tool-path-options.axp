(import core)
(import driver)
(import Str)
(import Vec)
(import Sys)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: textIs (-> (Option String) String Bool))
(fn (textIs found expected)
  (match found
    ((None) false)
    ((Some text) (strEq text expected))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (if (strEq (sysArg 1) "spawn")
    {
      (let args (vecNew))
      (for i in 3..sysArgc
        (vecPush args (sysArg i)))
      (let status (probeSpawnWait (sysArg 2) args))
      (println "status {status}")
      0
    }
    {
      (say 1 (textIs (probeResolve "./tool") "./tool"))
      (say 2 (textIs (probeResolve "/") "/"))
      (say 3 (textIs (probeResolve "missing/tool") "missing/tool"))
      (let absolute (sysEnv "AXIOM_TEST_TOOL"))
      (say 4 (textIs (probeResolve absolute) absolute))
      (say 5 (isNone (probeResolveIn "tool" "" 0)))
      (say 6 (isNone (probeResolveIn "absent" "first:second" 0)))
      (say 7 (textIs (probeResolveIn "tool" "first:second" 0) "first/tool"))
      (say 8 (textIs (probeResolveIn "tool" "missing:second" 0) "second/tool"))
      (say 9 (textIs (probeResolveIn "tool" "second:first" 0) "second/tool"))
      (say 10 (textIs (probeResolveIn "tool" ":second" 0) "tool"))
      (say 11 (textIs (probeResolveIn "tool" "missing::second" 0) "tool"))
      (say 12 (isNone (probeResolveIn "tool" "missing:" 0)))
      (say 13 (textIs (probeResolveIn "tool" ":" 0) "tool"))
      (say 14 (isNone (probeResolveIn "tool" "bad path:bad;path" 0)))
      (say 15 (textIs (probeResolveIn "" "first" 0) "first/"))
      (say 16 (textIs (probeResolveIn "nonexec" "first" 0) "first/nonexec"))
      (say 17 (isNone (probeResolveIn "tool" "first" 5)))
      (say 18 (textIs (probeResolveIn "tool" "first:second" 6) "second/tool"))
      (say 19 (textIs (probeResolve "tool") "first/tool"))
      (say 20 (isNone (probeResolve "absent")))
      (let name (strDup "./tool"))
      (let before (count name))
      (let mut valid true)
      (for i in 0..32
        (if (! (textIs (probeResolve name) "./tool"))
          (set valid false)))
      (say 21 valid)
      (say 22 (== (count name) before))
      (say 23 (textIs (probeResolve (strDup "./tool")) "./tool"))
      (let path (strDup "missing:second"))
      (let pathBefore (count path))
      (for i in 0..32
        (probeResolveIn "tool" path 0))
      (say 24 (== (count path) pathBefore))
      0
    }))
