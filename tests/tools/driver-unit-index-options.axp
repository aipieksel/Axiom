(import core)
(import parser)
(import codegen)
(import driver)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: at (-> (Option Int) Int Bool))
(fn (at found expected)
  (match found
    ((None) false)
    ((Some index) (== index expected))))

(:: unit (-> (Option String) CUnit2))
(fn (unit name)
  (CUnit2 :file "unit.ax" :src "sample" :name name :imports vecNew :library false))

(:: external (-> (Option String) String ASTNode))
(fn (external module symbol)
  {
    (let field (nodeBuildFieldExtern "localName" (mkTCon "Int" vecNew) symbol (mkSpan 1 4)))
    (let declaration (nodeBuildDExtern "Library" vecNew (vecPush vecNew field) (mkSpan 0 6)))
    (match module
      ((None) 0)
      ((Some name) (writeNodeText declaration 8 name)))
    declaration
  })

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: lookupRetires (-> Nodes Units Int))
(fn (lookupRetires declarations units)
  {
    (let found (findExternUnit declarations "owned" units))
    (match found
      ((None) 1)
      ((Some index)
        (if (== index 1)
          0
          2)
      ))
  })

(:: detachedIndex (Option Int))
(fn (detachedIndex)
  (findExternUnit (vecPush vecNew (external (Some "Detached") "detached")) "detached"
    (vecPush vecNew (unit (Some "Detached")))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let entry (unit None))
    (let named (unit (Some "Module")))
    (let empty (unit (Some "")))
    (let units (vecPush (vecPush (vecPush vecNew entry) empty) named))
    (say 1 (isNone (unitIndexOf vecNew "Module" 0)))
    (say 2 (isNone (unitIndexOf (vecPush vecNew entry) "" 0)))
    (say 3 (at (unitIndexOf (vecPush vecNew named) "Module" 0) 0))
    (say 4 (isNone (unitIndexOf units "Missing" 0)))
    (say 5 (at (unitIndexOf units "Module" 0) 2))
    (say 6 (at (unitIndexOf units "" 0) 1))
    (let duplicates (vecPush (vecPush (vecPush vecNew named) entry) named))
    (say 7 (at (unitIndexOf duplicates "Module" 0) 0))
    (say 8 (at (unitIndexOf duplicates "Module" 1) 2))
    (say 9 (isNone (unitIndexOf duplicates "Module" 3)))
    (say 10 (isNone (unitIndexOf duplicates "module" 0)))
    (say 11 (isNone (findExternUnit vecNew "missing" vecNew)))
    (say 12 (isNone (findExternUnit (vecPush vecNew (mkEInt 0)) "missing" units)))
    (let local (external None "local"))
    (say 13 (at (findExternUnit (vecPush vecNew local) "local" units) 0))
    (say 14 (isNone (findExternUnit (vecPush vecNew local) "missing" units)))
    (let imported (external (Some "Module") "imported"))
    (say 15 (at (findExternUnit (vecPush vecNew imported) "imported" units) 2))
    (let emptyModule (external (Some "") "empty"))
    (say 16 (at (findExternUnit (vecPush vecNew emptyModule) "empty" units) 1))
    (let unresolved (external (Some "Missing") "same"))
    (say 17 (isNone (findExternUnit (vecPush vecNew unresolved) "same" units)))
    (say 18 (isNone (findExternUnit (vecPush vecNew imported) "imported" vecNew)))
    (let first (external None "same"))
    (let second (external (Some "Module") "same"))
    (say 19 (at (findExternUnit (vecPush (vecPush vecNew first) second) "same" units) 0))
    (say 20 (isNone (findExternUnit (vecPush (vecPush vecNew unresolved) second) "same" units)))
    (say 21 (at (findExternUnit (vecPush (vecPush vecNew local) imported) "imported" units) 2))
    (say 22 (at (findExternUnit (vecPush vecNew imported) "imported" duplicates) 0))
    (say 23 (at (findExternUnit (vecPush vecNew imported) "imported" (vecPush vecNew named)) 0))
    (say 24 (isNone (findExternUnit (vecPush vecNew emptyModule) "empty" (vecPush vecNew entry))))
    (say 25
      (isNone
        (findExternUnit (vecPush vecNew (nodeBuildDExtern "Empty" vecNew vecNew 0)) "missing"
          units)))
    (let ownedName (strDup "Owned"))
    (let ownedDeclaration (external (Some ownedName) "owned"))
    (let ownedDeclarations (vecPush vecNew ownedDeclaration))
    (let ownedUnits (vecPush (vecPush vecNew entry) (unit (Some ownedName))))
    (let nameBefore (count ownedName))
    (let declarationBefore (count ownedDeclaration))
    (let declarationsBefore (count ownedDeclarations))
    (let unitsBefore (count ownedUnits))
    (let mut failures 0)
    (for iteration in 0..32
      (set failures (+ failures (lookupRetires ownedDeclarations ownedUnits))))
    (say 26 (== failures 0))
    (say 27 (== (count ownedName) nameBefore))
    (say 28 (== (count ownedDeclaration) declarationBefore))
    (say 29 (== (count ownedDeclarations) declarationsBefore))
    (say 30 (== (count ownedUnits) unitsBefore))
    (say 31 (at detachedIndex 0))
    0
  })
