(import core)
(import parser)
(import expand)
(import Vec)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: isIndex (-> (Option Int) Int Bool))
(fn (isIndex result wanted)
  (match result
    ((None) false)
    ((Some index) (== index wanted))))

(:: operand (-> String AsmOp))
(fn (operand name)
  (AsmOp
    :kind "in"
    :name name
    :reg ""
    :node nilNode
    :val nilNode
    :into ""
    :intoNode nilNode
    :text ""))

(:: output (-> String String AsmOp))
(fn (output name into)
  (AsmOp
    :kind "out"
    :name name
    :reg ""
    :node nilNode
    :val nilNode
    :into into
    :intoNode nilNode
    :text ""))

(:: outputReg (-> String AsmOp))
(fn (outputReg name)
  (AsmOp
    :kind "out"
    :name name
    :reg "x0"
    :node nilNode
    :val nilNode
    :into ""
    :intoNode nilNode
    :text ""))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let ops
      (vecPush
        (vecPush (vecPush (vecPush vecNew (operand "first")) (operand "second")) (operand "first"))
        (operand "")))
    (let names (vecPush (vecPush (vecPush (vecPush vecNew "first") "second") "first") ""))
    (let outs
      (vecPush (vecPush (vecPush vecNew (output "first" "")) (output "stored" "slot"))
        (output "last" "")))
    (let mixed (vecPush (vecPush vecNew (outputReg "fixed")) (output "free" "")))
    (let unused (vecPush (vecPush (vecPush (vecPush vecNew 0) 0) 0) 0))
    (let firstUsed (vecPush (vecPush (vecPush (vecPush vecNew 1) 0) 0) 0))
    (let allUsed (vecPush (vecPush (vecPush (vecPush vecNew 1) 1) 1) 1))
    (say 1 (isNone (expAsmOpAt vecNew "first" 0)))
    (say 2 (isIndex (expAsmOpAt ops "first" 0) 0))
    (say 3 (isIndex (expAsmOpAt ops "second" 0) 1))
    (say 4 (isIndex (expAsmOpAt ops "first" 1) 2))
    (say 5 (isNone (expAsmOpAt ops "missing" 0)))
    (say 6 (isNone (expAsmOpAt ops "first" 4)))
    (say 7 (isNone (expAsmOpAt ops "first" -1)))
    (say 8 (isIndex (expAsmOpAt ops "" 0) 3))
    (say 9 (isIndex (expAsmOpAt ops "first" 2) 2))
    (say 10 (isNone (expAsmNameAt vecNew "first" 0)))
    (say 11 (isIndex (expAsmNameAt names "first" 0) 0))
    (say 12 (isIndex (expAsmNameAt names "second" 0) 1))
    (say 13 (isIndex (expAsmNameAt names "first" 1) 2))
    (say 14 (isNone (expAsmNameAt names "missing" 0)))
    (say 15 (isNone (expAsmNameAt names "first" -1)))
    (say 16 (isIndex (expAsmNameAt names "" 0) 3))
    (say 17 (isNone (expAsmAnswered vecNew 0 0)))
    (say 18 (isIndex (expAsmAnswered outs 0 0) 0))
    (say 19 (isIndex (expAsmAnswered outs 1 0) 2))
    (say 20 (isNone (expAsmAnswered outs 2 0)))
    (say 21 (isNone (expAsmAnswered outs 0 -1)))
    (say 22 (isIndex (expAsmFirstUnused ops unused 0) 0))
    (say 23 (isIndex (expAsmFirstUnused ops firstUsed 0) 1))
    (say 24 (isNone (expAsmFirstUnused ops allUsed 0)))
    (say 25 (isIndex (expAsmFirstUnused ops unused 2) 2))
    (say 26 (isNone (expAsmFirstUnused ops unused -1)))
    (say 27 (isNone (expAsmFirstUnused vecNew vecNew 0)))
    (say 28 (isNone (expAsmFirstOut vecNew true 0)))
    (say 29 (isIndex (expAsmFirstOut outs true 0) 0))
    (say 30 (isIndex (expAsmFirstOut outs false 0) 0))
    (say 31 (isIndex (expAsmFirstOut mixed true 0) 0))
    (say 32 (isIndex (expAsmFirstOut mixed false 0) 1))
    (say 33 (isNone (expAsmFirstOut ops true 0)))
    (say 34 (isNone (expAsmFirstOut outs true -1)))
    (say 35 (isNone (expAsmFirstOut outs true 3)))
  })
