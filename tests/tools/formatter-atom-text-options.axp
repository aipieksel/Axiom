; Appended to format.ax to test private atom queries and their consumers.
(import IO)
(import Fmt)
(import Sys)

(:: atomSay (-> Int Bool ()))
;@axiom:effect(io)
(fn (atomSay index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: atomTextIs (-> (Option String) String Bool))
(fn (atomTextIs result expected)
  (match result
    ((None) false)
    ((Some text) (strEq text expected))))

(:: atomQuery (-> String Bool (Option String)))
(fn (atomQuery src head)
  (match (readForms src (fsToksVec (fscan src)))
    ((None) None)
    ((Some forms)
      (if (== (vecLen forms) 1)
        (if head
          (fnHeadText src (vecGet forms 0))
          (fnText src (vecGet forms 0)))
        None)
    )))

(:: atomShape (-> String Bool Bool))
(fn (atomShape src application)
  (match (readForms src (fsToksVec (fscan src)))
    ((None) false)
    ((Some forms)
      (if application
        (fpIsAppForm src (vecGet forms 0))
        (isSimpleForm src (vecGet forms 0)))
    )))

(:: atomMalformed (-> FNode FNode Int Int))
(fn (atomMalformed base suffix mode)
  {
    (let kind
      (if (|| (== mode 3) (== mode 4))
        FN_QUAL
        FN_FIELD))
    (let node (mkFNode kind (mkFTok FT_DOT 1 2) (vecPush (vecPush vecNew base) suffix) 0 2))
    (let out mkFOut)
    (let printer (mkFPr "a." (lineStarts "a.") (mkFCq vecNew) out))
    (if (== mode 0)
      (fpEmitAtomText printer suffix)
      (if (== mode 1)
        (fpQualLeft printer node)
        (if (|| (== mode 2) (== mode 3))
          (fpExpr printer node)
          (if (== mode 4)
            (fpType printer node)
            (fpImportPath printer node)))))
    out.bad
  })

(:: atomEmptyPrint (-> FNode Bool))
(fn (atomEmptyPrint node)
  {
    (let out mkFOut)
    (let printer (mkFPr "" (lineStarts "") (mkFCq vecNew) out))
    (fpEmitAtomText printer node)
    (&& (== out.bad 0) (== (strLen (foFinish out)) 0))
  })

(:: atomReturnedText (Option String))
(fn (atomReturnedText)
  (atomQuery (strDup "owned") false))

(:: atomReturnedHead (Option String))
(fn (atomReturnedHead)
  (atomQuery (strDup "(f 42)") true))

(:: atomBorrowOnly (-> String FNode Bool))
(fn (atomBorrowOnly src node)
  (atomTextIs (fnText src node) "a"))

(:: atomStringCount (-> String Int))
;@axiom:effect(unsafe)
(fn (atomStringCount value)
  (__load64 (as value Int) -2))

(:: atomNodeCount (-> FNode Int))
;@axiom:effect(unsafe)
(fn (atomNodeCount value)
  (__load64 (as value Int) -2))

(:: atomFormatBorrow (-> String Bool))
(fn (atomFormatBorrow src)
  {
    (let result (fmtFormat src))
    (&& (== result.ok 1) (> (strLen result.text) 0))
  })

(:: atomChecks Int)
;@axiom:effect(io)
(fn (atomChecks)
  {
    (atomSay 1 (isNone (atomQuery "()" false)))
    (atomSay 2 (atomTextIs (atomQuery "word" false) "word"))
    (atomSay 3 (atomTextIs (atomQuery "42" false) "42"))
    (atomSay 4 (atomTextIs (atomQuery "\"\"" false) "\"\""))
    (atomSay 5 (atomTextIs (atomQuery "'x'" false) "'x'"))
    (atomSay 6 (atomTextIs (atomQuery "-" false) "-"))
    (let empty (mkFNode FN_ATOM (mkFTok FT_IDENT 0 0) vecNew 0 0))
    (let emptyGroup (mkFNode FN_PAREN (mkFTok FT_LPAREN 0 0) vecNew 0 0))
    (atomSay 7 (atomTextIs (fnText "" empty) ""))
    (atomSay 8 (isNone (fnText "" emptyGroup)))
    (atomSay 9 (atomTextIs (atomQuery "(f 42)" true) "f"))
    (atomSay 10 (isNone (atomQuery "f" true)))
    (atomSay 11 (isNone (atomQuery "()" true)))
    (atomSay 12 (isNone (atomQuery "((f) 42)" true)))
    (atomSay 13 (isNone (atomQuery "(Lib::f 42)" true)))
    (atomSay 14 (isNone (atomQuery "[f 42]" true)))
    (let emptyHead (mkFNode FN_PAREN (mkFTok FT_LPAREN 0 0) (vecPush vecNew empty) 0 0))
    (atomSay 15 (atomTextIs (fnHeadText "" emptyHead) ""))
    (atomSay 16 (! (fnTextMatches None "")))
    (atomSay 17 (fnTextMatches (Some "") ""))
    (atomSay 18 (! (atomShape "(if x y z)" false)))
    (atomSay 19 (atomShape "((f) 1)" false))
    (atomSay 20 (atomShape "(Lib::f 1)" false))
    (atomSay 21 (atomShape "(f 1)" true))
    (atomSay 22 (atomShape "((lambda (x) x) 1)" true))
    (atomSay 23 (! (atomShape "(if x y z)" true)))
    (atomSay 24 (! (atomShape "(consume 1)" true)))
    (atomSay 25 (atomShape "(Lib::f 1)" true))
    (let base (mkFNode FN_ATOM (mkFTok FT_IDENT 0 1) vecNew 0 1))
    (atomSay 26 (== (atomMalformed base emptyGroup 0) 1))
    (atomSay 27 (== (atomMalformed base emptyGroup 1) 1))
    (atomSay 28 (== (atomMalformed base emptyGroup 2) 1))
    (atomSay 29 (== (atomMalformed base emptyGroup 3) 1))
    (atomSay 30 (== (atomMalformed base emptyGroup 4) 1))
    (atomSay 31 (== (atomMalformed base emptyGroup 5) 1))
    (atomSay 32 (atomEmptyPrint empty))
    (atomSay 33 (atomTextIs atomReturnedText "owned"))
    (let source (strDup "a"))
    (let sourceCount (atomStringCount source))
    (let nodeCount (atomNodeCount base))
    (atomSay 34 (atomBorrowOnly source base))
    (atomSay 35 (== (atomNodeCount base) nodeCount))
    (atomSay 36 (== (atomStringCount source) sourceCount))
    (atomSay 37 (atomTextIs (atomQuery "(\"\" 42)" true) "\"\""))
    (atomSay 38 (atomTextIs atomReturnedHead "f"))
    (let program (strDup "(fn (f) ((lambda (x) x) 42))\n"))
    (let programCount (atomStringCount program))
    (atomSay 39 (atomFormatBorrow program))
    (atomSay 40 (== (atomStringCount program) programCount))
    0
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (strEq (sysArg 1) "format")
    {
      (let result (fmtFormat (sysArg 2)))
      (println (fmtInt result.ok))
      (writeStr stdout result.text)
      0
    }
    atomChecks))
