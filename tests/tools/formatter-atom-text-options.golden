    {
      "name": "262-long-positional-patterns.axp",
      "source": "(data Packet (Packet Int Int Int Int Int Int Int Int Int))\n(:: checksum (-> Packet Int))\n(fn (checksum packet) (match packet ((Packet firstPayloadValue ; header field\n secondPayloadValue thirdPayloadValue fourthPayloadValue fifthPayloadValue sixthPayloadValue seventhPayloadValue eighthPayloadValue ninthPayloadValue) ninthPayloadValue)))\n(:: main Int)\n(fn (main) (checksum (Packet 1 2 3 4 5 6 7 8 42)))\n",
      "ok": 1,
      "text": "(data Packet\n  (Packet Int Int Int Int Int Int Int Int Int))\n\n(:: checksum (-> Packet Int))\n(fn (checksum packet)\n  (match packet\n    ((Packet\n       firstPayloadValue  ; header field\n       secondPayloadValue\n       thirdPayloadValue\n       fourthPayloadValue\n       fifthPayloadValue\n       sixthPayloadValue\n       seventhPayloadValue\n       eighthPayloadValue\n       ninthPayloadValue) ninthPayloadValue)))\n\n(:: main Int)\n(fn (main)\n  (checksum (Packet 1 2 3 4 5 6 7 8 42)))\n"
    },
    {
      "name": "265-long-named-patterns.axp",
      "source": "(data Packet (Packet { first : Int, second : Int, third : Int, fourth : Int, fifth : Int, sixth : Int, seventh : Int, eighth : Int, ninth : Int }))\n(:: checksum (-> Packet Int))\n(fn (checksum packet) (match packet ((Packet {first = firstPayloadValue, ; first field stays here\n second = secondPayloadValue, third = thirdPayloadValue, fourth = fourthPayloadValue, fifth = fifthPayloadValue, sixth = sixthPayloadValue, seventh = seventhPayloadValue, eighth = eighthPayloadValue, ninth = ninthPayloadValue}) ninthPayloadValue)))\n(data Marker (Marker { value : Int, enabled : Bool }))\n(:: marker (-> Marker Bool))\n(fn (marker value) (match value ((Marker {value = -1, enabled}) enabled) (_ false)))\n(:: main Int)\n(fn (main) (if (marker (Marker -1 true)) (checksum (Packet 1 2 3 4 5 6 7 8 42)) 1))\n",
      "ok": 1,
      "text": "(data Packet\n  (Packet { first : Int, second : Int, third : Int, fourth : Int, fifth : Int, sixth : Int,\n    seventh : Int, eighth : Int, ninth : Int }))\n\n(:: checksum (-> Packet Int))\n(fn (checksum packet)\n  (match packet\n    ((Packet {first = firstPayloadValue,  ; first field stays here\n       second = secondPayloadValue,\n       third = thirdPayloadValue,\n       fourth = fourthPayloadValue,\n       fifth = fifthPayloadValue,\n       sixth = sixthPayloadValue,\n       seventh = seventhPayloadValue,\n       eighth = eighthPayloadValue,\n       ninth = ninthPayloadValue}) ninthPayloadValue)))\n\n(data Marker\n  (Marker { value : Int, enabled : Bool }))\n\n(:: marker (-> Marker Bool))\n(fn (marker value)\n  (match value\n    ((Marker {value = -1, enabled = enabled}) enabled)\n    (_ false)))\n\n(:: main Int)\n(fn (main)\n  (if (marker (Marker -1 true))\n    (checksum (Packet 1 2 3 4 5 6 7 8 42))\n    1))\n"
    },
    {
      "name": "266-long-extern-types.axp",
