; Appended to the production formatter by the runner to test private queries.
(import IO)
(import Fmt)
(import Sys)

(:: querySay (-> Int Bool ()))
;@axiom:effect(io)
(fn (querySay index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: queryIndexIs (-> (Option Int) Int Bool))
(fn (queryIndexIs result expected)
  (match result
    ((None) false)
    ((Some index) (== index expected))))

(:: queryTextIs (-> (Option String) String Bool))
(fn (queryTextIs result expected)
  (match result
    ((None) false)
    ((Some text) (strEq text expected))))

(:: queryBinding (-> String (Option Int)))
(fn (queryBinding src)
  (match (readForms src (fsToksVec (fscan src)))
    ((None) None)
    ((Some forms)
      (if (== (vecLen forms) 1)
        (fpBindInit src (vecGet forms 0))
        None)
    )))

(:: queryBindingBad (-> String Bool Int))
(fn (queryBindingBad src broken)
  (match (readForms src (fsToksVec (fscan src)))
    ((None) 1)
    ((Some forms)
      {
        (let out mkFOut)
        (let printer (mkFPr src (lineStarts src) (mkFCq vecNew) out))
        (if broken
          (fpLetBindingBroken printer (vecGet forms 0))
          (fpLetBinding printer (vecGet forms 0)))
        out.bad
      }
    )))

(:: queryStringCount (-> String Int))
;@axiom:effect(unsafe)
(fn (queryStringCount value)
  (__load64 (as value Int) -2))

(:: queryBorrowSpelling (-> String Bool))
(fn (queryBorrowSpelling value)
  (match (fpOperSpelling value)
    ((None) false)
    ((Some text) (strEq text value))))

(:: queryChecks Int)
;@axiom:effect(io)
(fn (queryChecks)
  {
    (querySay 1 (isNone (strLastNewline "" -1)))
    (querySay 2 (isNone (strLastNewline "abc" 2)))
    (querySay 3 (isNone (strLastNewline "a\n" -1)))
    (querySay 4 (queryIndexIs (strLastNewline "\n" 0) 0))
    (querySay 5 (queryIndexIs (strLastNewline "a\nb\nc" 4) 3))
    (querySay 6 (queryIndexIs (strLastNewline "a\nb\nc" 2) 1))
    (querySay 7 (isNone (strLastNewline "a\n" 0)))
    (let out mkFOut)
    (querySay 8 (== (foColumn out) 0))
    (vecPush out.frags "ab")
    (vecPush out.frags "cd")
    (querySay 9 (== (foColumn out) 4))
    (vecPush out.frags "\nabc")
    (querySay 10 (== (foColumn out) 3))
    (vecPush out.frags "\n")
    (querySay 11 (== (foColumn out) 0))
    (vecPush out.frags "abc")
    (vecPush out.frags "de")
    (querySay 12 (== (foColumn out) 5))
    (querySay 13 (isNone (fNestOverflow (fsToksVec (fscan "")) 0)))
    (querySay 14 (queryIndexIs (fNestOverflow (fsToksVec (fscan "(x)")) 0) 0))
    (querySay 15 (isNone (fNestOverflow (fsToksVec (fscan "(x)")) 1)))
    (querySay 16 (queryIndexIs (fNestOverflow (fsToksVec (fscan "((x))")) 1) 1))
    (querySay 17 (queryIndexIs (fNestOverflow (fsToksVec (fscan "x.a.b")) 1) 3))
    (querySay 18 (isNone (fNestOverflow (fsToksVec (fscan "(x.a y.b z.c)")) 4)))
    (querySay 19 (queryIndexIs (queryBinding "(x 42)") 1))
    (querySay 20 (queryIndexIs (queryBinding "(mut x -5)") 2))
    (querySay 21 (isNone (queryBinding "x")))
    (querySay 22 (isNone (queryBinding "()")))
    (querySay 23 (isNone (queryBinding "(x)")))
    (querySay 24 (isNone (queryBinding "(mut x)")))
    (querySay 25 (== (queryBindingBad "(x 42)" false) 0))
    (querySay 26 (== (queryBindingBad "(mut x -5)" true) 0))
    (querySay 27 (== (queryBindingBad "()" false) 1))
    (querySay 28 (== (queryBindingBad "(x)" true) 1))
    (querySay 29 (== (queryBindingBad "(x = 42)" false) 1))
    (querySay 30 (== (queryBindingBad "(x = 42)" true) 1))
    (querySay 31 (queryTextIs (fpOperSpelling "+") "+"))
    (querySay 32 (queryTextIs (fpOperSpelling "$") "!"))
    (querySay 33 (queryTextIs (fpOperSpelling "&&") "&&"))
    (querySay 34 (isNone (fpOperSpelling "~~")))
    (querySay 35 (isNone (fpOperSpelling "")))
    (let spelling (strDup "<<"))
    (let count (queryStringCount spelling))
    (querySay 36 (queryBorrowSpelling spelling))
    (querySay 37 (== (queryStringCount spelling) count))
    (querySay 38 (queryIndexIs (fNestOverflow (fsToksVec (fscan ") ((x))")) 1) 2))
    (querySay 39 (isNone (fNestOverflow (fsToksVec (fscan "(a.b c.d e.f) (g.h.i)")) 4)))
    (querySay 40 (queryIndexIs (queryBinding "(x -5)") 1))
    0
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (strEq (sysArg 1) "format")
    {
      (let result (fmtFormat (sysArg 2)))
      (println (fmtInt result.ok))
      (writeStr stdout result.text)
      0
    }
    queryChecks))
