; Untrusted macro packets fail closed before any expansion consumes them.
(import frontpack)
(import IO)
(import Sys)
(import Str)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (readFile (sysArg 1))
    ((Err _) 2)
    ((Ok bytes)
      (match (frontDecode bytes)
        ((None)
          {
            (println "fallback")
            0
          }
        )
        ((Some copied)
          {
            (println
              (if (strEq bytes (frontEncode copied))
                "same"
                "changed"))
            0
          }
        ))
    )))
