; Packet bytes remain independent of the in-memory macro record layout.
(import frontpack)
(import Str)
(import Vec)
(import Fmt)
(import IO)

(:: dump (-> String ()))
;@axiom:effect(io)
(fn (dump source)
  (match (frontParse source)
    ((None) (println "parse failed"))
    ((Some parsed)
      {
        (let packet (frontEncode parsed))
        (let parts vecNew)
        (for i in 0..(strLen packet)
          (vecPush parts
            (concat
              (if (< (strByte packet i) 16)
                "0"
                "")
              (fmtHex (strByte packet i)))))
        (println (strJoin parts ""))
      }
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (dump "(macro (head value) value)")
    (dump "(macro expr ((expr value) (+ value 1)))")
    (dump "(macro dual ((dual value) (callee value)))")
    (dump "(macro decl ((decl name) (:: name Int) (fn (name) 42)))")
    (dump
      "(macro literal (literals key) ((literal key item) item) ((literal (f arg) rest ...) (+ arg 1)))")
    0
  })
