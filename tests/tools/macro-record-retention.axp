; Observe packed getter retention separately from typed-product cleanup.
(import core)
(import parser)
(import Vec)
(import Str)
(import IO)
(import Fmt)

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: query (-> String (Option Names)))
(fn (query payload)
  {
    (let node (nodeWireEmpty TAG_CTOR))
    (writeNodeNames node 9 (vecPush vecNew payload))
    (nodeFieldNamesOpt node)
  })

(:: observe (-> String Int))
(fn (observe payload)
  (match (query payload)
    ((None) 0)
    ((Some _) 7)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let payload (strDup "existing-packed-name-owner"))
    (println (fmtInt (count payload)))
    (observe payload)
    (println (fmtInt (count payload)))
    (observe payload)
    (println (fmtInt (count payload)))
    0
  })
