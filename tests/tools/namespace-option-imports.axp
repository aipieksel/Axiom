; Typed module rows distinguish unrestricted and explicitly empty filters.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import core)
(import parser)
(import namespace)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: unrestricted (-> ModuleImports String Bool))
(fn (unrestricted mods name)
  (if (let (Some _) (modFilterFor mods name))
    false
    true))

(:: indexIs (-> MangleIdx Names String Int Bool))
(fn (indexIs index names name want)
  (if (let (Some position) (mangleIdxIndexOf index names name))
    (== position want)
    false))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let mods (:: vecNew ModuleImports))
    (say 1 (unrestricted mods "missing"))
    (say 2 (== (vecLen (modPubsFor mods "missing")) 0))
    (modPubsAdd mods "missing" "ignored")
    (modFilterWiden mods "missing" (Some (vecPush vecNew "ignored")))
    (say 3 (== (vecLen mods) 0))
    (modFilterRecord mods "All" None)
    (say 4 (filterKeeps (modFilterFor mods "All") "anything"))
    (modFilterRecord mods "Empty" (Some vecNew))
    (say 5 (! (unrestricted mods "Empty")))
    (say 6 (! (filterKeeps (modFilterFor mods "Empty") "anything")))
    (let original (vecPush vecNew "first"))
    (modFilterRecord mods "Named" (Some original))
    (say 7 (filterKeeps (modFilterFor mods "Named") "first"))
    (say 8 (! (filterKeeps (modFilterFor mods "Named") "second")))
    (modPubsAdd mods "Named" "first")
    (modPubsAdd mods "Named" "second")
    (say 9 (== (vecLen (modPubsFor mods "Named")) 2))
    (say 10 (== (vecLen (modPubsFor mods "All")) 0))
    (modFilterWiden mods "Named" (Some (vecPush (vecPush vecNew "first") "second")))
    (say 11 (filterKeeps (modFilterFor mods "Named") "second"))
    (say 12 (== (vecLen original) 1))
    (modFilterWiden mods "Named" None)
    (say 13 (filterKeeps (modFilterFor mods "Named") "third"))
    (say 14 (== (vecLen (modPubsFor mods "Named")) 2))
    (let index mangleIdxNew)
    (let names (:: vecNew Names))
    (let fulls (:: vecNew Names))
    (say 15 (! (mangleIdxHas index names "absent")))
    (mangleRecord index names fulls "item" "Module$item")
    (say 16 (indexIs index names "Module$item" 0))
    (say 17 (indexIs index names "item" 1))
    (mangleRecord index names fulls "item" "Other$item")
    (say 18 (strEq (vecGet fulls 1) "Module$item"))
    (vecPush names "direct")
    (vecPush fulls "Direct$direct")
    (say 19 (mangleIdxHas index names "direct"))
    (mangleRecordEntry index names fulls "item")
    (say 20 (strEq (vecGet fulls 1) "item"))
    (say 21 (mangleIdxHas index names "$item"))
    (say 22
      (if (let (Some position) (mangleIdxIndexOf index names "$item"))
        (strEq (vecGet fulls position) "Module$item")
        false))
    (for i in 0..200
      (mangleRecordSelf index names fulls (concat "growing" (fmtInt i))))
    (say 23 (mangleIdxHas index names "growing199"))
    (say 24 (indexIs index names "item" 1))
    (say 25 (! (mangleIdxHas index names "still-absent")))
    (modFilterRecord mods "Visibility" (Some (vecPush vecNew "shown")))
    (let shown (mkDFnAt "shown" vecNew (mkEInt 1) 0))
    (let hidden (mkDFnAt "hidden" vecNew (mkEInt 2) 0))
    (let private (mkDFnAt "private" vecNew (mkEInt 3) 0))
    (writeNodeWord shown 5 1)
    (writeNodeWord hidden 5 1)
    (say 26 (== (moduleDeclExport shown "Visibility" mods (modFilterFor mods "Visibility")) 1))
    (say 27 (== (moduleDeclExport hidden "Visibility" mods (modFilterFor mods "Visibility")) 0))
    (say 28 (== (moduleDeclExport private "Visibility" mods None) 0))
    (say 29 (== (vecLen (modPubsFor mods "Visibility")) 2))
    0
  })
