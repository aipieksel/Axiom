; Entry declaration and signature queries distinguish absence and ordered matches.
(import core)
(import lexer)
(import parser)
(import rustbind)
(import Str)
(import Vec)
(import IO)

(:: declarations (-> String Nodes))
(fn (declarations source)
  (match (parseModule (lex source))
    ((ParseSuccess nodes position) nodes)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: firstFieldIs (-> (Option ASTNode) String Bool))
(fn (firstFieldIs found expected)
  (match found
    ((None) false)
    ((Some node) (strEq (nodeAName (vecGet (nodeBChildren node) 0)) expected))))

(:: typeIs (-> (Option ASTNode) Int Bool))
(fn (typeIs found tag)
  (match found
    ((None) false)
    ((Some node) (== (nodeTag (nodeTyChild node)) tag))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let nodes
      (declarations
        "(struct Product (first : Int)) (struct Product (last : String)) (struct Empty) (data Choice (One Int) (Two)) (:: signed Int) (:: signed String) (fn (signed) 7) (fn (unsigned) 1)"))
    (say 1 (isNone (bindingProbeData vecNew "Product")))
    (say 2 (firstFieldIs (bindingProbeData nodes "Product") "last"))
    (say 3 (isNone (bindingProbeData nodes "absent")))
    (say 4 (isNone (bindingProbeData nodes "signed")))
    (say 5 (typeIs (bindingProbeSig nodes "signed" 0) TAG_T_CON))
    (say 6
      (match (bindingProbeSig nodes "signed" 0)
        ((None) false)
        ((Some node) (strEq (nodeAName (nodeTyChild node)) "Int"))))
    (say 7
      (match (bindingProbeSig nodes "signed" 5)
        ((None) false)
        ((Some node) (strEq (nodeAName (nodeTyChild node)) "String"))))
    (say 8 (isNone (bindingProbeSig nodes "signed" (vecLen nodes))))
    (say 9 (isNone (bindingProbeSig nodes "unsigned" 0)))
    (let imported (declarations "(struct Product (foreignField : Int))"))
    (writeNodeText (vecGet imported 0) 8 "ForeignModule")
    (say 10 (isNone (bindingProbeData imported "Product")))
    (say 11 (== (bindingProbeIsData nodes (mkTCon "Product" vecNew)) 1))
    (say 12 (== (bindingProbeIsData nodes (mkTCon "Absent" vecNew)) 0))
    (say 13 (== (bindingProbeIsStruct nodes (mkTCon "Empty" vecNew)) 1))
    (say 14 (== (bindingProbeIsStruct nodes (mkTCon "Choice" vecNew)) 0))
    (say 15 (== (bindingProbeCtorCount nodes (mkTCon "Choice" vecNew)) 2))
    (say 16 (== (bindingProbeCtorCount nodes (mkTCon "Absent" vecNew)) 0))
    (say 17 (bindingProbeNamedEmpty nodes (mkTCon "Empty" vecNew)))
    (say 18 (! (bindingProbeNamedEmpty nodes (mkTCon "Choice" vecNew))))
    (say 19
      (== (bindingProbeCtorCount nodes (mkTCon "Option" (vecPush vecNew (mkTCon "Int" vecNew)))) 2))
    (say 20
      (== (bindingProbeIsData vecNew (mkTCon "Option" (vecPush vecNew (mkTCon "Int" vecNew)))) 1))
    (println "BINDING")
    (let api
      (declarations
        "(pub struct Empty) (pub struct Product (value : Int)) (pub data Choice (One Int) (Two)) (pub :: identity (-> Int Int)) (pub fn (identity value) value) (pub fn (unsigned) 1) (pub :: unsupported (-> (-> Int Int) Int)) (pub fn (unsupported f) 0)"))
    (println (rustBindingOf api (rbPubNames api) "binding-options.ax"))
    0
  })
