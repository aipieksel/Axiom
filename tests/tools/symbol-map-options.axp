; Symbol lookups preserve missing keys, empty collections and owned aliases.
(import core)
(import lexer)
(import parser)
(import typecheck)
(import symbols)
(import axir)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: same (-> (Option ASTNode) ASTNode Bool))
(fn (same candidate expected)
  (match candidate
    ((None) false)
    ((Some actual) (nodeSame actual expected))))

(:: escapedNames (-> String (Option Names)))
(fn (escapedNames payload)
  {
    (let names (vecPush vecNew "entry"))
    (let values (vecPush vecNew (vecPush vecNew payload)))
    (saGetNames names values "entry")
  })

(:: duringNames (-> String Int))
(fn (duringNames payload)
  {
    (let result (escapedNames payload))
    (match result
      ((None) -1)
      ((Some names)
        (if (== (vecLen names) 1)
          (count payload)
          -2)
      ))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let keys (vecPush (vecPush vecNew "empty") "value"))
    (let empty (:: vecNew Names))
    (let names (vecPush vecNew (strDup "owned-name")))
    (let values (vecPush (vecPush vecNew empty) names))
    (say 1 (isNone (saGetNames keys values "missing")))
    (say 2
      (match (saGetNames keys values "empty")
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (say 3
      (match (saGetNames keys values "value")
        ((None) false)
        ((Some found) (strEq (vecGetStr found 0) "owned-name"))))
    (if (let (Some found) (saGetNames keys values "value"))
      (vecPush found "alias"))
    (say 4 (== (vecLen names) 2))
    (let payload (strDup "retained-child"))
    (let before (count payload))
    (say 5 (== (duringNames payload) (+ before 1)))
    (say 6 (== (count payload) before))
    (say 7
      (match (escapedNames (strDup "escaped"))
        ((None) false)
        ((Some found) (strEq (vecGetStr found 0) "escaped"))))
    (let words (vecPush (vecPush vecNew (:: vecNew Ints)) (vecPush vecNew 42)))
    (say 8 (isNone (symbolProbeVec keys words "missing")))
    (say 9
      (match (symbolProbeVec keys words "empty")
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (say 10
      (match (symbolProbeVec keys words "value")
        ((None) false)
        ((Some found) (== (vecGet found 0) 42))))
    (let poison mkTErr)
    (let wild (mkTVar ""))
    (let nodeKeys (vecPush (vecPush (vecPush vecNew "nil") "poison") "wild"))
    (let nodes (vecPush (vecPush (vecPush vecNew nilNode) poison) wild))
    (say 11 (isNone (saGetNode nodeKeys nodes "missing")))
    (say 12 (isNone (saGetNode nodeKeys nodes "nil")))
    (say 13 (same (saGetNode nodeKeys nodes "poison") poison))
    (say 14 (same (saGetNode nodeKeys nodes "wild") wild))
    (say 15 (strEq (symbolProbeParam None 0) "0"))
    (say 16 (strEq (symbolProbeParam (Some empty) 0) "0"))
    (say 17 (strEq (symbolProbeParam (Some names) 0) "owned-name"))
    (say 18 (strEq (symbolProbeParam (Some names) 3) "3"))
    (say 19 (strEq (symbolProbeParam (Some names) -1) "-1"))
    (let parsed
      (parseModuleWith
        (lex
          ";@axiom:effect(pure)\n(pub :: tagged (-> Int Int))\n;@axiom:restrict(no-io)\n(pub fn (tagged item) item)\n(pub fn (untagged) 42)\n")
        (scanAxtags
          ";@axiom:effect(pure)\n(pub :: tagged (-> Int Int))\n;@axiom:restrict(no-io)\n(pub fn (tagged item) item)\n(pub fn (untagged) 42)\n")))
    (let declarations (expectParsed parsed))
    (let map smNew)
    (let signature (vecGet declarations 0))
    (let definition (vecGet declarations 1))
    (smTags map signature "tagged")
    (smTags map definition "tagged")
    (let metas vecNew)
    (smTagMetas map "tagged" metas)
    (say 20 (== (vecLen metas) 2))
    (say 21 (&& (> (vecLen metas) 0) (strEq (vecGet metas 0) "effect=pure")))
    (say 22 (&& (> (vecLen metas) 1) (strEq (vecGet metas 1) "restrict=no-io")))
    (smTags map signature "tagged")
    (let duplicate vecNew)
    (smTagMetas map "tagged" duplicate)
    (say 23 (== (vecLen duplicate) 2))
    (say 24 (== (vecLen (nodeAxtagsWords signature)) 1))
    (say 25 (== (vecLen (nodeAxtagsWords definition)) 1))
    (if (let (Some union) (symbolProbeVec map.tagN map.tagV "tagged"))
      (vecPush union (vecGet (nodeAxtagsWords signature) 0)))
    (say 26 (== (vecLen (nodeAxtagsWords signature)) 1))
    (say 27 (== (vecLen (nodeAxtagsWords definition)) 1))
    (smTags map (vecGet declarations 2) "untagged")
    (say 28
      (match (symbolProbeVec map.tagN map.tagV "untagged")
        ((None) false)
        ((Some tags)
          (&& (!= (as tags Int) 0) (== (vecLen tags) 0))
        )))
    (say 29 (isNone (symbolProbeVec map.tagN map.tagV "absent")))
    (let collected (smBuild declarations vecNew))
    (say 30 (same (axirDeclFor collected "tagged") definition))
    (say 31 (isNone (axirDeclFor collected "not-defined")))
    (say 32
      (match (saGetNames collected.prmN collected.prmV "untagged")
        ((None) false)
        ((Some params) (== (vecLen params) 0))))
    (let bodyLines vecNew)
    (say 33 (== (axirLowered None bodyLines) 0))
    (say 34 (== (vecLen bodyLines) 0))
    (say 35 (== (axirLowered (Some definition) bodyLines) 1))
    (say 36 (> (vecLen bodyLines) 0))
    (let refused (nodeBuildDFn "refused" (vecPush vecNew "x") (mkEVarAt "unknown" 0) 0))
    (let saved (vecLen bodyLines))
    (say 37 (== (axirLowered (Some refused) bodyLines) 0))
    (say 38 (== (vecLen bodyLines) saved))
    (let functions (:: vecNew (Vec FnEnt)))
    (regFn functions "projection" (mkTArr mkIntTy mkIntTy))
    (let entry (vecGet functions 0))
    (let facts (rgnFactsNew 2))
    (set facts.flowsCUR 3)
    (set entry.rgn (Some facts))
    (let absentNames vecNew)
    (symMirMetas entry None 0 absentNames)
    (say 39 (strEq (vecGet absentNames 1) "mir-escapes=0,1"))
    (let shortNames vecNew)
    (symMirMetas entry (Some (vecPush vecNew "first")) 0 shortNames)
    (say 40 (strEq (vecGet shortNames 1) "mir-escapes=first,1"))
    0
  })
