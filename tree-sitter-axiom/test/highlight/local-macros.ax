(macro (paint value) value)
;       ^^^^^ function.macro
;             ^^^^^ variable.parameter
;                    ^^^^^ variable
(fn (after input)
  {
    (paint input)
;    ^^^^^ function.macro
    {
      (let paint input)
;          ^^^^^ variable
      (paint input)
;      ^^^^^ variable
      {
        (paint input)
;        ^^^^^ variable
      }
    }
    (paint input)
;    ^^^^^ function.macro
  })
(fn (shadow paint) (paint 1))
;           ^^^^^ variable.parameter
;                   ^^^^^ variable.parameter
(fn (before) (later 1))
;             ^^^^^ function.call
(macro (later value) value)
;       ^^^^^ function.macro
(fn (afterLater) (later 1))
;                 ^^^^^ function.macro
(macro unwrap
;      ^^^^^^ function.macro
  ((unwrap value) value))
;   ^^^^^^ function.macro
;                 ^^^^^ variable
(fn (ruleUse input) (unwrap input))
;                    ^^^^^^ function.macro
(:: ordinary (-> Int Int))
(fn (ordinary value) value)
(macro (quoted input) ordinary)
;                     ^^^^^^^^ variable
(macro (templateCalls input) (paint input))
;                             ^^^^^ function.call
;                                   ^^^^^ variable
(macro rawRule
  ((rawRule input) ordinary))
;                  ^^^^^^^^ variable
(fn (unrelated input) (ordinary input))
;                      ^^^^^^^^ function
